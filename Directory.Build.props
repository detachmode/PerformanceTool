<Project>
  <!-- Every project in this repo (brain 0055): compiler warnings fail the build. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet audit (known vulnerable packages) stays a warning, so a newly published advisory doesn't break every build at once (Proposed, brain 0055). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Shared NuGet metadata defaults for all packable libraries. -->
  <PropertyGroup>
    <Version>0.2.17</Version>
    <Authors>detachmode</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/detachmode/PerformanceTool</PackageProjectUrl>
    <RepositoryUrl>https://github.com/detachmode/PerformanceTool</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
