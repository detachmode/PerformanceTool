<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Aspire-style Beesharp.Host load-test project for the tracing example (brain 0058, 0063).
       Runs compiled C# 15 union step-machine scenarios against shop-api / payment-api, with
       embedded PDB sources so the Beesharp Editor can inspect the compiled scenario code. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Beesharp.Host/Beesharp.Host.csproj" />
    <!-- Only needed for in-repo ProjectReference; NuGet consumers get the UI bundled inside Beesharp.Host.nupkg. -->
    <ProjectReference Include="../../../src/Beesharp.Client/Beesharp.Client.csproj" />
  </ItemGroup>

</Project>
