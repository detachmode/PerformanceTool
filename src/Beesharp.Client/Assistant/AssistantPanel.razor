@* The assistant side panel (brain 0047, 0048, 0049): a chat on the right that pushes the page aside (a full-screen sheet on mobile). Calm UI (brain 0016): the agent's
   answers are short text, what it did shows as quiet one-line chips (reads grouped as "3 actions"), and data comes as small cards. Every chip and card opens what is behind it (brain 0029). *@
@using Beesharp.Ai.Contracts
@implements IDisposable
@inject AssistantState Assistant
@inject IJSRuntime JS

@if (Assistant.Available && Assistant.IsOpen)
{
    <aside class="asst" aria-label="Assistant">
        <header class="asst-head">
            <b>Assistant</b>
            @if (Assistant.Configured && !string.IsNullOrWhiteSpace(Assistant.Model))
            {
                <span class="muted asst-model" title="Model">@Assistant.Model</span>
            }
            <span class="spacer"></span>
            @if (Assistant.Configured)
            {
                <button type="button" class="btn ghost small" @onclick="Assistant.NewChat" disabled="@(Assistant.Entries.Count == 0)" title="Start a new conversation">New chat</button>
            }
            <button type="button" class="icon-btn" @onclick="Assistant.Close" aria-label="Close the assistant" title="Close">✕</button>
        </header>

        <div class="asst-scroll" @ref="scroller" role="log" aria-live="polite" aria-label="Conversation">
            @if (!Assistant.Configured)
            {
                <div class="asst-empty">
                    <p><b>Assistant is not configured</b></p>
                    <p class="muted">Set <code>AI__Model</code> (and optionally <code>AI__Endpoint</code> and <code>AI__ApiKey</code>) in the server environment to enable the AI assistant.</p>
                    <div class="asst-suggest">
                        <button type="button" class="btn ghost small" @onclick="Assistant.CheckStatusAsync">Recheck</button>
                    </div>
                </div>
            }
            else if (Assistant.Entries.Count == 0)
            {
                <div class="asst-empty">
                    <p class="muted">Ask about the runs, bees and logs, or tell me what to change in the plan.</p>
                    <div class="asst-suggest">
                        <button type="button" class="chip" @onclick='() => SendAsync("How did the last run go?")'>How did the last run go?</button>
                        <button type="button" class="chip" @onclick='() => SendAsync("Which endpoints have slow calls?")'>Which endpoints have slow calls?</button>
                        <button type="button" class="chip" @onclick='() => SendAsync("Show the failed bees on a time line.")'>Show the failed bees on a time line</button>
                        <button type="button" class="chip" @onclick='() => SendAsync("What is in the plan right now?")'>What is in the plan?</button>
                    </div>
                </div>
            }
            @for (var i = 0; i < Assistant.Entries.Count; i++)
            {
                var entryIndex = i;
                var entry = Assistant.Entries[i];
                @if (entry.FromUser)
                {
                    <div class="asst-user">@entry.Text</div>
                }
                else
                {
                    <div class="asst-answer">
                        @foreach (var block in Blocks(entry.Items))
                        {
                            var b = block;
                            @if (b.Item is { Type: AssistantItemTypes.Text } t)
                            {
                                <MarkdownBlock Text="@t.Text" />
                            }
                            else if (b.Item is { Type: AssistantItemTypes.View, View: { } view })
                            {
                                <ViewCard View="view" />
                            }
                            else if (b.Item is { Type: AssistantItemTypes.Tool, Tool: { } tool })
                            {
                                @Chip(tool, $"{entryIndex}:{b.Index}")
                            }
                            else if (b.Group is { Count: > 0 } group)
                            {
                                var key = $"{entryIndex}:g{b.Index}";
                                <div class="asst-group">
                                    <button type="button" class="asst-chip quiet" aria-expanded="@Aria.Bool(open.Contains(key))" @onclick="() => Toggle(key)" title="What I looked at">
                                        <span class="caret" aria-hidden="true">@(open.Contains(key) ? "▾" : "▸")</span>@Format.Plural(group.Count, "action", "actions")
                                    </button>
                                    @if (open.Contains(key))
                                    {
                                        <div class="asst-group-list">
                                            @foreach (var (tool2, idx) in group.Select((t2, k) => (t2, k)))
                                            {
                                                @Chip(tool2, $"{key}:{idx}")
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                        @if (entry.Error is not null)
                        {
                            <p class="asst-error bad" role="alert">@entry.Error</p>
                        }
                        @if (entry.Changed is { Count: > 0 })
                        {
                            <p class="asst-changed muted">
                                Changed:
                                @foreach (var area in entry.Changed)
                                {
                                    var a = area;
                                    <button type="button" class="link-btn" @onclick="() => Assistant.OpenLinkAsync(AreaLink(a))" title="Open @AreaName(a)">@AreaName(a)</button>
                                }
                            </p>
                        }
                    </div>
                }
            }
            @if (Assistant.Busy)
            {
                <div class="asst-thinking" role="status"><i></i><i></i><i></i><span class="visually-hidden">Thinking…</span></div>
            }
        </div>

        @if (Assistant.Configured)
        {
            <footer class="asst-composer">
                <div class="asst-composer-box">
                    <textarea @ref="composer" rows="1" placeholder="Ask or tell the assistant…" aria-label="Message" @bind="draft" @bind:event="oninput" disabled="@Assistant.Busy"></textarea>
                    <button type="button" class="btn primary small asst-send" @onclick="SendDraftAsync" disabled="@(Assistant.Busy || string.IsNullOrWhiteSpace(draft))" title="Send (Enter)">Send</button>
                </div>
            </footer>
        }
    </aside>
}

@code {
    private ElementReference scroller, composer;
    private string draft = "";
    private readonly HashSet<string> open = [];
    private IJSObjectReference? module;
    private IJSObjectReference? handle;
    private DotNetObjectReference<AssistantPanel>? self;
    private bool wasOpen, scrollNext;
    private int lastCount = -1;
    private bool lastBusy;

    private sealed record Block(int Index, AssistantItemDto? Item, List<ToolActivityDto>? Group);

    protected override void OnInitialized() => Assistant.Changed += OnChanged;

    private void OnChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    /// <summary>The items of an answer, with consecutive quiet reads folded into one group ("3 actions"); changes, failures and cards stand alone.</summary>
    private static List<Block> Blocks(IReadOnlyList<AssistantItemDto> items)
    {
        var blocks = new List<Block>();
        for (var i = 0; i < items.Count; i++)
        {
            var item = items[i];
            if (item.Tool is { Changes: false, Ok: true } quiet)
            {
                if (blocks.Count > 0 && blocks[^1].Group is { } open) open.Add(quiet);
                else blocks.Add(new Block(i, null, [quiet]));
            }
            else blocks.Add(new Block(i, item, null));
        }
        return blocks;
    }

    private RenderFragment Chip(ToolActivityDto tool, string key) => @<div class="asst-chip-wrap">
        <div class="asst-chiprow">
            <button type="button" class="asst-chip @(tool.Ok ? (tool.Changes ? "change" : "quiet") : "failed")" aria-expanded="@Aria.Bool(open.Contains(key))" @onclick="() => Toggle(key)" title="Show what was sent and returned">
                <span class="caret" aria-hidden="true">@(open.Contains(key) ? "▾" : "▸")</span>@tool.Summary
            </button>
            @if (tool.Link is { } link)
            {
                <button type="button" class="asst-open" @onclick="() => Assistant.OpenLinkAsync(link)" title="@LinkTitle(link)" aria-label="@LinkTitle(link)">↗</button>
            }
        </div>
        @if (open.Contains(key))
        {
            <div class="asst-io">
                <span class="muted">@tool.Name</span>
                @if (tool.InputJson is { } input) { <pre><span class="muted">sent </span>@input</pre> }
                @if (tool.OutputJson is { } output) { <pre><span class="muted">returned </span>@output</pre> }
            </div>
        }
    </div>;

    private void Toggle(string key) { if (!open.Remove(key)) open.Add(key); }

    private static string LinkTitle(ChipLinkDto link) => link.Target switch
    {
        "editor" => "Open the editor",
        "calls" => "Open Calls analysis",
        "scripts" => "Open the scripts",
        "environments" => "Open the environments",
        "logs" => "Open these logs",
        "run" => link.Query?.Bee is not null ? "Open this bee" : "Open the run",
        _ => "Open",
    };

    private static ChipLinkDto AreaLink(string area) => area switch
    {
        ChangedAreas.Plan or ChangedAreas.Presets => new("editor"),
        ChangedAreas.Environments => new("environments"),
        ChangedAreas.Scripts or ChangedAreas.Preflights => new("scripts"),
        _ => new("run"),
    };

    private static string AreaName(string area) => area switch
    {
        ChangedAreas.Plan => "plan",
        ChangedAreas.Presets => "presets",
        ChangedAreas.Environments => "environments",
        ChangedAreas.Scripts => "scripts",
        ChangedAreas.Preflights => "preflights",
        ChangedAreas.Run => "run",
        _ => area,
    };

    private Task SendAsync(string text) => Assistant.SendAsync(text);

    private async Task SendDraftAsync()
    {
        var text = draft;
        if (string.IsNullOrWhiteSpace(text) || Assistant.Busy) return;
        draft = "";
        await Assistant.SendAsync(text);
    }

    [JSInvokable]
    public async Task OnEnter() => await InvokeAsync(SendDraftAsync);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var isOpen = Assistant.Available && Assistant.Configured && Assistant.IsOpen;
        try
        {
            if (isOpen && !wasOpen)
            {
                module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./assistant.js");
                self ??= DotNetObjectReference.Create(this);
                handle = await module.InvokeAsync<IJSObjectReference>("attach", composer, self);
                await handle.InvokeVoidAsync("focus");
                scrollNext = true;
            }
            else if (!isOpen && wasOpen && handle is not null)
            {
                await handle.InvokeVoidAsync("dispose");
                await handle.DisposeAsync();
                handle = null;
            }
            wasOpen = isOpen;

            // Follow the newest message, and give the composer back its (cleared) size after sending.
            if (isOpen && module is not null && (scrollNext || lastCount != Assistant.Entries.Count || lastBusy != Assistant.Busy))
            {
                lastCount = Assistant.Entries.Count;
                lastBusy = Assistant.Busy;
                scrollNext = false;
                await module.InvokeVoidAsync("scrollToEnd", scroller);
                if (handle is not null)
                {
                    await handle.InvokeVoidAsync("resize");
                    if (!Assistant.Busy) await handle.InvokeVoidAsync("focus");
                }
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    public void Dispose()
    {
        Assistant.Changed -= OnChanged;
        self?.Dispose();
    }
}
