@* Generated editor for a scenario's parameter class (docs/brain/0007). Never add per-scenario markup here:
   new parameter shapes are supported by adding a FieldKind in ParameterSpec and a case below. *@
@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Nodes
@using Beesharp.Services.Environments
@using Beesharp.Services.Scenarios.Spec

@foreach (var f in Spec.Fields)
{
    var field = f;
    if (Show == FieldFilter.Essential && field.Advanced || Show == FieldFilter.Advanced && !field.Advanced) continue;
    var id = $"{IdPrefix}-{field.JsonName}";
    var fieldErrors = Errors is not null && Errors.TryGetValue(ErrorPrefix + field.JsonName, out var fe) ? fe : null;
    <div class="field @(field.Wide ? "wide" : "") @(fieldErrors is null ? "" : "is-invalid") kind-@field.Kind.ToString().ToLowerInvariant()" data-field="@field.JsonName" data-fid="@id">
        @if (field.Kind is not (FieldKind.Toggle or FieldKind.Group))
        {
            <label for="@id">
                @field.Label
                @if (field.Optional)
                {
                    <span class="opt">optional</span>
                }
            </label>
        }
        @switch (field.Kind)
        {
            case FieldKind.Text:
                <input id="@id" type="text" value="@Str(field)" placeholder="@field.Placeholder" disabled="@Disabled" @oninput="e => SetStr(field, e)" @onchange="Committed" />
                @if (Placeholders.HasPlaceholder(Str(field))) { <PlaceholderHint Text="@Str(field)" /> }
                break;
            case FieldKind.Url:
                <input id="@id" type="url" value="@Str(field)" placeholder="@(field.Placeholder ?? "https://")" disabled="@Disabled" @oninput="e => SetStr(field, e)" @onchange="Committed" />
                @if (Placeholders.HasPlaceholder(Str(field))) { <PlaceholderHint Text="@Str(field)" /> }
                break;
            case FieldKind.Multiline:
                <textarea id="@id" rows="3" value="@Str(field)" placeholder="@field.Placeholder" disabled="@Disabled" @oninput="e => SetStr(field, e)" @onchange="Committed"></textarea>
                @if (Placeholders.HasPlaceholder(Str(field))) { <PlaceholderHint Text="@Str(field)" /> }
                break;
            case FieldKind.Secret:
                var shown = revealed.Contains(id);
                <div class="secret">
                    <input id="@id" type="@(shown ? "text" : "password")" autocomplete="off" value="@Str(field)"
                           placeholder="@(field.Placeholder ?? "value, {{Key}} or ${env:NAME}")" disabled="@Disabled" @oninput="e => SetStr(field, e)" @onchange="Committed" />
                    <button type="button" class="icon-btn" title="@(shown ? "Hide" : "Show")" aria-label="@(shown ? "Hide value" : "Show value")"
                            @onclick="() => { if (!revealed.Remove(id)) revealed.Add(id); }">@(shown ? "Hide" : "Show")</button>
                </div>
                @if (Placeholders.HasPlaceholder(Str(field))) { <PlaceholderHint Text="@Str(field)" /> }
                break;
            case FieldKind.Toggle:
                var on = Bool(field);
                <div class="toggle-row">
                    <button id="@id" type="button" role="switch" aria-checked="@Aria.Bool(on)" class="toggle @(on ? "on" : "")"
                            disabled="@Disabled" @onclick="() => { Values[field.JsonName] = !on; Committed.InvokeAsync(); }"><span class="knob"></span></button>
                    <label for="@id">@field.Label</label>
                </div>
                break;
            case FieldKind.Choice:
                <select id="@id" value="@Str(field)" disabled="@Disabled" @onchange="e => { SetStr(field, e); Committed.InvokeAsync(); }">
                    @foreach (var o in field.Options)
                    {
                        <option value="@o.Value">@o.Label</option>
                    }
                </select>
                break;
            case FieldKind.Integer:
                {
                    var cur = NumVal(field);
                    var sc = SliderScale.For(field, cur);
                    var (sMin, sMax, sStep) = (sc.Min, sc.Max, sc.Step);
                    var clamped = sc.Thumb(cur);
                    <div class="slider with-input">
                        <input id="@id" type="range" min="@Inv(sMin)" max="@Inv(sMax)" step="@Inv(sStep)" value="@Inv(clamped)"
                               aria-label="@field.Label slider" disabled="@Disabled"
                               @oninput="e => { SetNumber(field, e); Committed.InvokeAsync(); }" />
                        <input id="@($"{id}-num")" class="slider-num" type="number" inputmode="numeric" step="1" min="@Inv(field.Min)" max="@Inv(field.Max)"
                               aria-label="@field.Label value"
                               value="@NumStr(field)" placeholder="@field.Placeholder" disabled="@Disabled"
                               @oninput="e => SetNumber(field, e)" @onchange="Committed" />
                    </div>
                }
                break;
            case FieldKind.Number:
                {
                    @* Floating point: a slider that also lands between whole numbers, and the number input beside it for exact values (brain 0066). *@
                    var cur = NumVal(field);
                    var sc = SliderScale.For(field, cur);
                    <div class="slider with-input">
                        <input id="@id" type="range" min="@Inv(sc.Min)" max="@Inv(sc.Max)" step="@Inv(sc.Step)" value="@Inv(sc.Thumb(cur))"
                               aria-label="@field.Label slider" disabled="@Disabled"
                               @oninput="e => { SetSlid(field, sc, e); Committed.InvokeAsync(); }" />
                        <input id="@($"{id}-num")" class="slider-num" type="number" inputmode="decimal" step="any" min="@Inv(field.Min)" max="@Inv(field.Max)"
                               aria-label="@field.Label value"
                               value="@NumStr(field)" placeholder="@field.Placeholder" disabled="@Disabled" @oninput="e => SetNumber(field, e)" @onchange="Committed" />
                    </div>
                }
                break;
            case FieldKind.Slider:
                <div class="slider">
                    <input id="@id" type="range" min="@Inv(field.Min)" max="@Inv(field.Max)" step="1" value="@NumStr(field)"
                           disabled="@Disabled" @oninput="e => { SetNumber(field, e); Committed.InvokeAsync(); }" />
                    <output for="@id">@NumStr(field)</output>
                </div>
                break;
            case FieldKind.Duration:
                <DurationInput Id="@id" Value="@Duration(field)" Disabled="Disabled" ValueChanged="v => SetDuration(field, v)" OnCommit="Committed" />
                break;
            case FieldKind.List:
                <ListEditor Id="@id" Items="@Array(field)" Urls="field.ItemsAreUrls" Disabled="Disabled" OnEdited="Edited" OnCommit="Committed" />
                break;
            case FieldKind.KeyValue:
                <KeyValueEditor Id="@id" Values="@Object(field)" Disabled="Disabled" OnEdited="Edited" OnCommit="Committed" />
                break;
            case FieldKind.Group:
                <details class="group" open>
                    <summary>@field.Label</summary>
                    <div class="group-body">
                        <ParameterEditor Spec="field.Children!" Values="@Object(field)" Disabled="Disabled" IdPrefix="@id" Errors="Errors" ErrorPrefix="@($"{ErrorPrefix}{field.JsonName}-")" Edited="Edited" Committed="Committed" />
                    </div>
                </details>
                break;
        }
        @if (fieldErrors is not null && field.Kind != FieldKind.Group)
        {
            <small class="field-error" id="@($"{id}-err")" role="alert">@string.Join(" ", fieldErrors)</small>
        }
        @if (field.Description is not null && field.Kind != FieldKind.Group)
        {
            <small class="help">@field.Description</small>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public ParameterSpec Spec { get; set; } = default!;
    /// <summary>The stored values (preset format). Edited in place.</summary>
    [Parameter, EditorRequired] public JsonObject Values { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string IdPrefix { get; set; } = "p";
    /// <summary>Optional inline validation messages by field (see <c>ParameterSpec.ValidateByField</c>).</summary>
    [Parameter] public IReadOnlyDictionary<string, List<string>>? Errors { get; set; }
    [Parameter] public string ErrorPrefix { get; set; } = "";
    /// <summary>Essential parameters are shown by default, advanced ones under "More options" (brain 0016).</summary>
    [Parameter] public FieldFilter Show { get; set; } = FieldFilter.All;

    /// <summary>Raised on every change while typing (input event): the page updates "Unsaved changes", Save and the card marker.</summary>
    [Parameter] public EventCallback Edited { get; set; }
    /// <summary>Raised when the user leaves a field (change event): the page shows validation errors right away.</summary>
    [Parameter] public EventCallback Committed { get; set; }

    private readonly HashSet<string> revealed = [];

    
    private static string? Inv(double? d) => d?.ToString(CultureInfo.InvariantCulture);

    private string Str(FieldSpec f) => Values[f.JsonName] is JsonValue v && v.TryGetValue<string>(out var s) ? s : "";
    private Task SetStr(FieldSpec f, ChangeEventArgs e) { Values[f.JsonName] = e.Value?.ToString() ?? ""; return Edited.InvokeAsync(); }

    private bool Bool(FieldSpec f) => Values[f.JsonName] is JsonValue v && v.TryGetValue<bool>(out var b) && b;

    private string NumStr(FieldSpec f) => Values[f.JsonName] switch
    {
        JsonValue v when v.GetValueKind() == JsonValueKind.Number => v.ToJsonString(),
        JsonValue v when v.TryGetValue<string>(out var s) => s,
        _ => "",
    };

    private double? NumVal(FieldSpec f) => double.TryParse(NumStr(f), NumberStyles.Float, CultureInfo.InvariantCulture, out var d) ? d : null;

    /// <summary>The slider moved: store the value rounded to the step's decimals (no 0.30000000000000004).</summary>
    private Task SetSlid(FieldSpec f, SliderScale scale, ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var d)) Values[f.JsonName] = scale.Snap(d);
        return Edited.InvokeAsync();
    }

    private Task SetNumber(FieldSpec f, ChangeEventArgs e)
    {
        var text = e.Value?.ToString()?.Trim() ?? "";
        if (text.Length == 0)
        {
            if (f.Nullable) Values[f.JsonName] = null;
            return Edited.InvokeAsync();
        }
        if (f.Kind is FieldKind.Integer or FieldKind.Slider)
        {
            if (long.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out var l)) Values[f.JsonName] = l;
        }
        else if (double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var d)) Values[f.JsonName] = d;
        return Edited.InvokeAsync();
    }

    private TimeSpan Duration(FieldSpec f) =>
        TimeSpan.TryParse(Str(f), CultureInfo.InvariantCulture, out var t) ? t : TimeSpan.Zero;

    private Task SetDuration(FieldSpec f, TimeSpan value) { Values[f.JsonName] = value.ToString("c", CultureInfo.InvariantCulture); return Edited.InvokeAsync(); }

    private JsonArray Array(FieldSpec f)
    {
        if (Values[f.JsonName] is JsonArray a) return a;
        var created = new JsonArray();
        Values[f.JsonName] = created;
        return created;
    }

    private JsonObject Object(FieldSpec f)
    {
        if (Values[f.JsonName] is JsonObject o) return o;
        var created = f.Children?.DefaultJson() ?? new JsonObject();
        Values[f.JsonName] = created;
        return created;
    }
}
