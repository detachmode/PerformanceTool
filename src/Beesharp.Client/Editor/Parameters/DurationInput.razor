@using Beesharp.Services.Scenarios.Spec

<input id="@Id" type="text" class="@(error is null ? "" : "invalid")" value="@text" placeholder="e.g. 500ms, 2s, 1m 30s"
       disabled="@Disabled" @oninput="OnInput" @onchange="OnChange" />
@if (error is not null)
{
    <small class="help warn">@error</small>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public TimeSpan Value { get; set; }
    [Parameter] public EventCallback<TimeSpan> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnCommit { get; set; }

    private string text = "";
    private string? error;
    private TimeSpan? shown;

    protected override void OnParametersSet()
    {
        if (shown != Value)
        {
            shown = Value;
            text = DurationFormat.Format(Value);
            error = null;
        }
    }

    // While typing: store the value as soon as it parses (so Save enables at once), but keep the typed text and show no error yet.
    private async Task OnInput(ChangeEventArgs e)
    {
        text = e.Value?.ToString() ?? "";
        if (DurationFormat.TryParse(text, out var value) && value >= TimeSpan.Zero)
        {
            error = null;
            shown = value;
            await ValueChanged.InvokeAsync(value);
        }
    }

    private async Task OnChange(ChangeEventArgs e)
    {
        text = e.Value?.ToString() ?? "";
        if (DurationFormat.TryParse(text, out var value) && value >= TimeSpan.Zero)
        {
            error = null;
            shown = value;
            text = DurationFormat.Format(value);
            await ValueChanged.InvokeAsync(value);
        }
        else
        {
            error = "Use a duration like 500ms, 2s or 1m 30s.";
        }
        await OnCommit.InvokeAsync();
    }
}
