@* C# script editor powered by Monaco Editor, with a clean textarea fallback if Monaco fails to load. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="cs-ed @(useFallback ? (WordWrap ? "wrap" : "nowrap") : "monaco-ed")">
    @if (useFallback)
    {
        <textarea class="cs-fallback-ta" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"
                  wrap="@(WordWrap ? "soft" : "off")"
                  readonly="@ReadOnly"
                  aria-label="@AriaLabel"
                  value="@Value"
                  @oninput="OnFallbackInput"></textarea>
    }
    else
    {
        <div class="monaco-host" @ref="hostEl" aria-label="@AriaLabel"></div>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool WordWrap { get; set; } = true;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "C# scenario script";

    private ElementReference hostEl;
    private DotNetObjectReference<CSharpCodeEditor>? selfRef;
    private IJSObjectReference? module;
    private IJSObjectReference? handle;
    private string lastAppliedValue = "";
    private bool lastWordWrap = true;
    private bool lastReadOnly;
    private bool useFallback;
    private bool disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;

        if (firstRender)
        {
            var initial = Value ?? "";
            lastAppliedValue = initial;
            lastWordWrap = WordWrap;
            lastReadOnly = ReadOnly;
            selfRef = DotNetObjectReference.Create(this);

            try
            {
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./monaco-host.js");
            }
            catch { }

            if (module is not null && !disposed)
            {
                try
                {
                    handle = await module.InvokeAsync<IJSObjectReference?>(
                        "createCodeEditor",
                        hostEl,
                        selfRef,
                        initial,
                        new { wordWrap = WordWrap, readOnly = ReadOnly, ariaLabel = AriaLabel });
                }
                catch { }
            }

            if (disposed)
            {
                await DisposeHandleAsync();
                return;
            }

            if (handle is null)
            {
                useFallback = true;
                StateHasChanged();
                return;
            }

            // Re-sync if Value, WordWrap, or ReadOnly changed while Monaco was loading from CDN.
            var current = Value ?? "";
            if (!string.Equals(current, lastAppliedValue, StringComparison.Ordinal))
            {
                lastAppliedValue = current;
                try { await handle.InvokeVoidAsync("setValue", current); } catch { }
            }
            if (WordWrap != lastWordWrap)
            {
                lastWordWrap = WordWrap;
                try { await handle.InvokeVoidAsync("setWordWrap", lastWordWrap); } catch { }
            }
            if (ReadOnly != lastReadOnly)
            {
                lastReadOnly = ReadOnly;
                try { await handle.InvokeVoidAsync("setReadOnly", lastReadOnly); } catch { }
            }
            return;
        }

        if (handle is not null)
        {
            var current = Value ?? "";
            if (!string.Equals(current, lastAppliedValue, StringComparison.Ordinal))
            {
                lastAppliedValue = current;
                try { await handle.InvokeVoidAsync("setValue", current); } catch { }
            }
            if (WordWrap != lastWordWrap)
            {
                lastWordWrap = WordWrap;
                try { await handle.InvokeVoidAsync("setWordWrap", lastWordWrap); } catch { }
            }
            if (ReadOnly != lastReadOnly)
            {
                lastReadOnly = ReadOnly;
                try { await handle.InvokeVoidAsync("setReadOnly", lastReadOnly); } catch { }
            }
        }
    }

    [JSInvokable]
    public async Task OnContentChanged(string next)
    {
        if (disposed) return;
        lastAppliedValue = next;
        Value = next;
        await ValueChanged.InvokeAsync(next);
    }

    private async Task OnFallbackInput(ChangeEventArgs e)
    {
        var next = e.Value?.ToString() ?? "";
        lastAppliedValue = next;
        Value = next;
        await ValueChanged.InvokeAsync(next);
    }

    private async Task DisposeHandleAsync()
    {
        if (handle is null) return;
        var h = handle;
        handle = null;
        try { await h.InvokeVoidAsync("dispose"); } catch { }
        try { await h.DisposeAsync(); } catch { }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        await DisposeHandleAsync();
        if (module is not null)
        {
            var m = module;
            module = null;
            try { await m.DisposeAsync(); } catch { }
        }
        selfRef?.Dispose();
        selfRef = null;
    }
}
