@* Calls overview chart (brain 0067): horizontal p50 (solid) vs. p95 (translucent) comparison across all visible endpoints,
   autoscaled linear X-axis, scenario/default 50 ms target line, latency-only green-to-amber gradient, and independent red failure pills. *@
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

@{
    var effectiveTarget = liveTargetMs ?? TargetMs;
    var maxP95 = 0.0;
    for (var i = 0; i < Endpoints.Count; i++)
    {
        if (Endpoints[i].P95Ms > maxP95) maxP95 = Endpoints[i].P95Ms;
    }
    var computedAxis = CallsOverviewScale.ComputeAxis(maxP95, dragAxisMaxMs ?? effectiveTarget, compact: IsPhone);
    var axis = dragAxisMaxMs is { } lockedMax && lockedMax > 0
        ? CallsOverviewScale.ComputeAxis(lockedMax, 0, compact: IsPhone)
        : computedAxis;
    currentAxisMaxMs = axis.AxisMaxMs;
    var targetPct = axis.AxisMaxMs > 0 ? Math.Clamp(effectiveTarget / axis.AxisMaxMs * 100.0, 0, 100) : 0;
}

<section class="cl-card cl-ov-card" aria-label="Response time by endpoint overview">
    <div class="cl-ov-head">
        <div class="cl-ov-title-wrap">
            <h2>Response Time by Endpoint: Typical (p50) vs. p95</h2>
            <p class="cl-ov-sub muted tnum">
                @Format.Plural((int)Math.Min(int.MaxValue, TotalCalls), "call", "calls") across @Format.Plural(Endpoints.Count, "endpoint", "endpoints") · autoscaled to max p95
            </p>
        </div>

        <div class="cl-ov-controls">
            @if (IsPhone)
            {
                <div class="cl-ep-chips" role="group" aria-label="Filter endpoints by outcome">
                    <button type="button" class="yt-chip @(OutcomeFilter == 0 ? "on" : "")" @onclick="() => OnOutcomeFilterChanged.InvokeAsync(0)">All</button>
                    <button type="button" class="yt-chip warn @(OutcomeFilter == 1 ? "on" : "")" @onclick="() => OnOutcomeFilterChanged.InvokeAsync(1)">Slow</button>
                    <button type="button" class="yt-chip bad @(OutcomeFilter == 2 ? "on" : "")" @onclick="() => OnOutcomeFilterChanged.InvokeAsync(2)">Failed</button>
                </div>

                <select class="cl-ov-sort" aria-label="Sort endpoints" value="@Sort" @onchange="OnSortSelect">
                    <option value="p95">Slowest p95</option>
                    <option value="p50">Slowest p50</option>
                    <option value="slow">Most slow</option>
                    <option value="max">Slowest max</option>
                    <option value="count">Most calls</option>
                    <option value="failed">Most failed</option>
                    <option value="name">Endpoint</option>
                </select>
            }

            <label class="cl-ov-target-box" title="@(HasScenarioTarget && !HasTargetOverride ? "Scenario target threshold (edit to override)" : "Target latency threshold in ms (default 50 ms)")">
                <span>Target</span>
                <input type="number" min="1" max="60000" step="5" inputmode="numeric"
                       value="@targetInput"
                       aria-label="Target latency in milliseconds"
                       @onfocusin="() => editingTarget = true"
                       @oninput="OnTargetInput"
                       @onblur="OnTargetBlur" />
                <span>ms</span>
            </label>
            @if (HasTargetOverride)
            {
                <button type="button" class="link-btn cl-ov-reset" @onclick="ResetTarget" title="Reset target to default">Reset</button>
            }
        </div>
    </div>

    <div class="cl-ov-meta-row">
        <div class="cl-ov-legend" aria-label="Chart legend">
            <span class="cl-ov-leg"><i class="sw p50" aria-hidden="true"></i> p50 (typical)</span>
            <span class="cl-ov-leg"><i class="sw p95" aria-hidden="true"></i> p95 (95% faster)</span>
            <span class="cl-ov-leg"><i class="sw grad" aria-hidden="true"></i> fast → very slow</span>
            <span class="cl-ov-leg"><i class="sw target" aria-hidden="true"></i> target line</span>
            <span class="cl-ov-leg">
                <span class="cl-ov-fail-pill demo" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5h.01"/></svg>
                    N
                </span>
                has failures
            </span>
        </div>
    </div>

    @if (Endpoints.Count == 0)
    {
        <p class="muted cl-empty">No endpoints match this filter.</p>
    }
    else
    {
        <div class="cl-ov-target-row">
            <div class="cl-ov-axis-spacer" aria-hidden="true"></div>
            <div class="cl-ov-target-track" @ref="targetTrackRef">
                <span class="cl-ov-target-tag"
                      @ref="targetHandleRef"
                      role="slider"
                      tabindex="0"
                      aria-label="Target latency threshold (drag to adjust)"
                      aria-valuemin="1"
                      aria-valuemax="@Math.Round(axis.AxisMaxMs)"
                      aria-valuenow="@Math.Round(effectiveTarget)"
                      aria-valuetext="@($"{CallsOverviewScale.FormatMsValue(effectiveTarget)} ms")"
                      title="Drag left or right to adjust target latency"
                      style="@TargetTagStyle(targetPct)"
                      @onkeydown="OnTargetHandleKeyDown">
                    <span class="cl-ov-grip" aria-hidden="true">⋮</span>
                    @CallsOverviewScale.FormatMsValue(effectiveTarget) ms target
                </span>
            </div>
            <div class="cl-ov-axis-spacer" aria-hidden="true"></div>
        </div>

        <div class="cl-ov-chart" role="list" aria-label="Endpoint p50 and p95 latency bars">
            @foreach (var ep in Endpoints)
            {
                var item = ep;
                var p95Pct = axis.AxisMaxMs > 0 ? Math.Clamp(item.P95Ms / axis.AxisMaxMs * 100.0, 0, 100) : 0;
                var p50InsideP95 = p95Pct > 0 && item.P95Ms > 0 ? Math.Clamp(item.TypicalMs / item.P95Ms * 100.0, 0, 100) : 100;
                var colorVar = CallsOverviewScale.ColorCssVar(CallsOverviewScale.ClassifyLatency(item, effectiveTarget));

                <div class="cl-ov-row @(hovered == item ? "on" : "")"
                     role="listitem"
                     tabindex="0"
                     style="--c:@colorVar"
                     title="@RowTitle(item, effectiveTarget)"
                     aria-label="@RowTitle(item, effectiveTarget)"
                     @onpointerenter="() => hovered = item"
                     @onpointerleave="() => { if (hovered == item) hovered = null; }"
                     @onfocusin="() => hovered = item"
                     @onclick="() => OnSelectEndpoint.InvokeAsync(item.Endpoint)"
                     @onkeydown="e => OnRowKeyDown(e, item.Endpoint)">
                    <div class="cl-ov-op">
                        <span class="cl-ov-name" title="@item.Endpoint">@item.Endpoint</span>
                        @if (item.FailedCount > 0)
                        {
                            <button type="button"
                                    class="cl-ov-fail-pill"
                                    title="@Format.Plural(item.FailedCount, "failed call", "failed calls") — inspect failed"
                                    aria-label="@item.Endpoint: @Format.Plural(item.FailedCount, "failed call", "failed calls"), inspect failed"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => OnSelectEndpointFailed.InvokeAsync(item.Endpoint)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5h.01"/></svg>
                                @Format.Num(item.FailedCount)
                            </button>
                        }
                    </div>

                    <div class="cl-ov-track">
                        <div class="cl-ov-grid" aria-hidden="true">
                            @foreach (var tick in axis.Ticks)
                            {
                                var tickPct = axis.AxisMaxMs > 0 ? Math.Clamp(tick / axis.AxisMaxMs * 100.0, 0, 100) : 0;
                                <span class="cl-ov-gridline" style="left:@Pct(tickPct)%"></span>
                            }
                        </div>
                        <span class="cl-ov-target-line" style="left:@Pct(targetPct)%" aria-hidden="true"></span>
                        @if (item.HasCustomThreshold && item.SlowThresholdMs is { } ct && ct > 0 && ct <= axis.AxisMaxMs)
                        {
                            var ctPct = Math.Clamp(ct / axis.AxisMaxMs * 100.0, 0, 100);
                            <span class="cl-ov-custom-tick" style="left:@Pct(ctPct)%" title="Endpoint slow limit: @Format.Ms(ct)" aria-hidden="true"></span>
                        }
                        <div class="cl-ov-bar-p95" style="width:@Pct(p95Pct)%">
                            <div class="cl-ov-bar-p50" style="width:@Pct(p50InsideP95)%"></div>
                        </div>
                    </div>

                    <div class="cl-ov-nums tnum">
                        <b>@CallsOverviewScale.FormatMsValue(item.TypicalMs)</b> / @CallsOverviewScale.FormatMsValue(item.P95Ms) ms
                    </div>
                </div>
            }
        </div>

        <div class="cl-ov-axis-row" aria-hidden="true">
            <div class="cl-ov-axis-spacer"></div>
            <div class="cl-ov-axis-track">
                @for (var i = 0; i < axis.Ticks.Count; i++)
                {
                    var tick = axis.Ticks[i];
                    var tickPct = axis.AxisMaxMs > 0 ? Math.Clamp(tick / axis.AxisMaxMs * 100.0, 0, 100) : 0;
                    var cls = i == 0 ? "first" : i == axis.Ticks.Count - 1 ? "last" : "";
                    <span class="cl-ov-tick-label @cls" style="left:@Pct(tickPct)%">@CallsOverviewScale.FormatTick(tick)</span>
                }
            </div>
            <div class="cl-ov-axis-spacer"></div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CallEndpointSummaryDto> Endpoints { get; set; } = [];
    [Parameter] public long TotalCalls { get; set; }
    [Parameter] public double TargetMs { get; set; } = CallsOverviewScale.DefaultTargetMs;
    [Parameter] public bool HasTargetOverride { get; set; }
    [Parameter] public bool HasScenarioTarget { get; set; }
    [Parameter] public bool IsPhone { get; set; }
    [Parameter] public int OutcomeFilter { get; set; }
    [Parameter] public string Sort { get; set; } = "p95";
    [Parameter] public EventCallback<string> OnSelectEndpoint { get; set; }
    [Parameter] public EventCallback<string> OnSelectEndpointFailed { get; set; }
    [Parameter] public EventCallback<double?> OnTargetOverrideChanged { get; set; }
    [Parameter] public EventCallback<int> OnOutcomeFilterChanged { get; set; }
    [Parameter] public EventCallback<string> OnSortChanged { get; set; }

    private CallEndpointSummaryDto? hovered;
    private string targetInput = "50";
    private double? liveTargetMs;
    private double? dragAxisMaxMs;
    private double currentAxisMaxMs = 200;
    private bool editingTarget;
    private ElementReference targetTrackRef;
    private ElementReference targetHandleRef;
    private bool dragAttached;
    private IJSObjectReference? jsModule;
    private IJSObjectReference? dragHandle;
    private DotNetObjectReference<CallsOverviewChart>? selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Endpoints.Count == 0)
        {
            if (dragAttached)
            {
                dragAttached = false;
                if (dragHandle is not null)
                {
                    try { await dragHandle.InvokeVoidAsync("dispose"); } catch (Exception) { }
                    try { await dragHandle.DisposeAsync(); } catch (Exception) { }
                    dragHandle = null;
                }
            }
            return;
        }
        if (dragAttached) return;
        dragAttached = true;
        try
        {
            jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./call-chart.js");
            selfRef ??= DotNetObjectReference.Create(this);
            dragHandle = await jsModule.InvokeAsync<IJSObjectReference?>("attachTargetDrag", targetTrackRef, targetHandleRef, selfRef);
        }
        catch (Exception)
        {
            dragAttached = false;
        }
    }

    [JSInvokable]
    public async Task OnTargetDrag(double fraction, bool done)
    {
        dragAxisMaxMs ??= Math.Max(currentAxisMaxMs, 10);
        var raw = Math.Clamp(fraction, 0, 1) * dragAxisMaxMs.Value;
        var snapped = raw >= 100
            ? Math.Round(raw / 5.0) * 5.0
            : Math.Round(raw);
        var ms = Math.Clamp(Math.Max(1, snapped), 1, 60000);
        liveTargetMs = ms;
        targetInput = FormatInput(ms);
        if (done) dragAxisMaxMs = null;
        await OnTargetOverrideChanged.InvokeAsync(ms);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnTargetDragCancel()
    {
        dragAxisMaxMs = null;
        return InvokeAsync(StateHasChanged);
    }

    private Task OnTargetHandleKeyDown(KeyboardEventArgs e)
    {
        var step = e.ShiftKey ? 25.0 : 5.0;
        var cur = liveTargetMs ?? TargetMs;
        double? next = e.Key switch
        {
            "ArrowLeft" or "ArrowDown" => Math.Max(1, cur - step),
            "ArrowRight" or "ArrowUp" => Math.Min(60000, cur + step),
            _ => null
        };
        if (next is null) return Task.CompletedTask;
        liveTargetMs = next.Value;
        targetInput = FormatInput(next.Value);
        return OnTargetOverrideChanged.InvokeAsync(next.Value);
    }

    public async ValueTask DisposeAsync()
    {
        if (dragHandle is not null)
        {
            try { await dragHandle.InvokeVoidAsync("dispose"); } catch (Exception) { }
            try { await dragHandle.DisposeAsync(); } catch (Exception) { }
        }
        if (jsModule is not null)
        {
            try { await jsModule.DisposeAsync(); } catch (Exception) { }
        }
        selfRef?.Dispose();
    }

    protected override void OnParametersSet()
    {
        if (!editingTarget)
        {
            liveTargetMs = null;
            targetInput = FormatInput(TargetMs);
        }
        if (hovered is { } h && !Endpoints.Any(e => string.Equals(e.Endpoint, h.Endpoint, StringComparison.OrdinalIgnoreCase)))
            hovered = null;
    }

    private Task OnTargetInput(ChangeEventArgs e)
    {
        targetInput = e.Value?.ToString() ?? "";
        if (double.TryParse(targetInput, NumberStyles.Float, CultureInfo.InvariantCulture, out var v)
            && v >= 1 && !double.IsNaN(v) && !double.IsInfinity(v))
        {
            liveTargetMs = Math.Round(v, 2);
            return OnTargetOverrideChanged.InvokeAsync(liveTargetMs);
        }
        return Task.CompletedTask;
    }

    private Task OnTargetBlur()
    {
        editingTarget = false;
        if (string.IsNullOrWhiteSpace(targetInput))
        {
            liveTargetMs = null;
            targetInput = FormatInput(TargetMs);
            return OnTargetOverrideChanged.InvokeAsync(null);
        }
        if (double.TryParse(targetInput, NumberStyles.Float, CultureInfo.InvariantCulture, out var v)
            && v >= 1 && !double.IsNaN(v) && !double.IsInfinity(v))
        {
            var rounded = Math.Round(v, 2);
            liveTargetMs = rounded;
            targetInput = FormatInput(rounded);
            return OnTargetOverrideChanged.InvokeAsync(rounded);
        }
        liveTargetMs = null;
        targetInput = FormatInput(TargetMs);
        return Task.CompletedTask;
    }

    private Task ResetTarget()
    {
        editingTarget = false;
        liveTargetMs = null;
        return OnTargetOverrideChanged.InvokeAsync(null);
    }

    private Task OnSortSelect(ChangeEventArgs e) =>
        OnSortChanged.InvokeAsync(e.Value?.ToString() ?? "p95");

    private Task OnRowKeyDown(KeyboardEventArgs e, string endpoint)
    {
        if (e.Key is "Enter" or " ")
            return OnSelectEndpoint.InvokeAsync(endpoint);
        return Task.CompletedTask;
    }

    private static string FormatInput(double ms) =>
        Math.Round(ms, 2).ToString("0.##", CultureInfo.InvariantCulture);

    private static string Pct(double v) =>
        Math.Clamp(v, 0, 100).ToString("0.##", CultureInfo.InvariantCulture);

    private string TargetTagStyle(double pct)
    {
        if (IsPhone)
        {
            if (pct <= 12) return $"left:{Pct(pct)}%;transform:translateX(0)";
            if (pct >= 88) return $"left:{Pct(pct)}%;transform:translateX(-100%)";
        }
        return $"left:{Pct(pct)}%;transform:translateX(-50%)";
    }

    private static string RowTitle(CallEndpointSummaryDto ep, double targetMs)
    {
        var refMs = CallsOverviewScale.ReferenceMs(ep, targetMs);
        var limit = ep.HasCustomThreshold && ep.SlowThresholdMs is { } cl
            ? $" · limit {Format.Ms(cl)}"
            : $" · target {Format.Ms(refMs)}";
        var failed = ep.FailedCount > 0 ? $" · {Format.Num(ep.FailedCount)} failed" : "";
        var slow = ep.SlowCount > 0 ? $" · {Format.Num(ep.SlowCount)} slow" : "";
        return $"{ep.Endpoint}: {Format.Num(ep.TotalCount)} calls · p50 {Format.Ms(ep.TypicalMs)} · p95 {Format.Ms(ep.P95Ms)} · max {Format.Ms(ep.MaxMs)}{slow}{failed}{limit}";
    }
}
