<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The UI (brain 0015): standalone Blazor WebAssembly. Data comes through IRunSource. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Beesharp.Client</RootNamespace>
    <!-- Content-hashed asset URLs (brain 0025): index.html uses #[.{fingerprint}] placeholders and an importmap. -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <!-- Project JS modules (dock-magnify.js) get hashed names and an importmap entry. CSS and the icon cannot use the placeholders in standalone WASM, so the workflow adds ?v=sha to them (brain 0025). -->
  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="AppJs" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <!-- Build info (brain 0025). CI passes -p:BuildSha=<full sha> -p:BuildTime=<ISO UTC>; local builds have no sha. -->
  <PropertyGroup>
    <BuildSha Condition="'$(BuildSha)' == ''"></BuildSha>
    <BuildTime Condition="'$(BuildTime)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))</BuildTime>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildSha</_Parameter1>
      <_Parameter2>$(BuildSha)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTime</_Parameter1>
      <_Parameter2>$(BuildTime)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.*-*" />
    <ProjectReference Include="../Beesharp.Core/Beesharp.Core.csproj" />
    <!-- The assistant's wire DTOs (brain 0047). Only the contracts: never Microsoft.Extensions.AI, so the trimmed WASM stays small. -->
    <ProjectReference Include="../Beesharp.Ai.Contracts/Beesharp.Ai.Contracts.csproj" />
    <!-- The generated parameter editor reflects over the parameter classes (brain 0007). Keep everything in Core
         (types, properties, attributes) when the Release publish trims the app. -->
    <TrimmerRootAssembly Include="Beesharp.Core" />
    <TrimmerRootAssembly Include="Beesharp.Ai.Contracts" />
  </ItemGroup>

</Project>
