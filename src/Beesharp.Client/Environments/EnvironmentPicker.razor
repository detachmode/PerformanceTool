@* Environment dropdown in the top bar, like Bruno (brain 0033): shows the active environment compactly ("No environment" when none); the menu picks another
   one or opens the Configure popup. Calm UI (0016): one small button, the list only on demand. *@
@implements IDisposable
@inject IEnvironmentSource Envs
@inject EnvironmentsPopupState Popup

<div class="env-picker" @onkeydown="OnKey">
    <button type="button" class="env-btn @(Envs.ActiveName is null ? "none" : "")" aria-haspopup="menu" aria-expanded="@Aria.Bool(open)"
            title="Environment: fills the {{Key}} placeholders when a run starts" @onclick="Toggle">
        <span class="env-label">Environment</span>
        <span class="env-name">@(Envs.ActiveName ?? "No environment")</span>
        <span class="caret" aria-hidden="true">▾</span>
    </button>
    @if (open)
    {
        var shown = Envs.Environments.Where(e => filter.Length == 0 || e.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)).ToList();
        <DropMenu Class="right env-dd" Label="Environments" OnClose="@(() => open = false)" Total="Envs.Environments.Count" @bind-Filter="filter" FilterPlaceholder="Filter environments…">
            <ChildContent>
                @if (filter.Length == 0)
                {
                    <button type="button" role="menuitemradio" aria-checked="@Aria.Bool(Envs.ActiveName is null)" class="dd-item @(Envs.ActiveName is null ? "on" : "")" @onclick="() => Pick(null)">
                        <span class="dd-check" aria-hidden="true">@(Envs.ActiveName is null ? "✓" : "")</span><span class="dd-text">No environment</span>
                    </button>
                }
                @if (shown.Count == 0)
                {
                    <div class="dd-none">No environment matches “@filter”.</div>
                }
                @foreach (var e in shown)
                {
                    var name = e.Name;
                    var on = name == Envs.ActiveName;
                    <button type="button" role="menuitemradio" aria-checked="@Aria.Bool(on)" class="dd-item @(on ? "on" : "")" title="@name" @onclick="() => Pick(name)">
                        <span class="dd-check" aria-hidden="true">@(on ? "✓" : "")</span><span class="dd-text">@name</span>
                    </button>
                }
            </ChildContent>
            <Foot>
                <button type="button" role="menuitem" class="dd-item configure" @onclick="Configure"><span class="dd-check" aria-hidden="true"></span><span class="dd-text">Configure…</span></button>
            </Foot>
        </DropMenu>
    }
</div>

@code {
    private bool open;
    private string filter = string.Empty;

    protected override void OnInitialized() => Envs.Changed += OnChanged;

    private void OnChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private void Toggle() { open = !open; filter = string.Empty; }
    private void Pick(string? name) { Envs.SetActive(name); open = false; }
    private void Configure() { open = false; Popup.Show(); }
    private void OnKey(KeyboardEventArgs e) { if (e.Key == "Escape") open = false; }

    public void Dispose() => Envs.Changed -= OnChanged;
}
