@* Configure popup for environments (brain 0033): the environments on the left (add, pick), the selected one's name and key-value table on the right
   (rename, delete, add and remove rows, edit inline). Visible state (brain 0019): "Unsaved changes", Save only when something changed, "Saved ✓", and a
   confirm before closing over unsaved changes. Calm UI (0016): credential-like values are masked until shown. *@
@using Beesharp.Services.Environments
@implements IDisposable
@inject IEnvironmentSource Envs
@inject EnvironmentsPopupState Popup

<div class="overlay envs" tabindex="-1" @ref="root" @onkeydown="OnKey" @onclick="TryClose" role="presentation">
    <div class="dialog env-dialog" role="dialog" aria-modal="true" aria-labelledby="env-title" @onclick:stopPropagation="true">
        <div class="dlg-head">
            <h2 id="env-title">Environments</h2>
            <span class="muted env-sub">Fill <code>{{Key}}</code> in scenario values</span>
            <span class="spacer"></span>
            @if (current is not null && Dirty(current)) { <span class="unsaved" role="status"><i></i>Unsaved changes</span> }
            else if (savedNote) { <span class="saved" role="status">Saved ✓</span> }
            <button class="icon-btn" @onclick="TryClose" aria-label="Close">✕</button>
        </div>

        @if (confirmClose)
        {
            <div class="notice" role="alertdialog" aria-label="Discard unsaved changes?">
                <span>Discard the unsaved changes in @drafts.Count(Dirty) environment(s)?</span>
                <button class="btn ghost" @onclick="() => confirmClose = false">Keep editing</button>
                <button class="btn danger" @onclick="Popup.Close">Discard and close</button>
            </div>
        }

        <div class="env-body">
            <nav class="env-list" aria-label="Environments">
                @if (drafts.Count >= DropMenu.FilterFrom)
                {
                    <div class="env-list-filter"><input type="text" placeholder="Filter environments…" aria-label="Filter environments" autocomplete="off" spellcheck="false" @bind="listFilter" @bind:event="oninput" /></div>
                }
                <div class="env-list-scroll" @ref="listScroll">
                    @foreach (var d in drafts.Where(x => listFilter.Length == 0 || x.Env.Name.Contains(listFilter, StringComparison.OrdinalIgnoreCase) || x == current))
                    {
                        var draft = d;
                        var isActive = draft.Original is not null && draft.Original == Envs.ActiveName;
                        <button type="button" class="env-item @(draft == current ? "on" : "")" aria-current="@Aria.Bool(draft == current)" title="@draft.Env.Name" @onclick="() => Select(draft)">
                            <span class="nm">@(string.IsNullOrWhiteSpace(draft.Env.Name) ? "(no name)" : draft.Env.Name)</span>
                            @if (Dirty(draft)) { <i class="dirty" title="Unsaved changes" aria-label="Unsaved changes"></i> }
                            @if (isActive) { <span class="tag">active</span> }
                            <small class="muted">@KeyCount(draft) @(KeyCount(draft) == 1 ? "key" : "keys")</small>
                        </button>
                    }
                </div>
                <button type="button" class="btn ghost small add-env" @onclick="AddEnvironment">+ Add environment</button>
            </nav>

            <section class="env-edit" aria-label="Selected environment">
                @if (current is null)
                {
                    <div class="muted empty">Add an environment to give scenarios values such as a base URL.</div>
                }
                else
                {
                    var errors = Problems(current);
                    <div class="env-name-row">
                        <label class="visually-hidden" for="env-name">Environment name</label>
                        <input id="env-name" class="env-name-input" value="@current.Env.Name" placeholder="Name" autocomplete="off" @oninput="e => { current.Env.Name = e.Value?.ToString() ?? string.Empty; savedNote = false; }" />
                        <span class="spacer"></span>
                        @if (current.Original is not null && current.Original != Envs.ActiveName)
                        {
                            <button class="btn secondary small" @onclick="() => Envs.SetActive(current.Original)" title="Use this environment for scenarios">Use this environment</button>
                        }
                    </div>
                    @if (confirmDelete)
                    {
                        <div class="notice" role="alertdialog" aria-label="Delete environment?">
                            <span>Delete “<b>@current.Env.Name</b>”? Its keys are gone.</span>
                            <button class="btn ghost" @onclick="() => confirmDelete = false">Cancel</button>
                            <button class="btn danger" @onclick="DeleteCurrent">Delete</button>
                        </div>
                    }

                    <div class="env-table" role="table" aria-label="Keys and values">
                        <div class="env-row head" role="row"><span role="columnheader">Key</span><span role="columnheader">Value</span><span></span></div>
                        @foreach (var v in current.Env.Variables)
                        {
                            var row = v;
                            var masked = EnvironmentDisplay.LooksLikeCredential(row.Key) && !shown.Contains(row);
                            <div class="env-row" role="row" @key="row">
                                <input class="key" value="@row.Key" placeholder="Key" aria-label="Key" autocomplete="off" spellcheck="false"
                                       @oninput="e => { row.Key = e.Value?.ToString() ?? string.Empty; savedNote = false; }" />
                                <div class="val">
                                    <input @ref="valueInput" type="@(masked ? "password" : "text")" value="@row.Value" placeholder="Value" aria-label="Value" autocomplete="off" spellcheck="false"
                                           @oninput="e => { row.Value = e.Value?.ToString() ?? string.Empty; savedNote = false; }" />
                                    @if (EnvironmentDisplay.LooksLikeCredential(row.Key))
                                    {
                                        <button type="button" class="icon-btn" title="@(masked ? "Show" : "Hide")" aria-label="@(masked ? "Show value" : "Hide value")"
                                                @onclick="() => { if (!shown.Remove(row)) shown.Add(row); }">@(masked ? "Show" : "Hide")</button>
                                    }
                                </div>
                                <button type="button" class="icon-btn danger" title="Remove" aria-label="Remove @row.Key" @onclick="() => { current.Env.Variables.Remove(row); savedNote = false; }">✕</button>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn ghost small add-row" @onclick="AddRow">+ Add key</button>

                    @foreach (var err in errors) { <small class="field-error" role="alert">@err</small> }

                    <div class="env-foot">
                        <button class="btn ghost danger" @onclick="() => confirmDelete = true">Delete environment</button>
                        <span class="spacer"></span>
                        <button class="btn primary" @onclick="Save" disabled="@(!Dirty(current) || errors.Count > 0)" title="Save this environment">Save</button>
                    </div>
                }
            </section>
        </div>
    </div>
</div>

@code {
    private sealed class Draft
    {
        /// <summary>Name it was saved under, null while it is new.</summary>
        public string? Original { get; set; }
        public EnvironmentDefinition Env { get; set; } = new();
        public string SavedFingerprint { get; set; } = "";
    }

    private ElementReference root;
    private ElementReference listScroll;
    private string listFilter = string.Empty;
    private ElementReference valueInput;
    private readonly List<Draft> drafts = [];
    private Draft? current;
    private readonly HashSet<EnvironmentVariable> shown = [];
    private bool savedNote, confirmClose, confirmDelete, focusValue;

    protected override void OnInitialized()
    {
        foreach (var e in Envs.Environments)
            drafts.Add(new Draft { Original = e.Name, Env = e.Clone(), SavedFingerprint = Fingerprint(e) });
        current = drafts.FirstOrDefault(d => d.Original == (Popup.Select ?? Envs.ActiveName)) ?? drafts.FirstOrDefault();
        if (Popup.AddKey is { } key && current is not null && !current.Env.Variables.Any(v => v.Key == key))
        {
            current.Env.Variables.Add(new EnvironmentVariable(key, ""));
            focusValue = true;
        }
        Envs.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await (focusValue ? valueInput : root).FocusAsync(); }
        catch (Exception) { /* nothing to focus */ }
    }

    private void OnChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public void Dispose() => Envs.Changed -= OnChanged;

    private static string Fingerprint(EnvironmentDefinition e) =>
        e.Name + "\n" + string.Join("\n", e.Variables.Select(v => v.Key + "\u0001" + v.Value));

    private bool Dirty(Draft d) => d.Original is null || Fingerprint(d.Env) != d.SavedFingerprint;
    private static int KeyCount(Draft d) => d.Env.Variables.Count(v => v.Key.Trim().Length > 0);

    private List<string> Problems(Draft d)
    {
        var errors = d.Env.Validate();
        if (drafts.Any(o => o != d && string.Equals(o.Env.Name.Trim(), d.Env.Name.Trim(), StringComparison.OrdinalIgnoreCase) && d.Env.Name.Trim().Length > 0))
            errors.Add($"There is already an environment named “{d.Env.Name.Trim()}”.");
        return errors;
    }

    private void Select(Draft d) { current = d; confirmDelete = false; savedNote = false; }

    private void AddEnvironment()
    {
        var name = "New environment";
        for (var n = 2; drafts.Any(d => d.Env.Name == name); n++) name = $"New environment {n}";
        var draft = new Draft { Env = new EnvironmentDefinition { Name = name, Variables = [new EnvironmentVariable("BaseUrl", "")] } };
        drafts.Add(draft);
        Select(draft);
    }

    private void AddRow() { current?.Env.Variables.Add(new EnvironmentVariable()); savedNote = false; focusValue = false; }

    private async Task Save()
    {
        if (current is null || Problems(current).Count > 0) return;
        var clean = current.Env.Clone();
        clean.Name = clean.Name.Trim();
        clean.Variables = clean.Variables.Where(v => v.Key.Trim().Length > 0).Select(v => new EnvironmentVariable(v.Key.Trim(), v.Value)).ToList();
        Envs.Save(current.Original, clean);
        current.Original = clean.Name;
        current.Env = clean;
        current.SavedFingerprint = Fingerprint(clean);
        savedNote = true;
        try { await root.FocusAsync(); } catch (Exception) { } // the disabled Save button drops focus; keep Escape working
    }

    private void DeleteCurrent()
    {
        if (current is null) return;
        if (current.Original is not null) Envs.Delete(current.Original);
        var index = drafts.IndexOf(current);
        drafts.Remove(current);
        current = drafts.Count == 0 ? null : drafts[Math.Min(index, drafts.Count - 1)];
        confirmDelete = false;
        savedNote = false;
    }

    private void TryClose()
    {
        if (drafts.Any(Dirty)) confirmClose = true;
        else Popup.Close();
    }

    private void OnKey(KeyboardEventArgs e) { if (e.Key == "Escape") TryClose(); }
}
