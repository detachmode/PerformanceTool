@* Run player bar (brain 0027): fixed at the bottom of every page, like a music player with cockpit-style readouts.
   Play/Pause is the main control, Stop is secondary. Calm UI (0016): the phone layout shows play, time and the two most
   important readouts; the rest opens with the "details" button. *@
@implements IDisposable
@implements IAsyncDisposable
@inject IRunSource Sim
@inject LogsLinks Logs
@inject DataModeState DataMode
@inject ApiRunSource ApiRun
@inject IJSRuntime JS
@inject PhoneState Phone
@inject NavigationManager Nav

@{
    var s = Sim.Current;
    var active = s.Running;
    var duration = s.Plan.DurationSeconds;
    var pct = s.State == FakeRunState.Finished ? 100 : duration > 0 ? Math.Min(100, s.Elapsed / duration * 100) : 0;
    var views = s.Scenarios;
    var inFlight = views.Sum(v => v.InFlight);
    var failed = views.Sum(v => v.Failed);
    var slow = views.Sum(v => v.SlowBees);
    var target = s.Plan.Scenarios.Sum(x => x.EffectiveRatePerMinute());
    var actual = s.Elapsed >= 3 ? views.Sum(v => v.Starts) / (s.Elapsed / 60) : 0;
    var shuttingDown = s.Shutdown is { IsRunning: true };
    var (stateText, stateCss) = s.State switch
    {
        FakeRunState.Running when shuttingDown => ("Shutting down", "run"),
        FakeRunState.Running => ("Running", "run"),
        FakeRunState.Paused => ("Paused", "paused"),
        FakeRunState.Finished => ("Finished", "done"),
        _ => ("Idle", "idle"),
    };
    var playShort = s.State switch { FakeRunState.Running => "Pause", FakeRunState.Paused => "Resume", FakeRunState.Finished => "Run again", _ => "Start run" };
    var playLabel = s.State switch { FakeRunState.Running => "Pause run", FakeRunState.Paused => "Resume run", _ => "Start run" };
}
@if (active || s.Paused)
{
@if (Phone.IsPhone)
{
    @* The phone's slim run bar above the tab bar (brain 0059): pause or resume, the time, a progress line, the bees active (blue) and failed (red). Tapping the bar or ⌃ opens the full
       player (below, as a sheet) with every figure; the figures drill down from there like on desktop. *@
    <section class="runbar" aria-label="Run">
        <button type="button" class="rb-play" @onclick="Toggle" disabled="@shuttingDown" aria-label="@playLabel">
            @if (s.State == FakeRunState.Running)
            {
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="6" y="5" width="4.2" height="14" rx="1.2" fill="currentColor"/><rect x="13.8" y="5" width="4.2" height="14" rx="1.2" fill="currentColor"/></svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M8 5.2v13.6a.8.8 0 0 0 1.2.7l11-6.8a.8.8 0 0 0 0-1.4l-11-6.8A.8.8 0 0 0 8 5.2z" fill="currentColor"/></svg>
            }
        </button>
        <button type="button" class="rb-open" @onclick="() => open = true" aria-label="Open the run details. @stateText, @Format.Time(s.Elapsed), @Format.Num(inFlight) active, @Format.Num(failed) failed" aria-haspopup="dialog">
            <span class="rb-time tnum">@Format.Time(s.Elapsed)</span>
            <span class="rb-gauge" role="progressbar" aria-label="Run progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)pct)"><i style="width:@pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></i></span>
            <span class="rb-fig run tnum" title="Active">@Format.Num(inFlight)</span>
            <span class="rb-fig tnum @(failed > 0 ? "bad" : "zero")" title="Failed">@Format.Num(failed)</span>
            <span class="rb-chev" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 15l6-6 6 6"/></svg></span>
        </button>
        <span class="visually-hidden" role="status" aria-live="polite">Run @stateText.ToLowerInvariant()</span>
    </section>
    @if (open) { <div class="sheet-backdrop run-backdrop" @onclick="() => open = false" role="presentation"></div> }
}
<section class="player @(open ? "open" : "")" aria-label="Run player" role="@(Phone.IsPhone && open ? "dialog" : null)">
    <div class="pl-main">
 <button class="play @stateCss" @onclick="Toggle" disabled="@shuttingDown" aria-label="@playLabel" title="@playLabel (space)">
            <span class="disc">
                @if (s.State == FakeRunState.Running)
                {
                    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><rect x="6" y="5" width="4.2" height="14" rx="1.2" fill="currentColor"/><rect x="13.8" y="5" width="4.2" height="14" rx="1.2" fill="currentColor"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M8 5.2v13.6a.8.8 0 0 0 1.2.7l11-6.8a.8.8 0 0 0 0-1.4l-11-6.8A.8.8 0 0 0 8 5.2z" fill="currentColor"/></svg>
                }
            </span>
            <span class="play-label" aria-hidden="true">@playShort</span>
        </button>
 <button class="stop-btn" @onclick="Sim.Stop" disabled="@(!active || shuttingDown)" aria-label="Stop run" title="Stop run">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2.2" fill="currentColor"/></svg>
        </button>
        <div class="state-lamp @stateCss" title="Run state: @stateText"><i aria-hidden="true"></i><span>@stateText</span></div>
    </div>

    <div class="inst clock" role="group" aria-label="Run time">
        <span class="lbl" title="@s.DisplayTitle">@s.DisplayTitle</span>
        <span class="val" role="timer" aria-live="off"><b>@Format.Time(s.Elapsed)</b><em> / @Format.Time(duration)</em></span>
        <div class="gauge" role="progressbar" aria-label="Run progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)pct)"><i style="width:@pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></i></div>
    </div>

    <button class="inst key" @onclick="() => Logs.Show()" title="Open the logs" aria-label="Active: @Format.Num(inFlight). Open logs"><span class="lbl">Active</span><span class="val run">@Format.Num(inFlight)</span></button>
    <div class="inst extra" role="group" aria-label="Bees per minute"><span class="lbl">Bees/min</span><span class="val">@(active || s.State == FakeRunState.Finished ? Format.Num(actual) : "–")<em> / @Format.Num(target)</em></span></div>
    <button class="inst key" @onclick="() => Logs.Show(null, null, BeeShow.Failed)" title="Show the logs of the failed bees" aria-label="Errors: @Format.Num(failed). Open failed bees in logs"><span class="lbl">Errors</span><span class="val @(failed > 0 ? "bad" : "")">@Format.Num(failed)</span></button>
    <button class="inst extra" @onclick="() => Logs.Show(null, null, BeeShow.Slow)" title="Show the logs of the slow bees" aria-label="Slow: @Format.Num(slow). Open slow bees in logs"><span class="lbl">Slow</span><span class="val @(slow > 0 ? "warn" : "")">@Format.Num(slow)</span></button>

    <div class="pl-end">
        @if (!DataMode.IsFakeMode && !string.IsNullOrEmpty(ApiRun.CurrentRunId))
        {
            <a class="btn ghost small" href="@($"api/runs/{Uri.EscapeDataString(ApiRun.CurrentRunId)}/export?format=parquet")" download title="Export this run as a ZIP of Parquet files (runs, bees, calls, logs)">Export</a>
        }
        <button class="btn ghost small logs-btn" @onclick="() => Logs.Show()">Logs</button>
        <button class="btn ghost small more-btn" @onclick="() => open = !open" aria-expanded="@Aria.Bool(open)" aria-label="Run details">@(open ? "✕" : "⋯")</button>
    </div>
    <span class="visually-hidden" role="status" aria-live="polite">Run @stateText.ToLowerInvariant()</span>
</section>
}

@code {
    private bool open;
    private DotNetObjectReference<PlayerBar>? self;
    private IJSObjectReference? module;

    protected override void OnInitialized() { Sim.Changed += OnChanged; Phone.Changed += OnChanged; Nav.LocationChanged += OnLocation; }

    private void OnLocation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) { if (open) { open = false; OnChanged(); } }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./player-bar.js");
            self = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("listen", self);
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private void OnChanged()
    {
        if (open && !Sim.Current.Running && !Sim.Current.Paused) open = false;   // the details sheet goes with the run
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private void Toggle()
    {
        switch (Sim.Current.State)
        {
            case FakeRunState.Running: Sim.Pause(); break;
            case FakeRunState.Paused: Sim.Resume(); break;
            default: Sim.Start(); break;
        }
    }

    /// <summary>Called by the space bar handler (player-bar.js) when focus is not in an input.</summary>
    [JSInvokable] public void ToggleFromKey() => Toggle();

    public void Dispose() { Sim.Changed -= OnChanged; Phone.Changed -= OnChanged; Nav.LocationChanged -= OnLocation; }

    public async ValueTask DisposeAsync()
    {
        try { if (module is not null) { await module.InvokeVoidAsync("unlisten"); await module.DisposeAsync(); } }
        catch (Exception) { }
        self?.Dispose();
    }
}
