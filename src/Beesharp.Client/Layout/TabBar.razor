@* The phone's tab bar at the bottom (brain 0059): Overview, Editor, Logs, Env, each with an icon and a label, in reach of the thumb; the home bar's safe area is padding.
   Overview stays marked on a scenario page (its way back). Desktop has the same four as tabs in the top bar. *@
@implements IDisposable
@inject NavigationManager Nav

<nav class="tabbar" aria-label="Main">
    <NavLink class="@(OnScenario ? "tab active" : "tab")" href="" Match="NavLinkMatch.All">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="2"/><rect x="13.5" y="3.5" width="7" height="7" rx="2"/><rect x="3.5" y="13.5" width="7" height="7" rx="2"/><rect x="13.5" y="13.5" width="7" height="7" rx="2"/></svg>
        <span>Overview</span>
    </NavLink>
    <NavLink class="tab" href="calls" Match="NavLinkMatch.Prefix">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 13h3.5l2.5-6.5 4 11 2.5-4.5H20.5"/></svg>
        <span>Calls</span>
    </NavLink>
    <NavLink class="tab" href="editor" Match="NavLinkMatch.Prefix">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 7-5 5 5 5"/><path d="m16 7 5 5-5 5"/><path d="M13.5 5l-3 14"/></svg>
        <span>Editor</span>
    </NavLink>
    <NavLink class="tab" href="logs" Match="NavLinkMatch.Prefix">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="3"/><path d="M7.5 9.5h9M7.5 13h6M7.5 16h3.5"/></svg>
        <span>Logs</span>
    </NavLink>
    <NavLink class="tab" href="environment" Match="NavLinkMatch.Prefix">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2.2"/><circle cx="9" cy="17" r="2.2"/></svg>
        <span>Env</span>
    </NavLink>
</nav>

@code {
    private bool OnScenario => ScenarioLink.IndexOf(Nav.ToBaseRelativePath(Nav.Uri)) is not null;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocation;

    private void OnLocation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }


    public void Dispose() => Nav.LocationChanged -= OnLocation;
}
