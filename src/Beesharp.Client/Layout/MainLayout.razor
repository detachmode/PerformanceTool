@* Fixed top bar shared by all pages (brain 0020): brand, Overview / Editor, and a clean hamburger menu on small screens so the header stays one crisp fixed row. *@
@inherits LayoutComponentBase
@implements IDisposable
@inject LogsPopupState Logs
@inject ViewSettings Settings
@inject EnvironmentsPopupState EnvPopup
@inject CustomScriptsPopupState ScriptsPopup
@inject DataModeState DataMode
@inject ApiRunSource ApiRun
@inject IRunSource Sim
@inject IEnvironmentSource Envs
@inject ScriptApiClient ScriptApi
@inject NavigationManager Nav
@inject Beesharp.Client.Components.Assistant.AssistantState Asst
@using Beesharp.Client.Components.Assistant

<div class="shell @(Asst.Available && Asst.IsOpen ? "asst-open" : "")">
    <header class="top">
        <a class="brand" href="" aria-label="Beesharp, overview" @onclick="CloseNavAsync">
            <svg viewBox="0 0 64 64" fill="none" width="32" height="32" class="brand-hex" aria-hidden="true">
                <defs>
                    <clipPath id="bsharp-hex">
                        <path d="M32 3L57 17.5V46.5L32 61L7 46.5V17.5L32 3Z"/>
                    </clipPath>
                </defs>
                <g clip-path="url(#bsharp-hex)">
                    <path d="M32 3L57 17.5V46.5L32 61L7 46.5V17.5L32 3Z" fill="#F5B700"/>
                    <path d="M32 32L57 17.5V46.5L32 61L7 46.5Z" fill="#D99B00"/>
                    <path d="M32 32L57 46.5L32 61L7 46.5Z" fill="#B87D00"/>
                </g>
                <path d="M32 3.8L56.2 17.9V46.1L32 60.2L7.8 46.1V17.9L32 3.8Z" stroke="#FDE68A" stroke-opacity="0.45" stroke-width="1.5"/>
                <path fill-rule="evenodd" clip-rule="evenodd"
                      d="M15 19H27.5C32.2 19 35.2 21.4 35.2 25.4C35.2 28.2 33.6 30.2 31.1 31.1C34.2 32 36.2 34.4 36.2 37.8C36.2 42.3 32.8 45 27.6 45H15V19ZM20.8 29.4H26.4C28.4 29.4 29.6 28.3 29.6 26.5C29.6 24.7 28.4 23.7 26.4 23.7H20.8V29.4ZM20.8 40.3H26.9C29.2 40.3 30.5 39.2 30.5 37.2C30.5 35.2 29.2 34.1 26.9 34.1H20.8V40.3Z"
                      fill="#110F0C"/>
                <path d="M43.4 22L41.8 41M49.6 22L48 41M39.2 28.2H52.2M38.5 34.8H51.5"
                      stroke="#110F0C" stroke-width="3.2" stroke-linecap="round"/>
            </svg>
            <span class="brand-name">Bee<b>sharp</b></span>
        </a>
        <nav class="nav" aria-label="Main">
            <NavLink class="nav-item" href="" Match="NavLinkMatch.All" @onclick="CloseNavAsync">Overview</NavLink>
            <NavLink class="nav-item" href="editor" Match="NavLinkMatch.Prefix" @onclick="CloseNavAsync">Editor</NavLink>
            <NavLink class="nav-item" href="logs" Match="NavLinkMatch.Prefix" @onclick="CloseNavAsync">Logs</NavLink>
            <NavLink class="nav-item" href="environment" Match="NavLinkMatch.Prefix" @onclick="CloseNavAsync">Environment</NavLink>
        </nav>

        <div class="top-desktop">
            <button type="button" class="mode-btn @ModeBtnCss()" @onclick="ToggleModeMenuAsync"
                    aria-haspopup="menu" aria-expanded="@Aria.Bool(modeMenuOpen)"
                    title="Switch Live/Fake mode or load a stored run">
                <i aria-hidden="true"></i>
                <span>@ModeBtnLabel(compact: false)</span>
                <span class="caret" aria-hidden="true">▾</span>
            </button>
            <EnvironmentPicker />
            <BuildStamp />
            @if (Asst.Available)
            {
                <button type="button" class="icon-btn asst-toggle @(Asst.IsOpen ? "on" : "")" @onclick="Asst.Toggle" aria-label="Assistant" aria-pressed="@Aria.Bool(Asst.IsOpen)" title="Assistant"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.5-4.7A8 8 0 1 1 21 12z"/></svg></button>
            }
            <button class="icon-btn gear" @onclick="Settings.Open" aria-label="Settings" title="Settings"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg></button>
        </div>

        <div class="top-mobile">
            <button type="button" class="mode-btn compact @ModeBtnCss()" @onclick="ToggleModeMenuAsync"
                    aria-haspopup="menu" aria-expanded="@Aria.Bool(modeMenuOpen)"
                    title="Switch Live/Fake mode or load a stored run">
                <i aria-hidden="true"></i>
                <span>@ModeBtnLabel(compact: true)</span>
                <span class="caret" aria-hidden="true">▾</span>
            </button>
            @if (Asst.Available)
            {
                <button type="button" class="icon-btn asst-toggle @(Asst.IsOpen ? "on" : "")" @onclick="() => { menuOpen = false; Asst.Toggle(); }" aria-label="Assistant" aria-pressed="@Aria.Bool(Asst.IsOpen)" title="Assistant"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.5-4.7A8 8 0 1 1 21 12z"/></svg></button>
            }
            <button type="button" class="icon-btn hamburger" @onclick="() => menuOpen = !menuOpen"
                    aria-label="Menu" aria-expanded="@Aria.Bool(menuOpen)" title="Menu">
                @if (menuOpen)
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                }
            </button>
        </div>
    </header>

    @if (modeMenuOpen)
    {
        <div class="dd-backdrop" @onclick="() => modeMenuOpen = false"></div>
        <div class="dd-menu mode-runs-menu" role="menu" aria-label="Data mode and stored runs">
            <div class="dd-lbl">Data mode</div>
            <button type="button" class="dd-item" role="menuitem" @onclick="() => SetModeAsync(false)">
                <span class="mode-dot live" aria-hidden="true"></span>
                <span>@(!DataMode.IsFakeMode && !ApiRun.IsViewingHistory ? "✓ " : "")<b>Live mode</b> <span class="muted">· server API</span></span>
            </button>
            <button type="button" class="dd-item" role="menuitem" @onclick="() => SetModeAsync(true)">
                <span class="mode-dot fake" aria-hidden="true"></span>
                <span>@(DataMode.IsFakeMode ? "✓ " : "")<b>Fake mode</b> <span class="muted">· simulation</span></span>
            </button>
            @if (!DataMode.IsFakeMode)
            {
                <div class="dd-sep" role="separator"></div>
                <div class="dd-lbl">Stored runs (@ApiRun.StorageProvider)</div>
                @if (Sim.IsRunning)
                {
                    <div class="muted" style="padding:.4rem .55rem">Stop the active run to open a past run.</div>
                }
                else if (runsLoading)
                {
                    <div class="muted" style="padding:.4rem .55rem">Loading…</div>
                }
                else if (storedRuns.Count == 0)
                {
                    <div class="muted" style="padding:.4rem .55rem">No stored runs yet.</div>
                }
                else
                {
                    @foreach (var r in storedRuns)
                    {
                        var item = r;
                        var isCurrent = string.Equals(item.RunId, ApiRun.CurrentRunId, StringComparison.Ordinal);
                        <button type="button" class="dd-item" role="menuitem" @onclick="() => PickRunAsync(item.RunId)" style="flex-direction:column;align-items:flex-start;gap:.1rem">
                            <span>@(isCurrent ? "✓ " : "")<b>@item.StartedUtc.ToLocalTime().ToString("dd MMM HH:mm:ss")</b> <span class="muted">(@item.ElapsedSeconds.ToString("0.#")s)</span></span>
                            <span class="muted" style="font-size:.74rem">@Format.Num(item.TotalBees) bees · @(item.FailedBees > 0 ? $"{item.FailedBees} failed · " : "")@Format.Num((int)Math.Min(int.MaxValue, item.TotalLogs)) logs</span>
                        </button>
                    }
                }
            }
        </div>
    }

    @if (menuOpen)
    {
        <div class="drawer-backdrop" @onclick="CloseMenu" role="presentation"></div>
        <aside class="top-drawer" aria-label="App menu">
            <div class="drawer-sec">
                <span class="drawer-lbl">Data mode</span>
                <button type="button" class="mode-btn @(DataMode.IsFakeMode ? "fake" : "live")" @onclick="DataMode.Toggle">
                    <i aria-hidden="true"></i>
                    <span>@(DataMode.IsFakeMode ? "Fake mode (tap for Live)" : "Live mode (tap for Fake)")</span>
                </button>
            </div>
            <div class="drawer-sec">
                <span class="drawer-lbl">Environment</span>
                <div class="drawer-row">
                    <span class="muted">@(Envs.ActiveName ?? "No environment")</span>
                    <button type="button" class="btn ghost small" @onclick="OpenEnvsFromMenu">Configure…</button>
                </div>
            </div>
            <div class="drawer-actions">
                <button type="button" class="btn ghost" @onclick="OpenScriptsFromMenu">Custom scripts (.cs)</button>
                <button type="button" class="btn ghost" @onclick="OpenSettingsFromMenu">Settings</button>
            </div>
            <div class="drawer-foot">
                <BuildStamp />
            </div>
        </aside>
    }

    @if (!DataMode.IsFakeMode && !ApiRun.IsServerReachable)
    {
        <div class="offline-banner" role="alert">
            <span class="offline-dot" aria-hidden="true"></span>
            <span>Server not reachable · reconnecting…</span>
            <button type="button" class="btn ghost small" @onclick="ApiRun.RefreshAsync">Retry</button>
        </div>
    }

    <main class="main">@Body</main>
    <PlayerBar />
    <AssistantPanel />
</div>

<AssistantBeeSetHost />

@if (Asst.FullLogs is { } fullLogs)
{
    <AssistantLogsDialog Request="fullLogs" @key="fullLogs" />
}

@if (Settings.IsOpen)
{
    <SettingsDialog />
}

@if (EnvPopup.IsOpen)
{
    <EnvironmentsDialog @key="EnvPopup.Version" />
}

@if (ScriptsPopup.IsOpen)
{
    <CustomScriptsDialog @key="ScriptsPopup.Version" />
}

@if (Logs.IsOpen)
{
    <LogsDialog @key="Logs.Version" />
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool menuOpen;
    private bool modeMenuOpen;
    private bool runsLoading;
    private List<ServerRunSummaryDto> storedRuns = [];

    private async Task ToggleModeMenuAsync()
    {
        menuOpen = false;
        modeMenuOpen = !modeMenuOpen;
        if (!modeMenuOpen || DataMode.IsFakeMode || Sim.IsRunning) return;
        runsLoading = true;
        try { storedRuns = await ApiRun.ListRunsAsync(30); }
        finally { runsLoading = false; }
    }

    private string ModeBtnCss() => DataMode.IsFakeMode ? "fake" : !ApiRun.IsServerReachable ? "offline" : ApiRun.IsViewingHistory ? "history" : "live";

    private string ModeBtnLabel(bool compact)
    {
        if (DataMode.IsFakeMode) return "Fake";
        if (ApiRun.IsViewingHistory && ApiRun.ActiveStartedUtc is { } dt)
        {
            var local = dt.ToLocalTime();
            return compact ? local.ToString("dd.MM HH:mm") : local.ToString("dd MMM HH:mm:ss");
        }
        return "Live";
    }

    private async Task SetModeAsync(bool fake)
    {
        if (DataMode.IsFakeMode != fake) DataMode.Toggle();
        if (!fake) ApiRun.ReturnToLive();
        modeMenuOpen = false;
        if (!fake && !Sim.IsRunning)
            storedRuns = await ApiRun.ListRunsAsync(30);
    }

    private async Task PickRunAsync(string runId)
    {
        modeMenuOpen = false;
        await Asst.CloseIfMobileAsync();
        await ApiRun.LoadStoredRunAsync(runId);
    }

    protected override void OnInitialized()
    {
        Logs.Changed += OnChanged;
        Settings.Changed += OnChanged;
        EnvPopup.Changed += OnChanged;
        ScriptsPopup.Changed += OnChanged;
        DataMode.Changed += OnChanged;
        ApiRun.Changed += OnChanged;
        Envs.Changed += OnChanged;
        Asst.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Settings.LoadAsync();
            await DataMode.LoadAsync();
            await ScriptApi.SyncCatalogAsync();
        }
    }

    private void CloseMenu() { menuOpen = false; modeMenuOpen = false; }
    private async Task CloseNavAsync() { menuOpen = false; modeMenuOpen = false; await Asst.CloseIfMobileAsync(); }
    private void OpenEnvsFromMenu() { menuOpen = false; EnvPopup.Show(); }
    private async Task OpenScriptsFromMenu() { menuOpen = false; await Asst.CloseIfMobileAsync(); Nav.NavigateTo("editor"); }
    private void OpenSettingsFromMenu() { menuOpen = false; Settings.Open(); }

    private void OnChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        Logs.Changed -= OnChanged;
        Settings.Changed -= OnChanged;
        EnvPopup.Changed -= OnChanged;
        ScriptsPopup.Changed -= OnChanged;
        DataMode.Changed -= OnChanged;
        ApiRun.Changed -= OnChanged;
        Envs.Changed -= OnChanged;
        Asst.Changed -= OnChanged;
    }
}
