@* Fixed top bar shared by all pages (brain 0020): brand, Overview / Editor, and a clean hamburger menu on small screens so the header stays one crisp fixed row. *@
@inherits LayoutComponentBase
@implements IDisposable
@inject ViewSettings Settings
@inject EnvironmentsPopupState EnvPopup
@inject DataModeState DataMode
@inject ApiRunSource ApiRun
@inject IRunSource Sim
@inject IEnvironmentSource Envs
@inject ScriptApiClient ScriptApi
@inject NavigationManager Nav
@inject Beesharp.Client.Assistant.AssistantState Asst
@inject PhoneState Phone

@{ var scnIndex = ScenarioLink.IndexOf(Nav.ToBaseRelativePath(Nav.Uri)); }
<div class="shell @(Asst.Available && Asst.IsOpen ? "asst-open" : "") @(Phone.IsPhone ? "shell-phone" : "")">
    @if (Phone.IsPhone)
    {
        @* The phone's top bar (brain 0059): logo or back arrow, the page title, mode in a compact form and ⋯ (environment, settings, assistant, build). The tabs are the bottom bar. *@
        var phoneTitle = PhoneTitle(scnIndex);
        <header class="top top-phone">
            @if (scnIndex is not null)
            {
                <a class="top-back" href="overview" aria-label="Back to the overview"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></a>
                <h1 class="top-title" title="@phoneTitle">@phoneTitle</h1>
            }
            else
            {
                <a class="brand brand-phone-logo" href="" aria-label="Beesharp, overview"><img src="beesharp-logo.png" alt="Beesharp" class="brand-logo-img" /></a>
                <span class="spacer"></span>
            }
            <button type="button" class="mode-btn compact @ModeBtnCss()" @onclick="ToggleModeMenuAsync"
                    aria-haspopup="menu" aria-expanded="@Aria.Bool(modeMenuOpen)" title="Switch Live/Fake mode or load a stored run">
                <i aria-hidden="true"></i>
                <span>@ModeBtnLabel(compact: true)</span>
                <span class="caret" aria-hidden="true">▾</span>
            </button>
            @if (Asst.Available)
            {
                <button type="button" class="icon-btn asst-toggle @(Asst.IsOpen ? "on" : "")" @onclick="() => { modeMenuOpen = false; moreOpen = false; Asst.Toggle(); }" aria-label="Assistant" aria-pressed="@Aria.Bool(Asst.IsOpen)" title="Assistant"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.5-4.7A8 8 0 1 1 21 12z"/></svg></button>
            }
            <button type="button" class="icon-btn top-more" @onclick="() => { modeMenuOpen = false; moreOpen = true; }" aria-label="More" aria-haspopup="dialog" title="Environment, settings and more">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></svg>
            </button>
        </header>
        <Sheet Open="moreOpen" OnClose="() => moreOpen = false" Label="More">
            <div class="more-sheet">
                <div class="drawer-sec">
                    <span class="drawer-lbl">Environment</span>
                    <div class="more-scroll">
                        <button type="button" class="more-row @(Envs.ActiveName is null ? "on" : "")" @onclick="() => PickEnv(null)"><i aria-hidden="true">@(Envs.ActiveName is null ? "✓" : "")</i>No environment</button>
                        @foreach (var env in Envs.Environments)
                        {
                            var envName = env.Name;
                            <button type="button" class="more-row @(envName == Envs.ActiveName ? "on" : "")" title="@envName" @onclick="() => PickEnv(envName)"><i aria-hidden="true">@(envName == Envs.ActiveName ? "✓" : "")</i><span class="more-text">@envName</span></button>
                        }
                    </div>
                    <button type="button" class="more-row" @onclick="OpenEnvsFromMore">Configure environments…</button>
                </div>
                <div class="drawer-sec">
                    <button type="button" class="more-row" @onclick="Open3DFromMore">3D Views</button>
                    @if (Asst.Available)
                    {
                        <button type="button" class="more-row" @onclick="() => { moreOpen = false; Asst.Toggle(); }">Assistant</button>
                    }
                    <button type="button" class="more-row" @onclick="OpenScriptsFromMenu">Custom scripts (.cs)</button>
                    <button type="button" class="more-row" @onclick="() => { moreOpen = false; Settings.Open(); }">Settings</button>
                </div>
                <div class="drawer-foot"><BuildStamp /></div>
            </div>
        </Sheet>
    }
    else
    {
    <header class="top">
        <a class="brand" href="" aria-label="Beesharp, overview" @onclick="CloseNavAsync">
            @BrandHex
            <span class="brand-name">Bee<b>sharp</b></span>
        </a>
        <nav class="nav" aria-label="Main">
            <NavLink class="nav-item" href="" Match="NavLinkMatch.All" @onclick="CloseNavAsync">Home</NavLink>
            <NavLink class="@(scnIndex is not null ? "nav-item active" : "nav-item")" href="overview" Match="NavLinkMatch.Prefix" @onclick="CloseNavAsync">Overview</NavLink>
            <NavLink class="nav-item" href="calls" Match="NavLinkMatch.Prefix" @onclick="CloseNavAsync">Calls</NavLink>
            <NavLink class="nav-item" href="editor" Match="NavLinkMatch.Prefix" @onclick="CloseNavAsync">Editor</NavLink>
            <NavLink class="nav-item" href="logs" Match="NavLinkMatch.Prefix" @onclick="CloseNavAsync">Logs</NavLink>
            <NavLink class="nav-item" href="environment" Match="NavLinkMatch.Prefix" @onclick="CloseNavAsync">Environment</NavLink>
            <NavLink class="nav-item" href="3d" Match="NavLinkMatch.Prefix" @onclick="CloseNavAsync">3D Views</NavLink>
        </nav>
        @* The scenario page (brain 0059): "Overview › name"; the Overview tab above stays the active one and leads back. *@
        @if (scnIndex is { } crumbAt)
        {
            var crumbLabel = crumbAt < Sim.Current.Labels.Count ? Sim.Current.Labels[crumbAt] : "Scenario " + (crumbAt + 1);
            <span class="crumb" aria-label="You are here"><i aria-hidden="true">›</i><b title="@crumbLabel">@crumbLabel</b></span>
        }

        <div class="top-desktop">
            <div class="dd mode-dd">
                <button type="button" class="mode-btn @ModeBtnCss()" @onclick="ToggleModeMenuAsync"
                        aria-haspopup="menu" aria-expanded="@Aria.Bool(modeMenuOpen)"
                        title="Switch Live/Fake mode or load a stored run">
                    <i aria-hidden="true"></i>
                    <span>@ModeBtnLabel(compact: false)</span>
                    <span class="caret" aria-hidden="true">▾</span>
                </button>
                @if (modeMenuOpen && !Phone.IsCompact)
                {
                    @ModeMenu
                }
            </div>
            <EnvironmentPicker />
            <BuildStamp />
            @if (Asst.Available)
            {
                <button type="button" class="icon-btn asst-toggle @(Asst.IsOpen ? "on" : "")" @onclick="Asst.Toggle" aria-label="Assistant" aria-pressed="@Aria.Bool(Asst.IsOpen)" title="Assistant"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.5-4.7A8 8 0 1 1 21 12z"/></svg></button>
            }
            <button class="icon-btn gear" @onclick="Settings.Open" aria-label="Settings" title="Settings"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg></button>
        </div>

        <div class="top-mobile">
            <button type="button" class="mode-btn compact @ModeBtnCss()" @onclick="ToggleModeMenuAsync"
                    aria-haspopup="menu" aria-expanded="@Aria.Bool(modeMenuOpen)"
                    title="Switch Live/Fake mode or load a stored run">
                <i aria-hidden="true"></i>
                <span>@ModeBtnLabel(compact: true)</span>
                <span class="caret" aria-hidden="true">▾</span>
            </button>
            @if (Asst.Available)
            {
                <button type="button" class="icon-btn asst-toggle @(Asst.IsOpen ? "on" : "")" @onclick="() => { menuOpen = false; Asst.Toggle(); }" aria-label="Assistant" aria-pressed="@Aria.Bool(Asst.IsOpen)" title="Assistant"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.5-4.7A8 8 0 1 1 21 12z"/></svg></button>
            }
            <button type="button" class="icon-btn hamburger" @onclick="() => menuOpen = !menuOpen"
                    aria-label="Menu" aria-expanded="@Aria.Bool(menuOpen)" title="Menu">
                @if (menuOpen)
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                }
            </button>
        </div>
    </header>
    }

    @* Small screens: the menu sits outside the header (fixed; a bottom sheet below 760px) so it can rise above the assistant sheet. *@
    @if (modeMenuOpen && (Phone.IsPhone || Phone.IsCompact))
    {
        <div class="mode-menu-mobile">
            @ModeMenu
        </div>
    }

    @if (menuOpen)
    {
        <div class="drawer-backdrop" @onclick="CloseMenu" role="presentation"></div>
        <aside class="top-drawer" aria-label="App menu">
            <div class="drawer-sec">
                <span class="drawer-lbl">Data mode</span>
                <button type="button" class="mode-btn @(DataMode.IsFakeMode ? "fake" : "live")" @onclick="DataMode.Toggle">
                    <i aria-hidden="true"></i>
                    <span>@(DataMode.IsFakeMode ? "Fake mode (tap for Live)" : "Live mode (tap for Fake)")</span>
                </button>
            </div>
            <div class="drawer-sec">
                <span class="drawer-lbl">Environment</span>
                <div class="drawer-row">
                    <span class="muted">@(Envs.ActiveName ?? "No environment")</span>
                    <button type="button" class="btn ghost small" @onclick="OpenEnvsFromMenu">Configure…</button>
                </div>
            </div>
            <div class="drawer-actions">
                <button type="button" class="btn ghost" @onclick="OpenScriptsFromMenu">Custom scripts (.cs)</button>
                <button type="button" class="btn ghost" @onclick="OpenSettingsFromMenu">Settings</button>
            </div>
            <div class="drawer-foot">
                <BuildStamp />
            </div>
        </aside>
    }

    @if (!DataMode.IsFakeMode && !ApiRun.IsServerReachable)
    {
        <div class="offline-banner" role="alert">
            <span class="offline-dot" aria-hidden="true"></span>
            <span>Server not reachable · reconnecting…</span>
            <button type="button" class="btn ghost small" @onclick="ApiRun.RefreshAsync">Retry</button>
        </div>
    }

    <main class="main">@Body</main>
    <PlayerBar />
    @if (Phone.IsPhone) { <TabBar /> }
    <AssistantPanel />
</div>

<AssistantBeeSetHost />

@if (Asst.FullLogs is { } fullLogs)
{
    <AssistantLogsDialog Request="fullLogs" @key="fullLogs" />
}

@if (Settings.IsOpen)
{
    <SettingsDialog />
}

@if (EnvPopup.IsOpen)
{
    <EnvironmentsDialog @key="EnvPopup.Version" />
}

@code {
    private bool menuOpen, moreOpen;

    private string PhoneTitle(int? scenario)
    {
        if (scenario is { } i) return i < Sim.Current.Labels.Count ? Sim.Current.Labels[i] : "Scenario " + (i + 1);
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var q = path.IndexOfAny(['?', '#']);
        if (q >= 0) path = path[..q];
        return path.Trim('/').ToLowerInvariant() switch { "calls" => "Calls", "3d" => "3D Views", "editor" or "scripts" => "Editor", "logs" => "Logs", "environment" => "Environment", _ => "Overview" };
    }

    private void PickEnv(string? name) { Envs.SetActive(name); moreOpen = false; }
    private void OpenEnvsFromMore() { moreOpen = false; EnvPopup.Show(); }
    private async Task Open3DFromMore() { moreOpen = false; await Asst.CloseIfMobileAsync(); Nav.NavigateTo("3d"); }

    private RenderFragment BrandHex => @<img src="beesharp-mark.png" alt="" width="30" height="30" class="brand-hex" aria-hidden="true" />;
    private bool modeMenuOpen;
    // One menu, shown under the desktop mode button or as the small-screen sheet. Brain 0068: the mode switch is the fixed header, Import the fixed footer,
    // the stored runs (there can be a hundred) scroll in between and can be filtered.
    private RenderFragment ModeMenu => @<DropMenu Class="mode-runs-menu" Label="Data mode and stored runs" OnClose="@(() => modeMenuOpen = false)"
                                                  Total="storedRuns.Count" @bind-Filter="runFilter" FilterPlaceholder="Filter runs (date, failed)…">
        <Head>
            <div class="dd-lbl">Data mode</div>
            <button type="button" class="dd-item" role="menuitem" @onclick="() => SetModeAsync(false)">
                <span class="mode-dot live" aria-hidden="true"></span>
                <span>@(!DataMode.IsFakeMode && !ApiRun.IsViewingHistory ? "✓ " : "")<b>Live mode</b> <span class="muted">· server API</span></span>
            </button>
            <button type="button" class="dd-item" role="menuitem" @onclick="() => SetModeAsync(true)">
                <span class="mode-dot fake" aria-hidden="true"></span>
                <span>@(DataMode.IsFakeMode ? "✓ " : "")<b>Fake mode</b> <span class="muted">· simulation</span></span>
            </button>
        </Head>
        <ChildContent>
            @if (!DataMode.IsFakeMode)
            {
                <div class="dd-lbl">Stored runs (@ApiRun.StorageProvider)</div>
                @if (Sim.IsRunning)
                {
                    <div class="muted dd-empty">Stop the active run to open a past run.</div>
                }
                else if (runsLoading)
                {
                    <div class="muted dd-empty">Loading…</div>
                }
                else if (storedRuns.Count == 0)
                {
                    <div class="muted dd-empty">No stored runs yet.</div>
                }
                else
                {
                    var shownRuns = storedRuns.Where(RunMatches).ToList();
                    @if (shownRuns.Count == 0)
                    {
                        <div class="dd-none">No run matches “@runFilter”.</div>
                    }
                    @foreach (var r in shownRuns)
                    {
                        var item = r;
                        var isCurrent = string.Equals(item.RunId, ApiRun.CurrentRunId, StringComparison.Ordinal);
                        <button type="button" class="dd-item run-item @(isCurrent ? "on" : "")" role="menuitemradio" aria-checked="@Aria.Bool(isCurrent)" @onclick="() => PickRunAsync(item.RunId)" title="@item.RunId">
                            <span class="run-line">@(isCurrent ? "✓ " : "")<b>@item.StartedUtc.ToLocalTime().ToString("dd MMM HH:mm:ss")</b> <span class="muted">(@item.ElapsedSeconds.ToString("0.#")s)</span></span>
                            <span class="muted run-sub">@Format.Num(item.TotalBees) bees · @(item.FailedBees > 0 ? $"{item.FailedBees} failed · " : "")@Format.Num((int)Math.Min(int.MaxValue, item.TotalLogs)) logs</span>
                        </button>
                    }
                }
            }
        </ChildContent>
        <Foot>
            @if (!DataMode.IsFakeMode && !Sim.IsRunning)
            {
                <label class="dd-item" role="menuitem" style="cursor:pointer" title="Import an exported run (.zip Parquet bundle, .duckdb, or .json)">
                    <InputFile OnChange="ImportRunFileAsync" accept=".zip,.duckdb,.json" style="display:none" />
                    <span>@(importingRun ? "Importing…" : "Import run…")</span>
                </label>
                @if (!string.IsNullOrEmpty(importError))
                {
                    <div class="bad" style="padding:.25rem .55rem;font-size:.76rem">@importError</div>
                }
            }
        </Foot>
    </DropMenu>;
    private string runFilter = string.Empty;
    private bool RunMatches(StoredRunSummary r) =>
        runFilter.Length == 0
        || r.StartedUtc.ToLocalTime().ToString("dd MMM HH:mm:ss").Contains(runFilter, StringComparison.OrdinalIgnoreCase)
        || (runFilter.StartsWith("fail", StringComparison.OrdinalIgnoreCase) && r.FailedBees > 0)
        || r.RunId.Contains(runFilter, StringComparison.OrdinalIgnoreCase);
    private bool runsLoading, importingRun;
    private string? importError;
    private List<StoredRunSummary> storedRuns = [];

    private async Task ToggleModeMenuAsync()
    {
        menuOpen = false;
        modeMenuOpen = !modeMenuOpen;
        runFilter = string.Empty;
        if (!modeMenuOpen || DataMode.IsFakeMode || Sim.IsRunning) return;
        runsLoading = true;
        try { storedRuns = await ApiRun.ListRunsAsync(200); }
        finally { runsLoading = false; }
    }

    private string ModeBtnCss() => DataMode.IsFakeMode ? "fake" : !ApiRun.IsServerReachable ? "offline" : ApiRun.IsViewingHistory ? "history" : "live";

    private string ModeBtnLabel(bool compact)
    {
        if (DataMode.IsFakeMode) return "Fake";
        if (ApiRun.IsViewingHistory && ApiRun.ActiveStartedUtc is { } dt)
        {
            var local = dt.ToLocalTime();
            return compact ? local.ToString("dd.MM HH:mm") : local.ToString("dd MMM HH:mm:ss");
        }
        return "Live";
    }

    private async Task SetModeAsync(bool fake)
    {
        if (DataMode.IsFakeMode != fake) DataMode.Toggle();
        if (!fake) ApiRun.ReturnToLive();
        modeMenuOpen = false;
        if (!fake && !Sim.IsRunning)
            storedRuns = await ApiRun.ListRunsAsync(200);
    }

    private async Task PickRunAsync(string runId)
    {
        modeMenuOpen = false;
        await Asst.CloseIfMobileAsync();
        await ApiRun.LoadStoredRunAsync(runId);
    }

    private async Task ImportRunFileAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null || importingRun) return;
        importingRun = true;
        importError = null;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 256L * 1024 * 1024);
            var (summary, error) = await ApiRun.ImportRunAsync(file.Name, stream);
            if (error is not null)
            {
                importError = error;
                return;
            }
            modeMenuOpen = false;
            await Asst.CloseIfMobileAsync();
            if (summary is not null)
                storedRuns = await ApiRun.ListRunsAsync(200);
        }
        catch (Exception ex)
        {
            importError = ex.Message;
        }
        finally
        {
            importingRun = false;
        }
    }

    protected override void OnInitialized()
    {
        Settings.Changed += OnChanged;
        EnvPopup.Changed += OnChanged;
        DataMode.Changed += OnChanged;
        ApiRun.Changed += OnChanged;
        Envs.Changed += OnChanged;
        Asst.Changed += OnChanged;
        Phone.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Settings.LoadAsync();
            await DataMode.LoadAsync();
            await ScriptApi.SyncCatalogAsync();
        }
    }

    private void CloseMenu() { menuOpen = false; modeMenuOpen = false; }
    private async Task CloseNavAsync() { menuOpen = false; modeMenuOpen = false; await Asst.CloseIfMobileAsync(); }
    private void OpenEnvsFromMenu() { menuOpen = false; EnvPopup.Show(); }
    private async Task OpenScriptsFromMenu() { menuOpen = false; moreOpen = false; await Asst.CloseIfMobileAsync(); Nav.NavigateTo("editor"); }
    private void OpenSettingsFromMenu() { menuOpen = false; Settings.Open(); }

    private void OnChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        Settings.Changed -= OnChanged;
        EnvPopup.Changed -= OnChanged;
        DataMode.Changed -= OnChanged;
        ApiRun.Changed -= OnChanged;
        Envs.Changed -= OnChanged;
        Asst.Changed -= OnChanged;
        Phone.Changed -= OnChanged;
    }
}
