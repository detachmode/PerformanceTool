@* Logs popup (brain 0017, 0020, 0021, 0045): all logs of the run. Filters, each removable: scenario, a single bee, outcome of the bee (all / failed / slow),
   levels and search. Rows show the full message, word-wrapped (variable row height). Virtualised in both modes; in Live mode queries indexed SQLite storage
   on the server with lazy-loaded pages on scroll so hundreds of thousands of log lines never bloat browser memory. *@
@implements IDisposable
@inject IRunSource Sim
@inject DataModeState DataMode
@inject ApiRunSource ApiRun
@inject LogsPopupState Popup

@{
    var s = Sim.Current;
    var useServer = !DataMode.IsFakeMode && !string.IsNullOrEmpty(ApiRun.CurrentRunId);
    if (useServer) EnsureServerQuery();
    else RebuildLocal(s);
    var allLevels = level.All(x => x);
    var nFailed = 0; var nSlow = 0;
    for (var i = 0; i < s.Count; i++) if (scenario is null || scenario == i) { nFailed += s.Scenarios[i].Failed; nSlow += s.Scenarios[i].SlowBees; }
}

<div class="overlay logs" tabindex="-1" @ref="root" @onkeydown="OnKey" @onclick="Popup.Close" role="presentation">
    <div class="dialog logs-dialog" role="dialog" aria-modal="true" aria-labelledby="logs-title" @onclick:stopPropagation="true">
        <div class="dlg-head">
            <h2 id="logs-title">Logs</h2>
            <span class="muted">@(useServer ? $"server-side filtered ({ApiRun.StorageProvider})" : "all logs of the run")</span>
            <span class="spacer"></span>
            @if (useServer)
            {
                <div class="dd" style="display:inline-flex;align-items:center;gap:2px">
                    <a class="btn ghost small" href="@ExportUrl("parquet")" download title="Export this run as a ZIP of Parquet files (runs, bees, calls, logs)">Export</a>
                    <button class="btn ghost small" style="padding:.25rem .45rem" aria-haspopup="true" aria-expanded="@Aria.Bool(exportOpen)" aria-label="Other export formats" @onclick="() => exportOpen = !exportOpen" title="Other export formats (debug/comparison)">▾</button>
                    @if (exportOpen)
                    {
                        <div class="dd-backdrop" @onclick="() => exportOpen = false"></div>
                        <div class="dd-menu right" role="menu" aria-label="Export format">
                            <a class="dd-item" href="@ExportUrl("parquet")" download @onclick="() => exportOpen = false">Parquet bundle (.zip) — default</a>
                            <a class="dd-item" href="@ExportUrl("duckdb")" download @onclick="() => exportOpen = false">DuckDB (.duckdb)</a>
                            <a class="dd-item" href="@ExportUrl("json")" download @onclick="() => exportOpen = false">JSON (.json)</a>
                            <a class="dd-item" href="@ExportUrl("csv")" download @onclick="() => exportOpen = false">CSV (.csv)</a>
                        </div>
                    }
                </div>
                <button class="btn ghost small" @onclick="RefreshServer" disabled="@serverLoading" title="Reload matching logs from server">Refresh</button>
            }
            <button class="icon-btn" @onclick="Popup.Close" aria-label="Close">✕</button>
        </div>

        <div class="log-filters" role="group" aria-label="Log filters">
            <label class="visually-hidden" for="log-scenario">Scenario</label>
            <select id="log-scenario" value="@(scenario?.ToString() ?? "")" @onchange="SetScenario">
                <option value="">All scenarios</option>
                @for (var i = 0; i < s.Count; i++) { <option value="@i">@s.Labels[i]</option> }
            </select>

            <div class="seg" role="group" aria-label="Bees">
                <button class="@(outcome == BeeShow.All ? "on" : "")" aria-pressed="@Aria.Bool(outcome == BeeShow.All)" @onclick="() => outcome = BeeShow.All">All bees</button>
                <button class="@(outcome == BeeShow.Failed ? "on" : "")" aria-pressed="@Aria.Bool(outcome == BeeShow.Failed)" @onclick="() => outcome = BeeShow.Failed" title="Only the logs of failed bees">Failed <span class="n">@Format.Num(nFailed)</span></button>
                <button class="@(outcome == BeeShow.Slow ? "on" : "")" aria-pressed="@Aria.Bool(outcome == BeeShow.Slow)" @onclick="() => outcome = BeeShow.Slow" title="Only the logs of slow bees">Slow <span class="n">@Format.Num(nSlow)</span></button>
            </div>

            @if (bee is { } a)
            {
                <button class="chip" @onclick="() => bee = null" title="Remove the bee filter">Bee <BeeChip Sequence="a" State="StateOf(a, scenario)" Tint="TintOf(a)" /> ✕</button>
            }

            <div class="dd">
                <button class="btn ghost" aria-haspopup="true" aria-expanded="@Aria.Bool(levelsOpen)" @onclick="() => levelsOpen = !levelsOpen">@(allLevels ? "All levels" : $"{level.Count(x => x)} of 5 levels") ▾</button>
                @if (levelsOpen)
                {
                    <div class="dd-backdrop" @onclick="() => levelsOpen = false"></div>
                    <div class="dd-menu" role="group" aria-label="Levels">
                        @for (var i = 0; i < FakeLogEntry.Levels.Length; i++)
                        {
                            var li = i;
                            <label class="dd-item"><input type="checkbox" checked="@level[li]" @onchange="e => level[li] = (bool)(e.Value ?? false)" /> @FakeLogEntry.Levels[li]</label>
                        }
                    </div>
                }
            </div>

            <input class="search" type="search" placeholder="Search messages or bee…" aria-label="Search messages" autocomplete="off" value="@search" @oninput="e => search = e.Value?.ToString() ?? string.Empty" />
        </div>

        <VirtualList Class="log-list" Role="log" Label="Log lines" Items="filtered" Variable="true" RowHeight="40" ResetKey="@builtSig" OnNearEnd="@(useServer && filtered.Count < serverTotal ? EventCallback.Factory.Create(this, OnNearEndAsync) : default)">
            <ItemContent Context="l">
                <div class="logrow lv-@l.Level @(ReferenceEquals(expanded, l) ? "on" : "")">
                    <BeeChip Sequence="l.Sequence" State="StateOf(l.Sequence, l.Entry)" Tint="TintOf(l.Sequence)" OnClick="() => FilterBee(l)" Title="@($"Show only the logs of bee #{l.Sequence + 1}")" />
                    <button class="msg" aria-pressed="@Aria.Bool(ReferenceEquals(expanded, l))" title="Show details" @onclick="() => expanded = ReferenceEquals(expanded, l) ? null : l"><span class="visually-hidden">@l.Level: </span>@l.Message</button>
                </div>
            </ItemContent>
            <Empty><p class="muted empty">@(serverLoading ? "Loading logs…" : "No log lines match the filters.")</p></Empty>
        </VirtualList>

        @if (expanded is { } x)
        {
            <section class="log-detail" aria-label="Log line details">
                <div class="log-detail-head"><b>Bee <BeeChip Sequence="x.Sequence" State="StateOf(x.Sequence, x.Entry)" Tint="TintOf(x.Sequence)" /></b><span class="muted">@x.Level · @x.Timestamp.ToString("HH:mm:ss.fff") · @Format.Time(x.AtSeconds) into the run</span><span class="spacer"></span><button class="icon-btn" @onclick="() => expanded = null" aria-label="Close details">✕</button></div>
                <dl>@foreach (var (k, v) in x.Scope) { <dt>@k</dt><dd>@v</dd> }</dl>
                @if (x.Exception is not null) { <pre>@x.Exception</pre> }
            </section>
        }

        <div class="log-foot muted">
            @if (useServer)
            {
                <span>Showing @Format.Num(filtered.Count) of @Format.Plural((int)Math.Min(int.MaxValue, serverTotal), "line", "lines") (@ApiRun.StorageProvider)</span>
                @if (filtered.Count < serverTotal)
                {
                    <button class="btn ghost small" style="margin-left:.5rem" disabled="@serverLoading" @onclick="OnNearEndAsync">@(serverLoading ? "Loading…" : "Load more")</button>
                }
            }
            else
            {
                @Format.Plural(filtered.Count, "line", "lines")
                @if (s.Store.DetailTrimmed) { <text> · logs of older successful bees are no longer kept</text> }
            }
        </div>
    </div>
</div>

@code {
    private const int ServerPageSize = 250;

    private ElementReference root;
    private int? scenario, bee;
    private BeeShow outcome = BeeShow.All;
    private readonly bool[] level = [true, true, true, true, true];
    private string search = "";
    private bool levelsOpen;
    private bool exportOpen;
    private FakeLogEntry? expanded;

    private string ExportUrl(string fmt) => $"api/runs/{Uri.EscapeDataString(ApiRun.CurrentRunId)}/export?format={fmt}";

    private List<FakeLogEntry> filtered = [];
    private string builtSig = "";
    private int builtSource = -1;
    private long builtAt;

    // Server-side lazy paging state (Live mode + SQLite).
    private long serverTotal;
    private bool serverLoading;
    private string serverQuerySig = "";
    private long serverQueryAt;
    private CancellationTokenSource? queryCts;

    protected override void OnInitialized()
    {
        (scenario, bee, outcome) = (Popup.Entry, Popup.Bee, Popup.Outcome);
        Sim.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { try { await root.FocusAsync(); } catch (Exception) { } }
    }

    private void OnChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        if (levelsOpen) levelsOpen = false; else Popup.Close();
    }

    private BeeState StateOf(int sequence, int? entry)
    {
        var s = Sim.Current;
        if (entry is { } e && s.BeesInFlight is { } fl && e < fl.Length && fl[e].Any(r => r.Sequence == sequence)) return BeeState.Running;
        if (entry is null && s.BeesInFlight is { } all && all.Any(l => l.Any(r => r.Sequence == sequence))) return BeeState.Running;
        return BeeOrder.StateOf(s.Store.OutcomeOf(sequence));
    }

    private int TintOf(int sequence) => Sim.Current.Store.TintOf(sequence);

    private void SetScenario(ChangeEventArgs e) => scenario = int.TryParse(e.Value?.ToString(), out var i) ? i : null;

    private void FilterBee(FakeLogEntry l) { bee = l.Sequence; scenario = l.Entry; }

    private string CurrentSig() => $"{ApiRun.CurrentRunId}|{scenario}|{bee}|{string.Concat(level.Select(x => x ? '1' : '0'))}|{outcome}|{search}";

    private void EnsureServerQuery()
    {
        var sig = CurrentSig();
        var changed = sig != serverQuerySig;
        var liveRefreshDue = Sim.IsRunning && !serverLoading && Environment.TickCount64 - serverQueryAt >= 1500 && filtered.Count <= ServerPageSize;
        if (!changed && !liveRefreshDue) return;

        serverQuerySig = sig;
        if (changed) builtSig = sig;
        _ = FetchServerPageAsync(reset: true, sig, debounceMs: changed && !string.IsNullOrEmpty(search) ? 200 : 0);
    }

    private void RefreshServer() => _ = FetchServerPageAsync(reset: true, CurrentSig(), debounceMs: 0);

    private Task OnNearEndAsync()
    {
        if (DataMode.IsFakeMode || string.IsNullOrEmpty(ApiRun.CurrentRunId)) return Task.CompletedTask;
        if (serverLoading || filtered.Count >= serverTotal) return Task.CompletedTask;
        return FetchServerPageAsync(reset: false, serverQuerySig, debounceMs: 0);
    }

    private async Task FetchServerPageAsync(bool reset, string sig, int debounceMs)
    {
        if (reset)
        {
            queryCts?.Cancel();
            queryCts?.Dispose();
            queryCts = new CancellationTokenSource();
        }
        var ct = queryCts?.Token ?? CancellationToken.None;
        if (debounceMs > 0)
        {
            try { await Task.Delay(debounceMs, ct); } catch (OperationCanceledException) { return; }
        }

        serverLoading = true;
        serverQueryAt = Environment.TickCount64;
        try
        {
            var selectedLevels = FakeLogEntry.Levels.Where((_, i) => level[i]).ToArray();
            bool? failedFilter = outcome == BeeShow.Failed ? true : null;
            bool? slowFilter = outcome == BeeShow.Slow ? true : null;
            var offset = reset ? 0 : filtered.Count;
            var page = await ApiRun.QueryLogsAsync(scenario, bee, failedFilter, slowFilter, selectedLevels, search, offset, ServerPageSize, ct);
            if (ct.IsCancellationRequested || sig != serverQuerySig || page is null) return;

            serverTotal = page.TotalCount;
            var startedUtc = ApiRun.CurrentStartedUtc;
            var mapped = page.Items.Select(r => new FakeLogEntry(
                r.AtSeconds,
                startedUtc.AddSeconds(r.AtSeconds),
                r.Level,
                r.Message,
                r.Exception,
                r.Entry,
                r.Sequence,
                new Dictionary<string, string> { ["Bee"] = r.BeeName },
                r.CallIndex)).ToList();

            if (reset) filtered = mapped;
            else
            {
                var next = new List<FakeLogEntry>(filtered.Count + mapped.Count);
                next.AddRange(filtered);
                next.AddRange(mapped);
                filtered = next;
            }
        }
        catch (OperationCanceledException) { }
        catch { }
        finally
        {
            serverLoading = false;
            try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { }
        }
    }

    private void RebuildLocal(RunSnapshot s)
    {
        var source = s.Store.Logs();
        var sig = $"fake|{scenario}|{bee}|{string.Concat(level.Select(x => x ? '1' : '0'))}|{outcome}|{search}";
        var changed = sig != builtSig;
        if (!changed && (source.Count == builtSource || Environment.TickCount64 - builtAt < 700)) return;

        var needle = search.Trim();
        var list = new List<FakeLogEntry>(Math.Min(source.Count, 1024));
        for (var i = 0; i < source.Count; i++)
        {
            var l = source[i];
            if (scenario is { } sc && l.Entry != sc) continue;
            if (bee is { } ac && l.Sequence != ac) continue;
            if (!level[l.LevelRank]) continue;
            if (outcome != BeeShow.All)
            {
                var st = StateOf(l.Sequence, l.Entry);
                if (outcome == BeeShow.Failed && st != BeeState.Failed) continue;
                if (outcome == BeeShow.Slow && st != BeeState.Slow) continue;
            }
            if (needle.Length > 0 && !l.Message.Contains(needle, StringComparison.OrdinalIgnoreCase)
                && (l.Exception is null || !l.Exception.Contains(needle, StringComparison.OrdinalIgnoreCase))) continue;
            list.Add(l);
        }
        filtered = list;
        builtSig = sig;
        builtSource = source.Count;
        builtAt = Environment.TickCount64;
    }

    public void Dispose()
    {
        queryCts?.Cancel();
        queryCts?.Dispose();
        Sim.Changed -= OnChanged;
    }
}
