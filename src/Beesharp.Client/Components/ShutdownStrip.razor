@* The shutdown program of the run (brain 0052), above the scenario cards. Calm UI (0016): while it runs or when it failed it shows its output;
   when it finished well it is one quiet line and the output opens on demand ("Logs", brain 0029). A failure never changes the scenarios' results. *@

@if (Run is { State: not "Pending" })
{
    var failed = Run.IsFailed;
    var showLogs = userOpen ?? (Run.IsRunning || failed);
    <section class="preflight-view shutdown-strip @(failed ? "failed" : Run.IsRunning ? "running" : "done")" aria-label="Shutdown program">
        <div class="preflight-head">
            <span class="pf-badge @(failed ? "bad" : Run.IsRunning ? "run" : "ok")">@(failed ? "Shutdown failed" : Run.IsRunning ? "Shutting down…" : "Shutdown finished")</span>
            <b class="mono">@Run.Name</b>
            <span class="spacer"></span>
            <button type="button" class="btn ghost small" aria-expanded="@Aria.Bool(showLogs)" @onclick="() => userOpen = !showLogs"
                    title="@(showLogs ? "Hide the output" : "Show the output of the shutdown program")">
                Logs · @Run.Logs.Count
            </button>
            @if (failed && !string.IsNullOrWhiteSpace(ScriptId))
            {
                <button type="button" class="btn ghost small" @onclick="Edit">Edit script</button>
            }
        </div>
        @if (failed && !string.IsNullOrWhiteSpace(Run.Error))
        {
            <div class="preflight-err-banner" role="alert">
                <b>The scenarios' results are not affected.</b>
                <span>@Run.Error</span>
            </div>
        }
        @if (showLogs)
        {
            <div class="sl-console shutdown-console" role="log" aria-live="polite">
                @if (Run.Logs.Count == 0)
                {
                    <div class="muted">Waiting for shutdown output…</div>
                }
                else
                {
                    @foreach (var line in Run.Logs)
                    {
                        <SerilogLine Raw="@line" />
                    }
                }
            </div>
        }
    </section>
}

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    [Parameter] public ProgramRun? Run { get; set; }
    [Parameter] public string? ScriptId { get; set; }

    private bool? userOpen;
    private string? lastState;

    protected override void OnParametersSet()
    {
        // A new phase (running, then done) starts with the default again: output open while running or failed, closed when it went well.
        if (lastState != Run?.State) userOpen = null;
        lastState = Run?.State;
    }

    private void Edit() => Nav.NavigateTo($"editor?shutdown={Uri.EscapeDataString(ScriptId!)}");
}
