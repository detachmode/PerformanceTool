@* The popup chart's bars in small (brain 0049): the same bars (BeeBars.Build), colours and time axis, without the zoom machinery. A bar is one bee,
   or a time bucket when there are many; clicking one opens the full chart (OnPick, with the bee when the bar is one bee). *@
@using PerformanceTool.Ai.Contracts
@{
    var bars = Bars();
}

@if (bars.Count == 0)
{
    <div class="chart-empty muted">No bees.</div>
}
else
{
    <div class="mini-chart" role="group" aria-label="Bees on a time line">
        <div class="chart-scroll">
            <div class="chart mini">
                <span class="chart-max">@Format.Ms(scale)</span>
                <div class="dz-bars">
                    @foreach (var b in bars)
                    {
                        var bar = b;
                        <button type="button" class="bar-hit @(bar.Sequence >= 0 && Selected == bar.Sequence + 1 ? "on" : "")" title="@Title(bar)" aria-label="@Title(bar)" @onclick="() => OnPick.InvokeAsync(bar.Sequence >= 0 ? bar.Sequence + 1 : null)">
                            <i class="bar @Cls(bar)" style="height:@Pct(bar.MaxMs / scale)%"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
        <div class="mini-axis" aria-hidden="true"><span>@Format.Time(first)</span><span>@Format.Time(last)</span></div>
    </div>
}

@code {
    private double scale = 1, first, last, bucketWidth;
    private int total;

    [Parameter, EditorRequired] public IReadOnlyList<ViewBeeDto> Bees { get; set; } = [];
    /// <summary>Called with the 1-based bee number of the bar, or null for a bar of several bees.</summary>
    [Parameter] public EventCallback<int?> OnPick { get; set; }
    [Parameter] public int? Selected { get; set; }

    private List<BeeBar> Bars()
    {
        var errors = new PerformanceTool.Client.Services.ErrorDictionary();
        var records = Bees.OrderBy(b => b.StartedAt).ThenBy(b => b.Bee)
            .Select(b => new PerformanceTool.Client.Services.BeeRecord(b.Bee - 1, 0, b.StartedAt, b.DurationMs, b.Outcome == "slow" ? 1 : 0, b.Outcome == "failed" ? errors.Intern(b.Error ?? "failed") : 0, errors))
            .ToList();
        var bars = BeeBars.Build(records, records.Count, BeeShow.All, out total, out bucketWidth, maxBars: 60);
        scale = bars.Count == 0 ? 1 : Math.Max(1, bars.Max(b => b.MaxMs));
        first = records.Count == 0 ? 0 : records.Min(r => r.StartedAt);
        last = records.Count == 0 ? 0 : records.Max(r => r.StartedAt + r.DurationMs / 1000);
        return bars;
    }

    private string Cls(BeeBar b) => b.Failed > 0 ? "bad" : b.Slow > 0 ? "warn" : BeeOrder.Good(b.Step);
    private static string Pct(double f) => Math.Clamp(f * 100, 3, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private string Title(BeeBar b) => b.Sequence >= 0
        ? $"B{b.Sequence + 1}: {Format.Ms(b.MaxMs)}, started {Format.Time(b.BucketStart)}"
        : $"{Format.Plural(b.Count, "bee", "bees")} from {Format.Time(b.BucketStart)}" + (b.Failed > 0 ? $", {b.Failed} failed" : "") + (b.Slow > 0 ? $", {b.Slow} slow" : "");
}
