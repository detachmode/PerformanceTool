@* The bee number (#192) in the colour of its outcome (brain 0028): red failed, yellow slow, green ok, blue running. Use this wherever a bee number is shown.
   With OnClick it is a button (e.g. a log row filters on the bee), otherwise plain text. The outcome is also in the accessible name. *@
@{
    var css = BeeOrder.Css(State, Tint);
    var label = $"Bee #{Sequence + 1}, {BeeOrder.Word(State)}";
}
@if (OnClick.HasDelegate)
{
    <button type="button" class="bee-chip achip @css @Class" title="@(Title ?? label)" aria-label="@label" @onclick="OnClick">#@(Sequence + 1)</button>
}
else
{
    <span class="achip @css @Class" title="@Title">#@(Sequence + 1)<span class="visually-hidden"> (@BeeOrder.Word(State))</span></span>
}

@code {
    /// <summary>Zero-based sequence of the bee; shown as #Sequence+1.</summary>
    [Parameter, EditorRequired] public int Sequence { get; set; }
    [Parameter] public BeeState State { get; set; } = BeeState.Ok;
    /// <summary>The colour step of an ok bee (brain 0041): 0 green at typical time, up to a yellower green the slower it was.</summary>
    [Parameter] public int Tint { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }
}
