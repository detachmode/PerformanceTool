@* The vertical stepper of one bee (brain 0056, calm UI brain 0016): numbered circles joined by a thin line. A done step gets a check and its time, the step the bee failed at
   is red with its error (one line), the step in flight is highlighted with the active spinner, steps not reached are greyed out. Clicking any step expands its calls and
   Azure DevOps-style console output; currently running and failed steps auto-open so logs stream in live. *@
@{
    // Steps the bee never reached at the end of a long story fold into one row (any number of steps, brain 0056); a click shows them.
    var tailFrom = Steps.Count;
    while (tailFrom > 0 && Steps[tailFrom - 1].State == StepState.Pending) tailFrom--;
    var shown = !showPending && Steps.Count - tailFrom >= 3 ? tailFrom : Steps.Count;
}
<ol class="stepper" aria-label="@AriaLabel">
    @for (var rowIdx = 0; rowIdx < shown; rowIdx++)
    {
        var row = rowIdx;
        var step = Steps[row];
        var stepLogs = LogsFor(step);
        var stepLiveLogs = LiveLogsFor(step);
        var hasLogs = stepLogs.Count > 0 || stepLiveLogs.Count > 0;
        var canOpen = step.HasCalls || hasLogs || step.State == StepState.Current;
        var defaultOpen = DefaultExpanded || (step.State == StepState.Current && (hasLogs || LiveLogs is not null)) || (step.State == StepState.Failed && hasLogs);
        var open = canOpen && (toggled.Contains(row) ? !defaultOpen : defaultOpen);
        <li class="stp @Css(step)">
            <span class="stp-dot" aria-hidden="true">
                @if (step.State == StepState.Current)
                {
                    <HexBadge Kind="spin" Size="26" StrokeWidth="9" />
                }
                else if (step.State == StepState.Done)
                {
                    <HexBadge Kind="@(step.SlowCalls > 0 ? "warn" : "ok")" Size="24" StrokeWidth="7" />
                }
                else if (step.State == StepState.Failed)
                {
                    <HexBadge Kind="bad" Size="24" StrokeWidth="7" />
                }
                else
                {
                    <HexBadge Kind="num" Size="24" StrokeWidth="6.5">@(step.Index + 1)</HexBadge>
                }
            </span>
            <div class="stp-body">
                <button type="button" class="stp-head" disabled="@(!canOpen)" aria-expanded="@(canOpen ? Aria.Bool(open) : null)" @onclick="() => Toggle(row)"
                        title="@(canOpen ? (open ? "Hide calls and logs of this step" : "Show calls and logs of this step") : null)">
                    <span class="stp-name">@step.Name</span>
                    @if (step.VisitNumber > 1) { <span class="stp-times" title="Visit #@step.VisitNumber of @step.Name">#@step.VisitNumber</span> }
                    else if (step.Repeats) { <span class="stp-times" title="@(step.HasKnownTotal ? $"This step runs {step.Times} times in a row" : $"This step ran {step.Times} times")">×@step.Times</span> }
                    <span class="stp-word">@Word(step)</span>
                    @if (step.State is StepState.Done or StepState.Failed && step.HasCalls)
                    {
                        <span class="stp-time @(step.SlowCalls > 0 ? "warn" : "")">@Format.Ms(step.DurationMs)</span>
                    }
                    @if (canOpen) { <span class="stp-chev" aria-hidden="true">@(open ? "▾" : "▸")</span> }
                </button>
                @if (!step.Repeats && step.RepData is not null && step.RepData.TryGetValue(0, out var singleData))
                {
                    <div class="stp-data" title="@singleData">@StepLogic.FormatStepData(singleData)</div>
                }
                @if (step.State == StepState.Failed && !string.IsNullOrWhiteSpace(step.Error))
                {
                    <p class="stp-error bad">@OneLine(step.Error)</p>
                }
                @if (step.State == StepState.Current && NowCall is not null)
                {
                    <p class="stp-now muted">now: @NowCall</p>
                }
                @if (open)
                {
                    @if (step.HasCalls)
                    {
                        <ol class="stp-calls" aria-label="Calls of @step.Name">
                            @{ var lastRep = -1; }
                            @foreach (var c in step.Calls)
                            {
                                var cls = c.Failed ? "bad" : c.Slow ? "warn" : "";
                                if (step.Repeats && c.Rep != lastRep)
                                {
                                    lastRep = c.Rep;
                                    var repJson = step.RepData is not null && step.RepData.TryGetValue(c.Rep, out var rd) ? rd : null;
                                    <li class="stp-rep @(step.FailedRep == c.Rep ? "bad" : "")">
                                        <span>@(step.HasKnownTotal ? $"{c.Rep + 1} of {step.Times}" : $"#{c.Rep + 1}")@(step.FailedRep == c.Rep ? " · failed" : "")</span>
                                        @if (repJson is not null)
                                        {
                                            <span class="stp-rep-data" title="@repJson">@StepLogic.FormatStepData(repJson)</span>
                                        }
                                    </li>
                                }
                                <li class="stp-call @cls @(step.Repeats ? "in-rep" : "")">
                                    @if (OnCallClick.HasDelegate)
                                    {
                                        <button type="button" class="call-name call-link" @onclick="() => OnCallClick.InvokeAsync(c)" title="Analyse all durations of @(c.Endpoint ?? c.Name)">@c.Name</button>
                                    }
                                    else
                                    {
                                        <span class="call-name" title="@c.Name">@c.Name</span>
                                    }
                                    <span class="call-dur">@Format.Ms(c.DurationMs)</span>
                                    <span class="call-status">@(c.Failed ? (c.Status?.ToString() ?? (Beesharp.Services.ExecutionResult.IsCanceledError(c.Error) ? "canceled" : "timeout")) : c.Slow ? "slow" : c.Status?.ToString() ?? "")</span>
                                </li>
                            }
                        </ol>
                    }
                    @if (stepLiveLogs.Count > 0 || stepLogs.Count > 0 || (step.State == StepState.Current && LiveLogs is not null))
                    {
                        <div class="stp-consolewrap">
                        <div class="stp-copy"><CopyButton GetText="@(() => ConsoleText(step))" Disabled="@(stepLiveLogs.Count == 0 && stepLogs.Count == 0)" Title="Copy all logs of this step to the clipboard" /></div>
                        <div class="sl-console compact stp-console wrap" role="log" aria-label="Console output of @step.Name">
                            @if (stepLiveLogs.Count > 0)
                            {
                                @foreach (var l in stepLiveLogs)
                                {
                                    <SerilogLine Timestamp="l.Timestamp" Level="@l.Level" Message="@l.Message" Exception="@l.Exception" />
                                }
                            }
                            else if (stepLogs.Count > 0)
                            {
                                @foreach (var l in stepLogs)
                                {
                                    <SerilogLine Timestamp="l.Timestamp" Level="@l.Level" Message="@l.Message" Exception="@l.Exception" />
                                }
                            }
                            else
                            {
                                <div class="sl-empty" style="padding:.2rem 0">Waiting for output…</div>
                            }
                        </div>
                        </div>
                    }
                }
            </div>
        </li>
    }
    @if (shown < Steps.Count)
    {
        <li class="stp pending stp-fold">
            <span class="stp-dot" aria-hidden="true"><HexBadge Kind="num" Size="24" StrokeWidth="6.5">⋯</HexBadge></span>
            <div class="stp-body">
                <button type="button" class="stp-head" @onclick="() => showPending = true" title="@string.Join(" → ", Steps.Skip(shown).Select(x => x.Name))">
                    <span class="stp-name">Steps @(shown + 1)–@Steps.Count</span>
                    <span class="stp-word">@(Steps.Count - shown) not reached</span>
                    <span class="stp-chev" aria-hidden="true">▸</span>
                </button>
            </div>
        </li>
    }
</ol>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<StepView> Steps { get; set; } = [];
    /// <summary>For a bee in flight: the call it is making now, shown quietly under the current step.</summary>
    [Parameter] public string? NowCall { get; set; }
    /// <summary>Stored logs of a finished bee, matched to each step by (Step, Rep).</summary>
    [Parameter] public IReadOnlyList<FakeLogEntry>? Logs { get; set; }
    /// <summary>Live streaming logs of a running bee, matched to each step by (Step, Rep).</summary>
    [Parameter] public IReadOnlyList<LiveLogEntryDto>? LiveLogs { get; set; }
    /// <summary>Whether steps start expanded (all console outputs visible) by default.</summary>
    [Parameter] public bool DefaultExpanded { get; set; } = true;
    /// <summary>Incremented by the parent when clicking Collapse all / Expand all to clear per-row manual overrides.</summary>
    [Parameter] public int ResetKey { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Steps";
    /// <summary>Optional callback when a call row is clicked (e.g. to open it on the Calls page).</summary>
    [Parameter] public EventCallback<FakeCall> OnCallClick { get; set; }

    private readonly HashSet<int> toggled = [];
    private bool showPending;
    private int lastResetKey;

    protected override void OnParametersSet()
    {
        if (ResetKey != lastResetKey)
        {
            lastResetKey = ResetKey;
            toggled.Clear();
        }
    }

    private void Toggle(int index) { if (!toggled.Remove(index)) toggled.Add(index); }

    private List<FakeLogEntry> LogsFor(StepView step)
    {
        if (Logs is not { Count: > 0 }) return [];
        var rep = step.VisitNumber > 0 ? step.VisitNumber - 1 : -1;
        return Logs.Where(l => l.Step == step.Index && (rep < 0 || l.Rep == rep)).ToList();
    }

    private List<LiveLogEntryDto> LiveLogsFor(StepView step)
    {
        if (LiveLogs is not { Count: > 0 }) return [];
        var rep = step.VisitNumber > 0 ? step.VisitNumber - 1 : -1;
        return LiveLogs.Where(l => l.Step == step.Index && (rep < 0 || l.Rep == rep)).ToList();
    }

    /// <summary>ALL log lines of a step (live or stored), one per line, for the copy button of its console.</summary>
    private string ConsoleText(StepView step)
    {
        var live = LiveLogsFor(step);
        var lines = live.Count > 0
            ? live.Select(l => LogText.CopyLine(l.AtSeconds, l.Timestamp, l.Level, l.Message, l.Exception))
            : LogsFor(step).Select(l => LogText.CopyLine(l.AtSeconds, l.Timestamp, l.Level, l.Message, l.Exception));
        return string.Join("\n", lines);
    }


    private static string Css(StepView s) => s.State switch { StepState.Done => "done", StepState.Failed => "failed", StepState.Current => "current", _ => "pending" };
    private static string Word(StepView s) => s.State switch
    {
        StepState.Failed => (s.Canceled ? "canceled" : "failed") + (s.VisitNumber == 0 && (s.Repeats || s.FailedRep > 0) && s.FailedRep >= 0 ? ", " + ScenarioSteps.Ordinal(s.FailedRep + 1) + " time" : ""),
        StepState.Current => s.HasKnownTotal && s.Repeats && s.CurrentRep >= 0 ? $"active · {s.CurrentRep + 1} of {s.Times}" : s.CurrentRep > 0 ? $"active · {ScenarioSteps.Ordinal(s.CurrentRep + 1)} time" : "active",
        StepState.Pending => "not reached",
        _ => "",
    };

    private static string OneLine(string text)
    {
        var line = text.Trim();
        var nl = line.IndexOfAny(['\r', '\n']);
        if (nl >= 0) line = line[..nl].Trim();
        return line.Length > 110 ? line[..109] + "…" : line;
    }
}
