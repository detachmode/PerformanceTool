@* The bees of the visible time frame, failed first, then slow, then successful, each by time (brain 0028, 0023 update 3).
   Wide screens: a virtualised list at the side of the popup. Narrow screens: the same rows below the chart, shown a page at a time, so the popup
   never holds a second scrolling list (CSS shows one of the two). Clicking a row selects the bee. *@
@{
    var visible = Math.Min(Rows.Count, pageCount * PageSize);
}

<VirtualList Class="bee-list side-virtual" Items="Rows" RowHeight="34" ResetKey="@ResetKey" Label="Bees in view" Role="list">
    <ItemContent Context="a">
        @Row(a)
    </ItemContent>
    <Empty><p class="muted empty">@EmptyText</p></Empty>
</VirtualList>

<div class="side-paged" role="list" aria-label="Bees in view">
    @for (var i = 0; i < visible; i++)
    {
        var a = Rows[i];
        @Row(a)
    }
    @if (Rows.Count == 0) { <p class="muted empty">@EmptyText</p> }
    @if (visible < Rows.Count)
    {
        <button class="btn ghost small side-more" @onclick="() => pageCount++">Show @Math.Min(PageSize, Rows.Count - visible) more (@Format.Num(Rows.Count - visible) left)</button>
    }
</div>

@code {
    private const int PageSize = 25;
    private int pageCount = 1;
    private object? lastKey;

    [Parameter, EditorRequired] public IReadOnlyList<BeeRow> Rows { get; set; } = [];
    [Parameter] public int? SelectedSequence { get; set; }
    [Parameter] public EventCallback<BeeRow> OnSelect { get; set; }
    [Parameter] public object? ResetKey { get; set; }
    [Parameter] public string EmptyText { get; set; } = "No bees in this time frame.";

    protected override void OnParametersSet()
    {
        if (!Equals(lastKey, ResetKey)) { lastKey = ResetKey; pageCount = 1; }
    }

    private RenderFragment Row(BeeRow a) => @<button class="bee-row @(SelectedSequence == a.Sequence ? "on" : "")" role="listitem" aria-pressed="@Aria.Bool(SelectedSequence == a.Sequence)" @onclick="() => OnSelect.InvokeAsync(a)">
        <BeeChip Sequence="a.Sequence" State="a.State" Tint="a.Tint" />
        <span class="dur">@(a.IsRunning ? "active" : Format.Ms(a.DurationMs))</span>
        <span class="at">@Format.Time(a.StartedAt)</span>
        @if (a.State == BeeState.Ok)
        {
            <span class="state good bee-ok-state" title="Ok" aria-label="Ok"><svg class="bee-ok-icon" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.2 8.4 6.5 11.7 12.8 4.8" /></svg></span>
        }
        else
        {
            <span class="state @BeeOrder.Css(a.State)">@(a.State is BeeState.Failed or BeeState.Slow ? BeeOrder.Word(a.State) : "")</span>
        }
    </button>;
}
