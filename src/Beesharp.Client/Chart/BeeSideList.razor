@* The bees of the visible time frame, bees in flight first, then failed, slow, successful, each by time (brain 0028, 0023 update 3, 0059).
   One row per bee: its number in the outcome colour, duration, start time and one quiet line (the error, the slow call, or the step it is in).
   A virtualised list (brain 0021, 0022), also on a phone. Clicking a row selects the bee. *@
<VirtualList Class="bee-list side-virtual" Items="Rows" RowHeight="34" ScrollToIndex="RevealIndex" ResetKey="@ResetKey" Label="Bees in view" Role="list">
    <ItemContent Context="a">
        @Row(a)
    </ItemContent>
    <Empty><p class="muted empty">@EmptyText</p></Empty>
</VirtualList>

@code {

    [Parameter, EditorRequired] public IReadOnlyList<BeeRow> Rows { get; set; } = [];
    [Parameter] public int? SelectedSequence { get; set; }
    [Parameter] public EventCallback<BeeRow> OnSelect { get; set; }
    [Parameter] public object? ResetKey { get; set; }
    /// <summary>The quiet line after a row: the error, the slow call, or "Step 3 of 5 · Open product" for a bee in flight (<see cref="BeeLine"/>).</summary>
    [Parameter] public Func<BeeRow, string?>? Info { get; set; }
    /// <summary>The row to keep in view (the selected bee, e.g. after ‹ ›): the list scrolls only when it is out of sight.</summary>
    [Parameter] public int? RevealIndex { get; set; }
    [Parameter] public string EmptyText { get; set; } = "No bees in this time frame.";

    private RenderFragment Row(BeeRow a) => @<button class="bee-row @(SelectedSequence == a.Sequence ? "on" : "")" role="listitem" aria-pressed="@Aria.Bool(SelectedSequence == a.Sequence)" @onclick="() => OnSelect.InvokeAsync(a)">
        <BeeChip Sequence="a.Sequence" State="a.State" Tint="a.Tint" />
        <span class="dur">@(a.IsRunning ? "active" : Format.Ms(a.DurationMs))</span>
        <span class="at">@Format.Time(a.StartedAt)</span>
        @if (Info?.Invoke(a) is { Length: > 0 } info)
        {
            <span class="info @(a.State == BeeState.Failed ? "bad" : a.State == BeeState.Slow ? "warn" : "")" title="@info">@info</span>
        }
    </button>;
}
