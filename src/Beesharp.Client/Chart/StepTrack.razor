@* The steps of a scenario at a glance (brain 0056): where the bees of a run got to. Shown on the overview card (Compact) and at the top of the
   scenario page, always open, so the steps are the first thing you see. Every count drills down (brain 0029): a failed count opens the bees
   that failed at that step, an active count the bees in flight there.
   The step list (user's choice): per step the bees there right now and the bees that failed there, then the bees that finished all steps.
   Any number of steps (brain 0056): past a few steps, runs of quiet steps (no failed and no active bees) fold into one "+N steps" item that opens
   on click, so a failure is never pushed out of sight; the first and the last step always show. Debug URL "?stepcount=1,8,24". *@
@{
    var n = Steps.Count;
    var failed = new int[n];
    var flight = new int[n];
    for (var i = 0; i < n; i++)
    {
        failed[i] = i < FailedPer.Count ? FailedPer[i] : 0;
        flight[i] = InFlightPer is not null && i < InFlightPer.Count ? InFlightPer[i] : 0;
    }
    // Bees that reached a step: every finished bee, minus those that failed at an earlier step. Bees in flight are counted at their step.
    var reached = new int[n];
    var before = 0;
    for (var i = 0; i < n; i++) { reached[i] = Math.Max(0, Finished - before); before += failed[i]; }
    var passedAll = Math.Max(0, Finished - before);
    var items = Items(n, failed, flight, Compact ? 6 : 10);
}

@if (n > 0)
{
        @* The step list: per step, the bees there right now (while the run goes) and the bees that failed there; the last line counts the bees
           that finished every step. Zero is a quiet dash, so the numbers that matter stand out. *@
        <div class="sls @(Compact ? "compact" : "") @(Live ? "live" : "")" role="table" aria-label="@AriaLabel">
            <div class="sls-row sls-headrow" role="row">
                <span class="sls-no" role="columnheader"></span>
                <span class="sls-name" role="columnheader">@(Compact ? "" : "Step")</span>
                @if (Live) { <span class="sls-col run" role="columnheader"><i class="yt-live-dot" aria-hidden="true"></i>Now</span> }
                @* A neutral heading: red is only for real failures, so a scenario without failures says "Failed 0" in grey. *@
                <span class="sls-col" role="columnheader">@(before == 0 ? "Failed 0" : "Failed")</span>
            </div>
            @foreach (var item in items)
            {
                var st = item.From;
                if (item.IsGroup)
                {
                    var grp = item;
                    <div class="sls-row grp" role="row">
                        <span class="sls-no" aria-hidden="true">⋯</span>
                        <button type="button" class="sls-name sls-grp" role="cell" @onclick="() => Expand(grp.From)" @onclick:stopPropagation="true" title="@GroupTitle(grp)">
                            Steps @(grp.From + 1)–@(grp.To + 1) <small>@(grp.Count) steps</small>
                        </button>
                        @if (Live) { <span class="sls-col zero" role="cell">–</span> }
                        <span class="sls-col zero" role="cell">–</span>
                    </div>
                    continue;
                }
                var on = Selected == st;
                <div class="sls-row @(flight[st] > 0 ? "has-run" : "") @(failed[st] > 0 ? "has-bad" : "") @(on ? "on" : "")" role="row">
                    <span class="sls-no" aria-hidden="true">@(st + 1)</span>
                    <span class="sls-name" role="cell" title="@Steps.Name(st)">@Steps.Name(st)@if (Steps.Times(st) > 1) { <small>×@Steps.Times(st)</small> }</span>
                    @if (Live)
                    {
                        @if (flight[st] > 0)
                        {
                            <button type="button" class="sls-col sls-num run @(on && SelectedInFlight ? "on" : "")" role="cell" @onclick="() => OnInFlight.InvokeAsync(st)" @onclick:stopPropagation="true"
                                    title="@Format.Plural(flight[st], "bee is", "bees are") at @Steps.Name(st) right now: show them">@Format.Num(flight[st])</button>
                        }
                        else { <span class="sls-col zero" role="cell">–</span> }
                    }
                    @if (failed[st] > 0)
                    {
                        <button type="button" class="sls-col sls-num bad @(on && !SelectedInFlight ? "on" : "")" role="cell" @onclick="() => OnFailed.InvokeAsync(st)" @onclick:stopPropagation="true"
                                title="@Format.Plural(failed[st], "bee", "bees") failed at @Steps.Name(st): show them">@Format.Num(failed[st])</button>
                    }
                    else { <span class="sls-col zero" role="cell">–</span> }
                </div>
            }
            <div class="sls-row end" role="row">
                <span class="sls-no" aria-hidden="true">✓</span>
                <span class="sls-name" role="cell">Finished all steps</span>
                @if (Live) { <span class="sls-col" role="cell"></span> }
                <span class="sls-col sls-done @(passedAll > 0 ? "" : "zero")" role="cell" title="Bees that went through every step">@(passedAll > 0 ? Format.Num(passedAll) : "–")</span>
            </div>
        </div>
}

@code {
    [Parameter, EditorRequired] public ScenarioSteps Steps { get; set; } = ScenarioSteps.None;
    [Parameter, EditorRequired] public IReadOnlyList<int> FailedPer { get; set; } = [];
    [Parameter] public IReadOnlyList<int>? InFlightPer { get; set; }
    /// <summary>Finished bees of the entry (to count the bees that finished all steps).</summary>
    [Parameter] public int Finished { get; set; }
    /// <summary>The small form on the overview card.</summary>
    [Parameter] public bool Compact { get; set; }
    /// <summary>The step the scenario page filters by, if any.</summary>
    [Parameter] public int? Selected { get; set; }
    [Parameter] public bool SelectedInFlight { get; set; }
    [Parameter] public EventCallback<int> OnFailed { get; set; }
    [Parameter] public EventCallback<int> OnInFlight { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Steps";
    /// <summary>The run is going: show the "Now" column with the bees at each step right now.</summary>
    [Parameter] public bool Live { get; set; }

    private readonly HashSet<int> expanded = [];

    /// <summary>One shown item: a single step, or a run of quiet steps folded into one (<see cref="IsGroup"/>).</summary>
    private readonly record struct Item(int From, int To)
    {
        public bool IsGroup => To > From;
        public int Count => To - From + 1;
    }

    /// <summary>All steps when they fit (<paramref name="max"/>); otherwise runs of two or more quiet steps fold into one item, unless the user opened them.</summary>
    private List<Item> Items(int n, int[] failed, int[] flight, int max)
    {
        var list = new List<Item>(n);
        bool Quiet(int i) => failed[i] == 0 && flight[i] == 0 && Selected != i;
        for (var i = 0; i < n; i++)
        {
            var j = i;
            if (n > max && i > 0 && Quiet(i) && !expanded.Contains(i))
                while (j + 1 < n - 1 && Quiet(j + 1)) j++;
            if (j > i) { list.Add(new Item(i, j)); i = j; }
            else list.Add(new Item(i, i));
        }
        return list;
    }

    private void Expand(int from) => expanded.Add(from);

    private string GroupTitle(Item g) => string.Join(" → ", Enumerable.Range(g.From, g.Count).Select(Steps.Name)) + " (click to show)";

}
