@* The scenario as its own page (brain 0059, 0020, 0017, 0021): three columns. Left: the name, one quiet line and the steps (they steer the rest). Middle: the filter chips,
   one bounded bee chart (a bar per bee, or per time bucket when there are many) and the bee list. Right: the selected bee (BeePanel), always there.
   Also used by the assistant's bee-set dialog (Selection): then there is no left column. *@
@using System.Globalization
@implements IDisposable
@inject LogsLinks Logs
@inject ViewSettings Settings
@inject ScenarioCatalog Catalog
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PhoneState Phone

@{
    var s = Snapshot;
    var view = s.Scenarios[Index];
    var stepsDecl = s.StepsOf(Index);   // the declared steps (brain 0056); none = the scenario looks as before
    var hasSteps = stepsDecl.Any;
    var allBees = s.Store.Bees(Index);
    var bees = FilteredBees(allBees, view.Finished);   // the step filter narrows the finished bees; without one this is the store's list
    var fin = stepFilter is null ? view.Finished : bees.Count;
    curBees = bees;
    var label = s.Labels[Index];
    var actual = s.Elapsed > 0 ? view.Starts / (s.Elapsed / 60) : 0;
    var target = s.Plan.Scenarios[Index].EffectiveRatePerMinute();
    var shape = Format.Shape(s.Plan.Scenarios[Index]);
    IReadOnlyList<RunningBee> runningRaw = s.BeesInFlight is { } rn && Index < rn.Length ? rn[Index] : [];
    var runningAll = StepLogic.FilterRunning(runningRaw, stepFilter, s.Elapsed);
    // Where each bee in flight is (brain 0056): shown quietly as "Step 2 of 4 · Search" wherever such a bee appears.
    var runStep = new Dictionary<int, (int Step, int Rep)>();
    if (hasSteps) foreach (var r in runningRaw) { var ems = Math.Max(0, (s.Elapsed - r.StartedAt) * 1000); runStep[r.Sequence] = (StepLogic.CurrentStep(r, ems), StepLogic.CurrentRep(r, ems)); }
    // The brushed time window (brain 0023, update 3): bees that started in [from, to). A window that reaches the live edge follows it (to = open).
    // The view [vf, vt]: a following window keeps its width and slides with the live edge.
    double vf = 0, vt = 0;
    if (win is { } w0) { var sp0 = w0.To - w0.From; if (w0.Follow) { vt = s.Elapsed; vf = Math.Max(0, vt - sp0); } else { vf = w0.From; vt = w0.To; } }
    var from = win is null ? double.NegativeInfinity : vf;
    var to = win is { Follow: false } ? vt : double.PositiveInfinity;
    IReadOnlyList<RunningBee> runningNow = win is null ? runningAll : runningAll.Where(r => r.StartedAt >= from && r.StartedAt < to).ToList();
    // While the user aims at the chart (brain 0026) the bars of the moment of aiming are shown again; running bars still grow with the clock,
    // and bees that were running at that moment get their final colour in place once they finish.
    ChartData cd;
    if (aiming && fz is not null)
    {
        var resolved = show == BeeShow.All ? BeeBars.ResolveFinished(fz.Bars, fz.Running, bees, fz.Finished, fin, fz.Width, fz.GridFrom) : fz.Bars;
        cd = ReferenceEquals(resolved, fz.Bars) ? fz : fz with { Bars = resolved };
    }
    else
    {
        List<BeeBar> b0; int total0; double width0; double? gridFrom = null; IReadOnlyList<RunningBee> runningBars = runningNow;
        if (win is not null)
        {
            // zoomed: bars on the stable time grid, buffered beyond both edges of the view (the script slides them while panning)
            grid.Ensure(vf, vt, s.Elapsed, Settings.MaxBars);
            width0 = grid.Width; gridFrom = grid.From;
            b0 = BeeBars.BuildGrid(bees, fin, show, width0, grid.First, grid.LastNow(s.Elapsed), vf, vt, out total0);
            var gTo = grid.To;
            runningBars = runningAll.Where(r => r.StartedAt >= gridFrom && r.StartedAt < gTo).ToList();
        }
        else b0 = BeeBars.Build(bees, fin, show, out total0, out width0, from, to, Settings.MaxBars);
        var scale0 = b0.Count == 0 ? 1 : Math.Max(1, b0.Where(b => b.Running == 0).Select(b => b.MaxMs).DefaultIfEmpty(0).Max());
        if (show == BeeShow.All) b0 = BeeBars.WithRunning(b0, runningBars, width0, s.Elapsed, gridFrom);
        if (b0.Count > 0 && scale0 <= 1) scale0 = Math.Max(1, b0.Max(b => b.MaxMs));
        cd = new(b0, scale0, width0, total0, s.Elapsed * 1000, view.Starts, fin, runningBars, gridFrom);
        lastChart = cd;
        if (aiming) fz = cd;
    }
    var bars = cd.Bars; var scale = cd.Scale; var width = cd.Width; var total = cd.Total;
    // As soon as there is room, bursts unfold into single-bee bars (brain 0038, rule of brain 0040: pixels per bee, with hysteresis); the grid stays
    // the one the script knows (cd.Bars), only this list changes, and the unfolded bars share the empty slots they borrow, so x stays linear in time.
    List<BurstSpan> burstSpans = [];
    if (win is null) unfoldPlay.Reset();
    else if (cd.GridFrom is { } gridStart && width > 0)
    {
        var room = UnfoldRoom.For(chartPx, vt - vf, unfoldPlay.Update(vt - vf), width, Settings.MaxBars);
        bars = BeeBars.Unfold(bars, bees, cd.Finished, show, cd.Running, width, BeeBars.SlotIndex(gridStart, width), cd.ElapsedMs / 1000, (vf + vt) / 2,
            BeeBars.UnfoldPerBurst(Settings.MaxBars), BeeBars.UnfoldBudget(Settings.MaxBars), room, out burstSpans);
    }
    var ovMarks = OverviewMarks(bees, fin, s.Elapsed);
    unfoldedSlots = burstSpans.Count == 0 ? [] : burstSpans.ToDictionary(b => b.Slot, b => b.GroupSize);
    var bucketed = width > 0;
    Dictionary<int, string>? failedErrors = null;
    if (view.Failed > 0)
    {
        for (var i = 0; i < fin; i++)
        {
            var fb = bees[i];
            if (!fb.Failed) continue;
            var msg = LastErrorOf(fb, s.Store.Detail(fb.Sequence));
            if (msg is not null) (failedErrors ??= [])[fb.Sequence] = msg;
        }
    }
    var newCount = aiming && win is not { Follow: false } ? Math.Max(0, view.Starts - cd.Starts) : 0;
    var stats = StatsFor(allBees, view.Finished, from, to);   // of the run (or the zoomed time frame), not of the step filter: the chips say what the whole run holds
    var activeBucket = bucketed ? bucket : null;
    var sideRows = SideRows(bees, fin, runningNow, show, from, to, activeBucket, width);
    // Nothing picked yet (or the filter changed): the first bee of the list is the selected one, and stays so (brain 0059). A bee in flight that finishes turns into its record below.
    if (selected is null && selRunning is null && sideRows.Count > 0)
    {
        var first = sideRows[0];
        if (first.IsRunning) { selRunning = first.Sequence; lastSelectedRunning = runningRaw.FirstOrDefault(r => r.Sequence == first.Sequence); autoSeq = first.Sequence; }
        else if (first.Index >= 0 && first.Index < bees.Count) { selected = bees[first.Index]; autoSeq = first.Sequence; }
    }
    var selSeq = selected?.Sequence ?? selRunning;
    // The selected bee stays selected when it is folded into a time bucket: that bucket shows as selected.
    double? selStart = selected?.StartedAt ?? (selRunning is { } rs0 ? runningNow.FirstOrDefault(r => r.Sequence == rs0)?.StartedAt : null);
    var selectedBucket = selStart is { } sa0 && bucketed ? BeeBars.BucketOf(sa0, width) : bucket;
    RunningBee? panelRunning = selRunning is { } rq ? runningRaw.FirstOrDefault(r => r.Sequence == rq) ?? (lastSelectedRunning?.Sequence == rq ? lastSelectedRunning : null) : null;
    var rowSeqs = sideRows.Select(r => r.Sequence).ToList();
    var revealAt = selSeq is { } rsq ? sideRows.FindIndex(r => r.Sequence == rsq) : -1;
    var runBy = runningRaw.Count == 0 ? null : runningRaw.ToDictionary(r => r.Sequence);
    var phone = Phone.IsPhone && !Selection;
    var shownTab = !hasSteps && tab == PhoneTab.Steps ? PhoneTab.Chart : tab;   // a scenario without steps has no Steps tab   // the phone layouts (brain 0059): three tabs, the bee in a bottom sheet
    var selSequence = selSeq;
}

<div class="scn @(Selection ? "scn-set" : "") @(phone ? "scn-phone" : "")" data-tab="@(phone ? shownTab.ToString().ToLowerInvariant() : null)" tabindex="-1" @ref="root" @onkeydown="OnKey" role="presentation">
    @if (phone)
    {
        <div class="scn-tabs" role="tablist" aria-label="Scenario view">
            @if (hasSteps)
            {
                <button type="button" role="tab" class="scn-tab @(shownTab == PhoneTab.Steps ? "on" : "")" aria-selected="@Aria.Bool(shownTab == PhoneTab.Steps)" @onclick="() => SetTab(PhoneTab.Steps)">Steps</button>
            }
            <button type="button" role="tab" class="scn-tab @(shownTab == PhoneTab.Chart ? "on" : "")" aria-selected="@Aria.Bool(shownTab == PhoneTab.Chart)" @onclick="() => SetTab(PhoneTab.Chart)">Chart</button>
            <button type="button" role="tab" class="scn-tab @(shownTab == PhoneTab.Bees ? "on" : "")" aria-selected="@Aria.Bool(shownTab == PhoneTab.Bees)" @onclick="() => SetTab(PhoneTab.Bees)">Bees<span class="n">@Format.Num(sideRows.Count)</span></button>
            <span class="spacer"></span>
            <div class="scn-tools">@ToolButtons</div>
        </div>
    }
    @if (!Selection)
    {
        var dlgActive = s.Running || view.InFlight > 0;
        var okPct = view.Finished > 0 ? Math.Max(0, (view.Finished - view.Failed) * 100.0 / view.Finished) : 100.0;
        var scnTypeName = Index < s.Plan.Scenarios.Count ? Catalog.Find(s.Plan.Scenarios[Index].ScenarioId)?.Name : null;
        var settingsLine = (scnTypeName is not null && !string.Equals(scnTypeName, label, StringComparison.OrdinalIgnoreCase) ? scnTypeName + " · " : "")
            + (shape.Length > 0 ? $"Bursts · {shape}" : $"Linear · {Format.Rate(target)} {Terms.PerMinuteShort}");
        <aside class="scn-left" aria-label="Scenario @label">
            @if (!phone)
            {
                <div class="scn-namerow">
                    <h1 id="scn-title" title="@label">@label</h1>
                    <div class="scn-tools">@ToolButtons</div>
                </div>
            }
            <p class="scn-line" title="@settingsLine">
                @if (dlgActive)
                {
                    <button type="button" class="scn-fig run" @onclick="() => { SetShow(BeeShow.All); GoToBees(); }" title="Show the bees in flight first"><i class="yt-live-dot" aria-hidden="true"></i>@Format.Num(view.InFlight) active</button>
                    <span class="scn-sep" aria-hidden="true">·</span>
                    <span class="tnum">@Format.Time(s.Elapsed)@(s.Plan.DurationSeconds > 0 ? $" / {Format.Time(s.Plan.DurationSeconds)}" : "")</span>
                }
                else
                {
                    <button type="button" class="scn-fig" @onclick="() => { SetShow(BeeShow.All); GoToBees(); }" title="Show all bees">@Format.Plural(view.Finished, "bee", "bees")</button>
                    @if (view.Finished > 0)
                    {
                        <span class="scn-sep" aria-hidden="true">·</span>
                        <span class="tnum">@okPct.ToString("0.0", CultureInfo.InvariantCulture)% ok</span>
                    }
                    @if (stats.Count > 0)
                    {
                        <span class="scn-sep" aria-hidden="true">·</span>
                        <button type="button" class="scn-fig" @onclick="() => SelectIndex(stats.MedianIndex)" title="Open the typical bee">typical @Format.Ms(stats.Median)</button>
                    }
                }
            </p>
            @if (hasSteps)
            {
                var failedPer = s.Store.FailedPerStep(Index);
                var inFlightPer = StepLogic.InFlightCounts(stepsDecl, runningRaw, s.Elapsed);
                <StepTrack Steps="stepsDecl" FailedPer="failedPer" InFlightPer="inFlightPer" Finished="view.Finished" Live="dlgActive"
                           Selected="stepFilter?.Step" SelectedInFlight="@(stepFilter?.InFlight ?? false)"
                           OnFailed="st => { ToggleStepFilter(st, false); GoToBees(); }" OnInFlight="st => { ToggleStepFilter(st, true); GoToBees(); }" AriaLabel="@("Steps of " + label)" />
            }
            else
            {
                <p class="scn-settings">@settingsLine@(dlgActive ? $" · {Format.Rate(actual)} / {Format.Rate(target)}/m" : "")</p>
            }
        </aside>
        @if (!phone)
        {
            <SidebarResizer CssVar="--scn-left" Side="left" Min="180" Max="480" MinMain="320" SidebarSelector=".scn-left" Label="Resize steps sidebar" VarClass="sb-scn-left" />
        }
    }

    <section class="scn-mid" aria-label="Bees of @label">
        <div class="scn-filters" role="group" aria-label="Filter bees">
            <button type="button" class="yt-chip @(show == BeeShow.All && tailMs is null && !HasFilter ? "on" : "")"
                    @onclick="ClearFilters" aria-pressed="@Aria.Bool(show == BeeShow.All && tailMs is null && !HasFilter)"
                    title="Show all bees (@Format.Num(Math.Max(0, view.Finished - view.Failed - view.SlowBees)) ok)">
                <span>All</span>
                <span class="n">@Format.Num(view.Finished)</span>
            </button>
            <button type="button" class="yt-chip bad @(view.Failed == 0 ? "zero" : "") @(show == BeeShow.Failed ? "on" : "")"
                    @onclick="() => SetShow(BeeShow.Failed)" disabled="@(view.Failed == 0)"
                    aria-pressed="@Aria.Bool(show == BeeShow.Failed)" title="Show only failed bees">
                <span>Failed</span>
                <span class="n">@Format.Num(view.Failed)@(stats.Count > 0 && view.Failed > 0 ? $" · {Pc(stats.ErrorRate)}" : "")</span>
            </button>
            <button type="button" class="yt-chip warn @(view.SlowBees == 0 ? "zero" : "") @(show == BeeShow.Slow ? "on" : "")"
                    @onclick="() => SetShow(BeeShow.Slow)" disabled="@(view.SlowBees == 0)"
                    aria-pressed="@Aria.Bool(show == BeeShow.Slow)" title="Show only slow bees">
                <span>Slow</span>
                <span class="n">@Format.Num(view.SlowBees)</span>
            </button>
            <button type="button" class="yt-chip @(stats.TailIsSlow ? "warn" : "") @(tailMs is not null ? "on" : "")"
                    disabled="@(stats.Count == 0)" @onclick="() => TailOnly(stats.P95)"
                    aria-pressed="@Aria.Bool(tailMs is not null)" title="Slowest 5%">
                <span>Slowest 5%</span>
                <span class="n">@(stats.Count > 0 ? Format.Ms(stats.P95) : "—")</span>
            </button>
            @if (Selection)
            {
                <button type="button" class="yt-chip @(stats.LongestIsSlow ? "warn" : "")" disabled="@(stats.Count == 0)" @onclick="() => SelectIndex(stats.LongestIndex)" title="Open the longest bee">
                    <span>Longest</span>
                    <span class="n">@(stats.Count > 0 ? Format.Ms(stats.Longest) : "—")</span>
                </button>
            }
            @if (stepFilter is { } sfc)
            {
                <button type="button" class="chip scn-x" @onclick="() => ToggleStepFilter(sfc.Step, sfc.InFlight)" title="Show all bees again">@(sfc.InFlight ? "in flight in" : "failed at") @stepsDecl.Name(sfc.Step) <i aria-hidden="true">✕</i></button>
            }
            @if (win is { } ws)
            {
                <button type="button" class="chip scn-x" @onclick="ResetZoom" title="Back to the whole run (live)">@Format.Time(ws.From)@(ws.Follow ? " → now" : $" – {Format.Time(ws.To)}") <i aria-hidden="true">✕</i></button>
            }
            @if (groupSel is { } gc)
            {
                <button type="button" class="chip scn-x" @onclick="() => bucket = null" title="Show the whole time frame again">bees #@(gc.Lo + 1)–#@(gc.Hi + 1) <i aria-hidden="true">✕</i></button>
            }
            @if (activeBucket is { } ab)
            {
                <button type="button" class="chip scn-x" @onclick="() => bucket = null" title="Show the whole time frame again">@Format.Time(ab)–@Format.Time(ab + width) <i aria-hidden="true">✕</i></button>
                <button type="button" class="link-btn" @onclick="() => ZoomTo(ab, ab + width)" title="Zoom the chart into this bucket">Zoom in</button>
            }
            <span class="spacer"></span>
            @if (StepCount(view) > 0)
            {
                <span class="scn-step" role="group" aria-label="Step through @StepWord bees">
                    <button type="button" class="link-btn" @onclick="() => StepTo(-1)" title="Previous @StepWord bee in the chart">‹ @StepWord</button>
                    <button type="button" class="link-btn" @onclick="() => StepTo(1)" title="Next @StepWord bee in the chart">@StepWord ›</button>
                </span>
            }
        </div>

        @if (bars.Count == 0)
        {
            <div class="chart-empty muted">@(stepFilter is { } sfe ? $"No bees {(sfe.InFlight ? "in flight in" : "failed at")} the step {stepsDecl.Name(sfe.Step)}." : show == BeeShow.All ? "No bees have started yet." : $"No {StepWord} bees.")</div>
        }
        else
        {
            <div class="chart-wrap">
            <div class="chart-status">
                @if (aiming && newCount >= 0 && win is not { Follow: false })
                {
                    <button class="live-paused" @onclick="Resume" title="Show the newest bees now">● Live paused · @(newCount == 0 ? "no new bees" : Format.Plural(newCount, "new bee", "new bees"))</button>
                }
            </div>
            <div class="chart-scroll">
                <DockZoom @ref="zoom" Select="true" OnPick="PickKey" OnAim="SetAiming" OnSize="SetChartSize" class="@(cd.GridFrom is not null ? "chart dense grid" : bars.Count > 60 ? "chart dense" : "chart")" style="@(cd.GridFrom is not null ? $"--p:{(width / Math.Max(1e-6, vt - vf) * 100).ToString("0.######", CultureInfo.InvariantCulture)}%" : bars.Count > 60 ? null : $"min-width:{bars.Count * 14}px")" data-grid="@(cd.GridFrom is not null ? T(width) : null)" data-buf="@(cd.GridFrom is { } gf ? T(gf) : null)" OnBrush="Brush" OnZoom="PinchZoom" data-zoom="@Settings.Zoom.ToString(CultureInfo.InvariantCulture)" data-zoomed="@(win is not null ? "1" : null)" data-win="@(win is not null ? $"{vf.ToString("R", CultureInfo.InvariantCulture)} {vt.ToString("R", CultureInfo.InvariantCulture)}" : null)" role="group" aria-label="Bees" data-ov="@ovMarks" data-elapsed="@Ms(cd.ElapsedMs)" data-scale="@Ms(scale)">
                    <span class="chart-max">@Format.Ms(scale)</span>
                    <span class="dz-label" aria-hidden="true"></span>
                    <span class="dz-strip" aria-hidden="true"></span>
                    <span class="dz-axis" aria-hidden="true"></span>
                    <span class="dz-brush" aria-hidden="true"><span></span></span>
                    <span class="dz-over" tabindex="@(win is not null ? "0" : null)" role="@(win is not null ? "slider" : null)" aria-label="@(win is not null ? "Part of the run in view" : null)" aria-valuemin="@(win is not null ? "0" : null)" aria-valuemax="@(win is not null ? Ms(s.Elapsed) : null)" aria-valuenow="@(win is not null ? Ms((vf + vt) / 2) : null)" aria-valuetext="@(win is not null ? $"{Format.Time(vf)} to {Format.Time(vt)} of {Format.Time(s.Elapsed)}" : null)" aria-hidden="@(win is null ? "true" : null)" title="@(win is not null ? "The whole run; the outlined window is in view. Drag it or tap the strip to move the view (arrow keys too)." : "The whole run: red and amber marks show where bees failed or were slow. Tap a spot to zoom in there.")"></span>
                    <div class="dz-bars">
                    @foreach (var b in bars)
                    {
                        var bar = b;
                        @if (bar.Total == 0)
                        {
                            <span class="bar-hit empty" data-t0="@T(bar.BucketStart)" data-t1="@T(bar.BucketStart + width)"></span>
                        }
                        else
                        {
                            var on = bar.IsBurstGroup ? groupSel is { } gsel && gsel.Slot == bar.Slot && gsel.Lo == bar.GroupLo && gsel.Hi == bar.GroupHi : bar.InBurst && bar.IsBucket ? bucket == bar.BucketStart : bar.IsBucket ? (selectedBucket is { } sb && sb == bar.BucketStart) : selSeq == bar.Sequence;
                            var key = bar.IsBurstGroup ? $"g{T(bar.Slot)}:{bar.GroupLo}:{bar.GroupHi}" : bar.IsBucket ? "b" + T(bar.BucketStart) : (bar.IsRunningBee ? "r" : "a") + bar.Sequence;
                            <button class="bar-hit @(on ? "on" : "") @(bar.InBurst && bucket == bar.Slot ? "inb" : "")" data-key="@key" data-ub="@(bar.InBurst ? T(bar.Slot) : null)" data-k="@(bar.InBurst ? K(bar.Cover) : null)" style="@(bar.InBurst ? "--k:" + K(bar.Cover) : null)" data-ts="@(bar.InBurst ? T(bar.Slot) : null)" data-te="@(bar.InBurst ? T(bar.Slot + width) : null)" data-l1="@LabelTop(bar, width)" data-l2="@LabelMeta(bar)" data-l3="@(bar.IsRunningBee && runStep.TryGetValue(bar.Sequence, out var rstp) ? stepsDecl.Position(rstp.Step, rstp.Rep) : LabelSub(bar))" data-err="@(!bar.IsBucket && bar.Failed > 0 && failedErrors is not null && failedErrors.TryGetValue(bar.Sequence, out var berr) ? berr : null)" data-s="@Status(bar)" data-ns="@(bar.IsBucket ? null : Status(bar))" data-bad="@(bar.IsBucket ? bar.Failed : null)" data-slow="@(bar.IsBucket ? bar.Slow : null)" data-ok="@(bar.IsBucket ? Math.Max(0, bar.Count - bar.Failed - bar.Slow) : null)" data-runn="@(bar.IsBucket ? bar.Running : null)" data-st="@(IsGroup(bar) ? BeeBars.StripeData(bar) : null)" data-n1="@Near1(bar, width)" data-n2="@Near2(bar)" data-t0="@T(bar.BucketStart)" data-t1="@T(bar.IsBucket ? bar.BucketStart + width : bar.BucketStart + bar.MaxMs / 1000)" data-run="@(bar.IsRunningBee ? "1" : null)" data-bucket="@(bar.IsBucket ? "1" : null)" aria-pressed="@Aria.Bool(on)" title="@BarTitle(bar, width)" aria-label="@BarTitle(bar, width)" @onclick="() => PickBar(bar)">
                                @if (bar.IsRunningBee)
                                {
                                    <i class="bar run" data-start="@Ms(bar.BucketStart * 1000)"></i>
                                }
                                else if (bar.Running > 0)
                                {
                                    <span class="bar-stack @(IsGroup(bar) ? "grp " + BarCls(bar) : null)" style="height:@Pct(bar.MaxMs / scale)%">
                                        <i class="bar run" style="flex:@bar.Running"></i>
                                        @if (bar.Count > 0) { <i class="bar @BarCls(bar) @(IsGroup(bar) ? "grp" : null)" style="flex:@bar.Count"></i> }
                                        @if (IsGroup(bar)) { <b class="grp-n" aria-hidden="true">@Format.Num(bar.Total)</b> }
                                    </span>
                                }
                                else
                                {
                                    <i class="bar @BarCls(bar) @(IsGroup(bar) ? "grp" : null)" style="height:@Pct(bar.MaxMs / scale)%">@if (IsGroup(bar)) { <b class="grp-n" aria-hidden="true">@Format.Num(bar.Total)</b> }</i>
                                }
                            </button>
                        }
                    }
                    @foreach (var bs in burstSpans)
                    {
                        var burst = bs;
                        <button class="burst-tag @(bucket == burst.Slot ? "on" : "")" data-ub="@T(burst.Slot)" title="Burst at @FT(burst.Slot, width): @Format.Plural(burst.Bees, "bee", "bees") started together@(burst.GroupSize > 1 ? ", shown in groups of " + burst.GroupSize : ""). Click to list them." aria-label="Burst at @FT(burst.Slot, width), @Format.Plural(burst.Bees, "bee", "bees"): select them as a group" @onclick="() => PickBar(new BeeBar(0, 0, 0, 0, -1, burst.Slot))">burst · @Format.Plural(burst.Bees, "bee", "bees")</button>
                    }
                    </div>
                </DockZoom>
            </div>
            </div>
            <p class="chart-note muted">
                @if (bucketed) { <text>@Format.Plural(total, "bee", "bees") in time buckets of @FT(width, width); a bar is red or yellow if any bee in it failed or was slow. Click a bar to list its bees.</text> }
                else { <text>One bar per bee, taller = slower. The axis shows the run time of the bees at that position. Click a bee to see its calls.</text> }
                <text> Drag across the chart to zoom (touch: pinch or double tap).</text>
            </p>
        }
        <div class="scn-list" aria-label="Bees in view" @onpointerenter="() => listHover = true" @onpointerleave="() => listHover = false" @onkeydown="OnListKey">
            @if (win is not null || HasFilter || tailMs is not null || show != BeeShow.All)
            {
                <p class="scn-listhead muted">@Format.Plural(sideRows.Count, "bee", "bees") shown</p>
            }
            <BeeSideList Rows="sideRows" SelectedSequence="@selSeq" OnSelect="SelectRow" ResetKey="@sideReset" RevealIndex="@(revealAt >= 0 ? revealAt : null)"
