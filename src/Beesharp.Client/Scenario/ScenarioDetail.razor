    }
    /// <summary>
    /// Previous / next failed (or slow) bee in time order, wrapping around. With grouped bars (brain 0032) it steps to the previous / next group that
    /// holds one and selects the group; when zoomed in and the target is outside the view, the view moves to it (same span, brain 0036).
    /// </summary>
    private void StepTo(int direction)
    {
        var bees = Snapshot.Store.Bees(Index);
        var count = Snapshot.Scenarios[Index].Finished;
        var outcome = StepOutcome;
        var list = new List<BeeRecord>();
        for (var i = 0; i < count; i++) if (bees[i].Outcome == outcome && (stepFilter is not { } sf || sf.Includes(bees[i]))) list.Add(bees[i]);
        if (list.Count == 0) return;
        list.Sort((x, y) => x.StartedAt != y.StartedAt ? x.StartedAt.CompareTo(y.StartedAt) : x.Sequence.CompareTo(y.Sequence));
        var w = lastChart?.Width ?? 0;
        var elapsed = Snapshot.Elapsed;
        double vf = double.NegativeInfinity, vt = double.PositiveInfinity;
        if (win is { } wv) { var sp = wv.To - wv.From; if (wv.Follow) { vt = elapsed; vf = Math.Max(0, vt - sp); } else { vf = wv.From; vt = wv.To; } }

        BeeRecord? FromView() => direction > 0
            ? list.Cast<BeeRecord?>().FirstOrDefault(a => a!.Value.StartedAt >= (double.IsNegativeInfinity(vf) ? 0 : vf))
            : list.Cast<BeeRecord?>().LastOrDefault(a => a!.Value.StartedAt < (double.IsPositiveInfinity(vt) ? double.MaxValue : vt));
        // the key of the current position: a group start (grouped bars) or a bee (start time, sequence)
        // Unfolded bursts (brain 0038) step bee by bee: inside one the key is (slot, sequence + 1), a group bar or the whole burst is (slot, 0).
        BeeRecord? tg = null;
        // brain 0043: a burst in even groups steps group by group (the key is the group number), a burst of single bars bee by bee
        var order = new Dictionary<double, List<int>>();
        if (w > 0 && unfoldedSlots.Count > 0)
        {
            var tmp = new Dictionary<double, List<(double, int)>>();
            void Note(double start, int seq) { var sl = BeeBars.BucketOf(start, w); if (!unfoldedSlots.ContainsKey(sl)) return; if (!tmp.TryGetValue(sl, out var l)) tmp[sl] = l = []; l.Add((start, seq)); }
            for (var i = 0; i < count; i++) Note(bees[i].StartedAt, bees[i].Sequence);
            if (Snapshot.BeesInFlight is { } rn && Index < rn.Length) foreach (var r in rn[Index]) Note(r.StartedAt, r.Sequence);
            foreach (var (sl, l) in tmp) { l.Sort(); order[sl] = l.Select(x => x.Item2).ToList(); }
        }
        long Pos(double sl, int seq)
        {
            if (!order.TryGetValue(sl, out var l)) return 0;
            var r = Math.Max(0, l.IndexOf(seq));
            return unfoldedSlots[sl] > 1 ? r / unfoldedSlots[sl] + 1L : r + 1L;
        }
        (double, long) GKey(BeeRecord a) { var sl = BeeBars.BucketOf(a.StartedAt, w); return (sl, unfoldedSlots.ContainsKey(sl) ? Pos(sl, a.Sequence) : 0L); }
        if (w > 0)
        {
            (double, long)? cur = bucket is { } bk ? (bk, 0L) : groupSel is { } gk ? (gk.Slot, Pos(gk.Slot, gk.Lo)) : selected is { } sa ? GKey(sa) : null;
            if (cur is { } c)
                tg = direction > 0 ? list.Cast<BeeRecord?>().FirstOrDefault(a => GKey(a!.Value).CompareTo(c) > 0) : list.Cast<BeeRecord?>().LastOrDefault(a => GKey(a!.Value).CompareTo(c) < 0);
            else
                tg = FromView();
        }
        else if (selected is { } cs)
        {
            tg = direction > 0 ? list.Cast<BeeRecord?>().FirstOrDefault(a => a!.Value.StartedAt > cs.StartedAt || (a.Value.StartedAt == cs.StartedAt && a.Value.Sequence > cs.Sequence))
                : list.Cast<BeeRecord?>().LastOrDefault(a => a!.Value.StartedAt < cs.StartedAt || (a.Value.StartedAt == cs.StartedAt && a.Value.Sequence < cs.Sequence));
        }
        else tg = FromView();
        var target = tg ?? (direction > 0 ? list[0] : list[^1]);     // wrap around

        double t0 = target.StartedAt, t1 = target.StartedAt;
        if (w > 0) { t0 = BeeBars.BucketOf(target.StartedAt, w); t1 = t0 + w; }
        if (win is not null && (t0 < vf || t1 > vt) && vt - vf > 0)
        {
            var span = vt - vf;
            var from = Math.Clamp((t0 + t1) / 2 - span / 2, 0, Math.Max(0, elapsed - span));
            var to = from + span;
            win = to >= elapsed - 0.02 * span ? new Win(Math.Max(0, elapsed - span), elapsed, true) : new Win(from, to, false);
        }
        tailMs = null; fz = null; selRunning = null;
        if (w > 0 && unfoldedSlots.TryGetValue(t0, out var gsz) && gsz > 1 && order.TryGetValue(t0, out var ord))
        {
            var at = ord.IndexOf(target.Sequence) / gsz * gsz;
            var part = ord.Skip(at).Take(gsz).ToList();
            bucket = null; selected = null;
            groupSel = (t0, part.Min(), part.Max());
        }
        else if (w > 0 && !unfoldedSlots.ContainsKey(t0) && !(win is not null && BeeBars.BucketBees(bees, count, show, t0, w).Count <= 1))
        {
            bucket = t0; selected = null;
        }
        else { bucket = null; selected = target; }
    }

    /// <summary>A bar that stands for several bees (brain 0032): lighter fill, outline and a count badge.</summary>
    private static bool IsGroup(BeeBar b) => b.IsBucket && b.Total > 1;

    private static string BarCls(BeeBar b) => b.Failed > 0 ? "bad" : b.Slow > 0 ? "warn" : BeeOrder.Good(b.Step);
    private static string Cls(BeeOutcome o) => o switch { BeeOutcome.Failed => "bad", BeeOutcome.Slow => "warn", _ => "" };
    private static string Ms(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string Pct(double f) => Math.Clamp(f * 100, 3, 100).ToString("0.#", CultureInfo.InvariantCulture);

    /// <summary>Label inside the hovered bar (brain 0023): bee number or time range, then start time and duration or bee count. Times are run time (m:ss).</summary>
    private static string LabelTop(BeeBar b, double width) => b.IsBurstGroup ? $"B{b.GroupLo + 1}–B{b.GroupHi + 1}" : b.IsBucket ? $"{FT(b.BucketStart, width)}–{FT(b.BucketStart + width, width)}" : $"B{b.Sequence + 1}";

    /// <summary>Run time m:ss, with decimals when the bucket width is below a second (zoomed in far).</summary>
    private static string FT(double seconds, double width)
    {
        if (width >= 1) return Format.Time(seconds);
        var d = width < 0.1 ? 2 : 1;
        var whole = Math.Floor(seconds);
        var frac = (int)Math.Floor((seconds - whole) * (d == 2 ? 100 : 10) + 1e-6);
        return Format.Time(whole) + "." + frac.ToString(d == 2 ? "00" : "0", CultureInfo.InvariantCulture);
    }

    private static string T(double seconds) => seconds.ToString("0.###", CultureInfo.InvariantCulture);
    private static string K(double cover) => cover.ToString("0.######", CultureInfo.InvariantCulture);

    /// <summary>Right-hand figure of the hover label: duration (with the outcome in words, brain 0018), or the bee count of a bucket.</summary>
    private static string LabelMeta(BeeBar b)
    {
        if (b.IsBucket) return Format.Plural(b.Total, "bee", "bees");
        if (b.IsRunningBee) return "active";
        return Format.Ms(b.MaxMs) + (b.Failed > 0 ? " · failed" : b.Slow > 0 ? " · slow" : Format.OverTypical(b.Ratio) ? " · " + Format.Times(b.Ratio) : "");
    }

    private static string LabelSub(BeeBar b)
    {
        if (!b.IsBucket) return $"started {Format.Time(b.BucketStart)}";
        return "";   // buckets show coloured counts instead (data-bad / data-slow / data-ok / data-runn, drawn by dock-magnify.js)
    }

    private static string Status(BeeBar b) => b.Failed > 0 ? "bad" : b.Slow > 0 ? "warn" : b.Running > 0 && b.Count == 0 ? "run" : BeeOrder.Good(b.Step);

    /// <summary>Compact text for the faint labels of the neighbours of the hovered bar.</summary>
    private static string Near1(BeeBar b, double width) => b.IsBurstGroup ? $"B{b.GroupLo + 1}–B{b.GroupHi + 1}" : b.IsBucket ? FT(b.BucketStart, width) : $"B{b.Sequence + 1}";
    private static string Near2(BeeBar b) => b.IsBucket ? Format.Num(b.Total) : b.IsRunningBee ? "…" : b.MaxMs < 1000 ? $"{b.MaxMs:0}ms" : b.MaxMs < 60_000 ? $"{b.MaxMs / 1000:0.0}s" : Format.Time(b.MaxMs / 1000);

    private static string BarTitle(BeeBar b, double width)
    {
        if (b.IsRunningBee) return $"B{b.Sequence + 1}, active, {Format.Ms(b.MaxMs)} so far";
        if (!b.IsBucket) return $"B{b.Sequence + 1}, {Format.Ms(b.MaxMs)}" + (b.Failed > 0 ? ", failed" : b.Slow > 0 ? ", slow" : Format.OverTypical(b.Ratio) ? $", {Format.Times(b.Ratio)} typical" : "");
        var text = b.IsBurstGroup ? $"B{b.GroupLo + 1}–B{b.GroupHi + 1} of the burst at {FT(b.Slot, width)}: {Format.Plural(b.Count, "bee", "bees")}"
            : $"{FT(b.BucketStart, width)} to {FT(b.BucketStart + width, width)}: {Format.Plural(b.Count, "bee", "bees")}";
        if (b.Failed > 0) text += $", {b.Failed} failed";
        if (b.Slow > 0) text += $", {b.Slow} slow";
        else if (Format.OverTypical(b.Ratio)) text += $", the slowest {Format.Times(b.Ratio)} typical";
        if (b.Running > 0) text += $", {b.Running} running";
        return text;
    }

    private static string? LastErrorOf(BeeRecord bee, BeeDetail? detail)
    {
        string? raw = null;
        if (detail is not null)
        {
            for (var i = detail.Logs.Count - 1; i >= 0; i--)
            {
                var log = detail.Logs[i];
                if (log.Level is "Error" or "Critical" or "Fatal")
                {
                    raw = !string.IsNullOrWhiteSpace(log.Message) ? log.Message : log.Exception;
                    if (!string.IsNullOrWhiteSpace(raw)) break;
                }
            }
            if (string.IsNullOrWhiteSpace(raw))
            {
                for (var i = detail.Calls.Count - 1; i >= 0; i--)
                {
                    if (!string.IsNullOrWhiteSpace(detail.Calls[i].Error))
                    {
                        raw = detail.Calls[i].Error;
                        break;
                    }
                }
            }
        }
        if (string.IsNullOrWhiteSpace(raw)) raw = bee.Error;
        if (string.IsNullOrWhiteSpace(raw)) return null;
        var line = raw.Trim();
        var nl = line.IndexOfAny(['\r', '\n']);
        if (nl >= 0) line = line[..nl].Trim();
        return line.Length > 84 ? line[..83] + "…" : line;
    }

    public void Dispose() { Settings.Changed -= OnSettingsChanged; Phone.Changed -= OnPhoneChanged; if (scrollMod is not null) _ = scrollMod.DisposeAsync().AsTask(); }
}
