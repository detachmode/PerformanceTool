@* Compact icon-only clipboard copy button: copies ALL of the logs it stands for (the whole filtered set, not only the rendered lines), user rule, brain 0057.
   Give it the text (GetText) or, when the text has to be fetched first (a stored run's pages), GetTextAsync. Works over plain http too (clipboard.js falls back
   to a hidden textarea when navigator.clipboard is missing). *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<button type="button"
        class="btn ghost small icon-toggle @(copied ? "copy-ok" : failed ? "copy-fail" : "")"
        disabled="@(Disabled || busy)"
        aria-label="@Label"
        title="@Label"
        @onclick="CopyAsync">
    @if (copied)
    {
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12" />
        </svg>
    }
    else if (failed)
    {
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    }
    else
    {
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
    }
</button>

@code {
    /// <summary>The text to copy, when it is at hand.</summary>
    [Parameter] public Func<string>? GetText { get; set; }
    /// <summary>The text to copy, when it first has to be fetched.</summary>
    [Parameter] public Func<Task<string>>? GetTextAsync { get; set; }
    [Parameter] public string Title { get; set; } = "Copy all logs to clipboard";
    [Parameter] public bool Disabled { get; set; }

    private bool copied, failed, busy;
    private CancellationTokenSource? resetCts;
    private IJSObjectReference? module;

    private string Label => busy ? "Copying…" : copied ? "Copied to clipboard" : failed ? "Could not copy" : Title;

    private async Task CopyAsync()
    {
        busy = true;
        failed = false;
        string text;
        try { text = GetTextAsync is not null ? await GetTextAsync() : GetText?.Invoke() ?? ""; }
        catch { busy = false; failed = true; Reset(); return; }
        busy = false;
        if (string.IsNullOrEmpty(text)) return;

        var ok = false;
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./clipboard.js");
            ok = await module.InvokeAsync<bool>("copy", text);
        }
        catch { ok = false; }

        (copied, failed) = (ok, !ok);
        Reset();
    }

    private void Reset()
    {
        StateHasChanged();
        resetCts?.Cancel();
        resetCts?.Dispose();
        resetCts = new CancellationTokenSource();
        _ = ClearLater(resetCts.Token);
    }

    private async Task ClearLater(CancellationToken ct)
    {
        try
        {
            await Task.Delay(1800, ct);
            copied = failed = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        resetCts?.Cancel();
        resetCts?.Dispose();
        if (module is not null) { try { await module.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
}
