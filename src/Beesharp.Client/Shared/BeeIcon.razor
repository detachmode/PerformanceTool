@* Little flying bee icons (F2: two streaks + twin wings + eyes) for inline bee counts: active ("run"), slow ("slow"), failed ("bad"). *@

<span class="bee-ico @Kind @Class" style="--bee-sz:@(Size)px" aria-hidden="true">
    @if (Kind == "bad")
    {
        <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none">
            <g transform="rotate(24 10.4 14.2)">
                <ellipse cx="9.2" cy="9.0" rx="2.7" ry="1.6" transform="rotate(-18 9.2 9.0)" fill="currentColor" opacity="0.28" />
                <ellipse cx="10.4" cy="14.2" rx="5.6" ry="4" fill="currentColor" />
                <path d="M7.8 10.6v7.2M10.5 10.4v7.6" stroke="var(--panel, #1a1612)" stroke-width="1.7" />
                <path d="M12.8 12.6l1.7 1.7m0-1.7l-1.7 1.7" stroke="var(--panel, #1a1612)" stroke-width="1.35" stroke-linecap="round" />
            </g>
            <path d="M16.5 5.2l4.8 4.8M21.3 5.2l-4.8 4.8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
    }
    else if (Kind is "slow" or "warn")
    {
        <svg class="bee-anim-slow-bob" viewBox="0 0 24 24" width="@Size" height="@Size" fill="none">
            <path d="M2.0 13.6h2.2M3.2 16.6h1.5" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" opacity="0.46" />
            <ellipse cx="10.0" cy="9.6" rx="2.5" ry="1.7" transform="rotate(-22 10.0 9.6)" fill="currentColor" opacity="0.34" class="bee-anim-slow-wing" />
            <ellipse cx="12.7" cy="9.6" rx="2.5" ry="1.7" transform="rotate(12 12.7 9.6)" fill="currentColor" opacity="0.52" class="bee-anim-slow-wing" />
            <ellipse cx="12.2" cy="14.7" rx="5.4" ry="3.9" fill="currentColor" />
            <path d="M9.7 11.2v7.0M12.3 11.0v7.4" stroke="var(--panel, #1a1612)" stroke-width="1.7" />
            <path d="M14.3 13.6h2.2" stroke="var(--panel, #1a1612)" stroke-width="1.45" stroke-linecap="round" />
            <circle cx="15.4" cy="14.2" r="0.7" fill="var(--panel, #1a1612)" />
            <circle cx="18.8" cy="6.6" r="3.6" fill="var(--panel, #1a1612)" stroke="currentColor" stroke-width="1.5" />
            <path d="M18.8 4.9v1.8l1.3.9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    }
    else
    {
        <HexBadge Kind="spin" Size="@Size" />
    }
</span>

@code {
    /// <summary>"run" (active), "slow" / "warn", or "bad" (failed).</summary>
    [Parameter] public string Kind { get; set; } = "run";
    [Parameter] public int Size { get; set; } = 17;
    [Parameter] public string? Class { get; set; }
}
