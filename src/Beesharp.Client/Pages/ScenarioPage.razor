@* One scenario as its own page (brain 0059): /scenario/{n} with query parameters for the entry points (?show=failed|slow|slowest, ?failedStep=n, ?nowStep=n, ?bee=n).
   The numbers are the ones the UI shows (scenario 1, step 1, B1). The view (PhoneView) keeps the filter and the picked bee in the address, so a reload or a link comes back to it. *@
@page "/scenario/{Number:int}"
@layout MainLayout
@implements IDisposable
@inject IRunSource Sim
@inject DataModeState DataMode
@inject NavigationManager Nav
@inject IJSRuntime JS

@{
    var s = Sim.Current;
    var index = Number - 1;
    var ok = index >= 0 && index < s.Count;
}
<PageTitle>@(ok ? s.Labels[index] : "Scenario") · Beesharp</PageTitle>

@if (ok)
{
    @* Re-created only for another scenario: the address changes with every filter click and must not reset the chart. *@
    <ScenarioDetail @key="Number" Index="index" Snapshot="s" InitialShow="initial.Show" InitialFailedStep="initial.FailedStep" InitialInFlightStep="initial.NowStep" InitialBee="initial.Bee"
                  Tab="view.Tab" Sheet="view.Sheet" OnTabChanged="TabChanged" OnSheetChanged="SheetChanged" BeeTab="beeTab" OnBeeTabChanged="BeeTabChanged"
                  OnFilterChanged="FilterChanged" />
}
else
{
    <div class="dr-note scn-missing">
        <h1>No scenario @Number</h1>
        <p class="muted">This run has @Format.Plural(s.Count, "scenario", "scenarios").</p>
        <a href="overview">Back to the overview</a>
    </div>
}

@code {
    [Parameter] public int Number { get; set; }

    private ScenarioFilter initial;
    private PhoneView view;
    private BeeTab beeTab;
    private int shownNumber = -1;
    private bool sheetPushed;   // this visit pushed the sheet's history entry, so closing it goes back instead of leaving a stale "sheet=1" behind

    protected override void OnInitialized()
    {
        Sim.Changed += OnChanged; DataMode.Changed += OnChanged;
        Nav.LocationChanged += OnLocation;
        view = ScenarioLink.ParseView(Nav.Uri);
        beeTab = ScenarioLink.ParseBeeTab(Nav.Uri);
    }

    // The phone's tab and bee sheet live in the address (brain 0059): a tab is a history entry, the sheet too (the browser's Back closes it).
    private void TabChanged(PhoneTab tab) => Nav.NavigateTo(ScenarioLink.WithView(Nav.Uri, view with { Tab = tab }));

    private void SheetChanged(bool open)
    {
        if (open) { sheetPushed = true; Nav.NavigateTo(ScenarioLink.WithView(Nav.Uri, view with { Sheet = true })); }
        else if (sheetPushed) { sheetPushed = false; _ = BackAsync(); }
        else Nav.NavigateTo(ScenarioLink.WithView(Nav.Uri, view with { Sheet = false }), new NavigationOptions { ReplaceHistoryEntry = true });
    }

    // The bee column's tab (Steps / Logs / Calls) lives in the address (brain 0069), history entry replaced: a click on a call leaves for /calls, and Back lands on the Calls tab again.
    private void BeeTabChanged(BeeTab tab)
    {
        beeTab = tab;
        var next = ScenarioLink.WithBeeTab(Nav.Uri, tab);
        if (Nav.ToBaseRelativePath(Nav.Uri) != next) Nav.NavigateTo(next, new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private async Task BackAsync()
    {
        try { await JS.InvokeVoidAsync("history.back"); }
        catch (JSException) { }
    }

    private void OnLocation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        view = ScenarioLink.ParseView(e.Location);
        if (ScenarioLink.IndexOf(e.Location) is not null) beeTab = ScenarioLink.ParseBeeTab(e.Location);   // not while leaving for another page (its address has no beeTab)
        if (!view.Sheet) sheetPushed = false;
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    protected override void OnParametersSet()
    {
        // The view starts from the address when the scenario changes (a link, the browser's back and forward), not on every filter click it makes itself.
        if (shownNumber != Number) { shownNumber = Number; initial = ScenarioLink.Parse(Nav.Uri); }
    }

    private void FilterChanged(ScenarioFilter f)
    {
        var next = ScenarioLink.WithFilter(Nav.Uri, f);
        if (Nav.ToBaseRelativePath(Nav.Uri) != next) Nav.NavigateTo(next, new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private void OnChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public void Dispose() { Sim.Changed -= OnChanged; DataMode.Changed -= OnChanged; Nav.LocationChanged -= OnLocation; }
}
