@* Full-screen Serilog-style Live Log Console (/logs): streams logs in real time from currently flying bees. *@
@page "/logs"
@layout MainLayout
@implements IDisposable
@inject ApiRunSource ApiRun
@inject IRunSource Sim
@inject DataModeState DataMode

<PageTitle>Live Logs · Beesharp</PageTitle>

<div class="live-logs-page">
    <div class="script-bar" role="toolbar" aria-label="Live log filters">
        <span class="sl-live-dot @(Sim.IsRunning ? "on" : "")" title="@(Sim.IsRunning ? "Streaming live from flying bees" : "Idle")"></span>
        <div class="seg" role="group" aria-label="Level filter">
            <button type="button" class="@(levelFilter is null ? "on" : "")" @onclick="() => levelFilter = null">All</button>
            <button type="button" class="@(levelFilter == "INF" ? "on" : "")" @onclick='() => levelFilter = "INF"'>INF</button>
            <button type="button" class="@(levelFilter == "WRN" ? "on" : "")" @onclick='() => levelFilter = "WRN"'>WRN</button>
            <button type="button" class="@(levelFilter == "ERR" ? "on" : "")" @onclick='() => levelFilter = "ERR"'>ERR</button>
        </div>
        <input class="sl-search" type="search" placeholder="Filter…" value="@search" @oninput="e => search = e.Value?.ToString() ?? string.Empty" />
        <span class="spacer"></span>
        <span class="muted mono" style="font-size:.74rem">@VisibleCount</span>
        <button type="button" class="btn ghost small @(wrap ? "wrap-on" : "")" @onclick="() => wrap = !wrap" title="Toggle line wrap">Wrap</button>
        <button type="button" class="btn ghost small" @onclick="Clear">Clear</button>
    </div>

    <div class="sl-console @(wrap ? "wrap" : "nowrap")" role="log" aria-live="polite">
        @if (DataMode.IsFakeMode)
        {
            <div class="sl-empty">Switch to <b>Live</b> mode to stream real-time logs from flying bees.</div>
        }
        else if (VisibleLines().Count == 0)
        {
            <div class="sl-empty">@(Sim.IsRunning ? "Waiting for flying bees to emit logs…" : "No live logs yet. Start a run to stream logs from flying bees in real time.")</div>
        }
        else
        {
            @foreach (var item in VisibleLines())
            {
                <SerilogLine @key="item.Id" Timestamp="item.Timestamp" Level="@item.Level" BeeName="@item.BeeName" Message="@item.Message" Exception="@item.Exception" />
            }
        }
    </div>
</div>

@code {
    private readonly List<ClientLiveLogDto> lines = [];
    private long lastId;
    private string? levelFilter;
    private string search = "";
    private bool wrap = true;
    private CancellationTokenSource? pollCts;
    private bool disposed;

    private int VisibleCount => VisibleLines().Count;

    private List<ClientLiveLogDto> VisibleLines()
    {
        if (levelFilter is null && string.IsNullOrWhiteSpace(search)) return lines;
        var q = search.Trim();
        return lines.Where(l =>
        {
            if (levelFilter is not null)
            {
                var tag = l.Level switch { "Trace" => "TRC", "Debug" => "DBG", "Warning" => "WRN", "Error" or "Critical" => "ERR", _ => "INF" };
                if (tag != levelFilter) return false;
            }
            if (q.Length > 0 && !l.Message.Contains(q, StringComparison.OrdinalIgnoreCase) && !l.BeeName.Contains(q, StringComparison.OrdinalIgnoreCase))
                return false;
            return true;
        }).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        Sim.Changed += OnSimChanged;
        DataMode.Changed += OnSimChanged;
        await PullOnceAsync();
        StartPolling();
    }

    private void StartPolling()
    {
        pollCts?.Cancel();
        pollCts?.Dispose();
        pollCts = new CancellationTokenSource();
        var ct = pollCts.Token;
        _ = Task.Run(async () =>
        {
            while (!ct.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(Sim.IsRunning ? 300 : 1200, ct);
                    if (!DataMode.IsFakeMode)
                        await PullOnceAsync(ct);
                }
                catch (OperationCanceledException) { break; }
                catch { }
            }
        }, CancellationToken.None);
    }

    private async Task PullOnceAsync(CancellationToken ct = default)
    {
        if (DataMode.IsFakeMode) return;
        var batch = await ApiRun.FetchLiveLogsAsync(lastId, 500, ct);
        if (batch.Count == 0) return;

        // If server restarted / cleared ids, reset local buffer.
        if (batch[0].Id <= lastId)
        {
            lines.Clear();
            lastId = 0;
        }
        lines.AddRange(batch);
        lastId = batch[^1].Id;
        if (lines.Count > 3000)
            lines.RemoveRange(0, lines.Count - 3000);

        if (!disposed)
            await InvokeAsync(StateHasChanged);
    }

    private void Clear() => lines.Clear();

    private void OnSimChanged()
    {
        if (!disposed)
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (ObjectDisposedException) { }
        }
    }

    public void Dispose()
    {
        disposed = true;
        pollCts?.Cancel();
        pollCts?.Dispose();
        Sim.Changed -= OnSimChanged;
        DataMode.Changed -= OnSimChanged;
    }
}
