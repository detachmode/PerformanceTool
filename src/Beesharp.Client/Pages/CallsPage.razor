    // ---------- the bee side panel and the way back (brain 0069, 0070) ----------

    /// <summary>A bee number (call row, selected call, "Open B…") opens the bee side panel; the page stays as it is. Another bee while it is open replaces the entry, so one Back closes the panel.</summary>
    private void OpenBee(int sequence)
    {
        if (view.OpenBee == sequence) return;
        var wasOpen = view.PanelOpen;
        if (!wasOpen) panelPushed = true;
        view = view with { OpenBee = sequence };
        Nav.NavigateTo(CallsAddress.Href(filter, view), replace: wasOpen);
    }

    private void PanelTabChanged(BeeTab tab)
    {
        if (!view.PanelOpen) return;
        view = view with { Tab = tab };
        Nav.NavigateTo(CallsAddress.Href(filter, view), replace: true);
    }

    /// <summary>✕ or Escape: back in history when this visit opened the panel, otherwise the address loses its panel part (replace).</summary>
    private async Task ClosePanel()
    {
        if (!view.PanelOpen) return;
        if (panelPushed)
        {
            panelPushed = false;
            try { await JS.InvokeVoidAsync("history.back"); }
            catch (JSException) { }
            catch (InvalidOperationException) { }
            return;
        }
        view = view with { OpenBee = null, Tab = BeeTab.Steps };
        Nav.NavigateTo(CallsAddress.Href(filter, view), replace: true);
    }

    private (int Sequence, FakeCall Call)? afterClose;

    /// <summary>A call in the panel's Calls tab was clicked: select it here (its endpoint, the call, enough loaded calls to show it). The panel stays open on desktop; the phone's sheet covers the page, so it closes first.</summary>
    private async Task OpenCallOfBee((int Sequence, FakeCall Call) x)
    {
        if (Phone.IsPhone && panelPushed)
        {
            afterClose = x;
            await ClosePanel();
            return;
        }
        ShowCallOfBee(x);
    }

    private void ShowCallOfBee((int Sequence, FakeCall Call) x)
    {
        var entry = BeeLookup.Find(Sim.Current, x.Sequence)?.Entry;
        var next = filter.WithEndpoint(CallKey.EndpointOf(x.Call));
        if (filter.Entry is not null && entry is { } e && filter.Entry != e) next = next.WithEntry(e);
        phoneTab = "detail";
        minMsText = "";
        view = view with { Call = x.Call.Skipped ? null : CallKey.Of(x.Sequence, x.Call) };
        var chase = view.Call is not null;
        if (next.SameAs(filter))
        {
            chaseCall = chase;
            Nav.NavigateTo(CallsAddress.Href(filter, view), replace: true);
            _ = ReloadDetailAsync();
        }
        else ApplyFilter(next, reloadEndpoints: next.Entry != filter.Entry, chase: chase);
    }

    /// <summary>"‹ B4668 · Checkout": back to where the call was opened. History goes back when that is where this visit came from (the bee's list keeps its place), else the scenario page opens on that bee's Calls tab.</summary>
    private async Task BackToOriginAsync()
    {
        if (view.Origin is not { } o) return;
        if (cameFromHistory && !panelPushed)
        {
            try { await JS.InvokeVoidAsync("history.back"); return; }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }
        Nav.NavigateTo(o.ScenarioHref());
    }

    private Task LoadMoreAsync()
    {
        callLimit += 200;
        return ReloadDetailAsync();
    }

    private void OnChanged()
    {
        if (disposed) return;
        try
        {
            _ = InvokeAsync(async () =>
            {
                var key = CurrentRunKey();
                if (key != runKey)
                {
                    runKey = key;
                    if (filter.Entry is { } ent && Sim.Current.Count > 0 && ent >= Sim.Current.Count)
                        filter = filter.WithEntry(null);
                    await ReloadAllAsync();
                    return;
                }
                if (!UseServer) ScheduleLocalRefresh();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private void ScheduleLocalRefresh()
    {
        if (localScheduled) return;
        var wait = Math.Max(0, 700 - (Environment.TickCount64 - localBuiltAt));
        localScheduled = true;
        _ = Task.Run(async () =>
        {
            await Task.Delay((int)wait);
            try
            {
                await InvokeAsync(async () =>
                {
                    localScheduled = false;
                    if (!UseServer && !disposed)
                    {
                        await ReloadAllAsync();
                        StateHasChanged();
                    }
                });
            }
            catch (ObjectDisposedException) { }
        });
    }

    private async Task LiveRefreshLoopAsync(CancellationToken ct)
    {
        var wasRunning = false;
        var extra = 0;
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(1500, ct);
                var running = Sim.IsRunning;
                if (wasRunning && !running) extra = 2;
                wasRunning = running;
                if (!UseServer || (!running && extra == 0)) continue;
                if (!running) extra--;
                await InvokeAsync(async () =>
                {
                    await ReloadAllAsync(preserveSelection: true);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task ReloadAllAsync(bool preserveSelection = false)
    {
        var g = ++gen;
        if (!UseServer)
        {
            var s = Sim.Current;
            var allCalls = s.Store.AllKeptCalls();
            localBuiltAt = Environment.TickCount64;
            endpoints = CallAnalytics.BuildEndpoints(
                allCalls,
                filter.Entry,
                slowOnly: epFilter == 1,
                failedOnly: epFilter == 2,
                minMs: null,
                search: filter.Search);
            SortEndpoints();
            EnsureSelectedEndpoint();
            if (selectedEndpoint is not null)
            {
                detail = CallAnalytics.BuildEndpointDetail(
                    allCalls,
                    selectedEndpoint,
                    s.Elapsed,
                    filter.Entry,
                    ShowName(filter.Outcome),
                    filter.MinMs,
                    filter.MaxMs,
                    filter.FromSec,
                    filter.ToSec,
                    filter.Sort,
                    0,
                    callLimit);
            }
            else
            {
                detail = null;
            }
            if (SyncSelectedCall(preserveSelection))
            {
                callLimit += 200;
                await ReloadDetailAsync(preserveSelection);
                return;
            }
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!preserveSelection)
        {
            endpoints = new([], 0, 0, 0);
            sortedEndpoints = [];
            detail = null;
            selectedCall = null;
        }
        endpointsLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var res = await ApiRun.QueryCallEndpointsAsync(
                filter.Entry,
                slowOnly: epFilter == 1,
                failedOnly: epFilter == 2,
                minMs: null,
                search: filter.Search);
            if (g != gen || disposed) return;
            endpoints = res ?? new CallEndpointsResult([], 0, 0, 0);
            SortEndpoints();
            EnsureSelectedEndpoint();
        }
        catch { }
        finally { endpointsLoading = false; }

        await ReloadDetailAsync(preserveSelection, g);
    }

    private async Task ReloadDetailAsync(bool preserveSelection = false, int? expectedGen = null)
    {
        var g = expectedGen ?? ++gen;
        if (string.IsNullOrWhiteSpace(selectedEndpoint))
        {
            detail = null;
            selectedCall = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!UseServer)
        {
            var s = Sim.Current;
            var allCalls = s.Store.AllKeptCalls();
            detail = CallAnalytics.BuildEndpointDetail(
                allCalls,
                selectedEndpoint,
                s.Elapsed,
                filter.Entry,
                ShowName(filter.Outcome),
                filter.MinMs,
                filter.MaxMs,
                filter.FromSec,
                filter.ToSec,
                filter.Sort,
                0,
                callLimit);
            if (SyncSelectedCall(preserveSelection))
            {
                callLimit += 200;
                await ReloadDetailAsync(preserveSelection);
                return;
            }
            await InvokeAsync(StateHasChanged);
            return;
        }

        var more = false;
        detailLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var d = await ApiRun.QueryCallEndpointDetailAsync(
                selectedEndpoint,
                filter.Entry,
                ShowName(filter.Outcome),
                filter.MinMs,
                filter.MaxMs,
                filter.FromSec,
                filter.ToSec,
                filter.Sort,
                0,
                callLimit,
                240);
            if (g != gen || disposed) return;
            detail = d;
            more = SyncSelectedCall(preserveSelection);
        }
        catch { }
        finally
        {
            detailLoading = false;
            if (g == gen && !disposed) await InvokeAsync(StateHasChanged);
        }
        if (more && !disposed)
        {
            callLimit += 200;
            await ReloadDetailAsync(preserveSelection);
        }
    }

    private void EnsureSelectedEndpoint()
    {
        if (selectedEndpoint is null) return;
        if (sortedEndpoints.Any(e => string.Equals(e.Endpoint, selectedEndpoint, StringComparison.OrdinalIgnoreCase)))
            return;
        selectedEndpoint = null;
        filter = filter with { Endpoint = null };
    }

    /// <summary>Picks the selected call after the calls were (re)loaded: the one in the address first (brain 0070), else the one that was selected, else the first. Returns true when the call in the
    /// address is not in the loaded calls yet but more can be loaded (the caller loads another page and calls this again), so a call far down the list is found without clicking "Load more".</summary>
    private bool SyncSelectedCall(bool preserveSelection)
    {
        if (detail is null) { selectedCall = null; return false; }
        if (detail.Calls.Count == 0)
        {
            selectedCall = null;
            chaseCall = false;
            WriteCall(null);
            return false;
        }
        CallSampleDto? pick = null;
        if (view.Call is { } want)
        {
            pick = detail.Calls.FirstOrDefault(c => CallKey.Of(c) == want);
            if (pick is null && chaseCall)
            {
                if (detail.Calls.Count < detail.MatchingCalls && callLimit < MaxCallLimit) return true;
                chaseCall = false;
            }
        }
        if (pick is null && preserveSelection && selectedCall is { } prev) pick = detail.Calls.FirstOrDefault(c => c.Id == prev.Id);
        pick ??= detail.Calls[0];
        selectedCall = pick;
        chaseCall = false;
        WriteCall(CallKey.Of(pick));
        return false;
    }

    private void SortEndpoints()
    {
        sortedEndpoints = [.. endpoints.Endpoints];
        switch (epSort)
        {
            case "p95": sortedEndpoints.Sort((a, b) => CompareDesc(b.P95Ms, a.P95Ms, a, b)); break;
            case "p50": sortedEndpoints.Sort((a, b) => CompareDesc(b.TypicalMs, a.TypicalMs, a, b)); break;
            case "max": sortedEndpoints.Sort((a, b) => CompareDesc(b.MaxMs, a.MaxMs, a, b)); break;
            case "count": sortedEndpoints.Sort((a, b) => CompareDesc(b.TotalCount, a.TotalCount, a, b)); break;
            case "failed": sortedEndpoints.Sort((a, b) => CompareDesc(b.FailedCount, a.FailedCount, a, b)); break;
            case "name": sortedEndpoints.Sort((a, b) => string.Compare(a.Endpoint, b.Endpoint, StringComparison.OrdinalIgnoreCase)); break;
            default: break;
        }
    }

    private static int CompareDesc(double bVal, double aVal, CallEndpointSummaryDto a, CallEndpointSummaryDto b)
    {
        var cmp = bVal.CompareTo(aVal);
        if (cmp != 0) return cmp;
        cmp = b.P95Ms.CompareTo(a.P95Ms);
        if (cmp != 0) return cmp;
        return string.Compare(a.Endpoint, b.Endpoint, StringComparison.OrdinalIgnoreCase);
    }

    private double? ScenarioDefaultTargetMs(RunSnapshot s)
    {
        if (filter.Entry is { } entryIdx && entryIdx >= 0 && entryIdx < s.Plan.Scenarios.Count)
            return Catalog.Find(s.Plan.Scenarios[entryIdx].ScenarioId)?.SlowThresholds.Default?.TotalMilliseconds;

        double? shared = null;
        foreach (var entry in s.Plan.Scenarios)
        {
            var def = Catalog.Find(entry.ScenarioId)?.SlowThresholds.Default?.TotalMilliseconds;
            if (def is not > 0) return null;
            if (shared is null) shared = def;
            else if (Math.Abs(shared.Value - def.Value) > 0.01) return null;
        }
        return shared;
    }

    private static string? ShowName(BeeShow s) => s switch
    {
        BeeShow.Slow => "slow",
        BeeShow.Failed => "failed",
        _ => null,
    };

    private static string DisplayPath(CallEndpointSummaryDto ep)
    {
        if (string.IsNullOrEmpty(ep.Method)) return ep.Endpoint;
        var prefix = ep.Method + " ";
        return ep.Endpoint.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)
            ? ep.Endpoint[prefix.Length..]
            : ep.Endpoint;
    }

    private static string MethodCss(string method) => method.ToUpperInvariant() switch
    {
        "GET" => "get",
        "POST" => "post",
        "PUT" or "PATCH" => "put",
        "DELETE" => "del",
        _ => "",
    };

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        gen++;
        Sim.Changed -= OnChanged;
        DataMode.Changed -= OnChanged;
        Phone.Changed -= OnPhoneChanged;
        debounceCts?.Cancel();
        debounceCts?.Dispose();
        liveLoopCts?.Cancel();
        liveLoopCts?.Dispose();
        await Task.CompletedTask;
    }
}
