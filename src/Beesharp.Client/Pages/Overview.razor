@* Unified Overview & Editor (brain 0020, 0024, 0046):
   - View mode (default): shows live/finished run cards, run summary, Run History picker (DuckDB), and opens ScenarioDetailDialog on click.
   - Edit mode (toggled via "Edit"): shows plan settings, presets, scripts, and switches each scenario box into the inline editor card + "Add scenario" tile.
   - Starting a run automatically exits Edit mode so live results are immediately visible. *@
@page "/"
@page "/overview"
@layout MainLayout
@implements IDisposable
@inject IRunSource Sim
@inject DataModeState DataMode
@inject ApiRunSource ApiRun
@inject ScenarioCatalog Catalog
@inject ScriptApiClient ScriptApi
@inject LogsPopupState Logs
@inject NavigationManager Nav

<PageTitle>@(editMode ? "Edit Scenarios" : "Overview") · Beesharp</PageTitle>

@{
    var s = Sim.Current;
    var plan = Sim.Plan;
    var locked = Sim.IsRunning;
    var dirty = Sim.HasUnsavedChanges;
    var state = s.Paused ? "Paused" : s.Running ? "Running" : s.State == FakeRunState.Finished ? "Finished" : "Idle";

    if (selected >= plan.Scenarios.Count) selected = plan.Scenarios.Count - 1;
    if (selected < -1) selected = -1;
    var cfg = editMode && selected >= 0 ? plan.Scenarios[selected] : null;
    var scenario = cfg is null ? null : Catalog.Find(cfg.ScenarioId);
    var planErr = planSnap ??= PlanErrors(plan);
    var cfgErr = cfg is null ? null : ShownErrors(cfg);
    var hasAdvanced = scenario?.Spec.Fields.Any(f => f.Advanced) ?? false;
    var advancedInvalid = cfgErr is not null && scenario is not null
        && scenario.Spec.Fields.Where(f => f.Advanced).Any(f => cfgErr.Fields.Keys.Any(k => k.StartsWith(f.JsonName, StringComparison.Ordinal)));
}

<div class="page @(editMode ? "editor" : "")">
    <section class="preset-bar" aria-label="Scenarios header">
        <div class="preset-title">
            <h1>Scenarios</h1>
            @if (editMode && dirty) { <span class="unsaved" role="status"><i></i>Unsaved</span> }
            else if (savedNote) { <span class="saved" role="status">Saved ✓</span> }
            @if (!editMode)
            {
                <span class="muted">@state · @Format.Num(s.Scenarios.Sum(x => x.Finished)) finished</span>
            }
        </div>
        <div class="preset-actions">
            @if (editMode)
            {
                <button type="button" class="btn @(dirty ? "primary" : "ghost") small" @onclick="ExitEditMode" title="Finish editing and return to Overview">Done</button>
            }
            else
            {
                <button type="button" class="btn ghost small" @onclick="EnterEditMode" disabled="@(locked || (!DataMode.IsFakeMode && ApiRun.IsViewingHistory))"
                        title="@(locked ? "Stop the running test to edit scenarios" : (!DataMode.IsFakeMode && ApiRun.IsViewingHistory) ? "Return to Live mode to edit scenarios" : "Edit scenarios, spawning and parameters")">
                    Edit
                </button>
            }
            <div class="dd">
                <button type="button" class="btn ghost small more-menu-btn @(viewMenuOpen ? "on" : "")"
                        aria-haspopup="menu" aria-expanded="@Aria.Bool(viewMenuOpen)"
                        @onclick="() => viewMenuOpen = !viewMenuOpen" aria-label="More actions" title="Presets and actions">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <circle cx="5" cy="12" r="2" />
                        <circle cx="12" cy="12" r="2" />
                        <circle cx="19" cy="12" r="2" />
                    </svg>
                </button>
                @if (viewMenuOpen)
                {
                    <div class="dd-backdrop" @onclick="() => viewMenuOpen = false"></div>
                    <div class="dd-menu right" role="menu" aria-label="Presets and overview actions">
                        <div class="dd-lbl">Presets</div>
                        <button type="button" class="dd-item" role="menuitem" disabled="@(locked || !dirty)" @onclick="() => { viewMenuOpen = false; Save(); }">
                            Save “@Sim.PresetName”
                        </button>
                        <button type="button" class="dd-item" role="menuitem" disabled="@locked" @onclick="() => { viewMenuOpen = false; OpenSaveAs(); }">
                            Save as new preset…
                        </button>
                        @if (Sim.PresetNames.Count > 0)
                        {
                            <div class="dd-sep" role="separator"></div>
                            <div class="dd-lbl">Load preset</div>
                            @foreach (var p in Sim.PresetNames)
                            {
                                var preset = p;
                                var isCurrent = string.Equals(preset, Sim.PresetName, StringComparison.OrdinalIgnoreCase);
                                <button type="button" class="dd-item" role="menuitem" disabled="@locked" @onclick="() => { viewMenuOpen = false; PickPreset(preset); }">
                                    @(isCurrent ? "✓ " : "")@preset
                                </button>
                            }
                        }
                        @if (!editMode)
                        {
                            <div class="dd-sep" role="separator"></div>
                            <div class="dd-lbl">Run</div>
                            <button type="button" class="dd-item" role="menuitem" @onclick="() => { viewMenuOpen = false; Logs.Show(); }">Run logs popup</button>
                            @if (!DataMode.IsFakeMode && !string.IsNullOrEmpty(ApiRun.CurrentRunId))
                            {
                                <a class="dd-item" role="menuitem" href="@($"api/runs/{Uri.EscapeDataString(ApiRun.CurrentRunId)}/export?format=parquet")" download @onclick="() => viewMenuOpen = false">Export Parquet (.zip)</a>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    @if (pendingLoad is not null)
    {
        <div class="notice" role="alertdialog" aria-label="Discard unsaved changes?">
            <span>Load preset “<b>@pendingLoad</b>” into the scenarios? It replaces the loaded scenarios; your unsaved changes will be lost.</span>
            <button class="btn primary" @onclick="ConfirmLoad">Load preset</button>
            <button class="btn ghost" @onclick="() => pendingLoad = null">Cancel</button>
        </div>
    }
    @if (saveAsOpen)
    {
        <form class="notice" @onsubmit="SaveAs" @onsubmit:preventDefault="true">
            <label for="save-as">Save the scenarios as preset</label>
            <input id="save-as" @bind="saveAsName" @bind:event="oninput" autocomplete="off" />
            <button class="btn primary" type="submit" disabled="@(saveAsName.Trim().Length == 0)">Save</button>
            <button class="btn ghost" type="button" @onclick="() => saveAsOpen = false">Cancel</button>
        </form>
    }

    @{
        var viewingHistory = !DataMode.IsFakeMode && ApiRun.IsViewingHistory;
        var hasPreflight = !DataMode.IsFakeMode && !string.IsNullOrWhiteSpace(plan.PreflightScriptId);
        var activePf = hasPreflight
            ? preflights.FirstOrDefault(p => string.Equals(p.ScriptId, plan.PreflightScriptId, StringComparison.OrdinalIgnoreCase))
            : null;
        var hasShutdown = !string.IsNullOrWhiteSpace(plan.ShutdownScriptId);
        var activeSd = hasShutdown
            ? shutdowns.FirstOrDefault(p => string.Equals(p.ScriptId, plan.ShutdownScriptId, StringComparison.OrdinalIgnoreCase))
            : null;
    }
    @if (viewingHistory)
    {
        var totalFinished = s.Scenarios.Sum(x => x.Finished);
        var totalFailed = s.Scenarios.Sum(x => x.Failed);
        var totalSlow = s.Scenarios.Sum(x => x.SlowBees);
        var totalOk = Math.Max(0, totalFinished - totalFailed - totalSlow);
        <section class="run-launch-card history-info-card" aria-label="Stored run details">
            <div class="history-info-head">
                <div class="history-info-title">
                    <span class="history-tag">HISTORY</span>
                    <b class="mono">@(ApiRun.ActiveStartedUtc?.ToLocalTime().ToString("dd MMM yyyy · HH:mm:ss") ?? "Stored run")</b>
                </div>
                <button type="button" class="btn ghost small" @onclick="ApiRun.ReturnToLive" title="Switch back to Live mode to start a new run">Back to live</button>
            </div>
            <div class="history-info-stats">
                <span class="hi-stat"><small>duration</small> <b>@Format.Time(s.Elapsed)</b></span>
                <span class="hi-stat good"><HexBadge Kind="ok" Size="15" StrokeWidth="7" /> <b>@Format.Num(totalOk)</b> <small>success</small></span>
                <span class="hi-stat @(totalFailed > 0 ? "bad" : "")"><HexBadge Kind="bad" Size="15" StrokeWidth="7" /> <b>@Format.Num(totalFailed)</b> <small>failed</small></span>
                <span class="hi-stat @(totalSlow > 0 ? "warn" : "")"><HexBadge Kind="warn" Size="15" StrokeWidth="7" /> <b>@Format.Num(totalSlow)</b> <small>slow</small></span>
                <span class="hi-stat"><small>logs</small> <b>@Format.Num((int)Math.Min(int.MaxValue, ApiRun.TotalServerLogs))</b></span>
            </div>
        </section>
    }
    else
    {
    <section class="run-launch-card" aria-label="Run and preflight controls">
        <div class="plan-ctrl @(planErr.ContainsKey("dur") ? "is-invalid" : "")">
            <label for="p-dur-range">Duration (s)</label>
            <div class="slider with-input">
                <input id="p-dur-range" type="range" min="10" max="600" step="10" value="@Math.Clamp(plan.DurationSeconds, 10, 600)"
                       aria-label="Duration slider" disabled="@locked"
                       @oninput="e => { SetPlanInt(e, v => plan.DurationSeconds = v); Committed(); }" />
                <input id="p-dur" class="slider-num" type="number" inputmode="numeric" min="1" step="1" value="@plan.DurationSeconds"
                       aria-label="Duration in seconds"
                       @oninput="e => SetPlanInt(e, v => plan.DurationSeconds = v)" @onchange="Committed"
                       disabled="@locked" aria-invalid="@Aria.Bool(planErr.ContainsKey("dur"))" />
            </div>
        </div>
        @foreach (var e in planErr.Values) { <small class="field-error" role="alert">@e</small> }

        @if (preflightPickerOpen)
        {
            var forShutdown = pickerIsShutdown;
            var pickList = forShutdown ? shutdowns : preflights;
            <div class="run-pf-picker">
                <div class="run-pf-picker-head">
                    <b>@(forShutdown ? "Shutdown program" : "Preflight script")</b>
                    <span class="spacer"></span>
                    @if (forShutdown ? hasShutdown : hasPreflight)
                    {
                        <button type="button" class="btn ghost danger small" disabled="@locked" @onclick="RemovePreflight">Remove</button>
                    }
                    <button type="button" class="icon-btn" @onclick="() => preflightPickerOpen = false" aria-label="Close">✕</button>
                </div>
                <ul class="add-menu inline" aria-label="@(forShutdown ? "Available shutdown programs" : "Available preflight scripts")">
                    @foreach (var pf in pickList)
                    {
                        var chosen = pf;
                        <li>
                            <button type="button" @onclick="() => PickPreflight(chosen.ScriptId)">
                                <b>@chosen.FileName</b>
                                <span>@(forShutdown ? "Always runs at the end of the run" : "Runs once before scenarios start")</span>
                            </button>
                        </li>
                    }
                    <li>
                        <button type="button" @onclick='() => Nav.NavigateTo(forShutdown ? "editor?shutdown=new" : "editor?preflight=new")'>
                            <b>@(forShutdown ? "+ Create new shutdown .cs…" : "+ Create new preflight .cs…")</b>
                            <span>Open the C# Script Editor with @(forShutdown ? "a shutdown" : "a preflight") template</span>
                        </button>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <div class="run-pf-row">
                @if (editMode)
                {
                    @if (hasPreflight)
                    {
                        <button type="button" class="run-pf-trigger has-pf" disabled="@locked" @onclick="OpenPreflightPickerAsync" title="Change preflight script">
                            <span class="run-pf-text">
                                <b class="mono">@(activePf?.FileName ?? $"{plan.PreflightScriptId}.cs")</b>
                                <small class="muted">Preflight · tap to change</small>
                            </span>
                        </button>
                        <button type="button" class="run-pf-plus danger" disabled="@locked" @onclick="RemovePreflight" aria-label="Remove preflight" title="Remove preflight">✕</button>
                    }
                    else if (!DataMode.IsFakeMode)
                    {
                        <button type="button" class="run-pf-trigger muted-trigger" disabled="@locked" @onclick="OpenPreflightPickerAsync" title="Attach a preflight script">
                            <span class="run-pf-plus-inline">+</span>
                            <span class="run-pf-text">
                                <span>Add preflight</span>
                                <small class="muted">Optional script before scenarios start</small>
                            </span>
                        </button>
                    }
                }
                else
                {
                    <button type="button" class="run-pf-trigger @(hasPreflight ? "has-pf" : "")"
                            disabled="@(locked || plan.Scenarios.Count == 0)"
                            @onclick="StartRun"
                            title="@(locked ? "Run is in progress" : hasPreflight ? "Run preflight and start scenarios" : "Start load test run")">
                        <span class="run-pf-play" aria-hidden="true">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.2v13.6a.8.8 0 0 0 1.2.7l11-6.8a.8.8 0 0 0 0-1.4l-11-6.8A.8.8 0 0 0 8 5.2z"/></svg>
                        </span>
                        <span class="run-pf-text">
                            @if (hasPreflight)
                            {
                                <b class="mono">@(activePf?.FileName ?? $"{plan.PreflightScriptId}.cs")</b>
                                <small class="muted">@(locked ? "Running…" : "Preflight · tap to run")</small>
                            }
                            else
                            {
                                <b>@(locked ? "Running…" : "Start run")</b>
                            }
                        </span>
                    </button>
                    @if (!DataMode.IsFakeMode && !hasPreflight)
                    {
                        <button type="button" class="run-pf-plus" disabled="@locked" @onclick="OpenPreflightPickerAsync" aria-label="Add preflight program" title="Add preflight program">+</button>
                    }
                }
            </div>
            @if (editMode && (hasShutdown || !DataMode.IsFakeMode))
            {
                <div class="run-pf-row">
                    @if (hasShutdown)
                    {
                        <button type="button" class="run-pf-trigger has-pf" disabled="@locked" @onclick="OpenShutdownPickerAsync" title="Change shutdown program">
                            <span class="run-pf-text">
                                <b class="mono">@(activeSd?.FileName ?? $"{plan.ShutdownScriptId}.cs")</b>
                                <small class="muted">Shutdown · always runs at the end · tap to change</small>
                            </span>
                        </button>
                        <button type="button" class="run-pf-plus danger" disabled="@locked" @onclick="RemoveShutdown" aria-label="Remove shutdown program" title="Remove shutdown program">✕</button>
                    }
                    else
                    {
                        <button type="button" class="run-pf-trigger muted-trigger" disabled="@locked" @onclick="OpenShutdownPickerAsync" title="Attach a shutdown program">
                            <span class="run-pf-plus-inline">+</span>
                            <span class="run-pf-text">
                                <span>Add shutdown</span>
                                <small class="muted">Optional program that always runs at the end</small>
                            </span>
                        </button>
                    }
                </div>
            }
        }
    </section>
    }

    @if (editMode)
    {
        @if (locked) { <div class="notice">A run is in progress. Stop it to edit the plan.</div> }

        <div class="grid ed-grid" aria-label="Edit scenarios">
            @for (var i = 0; i < plan.Scenarios.Count; i++)
            {
                var idx = i;
                var c = plan.Scenarios[idx];
                @if (idx == selected)
                {
                    <section class="card card-expanded selected" @key="c" aria-label="Edit @LabelOf(c)">
                        <div class="detail-head">
                            <span class="card-title">
                                @if (Sim.IsEntryChanged(c)) { <i class="edit-dot" title="Unsaved changes"></i> }
                                <b>@LabelOf(c)</b>
                            </span>
                            @{ var scName = scenario?.Name ?? c.ScenarioId; }
                            @if (!string.Equals(LabelOf(c), scName, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="muted" title="@scenario?.Description">@scName</span>
                            }
                            <span class="spacer"></span>
                            @if (scenario is not null && Catalog.IsCustom(c.ScenarioId))
                            {
                                <button type="button" class="btn ghost small" @onclick='() => Nav.NavigateTo($"editor?script={Uri.EscapeDataString(c.ScenarioId)}")' title="View and edit this scenario's .cs file in the Script Editor">Edit .cs</button>
                            }
                            @if (dirty)
                            {
                                <button type="button" class="btn primary small" @onclick="Save" disabled="@locked" title="Save to preset “@Sim.PresetName”">Save</button>
                            }
                            <button type="button" class="icon-btn" @onclick="() => selected = -1" aria-label="Collapse settings" title="Done">✕</button>
                        </div>
                        @if (scenario is null)
                        {
                            <div class="muted empty">This scenario no longer exists in code.</div>
                        }
                        else
                        {
                            <div class="detail-body">
                                <div class="ed-section ed-schedule" @key="c">
                                    <div class="ed-sec-head">
                                        <span class="ed-sec-title">Scenario &amp; Spawning</span>
                                        <span class="ed-rate-badge" title="Effective spawn rate">@Format.Rate(c.EffectiveRatePerMinute()) @Terms.PerMinuteShort</span>
                                    </div>
                                    <div class="ed-sched-grid">
                                        <div class="field wide">
                                            <label for="entry-label">Label</label>
                                            <input id="entry-label" class="entry-label" value="@c.Label" @oninput="e => { c.Label = e.Value?.ToString() ?? string.Empty; }" disabled="@locked" />
                                        </div>
                                        <div class="ed-spawn-sliders">
                                            <div class="field pattern">
                                                <label id="pattern-label">Spawning</label>
                                                <div class="seg" role="group" aria-labelledby="pattern-label" title="Linear: bees start evenly. Bursts: several bees start at once, now and then.">
                                                    <button type="button" class="@(c.Pattern == SpawningPattern.Linear ? "on" : "")" aria-pressed="@Aria.Bool(c.Pattern == SpawningPattern.Linear)" disabled="@locked" @onclick="() => SetPattern(SpawningPattern.Linear)">Linear</button>
                                                    <button type="button" class="@(c.Pattern == SpawningPattern.Bursts ? "on" : "")" aria-pressed="@Aria.Bool(c.Pattern == SpawningPattern.Bursts)" disabled="@locked" @onclick="() => SetPattern(SpawningPattern.Bursts)">Bursts</button>
                                                </div>
                                            </div>
                                            @if (c.Pattern == SpawningPattern.Bursts)
                                            {
                                                <div class="field wide compact-slider @(cfgErr!.Burst is null ? "" : "is-invalid")">
                                                    <label for="entry-burst-size-range">Bees / burst</label>
                                                    <div class="slider with-input">
                                                        <input id="entry-burst-size-range" type="range" min="1" max="100" step="1" value="@Math.Clamp(c.BeesPerBurst, 1, 100)"
                                                               aria-label="Bees per burst slider" disabled="@locked"
                                                               @oninput="e => { SetBurstSize(e); Committed(); }" />
                                                        <input id="entry-burst-size" class="slider-num" type="number" inputmode="numeric" min="1" step="1" value="@c.BeesPerBurst"
                                                               aria-label="Bees per burst" @oninput="SetBurstSize" @onchange="Committed" disabled="@locked" aria-invalid="@Aria.Bool(cfgErr.Burst is not null)" />
                                                    </div>
                                                </div>
                                                <div class="field wide compact-slider @(cfgErr.BurstRate is null ? "" : "is-invalid")">
                                                    <label for="entry-burst-rate-range">Bursts / min</label>
                                                    <div class="slider with-input">
                                                        <input id="entry-burst-rate-range" type="range" min="1" max="60" step="1" value="@Math.Clamp(c.BurstsPerMinute, 1, 60).ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                               aria-label="Bursts per minute slider" disabled="@locked"
                                                               @oninput="e => { SetBurstRate(e); Committed(); }" />
                                                        <input id="entry-burst-rate" class="slider-num" type="number" inputmode="decimal" min="0.1" step="any" value="@c.BurstsPerMinute"
                                                               aria-label="Bursts per minute" @oninput="SetBurstRate" @onchange="Committed" disabled="@locked" aria-invalid="@Aria.Bool(cfgErr.BurstRate is not null)" />
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="field wide compact-slider @(cfgErr!.Rate is null ? "" : "is-invalid")">
                                                    <label for="entry-rate-range">Bees / min</label>
                                                    <div class="slider with-input">
                                                        <input id="entry-rate-range" type="range" min="1" max="300" step="1" value="@Math.Clamp(c.RatePerMinute, 1, 300).ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                               aria-label="Bees per minute slider" disabled="@locked"
                                                               @oninput="e => { SetRate(e); Committed(); }" />
                                                        <input id="entry-rate" class="slider-num" type="number" inputmode="decimal" min="0.1" step="any" value="@c.RatePerMinute"
                                                               aria-label="Bees per minute" @oninput="SetRate" @onchange="Committed" disabled="@locked" aria-invalid="@Aria.Bool(cfgErr.Rate is not null)" />
                                                    </div>
                                                </div>
                                            }
                                            @{ var maxInf = c.MaxInFlight ?? plan.MaxConcurrency; }
                                            <div class="field wide compact-slider @(cfgErr!.MaxInFlight is null ? "" : "is-invalid")">
                                                <label for="entry-max-inflight-range">Max in-flight</label>
                                                <div class="slider with-input">
                                                    <input id="entry-max-inflight-range" type="range" min="1" max="200" step="1" value="@Math.Clamp(maxInf, 1, 200)"
                                                           aria-label="Max in-flight slider" disabled="@locked"
                                                           @oninput="e => { SetMaxInFlight(e); Committed(); }" />
                                                    <input id="entry-max-inflight" class="slider-num" type="number" inputmode="numeric" min="1" max="1000" step="1" value="@maxInf"
                                                           aria-label="Max in-flight" @oninput="SetMaxInFlight" @onchange="Committed" disabled="@locked" aria-invalid="@Aria.Bool(cfgErr.MaxInFlight is not null)" />
                                                </div>
                                            </div>
                                        </div>
                                        @if (c.Pattern == SpawningPattern.Bursts && (cfgErr!.Burst is not null || cfgErr.BurstRate is not null))
                                        {
                                            <div class="ed-sched-errors">
                                                @if (cfgErr.Burst is not null) { <small class="field-error" role="alert">@cfgErr.Burst</small> }
                                                @if (cfgErr.BurstRate is not null) { <small class="field-error" role="alert">@cfgErr.BurstRate</small> }
                                            </div>
                                        }
                                        else if (c.Pattern != SpawningPattern.Bursts && cfgErr!.Rate is not null)
                                        {
                                            <div class="ed-sched-errors">
                                                <small class="field-error" role="alert">@cfgErr.Rate</small>
                                            </div>
                                        }
                                        @if (cfgErr!.MaxInFlight is not null)
                                        {
                                            <div class="ed-sched-errors">
                                                <small class="field-error" role="alert">@cfgErr.MaxInFlight</small>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (scenario.Spec.Fields.Any(f => !f.Advanced))
                                {
                                    <div class="ed-section ed-params" @key="@((c, "params"))">
                                        <div class="ed-sec-head">
                                            <span class="ed-sec-title">Scenario Parameters</span>
                                            <span class="ed-sec-meta">@scenario.Name</span>
                                        </div>
                                        <div class="form param-grid">
                                            <ParameterEditor Spec="scenario.Spec" Values="c.Parameters" Disabled="locked" IdPrefix="@($"p{selected}")" Errors="cfgErr!.Fields" Show="FieldFilter.Essential" Edited="Edited" Committed="Committed" />
                                        </div>
                                    </div>
                                }
                                @if (hasAdvanced)
                                {
                                    <details class="more" open="@advancedInvalid" @key="@((c, "more"))">
                                        <summary>More options</summary>
                                        <div class="form param-grid">
                                            <ParameterEditor Spec="scenario.Spec" Values="c.Parameters" Disabled="locked" IdPrefix="@($"p{selected}")" Errors="cfgErr!.Fields" Show="FieldFilter.Advanced" Edited="Edited" Committed="Committed" />
                                        </div>
                                    </details>
                                }
                            </div>
                        }
                        <div class="detail-foot">
                            <button type="button" class="btn ghost danger small" @onclick="Remove" disabled="@locked">Remove scenario</button>
                            <span class="spacer"></span>
                            <button type="button" class="btn @(dirty ? "ghost" : "primary") small" @onclick="() => selected = -1">Done</button>
                        </div>
                    </section>
                }
                else
                {
                    <ScenarioCard @key="c" Index="idx" Label="@LabelOf(c)" View="Empty" Bees="NoBees" Target="c.EffectiveRatePerMinute()" Shape="@Format.Shape(c)"
                                  Idle="true" Subtitle="@(Catalog.Find(c.ScenarioId)?.Name ?? c.ScenarioId)" Selectable="true" Selected="false"
                                  Edited="Sim.IsEntryChanged(c)" OnOpen="Select" OnDelete="RemoveAt" ActionsDisabled="locked" />
                }
            }

            @if (addOpen)
            {
                <section class="card card-add-open" aria-label="Add scenario">
                    <div class="detail-head">
                        <b>Add scenario</b>
                        <span class="muted">@plan.Scenarios.Count / @LoadPlan.MaxEntries</span>
                        <span class="spacer"></span>
                        <button type="button" class="icon-btn" @onclick="() => addOpen = false" aria-label="Close">✕</button>
                    </div>
                    <ul class="add-menu inline" aria-label="Scenario types">
                        @foreach (var sc in Catalog.All)
                        {
                            var chosen = sc;
                            <li><button type="button" @onclick="() => Add(chosen)"><b>@chosen.Name</b><span>@chosen.Description</span></button></li>
                        }
                    </ul>
                </section>
            }
            else
            {
                <button class="card card-add" @onclick="ToggleAdd" disabled="@(locked || plan.Scenarios.Count >= LoadPlan.MaxEntries)" aria-haspopup="true" aria-expanded="false">
                    <span class="plus">+</span><span>Add scenario</span><small class="muted">@plan.Scenarios.Count / @LoadPlan.MaxEntries</small>
                </button>
            }
        </div>
    }
    else if (!DataMode.IsFakeMode && !ApiRun.PreflightDismissed && ApiRun.PreflightState is "Running" or "Failed")
    {
        var pfFailed = ApiRun.PreflightState == "Failed";
        <section class="preflight-view @(pfFailed ? "failed" : "running")" aria-label="Preflight output">
            <div class="preflight-head">
                <span class="pf-badge @(pfFailed ? "bad" : "run")">@(pfFailed ? "Preflight failed" : "Running preflight…")</span>
                <b class="mono">@(ApiRun.PreflightScriptName ?? plan.PreflightScriptId ?? "preflight.cs")</b>
                <span class="spacer"></span>
                <CopyButton GetText="@(() => string.Join("\n", ApiRun.PreflightLogs))" Disabled="@(ApiRun.PreflightLogs.Count == 0)" />
                <WrapToggleButton @bind-Wrapped="preflightWrap" />
                @if (pfFailed)
                {
                    @if (!string.IsNullOrWhiteSpace(plan.PreflightScriptId))
                    {
                        <button type="button" class="btn ghost small" @onclick='() => Nav.NavigateTo($"editor?preflight={Uri.EscapeDataString(plan.PreflightScriptId)}")'>Edit script</button>
                    }
                    <button type="button" class="btn primary small" @onclick="ApiRun.DismissPreflight">Clear &amp; back to overview</button>
                }
                else
                {
                    <button type="button" class="btn ghost danger small" @onclick="Sim.Stop">Cancel</button>
                }
            </div>
            @if (pfFailed)
            {
                <div class="preflight-err-banner" role="alert">
                    <b>Scenarios were not started.</b>
                    @if (!string.IsNullOrWhiteSpace(ApiRun.PreflightError))
                    {
                        <span>@ApiRun.PreflightError</span>
                    }
                </div>
            }
            <div class="preflight-console sl-console @(preflightWrap ? "wrap" : "nowrap")" role="log" aria-live="polite">
                @if (ApiRun.PreflightLogs.Count == 0)
                {
                    <div class="muted">Waiting for preflight output…</div>
                }
                else
                {
                    @foreach (var line in ApiRun.PreflightLogs)
                    {
                        <SerilogLine Raw="@line" />
                    }
                }
            </div>
        </section>
    }
    else
    {
        <ShutdownStrip Run="s.Shutdown" ScriptId="@plan.ShutdownScriptId" />
        <div class="grid" aria-label="Scenarios">
            @for (var i = 0; i < s.Count; i++)
            {
                var idx = i;
                <ScenarioCard @key="idx" Index="idx" Label="@s.Labels[idx]" View="s.Scenarios[idx]" Bees="s.Store.Bees(idx)" Running="s.BeesInFlight?[idx]"
                              Target="s.Plan.Scenarios[idx].EffectiveRatePerMinute()" Shape="@Format.Shape(s.Plan.Scenarios[idx])" Elapsed="s.Elapsed" DurationSeconds="s.Plan.DurationSeconds" IsLive="s.Running && !s.Paused"
                              ScenarioType="@(Catalog.Find(s.Plan.Scenarios[idx].ScenarioId)?.Name)"
                              OnOpen="i => { open = i; openFilter = DetailFilter.All; openStep = null; }"
                              OnOpenFiltered="t => { open = t.Index; openFilter = t.Filter; openStep = null; }"
                              OnOpenLogs="i => Logs.Show(entry: i)"
                              OnEdit="EditEntry" ActionsDisabled="@(locked || viewingHistory)"
                              MostFailedStep="StepLogic.MostFailed(s.Store.FailedPerStep(idx))" StepName="@(StepLogic.MostFailed(s.Store.FailedPerStep(idx)) is { } mfs ? s.StepsOf(idx).Name(mfs.Step) : null)"
                              OnOpenStep="t => { open = t.Index; openFilter = DetailFilter.All; openStep = t.Step; }" />
            }
        </div>
    }
</div>

@if (!editMode && open is { } o && o < s.Count)
{
    <ScenarioDetailDialog Index="o" Snapshot="s" InitialShow="openFilter" InitialFailedStep="openStep" OnClose="() => { open = null; openStep = null; }" />
}

@code {
    private sealed record EntryProblems(string? Rate, string? Burst, string? BurstRate, string? MaxInFlight, Dictionary<string, List<string>> Fields)
    {
        public int Count => (Rate is null ? 0 : 1) + (Burst is null ? 0 : 1) + (BurstRate is null ? 0 : 1) + (MaxInFlight is null ? 0 : 1) + Fields.Count;
    }

    private static readonly ScenarioView Empty = new(0, 0, 0, 0, 0, 0);
    private static readonly BeeRecord[] NoBees = [];

    // Overview state
    private int? open;
    private DetailFilter openFilter;
    private int? openStep;
    private bool viewMenuOpen;
    private List<PreflightScriptSummary> preflights = [];
    private List<PreflightScriptSummary> shutdowns = [];
    private bool pickerIsShutdown;

    // Edit mode state
    private bool editMode;
    private bool preflightPickerOpen;
    private bool preflightWrap = true;
    private bool wasRunning;
    private int selected = -1;
    private bool addOpen, saveAsOpen, savedNote;
    private string saveAsName = "";
    private string? pendingLoad;
    private bool disposed;

    // Debounced validation
    private ScenarioRunConfig? snapFor;
    private EntryProblems? snap;
    private Dictionary<string, string>? planSnap;
    private CancellationTokenSource? debounce;

    private string? handledEditUri;

    /// <summary>"?edit=..." opens the plan editor (the assistant's links lead here); each link carries a new value, so it works again after leaving edit mode.</summary>
    protected override void OnParametersSet()
    {
        if (editMode || Sim.IsRunning || Nav.Uri == handledEditUri || !Nav.Uri.Contains("?edit=", StringComparison.Ordinal)) return;
        handledEditUri = Nav.Uri;
        EnterEditMode();
    }

    protected override void OnInitialized()
    {
        wasRunning = Sim.IsRunning;

        Sim.Changed += OnChanged;
        DataMode.Changed += OnChanged;
        Catalog.Changed += OnChanged;
        _ = ScriptApi.SyncCatalogAsync();
        _ = LoadPreflightsAsync();
    }

    private async Task LoadPreflightsAsync()
    {
        preflights = await ScriptApi.ListPreflightsAsync();
        shutdowns = await ScriptApi.ListPreflightsAsync(kind: ScriptApiClient.Shutdowns);
        if (!disposed) await InvokeAsync(StateHasChanged);
    }

    private async Task OpenPreflightPickerAsync()
    {
        pickerIsShutdown = false;
        preflightPickerOpen = true;
        await LoadPreflightsAsync();
    }

    private async Task OpenShutdownPickerAsync()
    {
        pickerIsShutdown = true;
        preflightPickerOpen = true;
        await LoadPreflightsAsync();
    }

    // The picker serves both programs (brain 0052): pickerIsShutdown says which one it is choosing.
    private void PickPreflight(string scriptId)
    {
        if (pickerIsShutdown) Sim.Plan.ShutdownScriptId = scriptId;
        else Sim.Plan.PreflightScriptId = scriptId;
        preflightPickerOpen = false;
        Committed();
        Edited();
    }

    private void RemovePreflight()
    {
        if (pickerIsShutdown) Sim.Plan.ShutdownScriptId = null;
        else Sim.Plan.PreflightScriptId = null;
        preflightPickerOpen = false;
        Committed();
        Edited();
    }

    private void RemoveShutdown()
    {
        Sim.Plan.ShutdownScriptId = null;
        Committed();
        Edited();
    }

    private void StartRun()
    {
        if (Sim.IsRunning || Sim.Plan.Scenarios.Count == 0) return;
        if (editMode) ExitEditMode();
        Sim.Start();
    }

    private void EnterEditMode()
    {
        if (Sim.IsRunning) return;
        viewMenuOpen = false;
        open = null;
        editMode = true;
        selected = -1;
        addOpen = false;
        ResetErrors();
        _ = ScriptApi.SyncCatalogAsync();
    }

    private void ExitEditMode()
    {
        editMode = false;
        selected = -1;
        addOpen = false;
        preflightPickerOpen = false;
        saveAsOpen = false;
        pendingLoad = null;
        ResetErrors();
    }

    // ---------- Editor selection & validation ----------

    private void Select(int i) { selected = i; addOpen = false; ResetErrors(); }

    private void ResetErrors() { snapFor = null; snap = null; planSnap = null; debounce?.Cancel(); }

    private EntryProblems ShownErrors(ScenarioRunConfig c)
    {
        if (!ReferenceEquals(snapFor, c) || snap is null) { snapFor = c; snap = EntryErrors(c); }
        return snap;
    }

    private void Edited()
    {
        debounce?.Cancel();
        debounce = new CancellationTokenSource();
        _ = SnapshotLater(debounce.Token);
    }

    private async Task SnapshotLater(CancellationToken ct)
    {
        try { await Task.Delay(300, ct); } catch (TaskCanceledException) { return; }
        if (disposed || ct.IsCancellationRequested) return;
        snap = null; planSnap = null;
        await InvokeAsync(StateHasChanged);
    }

    private void Committed() { debounce?.Cancel(); snap = null; planSnap = null; }

    private void SetRate(ChangeEventArgs e)
    {
        if (selected < 0) return;
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d))
            Sim.Plan.Scenarios[selected].RatePerMinute = d;
        Edited();
    }

    private void SetPattern(SpawningPattern pattern)
    {
        if (selected < 0) return;
        Sim.Plan.Scenarios[selected].Pattern = pattern;
        Committed();
        Edited();
    }

    private void SetBurstSize(ChangeEventArgs e)
    {
        if (selected < 0) return;
        if (int.TryParse(e.Value?.ToString(), out var v)) Sim.Plan.Scenarios[selected].BeesPerBurst = v;
        Edited();
    }

    private void SetBurstRate(ChangeEventArgs e)
    {
        if (selected < 0) return;
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d))
            Sim.Plan.Scenarios[selected].BurstsPerMinute = d;
        Edited();
    }

    private void SetMaxInFlight(ChangeEventArgs e)
    {
        if (selected < 0) return;
        if (int.TryParse(e.Value?.ToString(), out var v)) Sim.Plan.Scenarios[selected].MaxInFlight = v;
        Edited();
    }

    private void SetPlanInt(ChangeEventArgs e, Action<int> set)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) set(v);
        Edited();
    }

    private void ToggleAdd()
    {
        addOpen = !addOpen;
        if (addOpen) _ = ScriptApi.SyncCatalogAsync();
    }

    private static string LabelOf(ScenarioRunConfig c) => string.IsNullOrWhiteSpace(c.Label) ? c.ScenarioId : c.Label;

    private static Dictionary<string, string> PlanErrors(LoadPlan plan)
    {
        var m = new Dictionary<string, string>();
        if (plan.DurationSeconds < 1) m["dur"] = "Duration must be at least 1 second.";
        return m;
    }

    private EntryProblems EntryErrors(ScenarioRunConfig c)
    {
        string? rate = null, burst = null, burstRate = null, maxInFlight = null;
        if (c.Pattern == SpawningPattern.Bursts)
        {
            if (c.BeesPerBurst is < 1 or > LoadPlan.MaxBeesPerBurst) burst = $"Bees per burst: between 1 and {LoadPlan.MaxBeesPerBurst:N0}.";
            if (c.BurstsPerMinute <= 0 || double.IsNaN(c.BurstsPerMinute)) burstRate = "Bursts per minute: more than 0.";
            else if (c.EffectiveRatePerMinute() > LoadPlan.MaxRatePerMinute) burstRate = $"Together at most {LoadPlan.MaxRatePerMinute:N0} bees per minute.";
        }
        else if (c.RatePerMinute is <= 0 or > LoadPlan.MaxRatePerMinute || double.IsNaN(c.RatePerMinute))
            rate = $"Between 0 and {LoadPlan.MaxRatePerMinute:N0} per minute.";
        if (c.MaxInFlight is < 1 or > 1000)
            maxInFlight = "Max in-flight: between 1 and 1000.";
        var fields = Catalog.Find(c.ScenarioId) is { } sc ? sc.Spec.ValidateByField(c.Parameters) : new Dictionary<string, List<string>>();
        return new(rate, burst, burstRate, maxInFlight, fields);
    }

    private void Add(IScenario scenario)
    {
        Sim.AddEntry(scenario);
        ResetErrors();
        selected = Sim.Plan.Scenarios.Count - 1;
        addOpen = false;
    }

    private void EditEntry(int idx)
    {
        if (Sim.IsRunning || (!DataMode.IsFakeMode && ApiRun.IsViewingHistory)) return;
        EnterEditMode();
        if (idx >= 0 && idx < Sim.Plan.Scenarios.Count) Select(idx);
    }

    private void Remove() => RemoveAt(selected);

    private void RemoveAt(int idx)
    {
        if (Sim.IsRunning || idx < 0 || idx >= Sim.Plan.Scenarios.Count) return;
        Sim.RemoveEntry(idx);
        if (selected == idx) selected = -1;
        else if (selected > idx) selected--;
        ResetErrors();
    }

    private void PickPreset(string name)
    {
        if (editMode && Sim.HasUnsavedChanges) pendingLoad = name;
        else DoLoad(name);
    }

    private void ConfirmLoad()
    {
        var name = pendingLoad;
        pendingLoad = null;
        if (name is not null) DoLoad(name);
    }

    private void DoLoad(string name)
    {
        Sim.LoadPreset(name);
        selected = -1;
        ResetErrors();
        saveAsOpen = false;
    }

    private void Save() { Sim.SavePreset(Sim.PresetName); FlashSaved(); }

    private void OpenSaveAs() { saveAsName = Sim.PresetName; saveAsOpen = true; pendingLoad = null; }

    private void SaveAs()
    {
        if (saveAsName.Trim().Length == 0) return;
        Sim.SavePreset(saveAsName);
        saveAsOpen = false;
        FlashSaved();
    }

    private async void FlashSaved()
    {
        savedNote = true;
        StateHasChanged();
        await Task.Delay(2500);
        if (disposed) return;
        savedNote = false;
        StateHasChanged();
    }

    private void OnChanged()
    {
        if (!wasRunning && Sim.IsRunning && editMode)
            ExitEditMode();
        wasRunning = Sim.IsRunning;

        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        disposed = true;
        debounce?.Cancel();
        Sim.Changed -= OnChanged;
        DataMode.Changed -= OnChanged;
        Catalog.Changed -= OnChanged;
    }
}
