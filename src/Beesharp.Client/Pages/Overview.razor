@* Unified Overview & Editor (brain 0020, 0024, 0046):
   - View mode (default): shows live/finished run cards, run summary, Run History picker (DuckDB), and opens the scenario page (/scenario/n) on click.
   - Edit mode (toggled via "Edit"): shows plan settings, presets, scripts, and switches each scenario box into the inline editor card + "Add scenario" tile.
   - Starting a run automatically exits Edit mode so live results are immediately visible. *@
@page "/overview"
@layout MainLayout
@implements IDisposable
@inject IRunSource Sim
@inject DataModeState DataMode
@inject ApiRunSource ApiRun
@inject ScenarioCatalog Catalog
@inject ScriptApiClient ScriptApi
@inject LogsLinks Logs
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PhoneState Phone

<PageTitle>@(Sim.Current.IsIdlePlan ? Sim.Current.DisplayTitle : "Overview") · Beesharp</PageTitle>

@{
    var s = Sim.Current;
    var plan = Sim.Plan;
    var locked = Sim.IsRunning;
    var isIdlePlan = s.IsIdlePlan;
    var state = s.Paused ? "Paused" : s.Running ? "Running" : s.State == FakeRunState.Finished ? "Finished" : "Idle";

    if (selected >= plan.Scenarios.Count) selected = plan.Scenarios.Count - 1;
    if (selected < PlanSelected) selected = -1;
    var isPlanSelected = isIdlePlan && selected == PlanSelected;
    var cfg = isIdlePlan && selected >= 0 ? plan.Scenarios[selected] : null;
    var scenario = cfg is null ? null : Catalog.Find(cfg.ScenarioId);
    var planErr = planSnap ??= PlanErrors(plan);
    var cfgErr = cfg is null ? null : ShownErrors(cfg);
    var hasAdvanced = scenario?.Spec.Fields.Any(f => f.Advanced) ?? false;
    var advancedInvalid = cfgErr is not null && scenario is not null
        && scenario.Spec.Fields.Where(f => f.Advanced).Any(f => cfgErr.Fields.Keys.Any(k => k.StartsWith(f.JsonName, StringComparison.Ordinal)));
    var totalPlanRate = plan.Scenarios.Sum(x => x.EffectiveRatePerMinute());
    var estTotalBees = (long)Math.Round(totalPlanRate * (plan.DurationSeconds / 60.0));
    var viewingHistory = s.IsHistorical;
    var planTitle = s.DisplayTitle;
    var hasSideSelection = isIdlePlan && (isPlanSelected || cfg is not null);
    var sideOpen = hasSideSelection && !Phone.IsPhone;
}

@* Coming back from a scenario page, the Logs, ...: the overview scrolls to where it was (brain 0059, 0069). *@
<ScrollMemory Key="@(isIdlePlan ? "overview-edit" : "overview")" />

<div class="page @(isIdlePlan ? "editor" : "") @(sideOpen ? "ed-side-open" : "")">
    <section class="preset-bar" aria-label="Scenarios header">
        <div class="preset-title">
            <h1>@planTitle</h1>
            @if (isIdlePlan)
            {
                <span class="pe-plan-summary mono">@plan.Scenarios.Count @(plan.Scenarios.Count == 1 ? "scenario" : "scenarios") · @Format.Rate(totalPlanRate) bees/min · ~@(estTotalBees >= 1000 ? (estTotalBees / 1000.0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "k" : estTotalBees.ToString(System.Globalization.CultureInfo.InvariantCulture)) bees</span>
            }
            else
            {
                <span class="muted">@state · @Format.Num(s.Scenarios.Sum(x => x.Finished)) finished</span>
            }
        </div>
        <div class="preset-actions">
            <div class="dd preset-dd" @onkeydown="OnPresetKey">
                <button type="button" class="preset-pick-btn @(presetMenuOpen ? "on" : "")"
                        aria-haspopup="menu" aria-expanded="@Aria.Bool(presetMenuOpen)"
                        disabled="@locked"
                        title="@(locked ? "Stop the running test to load a preset" : "Load a preset into the current plan")"
                        @onclick="TogglePresetMenu">
                    <span class="preset-pick-name">Load preset</span>
                    <span class="caret" aria-hidden="true">▾</span>
                </button>
                @if (presetMenuOpen)
                {
                    var shownPresets = Sim.PresetNames.Where(n => presetFilter.Length == 0 || n.Contains(presetFilter, StringComparison.OrdinalIgnoreCase)).ToList();
                    <DropMenu Class="right preset-menu" Label="Load preset" OnClose="@(() => presetMenuOpen = false)" Total="Sim.PresetNames.Count"
                              @bind-Filter="presetFilter" FilterPlaceholder="Filter presets…">
                        <Head><div class="dd-lbl">Load preset into plan</div></Head>
                        <ChildContent>
                            @if (Sim.PresetNames.Count == 0)
                            {
                                <div class="muted dd-empty">No presets available.</div>
                            }
                            else if (shownPresets.Count == 0)
                            {
                                <div class="dd-none">No preset matches “@presetFilter”.</div>
                            }
                            @foreach (var p in shownPresets)
                            {
                                var preset = p;
                                <button type="button" class="dd-item" role="menuitem" title="@preset"
                                        disabled="@locked" @onclick="() => { presetMenuOpen = false; DoLoad(preset); }">
                                    <span class="dd-text">@preset</span>
                                </button>
                            }
                        </ChildContent>
                    </DropMenu>
                }
            </div>
            @if (isIdlePlan)
            {
                <div class="dd">
                    <button type="button" class="btn ghost small more-menu-btn @(editMenuOpen ? "on" : "")"
                            aria-haspopup="menu" aria-expanded="@Aria.Bool(editMenuOpen)"
                            @onclick="ToggleEditMenu" aria-label="Plan actions" title="Plan actions">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <circle cx="5" cy="12" r="2.2" />
                            <circle cx="12" cy="12" r="2.2" />
                            <circle cx="19" cy="12" r="2.2" />
                        </svg>
                    </button>
                    @if (editMenuOpen)
                    {
                        <div class="dd-backdrop" @onclick="() => editMenuOpen = false"></div>
                        <div class="dd-menu right" role="menu" aria-label="Plan actions">
                            <div class="dd-lbl">Plan</div>
                            <button type="button" class="dd-item" role="menuitem" disabled="@locked" @onclick="() => { editMenuOpen = false; ToggleAdd(); }">+ Add scenario</button>
                            <button type="button" class="dd-item" role="menuitem" disabled="@locked" @onclick="() => { editMenuOpen = false; SelectPlan(); }">Plan settings</button>
                            <div class="dd-sep" role="separator"></div>
                            <button type="button" class="dd-item" role="menuitem" disabled="@locked" @onclick="() => { editMenuOpen = false; ClearPlan(); }">New Plan</button>
                        </div>
                    }
                </div>
            }
            else
            {
                @if (s.CanEditPlan)
                {
                    <button type="button" class="btn secondary small" @onclick="EnterEditMode"
                            title="Edit scenarios, spawning and parameters">
                        Edit
                    </button>
                }
                <div class="dd">
                    <button type="button" class="btn ghost small more-menu-btn @(viewMenuOpen ? "on" : "")"
                            aria-haspopup="menu" aria-expanded="@Aria.Bool(viewMenuOpen)"
                            @onclick="ToggleViewMenu" aria-label="More actions" title="Run actions">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <circle cx="5" cy="12" r="2.2" />
                            <circle cx="12" cy="12" r="2.2" />
                            <circle cx="19" cy="12" r="2.2" />
                        </svg>
                    </button>
                    @if (viewMenuOpen)
                    {
                        <div class="dd-backdrop" @onclick="() => viewMenuOpen = false"></div>
                        <div class="dd-menu right" role="menu" aria-label="Plan and run actions">
                            @if (s.CanEditPlan)
                            {
                                <div class="dd-lbl">Plan</div>
                                <button type="button" class="dd-item" role="menuitem" @onclick="() => { viewMenuOpen = false; StartNewPlan(); }">New Plan</button>
                                <div class="dd-sep" role="separator"></div>
                            }
                            <div class="dd-lbl">Run</div>
                            <button type="button" class="dd-item" role="menuitem" @onclick="() => { viewMenuOpen = false; Logs.Show(); }">Logs</button>
                            @if (!DataMode.IsFakeMode && !string.IsNullOrEmpty(ApiRun.CurrentRunId))
                            {
                                <a class="dd-item" role="menuitem" href="@($"api/runs/{Uri.EscapeDataString(ApiRun.CurrentRunId)}/export?format=parquet")" download @onclick="() => viewMenuOpen = false">Export Parquet (.zip)</a>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    @if (undoEntries is not null)
    {
        <div class="pe-undo-toast" role="status">
            <span>@undoMessage</span>
            <button type="button" class="btn secondary small pe-undo-btn" @onclick="UndoPlanChange">Undo</button>
            <button type="button" class="icon-btn" @onclick="DismissUndo" aria-label="Dismiss">✕</button>
        </div>
    }

    @{
        var hasPreflight = !DataMode.IsFakeMode && !string.IsNullOrWhiteSpace(plan.PreflightScriptId);
        var activePf = hasPreflight
            ? preflights.FirstOrDefault(p => string.Equals(p.ScriptId, plan.PreflightScriptId, StringComparison.OrdinalIgnoreCase))
            : null;
        var hasShutdown = !string.IsNullOrWhiteSpace(plan.ShutdownScriptId);
        var activeSd = hasShutdown
            ? shutdowns.FirstOrDefault(p => string.Equals(p.ScriptId, plan.ShutdownScriptId, StringComparison.OrdinalIgnoreCase))
            : null;
    }
    @if (viewingHistory)
    {
        var totalFinished = s.Scenarios.Sum(x => x.Finished);
        var totalFailed = s.Scenarios.Sum(x => x.Failed);
        var totalSlow = s.Scenarios.Sum(x => x.SlowBees);
        var totalOk = Math.Max(0, totalFinished - totalFailed - totalSlow);
        <section class="run-launch-card history-info-card" aria-label="Stored run details">
            <div class="history-info-head">
                <div class="history-info-title">
                    <span class="history-tag">HISTORY</span>
                    <b class="mono">@(ApiRun.ActiveStartedUtc?.ToLocalTime().ToString("dd MMM yyyy · HH:mm:ss") ?? "Stored run")</b>
                </div>
                <button type="button" class="btn primary small" @onclick="ApiRun.ReturnToLive" title="Switch back to Live mode to start a new run">Back to live</button>
            </div>
            <div class="history-info-stats">
                <span class="hi-stat"><small>duration</small> <b>@Format.Time(s.Elapsed)</b></span>
                <span class="hi-stat good"><HexBadge Kind="ok" Size="15" StrokeWidth="7" /> <b>@Format.Num(totalOk)</b> <small>success</small></span>
                <span class="hi-stat @(totalFailed > 0 ? "bad" : "")"><HexBadge Kind="bad" Size="15" StrokeWidth="7" /> <b>@Format.Num(totalFailed)</b> <small>failed</small></span>
                <span class="hi-stat @(totalSlow > 0 ? "warn" : "")"><HexBadge Kind="warn" Size="15" StrokeWidth="7" /> <b>@Format.Num(totalSlow)</b> <small>slow</small></span>
                <span class="hi-stat"><small>logs</small> <b>@Format.Num((int)Math.Min(int.MaxValue, ApiRun.TotalServerLogs))</b></span>
            </div>
        </section>
    }
    else   @* the bar stays while a run goes (disabled, "Running…"), so the cards do not move when it starts or ends (brain 0071); the player bar at the bottom holds the run's controls (brain 0027) *@
    {
    <section class="run-launch-card" aria-label="Run and preflight controls">
        <div class="plan-ctrl @(planErr.ContainsKey("dur") ? "is-invalid" : "")">
            <label for="p-dur">Duration</label>
            <DurationSlider Id="p-dur" Seconds="plan.DurationSeconds" Disabled="locked" Invalid='planErr.ContainsKey("dur")'
                            SecondsChanged="v => { plan.DurationSeconds = v; Edited(); }" OnCommit="Committed" />
        </div>
        @foreach (var e in planErr.Values) { <small class="field-error" role="alert">@e</small> }

        @if (preflightPickerOpen)
        {
            var forShutdown = pickerIsShutdown;
            var pickList = forShutdown ? shutdowns : preflights;
            <div class="run-pf-picker">
                <div class="run-pf-picker-head">
                    <b>@(forShutdown ? "Shutdown program" : "Preflight script")</b>
                    <span class="spacer"></span>
                    @if (forShutdown ? hasShutdown : hasPreflight)
                    {
                        <button type="button" class="btn ghost danger small" disabled="@locked" @onclick="RemovePreflight">Remove</button>
                    }
                    <button type="button" class="icon-btn" @onclick="() => preflightPickerOpen = false" aria-label="Close">✕</button>
                </div>
                @if (pickList.Count >= DropMenu.FilterFrom)
                {
                    <div class="pick-filter"><input type="text" placeholder="Filter scripts…" aria-label="Filter scripts" autocomplete="off" spellcheck="false" @bind="pickFilter" @bind:event="oninput" /></div>
                }
                <ul class="add-menu inline scroll" aria-label="@(forShutdown ? "Available shutdown programs" : "Available preflight scripts")">
                    @foreach (var pf in pickList.Where(x => pickFilter.Length == 0 || x.FileName.Contains(pickFilter, StringComparison.OrdinalIgnoreCase)))
                    {
                        var chosen = pf;
                        var isCurrent = string.Equals(chosen.ScriptId, forShutdown ? plan.ShutdownScriptId : plan.PreflightScriptId, StringComparison.OrdinalIgnoreCase);
                        <li>
                            <button type="button" class="@(isCurrent ? "on" : "")" aria-current="@Aria.Bool(isCurrent)" title="@chosen.FileName" @onclick="() => PickPreflight(chosen.ScriptId)">
                                <b>@chosen.FileName</b>
                                <span>@(forShutdown ? "Always runs at the end of the run" : "Runs once before scenarios start")</span>
                            </button>
                        </li>
                    }
                </ul>
                <ul class="add-menu inline pinned" aria-label="Create">
                    <li>
                        <button type="button" @onclick='() => Nav.NavigateTo(forShutdown ? "editor?shutdown=new" : "editor?preflight=new")'>
                            <b>@(forShutdown ? "+ Create new shutdown .cs…" : "+ Create new preflight .cs…")</b>
                            <span>Open the C# Script Editor with @(forShutdown ? "a shutdown" : "a preflight") template</span>
                        </button>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <div class="run-pf-row">
                @if (locked)
                {
                    <button type="button" class="run-pf-trigger is-stop"
                            @onclick="Sim.Stop"
                            title="Stop the running load test">
                        <span class="run-pf-play" aria-hidden="true">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><rect x="4" y="4" width="16" height="16" rx="2.5"/></svg>
                        </span>
                        <span class="run-pf-text"><b>Stop run</b></span>
                    </button>
                }
                else
                {
                    <button type="button" class="run-pf-trigger"
                            disabled="@(plan.Scenarios.Count == 0)"
                            @onclick="StartRun"
                            title="@(hasPreflight ? "Run the preflight, then start the scenarios" : "Start load test run")">
                        <span class="run-pf-play" aria-hidden="true">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.2v13.6a.8.8 0 0 0 1.2.7l11-6.8a.8.8 0 0 0 0-1.4l-11-6.8A.8.8 0 0 0 8 5.2z"/></svg>
                        </span>
                        <span class="run-pf-text"><b>Start run</b></span>
                    </button>
                }
                @if (!isIdlePlan)
                {
                    <button type="button" class="pe-plan-pill run-plan-btn" disabled="@s.IsPlanReadOnly" @onclick="OpenPlanSettings"
                            title="Configure plan limits, preflight and shutdown">
                        <span>Plan settings</span>
                    </button>
                }
            </div>
            @if (isIdlePlan)
            {
                <div class="pe-plan-chips">
                    <button type="button" class="pe-plan-pill @(isPlanSelected ? "active" : "")" disabled="@locked" @onclick="SelectPlan" title="Configure plan-wide max in-flight limit">
                        <span>Max in-flight</span>
                        <b>@(plan.MaxConcurrency > 0 ? plan.MaxConcurrency.ToString(System.Globalization.CultureInfo.InvariantCulture) : "Unlimited")</b>
                    </button>
                    @if (!DataMode.IsFakeMode)
                    {
                        <button type="button" class="pe-plan-pill @(isPlanSelected ? "active" : "")" disabled="@locked" @onclick="SelectPlan" title="Configure preflight script">
                            <span>Preflight</span>
                            <b>@(hasPreflight ? (activePf?.FileName ?? $"{plan.PreflightScriptId}.cs") : "none")</b>
                        </button>
                        <button type="button" class="pe-plan-pill @(isPlanSelected ? "active" : "")" disabled="@locked" @onclick="SelectPlan" title="Configure shutdown program">
                            <span>Shutdown</span>
                            <b>@(hasShutdown ? (activeSd?.FileName ?? $"{plan.ShutdownScriptId}.cs") : "none")</b>
                        </button>
                    }
                    <button type="button" class="pe-plan-pill @(isPlanSelected ? "active" : "")" disabled="@locked" @onclick="SelectPlan" title="Edit plan limits and lifecycle scripts">
                        <span>Plan settings</span>
                    </button>
                </div>
            }
        }
    </section>
    }

    @{
        RenderFragment planSettingsPanel = @<div class="ed-panel-in">
            <div class="pe-insp-head">
                <div class="pe-insp-titles">
                    <div class="pe-kicker">PLAN CONFIGURATION</div>
                    <h2>Plan &amp; Lifecycle</h2>
                    <div class="pe-sub">Duration, concurrency cap &amp; lifecycle hooks</div>
                </div>
                <button type="button" class="icon-btn" @onclick="() => selected = -1" aria-label="Close panel" title="Close panel">✕</button>
            </div>
            <div class="detail-body pe-insp-body">
                <div class="pe-sec-head"><span>Run Limits</span></div>
                <div class="pe-param-list">
                    <div class="pe-row">
                        <label class="pe-lbl" for="plan-dur-side">Duration</label>
                        <div class="pe-ctl">
                            <DurationSlider Id="plan-dur-side" Seconds="plan.DurationSeconds" Disabled="locked" Invalid='planErr.ContainsKey("dur")'
                                            SecondsChanged="v => { plan.DurationSeconds = v; Edited(); }" OnCommit="Committed" />
                        </div>
                    </div>
                    <div class="pe-row">
                        <label class="pe-lbl" for="plan-cap-toggle">Max in-flight</label>
                        <div class="pe-ctl">
                            <button id="plan-cap-toggle" type="button" role="switch" aria-checked="@Aria.Bool(plan.MaxConcurrency > 0)"
                                    class="toggle @(plan.MaxConcurrency > 0 ? "on" : "")" disabled="@locked" @onclick="TogglePlanMaxInFlight">
                                <span class="knob"></span>
                            </button>
                            <span class="muted mono pe-toggle-lbl">@(plan.MaxConcurrency > 0 ? $"Limit: {plan.MaxConcurrency}" : "No restriction")</span>
                        </div>
                    </div>
                    @if (plan.MaxConcurrency > 0)
                    {
                        <div class="pe-row">
                            <label class="pe-lbl" for="plan-cap-num">Max bees</label>
                            <div class="pe-ctl">
                                <div class="slider with-input pe-slider">
                                    <input id="plan-cap-range" type="range" min="1" max="1000" step="1" value="@Math.Clamp(plan.MaxConcurrency, 1, 1000)"
                                           aria-label="Plan max in-flight slider" disabled="@locked"
                                           @oninput="e => { SetPlanMaxInFlight(e); Committed(); }" />
                                    <input id="plan-cap-num" class="slider-num" type="number" inputmode="numeric" min="1" max="1000" step="1" value="@plan.MaxConcurrency"
                                           aria-label="Plan max in-flight" @oninput="SetPlanMaxInFlight" @onchange="Committed" disabled="@locked" />
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (!DataMode.IsFakeMode)
                {
                    <div class="pe-sec-head"><span>Lifecycle Programs</span></div>
                    <div class="pe-param-list">
                        <div class="pe-row">
                            <label class="pe-lbl" for="plan-pf-sel">Preflight (.cs)</label>
                            <div class="pe-ctl">
                                <select id="plan-pf-sel" value="@(plan.PreflightScriptId ?? "")" disabled="@locked"
                                        @onchange="e => { plan.PreflightScriptId = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value.ToString(); Committed(); Edited(); }">
                                    <option value="">none</option>
                                    @foreach (var pf in preflights)
                                    {
                                        <option value="@pf.ScriptId">@pf.FileName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="pe-row">
                            <label class="pe-lbl" for="plan-sd-sel">Shutdown (.cs)</label>
                            <div class="pe-ctl">
                                <select id="plan-sd-sel" value="@(plan.ShutdownScriptId ?? "")" disabled="@locked"
                                        @onchange="e => { plan.ShutdownScriptId = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value.ToString(); Committed(); Edited(); }">
                                    <option value="">none</option>
                                    @foreach (var sd in shutdowns)
                                    {
                                        <option value="@sd.ScriptId">@sd.FileName</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>;

        RenderFragment editorPanel = @<div class="ed-panel-in">
            @{ var c = cfg!; var scName = scenario?.Name ?? c.ScenarioId; }
                        <div class="pe-insp-head">
                            <div class="pe-insp-titles">
                                <div class="pe-kicker">@c.ScenarioId</div>
                                <h2 title="@LabelOf(c)">@LabelOf(c)</h2>
                                @if (!string.Equals(LabelOf(c), scName, StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="pe-sub" title="@scName">@scName</div>
                                }
                            </div>
                            @if (scenario is RemoteSchemaScenario { ScriptId: not null })
                            {
                                var runQs = !DataMode.IsFakeMode && !string.IsNullOrEmpty(ApiRun.CurrentRunId) ? $"&run={Uri.EscapeDataString(ApiRun.CurrentRunId)}" : "";
                                <button type="button" class="btn ghost small" @onclick='() => Nav.NavigateTo($"editor?script={Uri.EscapeDataString(c.ScenarioId)}{runQs}")' title="View and edit this scenario's .cs file in the Script Editor">Edit .cs</button>
                            }
                            else if (scenario is not null && !DataMode.IsFakeMode)
                            {
                                var runQs = !string.IsNullOrEmpty(ApiRun.CurrentRunId) ? $"&run={Uri.EscapeDataString(ApiRun.CurrentRunId)}" : "";
                                <button type="button" class="btn ghost small" @onclick='() => Nav.NavigateTo($"editor?scenario={Uri.EscapeDataString(c.ScenarioId)}{runQs}")' title="Inspect this compiled scenario's C# code in the Editor">View C#</button>
                            }
                            <button type="button" class="icon-btn danger" @onclick="Remove" disabled="@locked" aria-label="Remove scenario" title="Remove scenario">
                                <svg class="yt-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12"/><path d="M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"/></svg>
                            </button>
                            <button type="button" class="icon-btn" @onclick="() => selected = -1" aria-label="Close panel" title="Close panel">✕</button>
                        </div>
                        @if (scenario is null)
                        {
                            <div class="muted empty">This scenario no longer exists in code.</div>
                        }
                        else
                        {
                            <div class="detail-body pe-insp-body" @key="c">
                                @if (!string.IsNullOrWhiteSpace(scenario.Description))
                                {
                                    <p class="pe-insp-desc" title="@scenario.Description">@scenario.Description</p>
                                }
                                <div class="pe-sec-head">
                                    <span>Identity &amp; Spawning</span>
                                    <span class="mono pe-sec-rate">@Format.Rate(c.EffectiveRatePerMinute()) @Terms.PerMinuteShort</span>
                                </div>
                                <div class="pe-param-list">
                                    <div class="pe-row">
                                        <label class="pe-lbl" for="entry-label">Entry label</label>
                                        <div class="pe-ctl">
                                            <input id="entry-label" class="entry-label" value="@c.Label" @oninput="e => { c.Label = e.Value?.ToString() ?? string.Empty; Edited(); }" disabled="@locked" />
                                        </div>
                                    </div>
                                    <div class="pe-row">
                                        <label class="pe-lbl" id="pattern-label">Pattern</label>
                                        <div class="pe-ctl">
                                            <div class="seg" role="group" aria-labelledby="pattern-label" title="Linear: bees start evenly. Bursts: several bees start at once, now and then.">
                                                <button type="button" class="@(c.Pattern == SpawningPattern.Linear ? "on" : "")" aria-pressed="@Aria.Bool(c.Pattern == SpawningPattern.Linear)" disabled="@locked" @onclick="() => SetPattern(SpawningPattern.Linear)">Linear</button>
                                                <button type="button" class="@(c.Pattern == SpawningPattern.Bursts ? "on" : "")" aria-pressed="@Aria.Bool(c.Pattern == SpawningPattern.Bursts)" disabled="@locked" @onclick="() => SetPattern(SpawningPattern.Bursts)">Bursts</button>
                                            </div>
                                        </div>
                                    </div>
                                    @if (c.Pattern == SpawningPattern.Bursts)
                                    {
                                        <div class="pe-row @(cfgErr!.Burst is null ? "" : "is-invalid")">
                                            <label class="pe-lbl" for="entry-burst-size">Bees / burst</label>
                                            <div class="pe-ctl">
                                                <div class="slider with-input pe-slider">
                                                    <input id="entry-burst-size-range" type="range" min="1" max="100" step="1" value="@Math.Clamp(c.BeesPerBurst, 1, 100)"
                                                           aria-label="Bees per burst slider" disabled="@locked"
                                                           @oninput="e => { SetBurstSize(e); Committed(); }" />
                                                    <input id="entry-burst-size" class="slider-num" type="number" inputmode="numeric" min="1" step="1" value="@c.BeesPerBurst"
                                                           aria-label="Bees per burst" @oninput="SetBurstSize" @onchange="Committed" disabled="@locked" aria-invalid="@Aria.Bool(cfgErr.Burst is not null)" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="pe-row @(cfgErr.BurstRate is null ? "" : "is-invalid")">
                                            <label class="pe-lbl" for="entry-burst-rate">Bursts / min</label>
                                            <div class="pe-ctl">
                                                <div class="slider with-input pe-slider">
                                                    <input id="entry-burst-rate-range" type="range" min="1" max="60" step="1" value="@Math.Clamp(c.BurstsPerMinute, 1, 60).ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                           aria-label="Bursts per minute slider" disabled="@locked"
                                                           @oninput="e => { SetBurstRate(e); Committed(); }" />
                                                    <input id="entry-burst-rate" class="slider-num" type="number" inputmode="decimal" min="0.1" step="any" value="@c.BurstsPerMinute"
                                                           aria-label="Bursts per minute" @oninput="SetBurstRate" @onchange="Committed" disabled="@locked" aria-invalid="@Aria.Bool(cfgErr.BurstRate is not null)" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pe-row @(cfgErr!.Rate is null ? "" : "is-invalid")">
                                            <label class="pe-lbl" for="entry-rate">Bees / min</label>
                                            <div class="pe-ctl">
                                                <div class="slider with-input pe-slider">
                                                    <input id="entry-rate-range" type="range" min="1" max="300" step="1" value="@Math.Clamp(c.RatePerMinute, 1, 300).ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                           aria-label="Bees per minute slider" disabled="@locked"
                                                           @oninput="e => { SetRate(e); Committed(); }" />
                                                    <input id="entry-rate" class="slider-num" type="number" inputmode="decimal" min="0.1" step="any" value="@c.RatePerMinute"
                                                           aria-label="Bees per minute" @oninput="SetRate" @onchange="Committed" disabled="@locked" aria-invalid="@Aria.Bool(cfgErr.Rate is not null)" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    <div class="pe-row">
                                        <label class="pe-lbl" for="entry-cap-toggle">Max in-flight</label>
                                        <div class="pe-ctl">
                                            <button id="entry-cap-toggle" type="button" role="switch" aria-checked="@Aria.Bool(c.MaxInFlight is > 0)"
                                                    class="toggle @(c.MaxInFlight is > 0 ? "on" : "")" disabled="@locked" @onclick="ToggleEntryMaxInFlight">
                                                <span class="knob"></span>
                                            </button>
                                            <span class="muted mono pe-toggle-lbl">@(c.MaxInFlight is > 0 ? $"Limit: {c.MaxInFlight}" : (plan.MaxConcurrency > 0 ? $"Plan cap ({plan.MaxConcurrency})" : "No restriction"))</span>
                                        </div>
                                    </div>
                                    @if (c.MaxInFlight is > 0)
                                    {
                                        <div class="pe-row @(cfgErr!.MaxInFlight is null ? "" : "is-invalid")">
                                            <label class="pe-lbl" for="entry-max-inflight">Max bees</label>
                                            <div class="pe-ctl">
                                                <div class="slider with-input pe-slider">
                                                    <input id="entry-max-inflight-range" type="range" min="1" max="500" step="1" value="@Math.Clamp(c.MaxInFlight.Value, 1, 500)"
                                                           aria-label="Max in-flight slider" disabled="@locked"
                                                           @oninput="e => { SetMaxInFlight(e); Committed(); }" />
                                                    <input id="entry-max-inflight" class="slider-num" type="number" inputmode="numeric" min="1" max="1000" step="1" value="@c.MaxInFlight.Value"
                                                           aria-label="Max in-flight" @oninput="SetMaxInFlight" @onchange="Committed" disabled="@locked" aria-invalid="@Aria.Bool(cfgErr.MaxInFlight is not null)" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                @if (c.Pattern == SpawningPattern.Bursts && (cfgErr!.Burst is not null || cfgErr.BurstRate is not null))
                                {
                                    <div class="ed-sched-errors">
                                        @if (cfgErr.Burst is not null) { <small class="field-error" role="alert">@cfgErr.Burst</small> }
                                        @if (cfgErr.BurstRate is not null) { <small class="field-error" role="alert">@cfgErr.BurstRate</small> }
                                    </div>
                                }
                                else if (c.Pattern != SpawningPattern.Bursts && cfgErr!.Rate is not null)
                                {
                                    <div class="ed-sched-errors">
                                        <small class="field-error" role="alert">@cfgErr.Rate</small>
                                    </div>
                                }
                                @if (cfgErr!.MaxInFlight is not null)
                                {
                                    <div class="ed-sched-errors">
                                        <small class="field-error" role="alert">@cfgErr.MaxInFlight</small>
                                    </div>
                                }

                                @if (scenario.Spec.Fields.Any(f => !f.Advanced))
                                {
                                    <div class="pe-sec-head" @key="@((c, "params"))">
                                        <span>Scenario Parameters</span>
                                        <span class="mono">@scenario.Name</span>
                                    </div>
                                    <div class="form param-grid pe-flat-params">
                                        <ParameterEditor Spec="scenario.Spec" Values="c.Parameters" Disabled="locked" IdPrefix="@($"p{selected}")" Errors="cfgErr!.Fields" Show="FieldFilter.Essential" Edited="Edited" Committed="Committed" />
                                    </div>
                                }
                                @if (hasAdvanced)
                                {
                                    <details class="more" open="@advancedInvalid" @key="@((c, "more"))">
                                        <summary>More options</summary>
                                        <div class="form param-grid pe-flat-params">
                                            <ParameterEditor Spec="scenario.Spec" Values="c.Parameters" Disabled="locked" IdPrefix="@($"p{selected}")" Errors="cfgErr!.Fields" Show="FieldFilter.Advanced" Edited="Edited" Committed="Committed" />
                                        </div>
                                    </details>
                                }
                            </div>
                        }
        </div>;
    }

    @if (isIdlePlan)
    {
        @if (plan.Scenarios.Count == 0)
        {
            <section class="plan-empty" aria-label="Empty plan">
                <h2>Current plan is empty</h2>
                <p class="muted">Add a scenario from the catalog or load a preset to begin configuring your load mix.</p>
                <div class="plan-empty-actions">
                    @if (!locked && Sim.PresetNames.Count > 0)
                    {
                        <button type="button" class="btn ghost" @onclick="TogglePresetMenu">Load preset…</button>
                    }
                    <button type="button" class="btn primary" @onclick="ToggleAdd" disabled="@locked">+ Add scenario</button>
                </div>
            </section>
        }
        else
        {
            <div class="pe-grid" aria-label="Edit scenarios">
                @for (var i = 0; i < plan.Scenarios.Count; i++)
                {
                    var idx = i;
                    var c = plan.Scenarios[idx];
                    <PlanEntryCard @key="c" Index="idx" Config="c" Scenario="@Catalog.Find(c.ScenarioId)"
                                   TotalPlanRate="totalPlanRate"
                                   Selected="idx == selected" Disabled="locked"
                                   OnSelect="Select" OnDuplicate="DuplicateAt" OnDelete="RemoveAt" />
                }

                <button type="button" class="pe-card-add" @onclick="ToggleAdd" disabled="@locked" aria-haspopup="dialog" aria-expanded="@Aria.Bool(addOpen)">
                    <span class="pe-plus-ring">+</span>
                    <b>Add scenario</b>
                    <span class="mono">Append to load mix</span>
                </button>
            </div>
        }

        @if (addOpen)
        {
            var filteredScenarios = Catalog.All
                .Where(x => addFilter.Length == 0
                    || x.Name.Contains(addFilter, StringComparison.OrdinalIgnoreCase)
                    || x.Description.Contains(addFilter, StringComparison.OrdinalIgnoreCase)
                    || x.Id.Contains(addFilter, StringComparison.OrdinalIgnoreCase))
                .ToList();
            <div class="overlay pe-add-overlay" role="dialog" aria-modal="true" aria-label="Add scenario"
                 @onclick="() => addOpen = false" @onkeydown="OnAddKey" tabindex="-1">
                <section class="pe-add-modal" @onclick:stopPropagation="true">
                    <div class="pe-add-head">
                        <div class="pe-insp-titles">
                            <div class="pe-kicker">SCENARIO CATALOG</div>
                            <h2>Add scenario</h2>
                        </div>
                        <span class="pe-add-count mono">@filteredScenarios.Count</span>
                        <button type="button" class="icon-btn" @onclick="() => addOpen = false" aria-label="Close">✕</button>
                    </div>
                    <div class="pe-add-search">
                        <input type="text" placeholder="Filter scenarios…" aria-label="Filter scenario types"
                               autocomplete="off" spellcheck="false" @bind="addFilter" @bind:event="oninput" />
                    </div>
                    <ul class="pe-add-list" aria-label="Scenario types">
                        @if (filteredScenarios.Count == 0)
                        {
                            <li class="pe-add-empty muted">No scenarios match “@addFilter”.</li>
                        }
                        @foreach (var sc in filteredScenarios)
                        {
                            var chosen = sc;
                            <li>
                                <button type="button" class="pe-add-item" title="@chosen.Name" @onclick="() => Add(chosen)">
                                    <span class="pe-add-item-top">
                                        <b>@chosen.Name</b>
                                        <span class="mono pe-add-id">@chosen.Id</span>
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(chosen.Description))
                                    {
                                        <span class="pe-add-desc">@chosen.Description</span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>
                </section>
            </div>
        }

        @if (Phone.IsPhone)
        {
            @if (hasSideSelection)
            {
                var sheetLabel = isPlanSelected ? "Plan settings" : "Edit " + LabelOf(cfg!);
                var activePanel = isPlanSelected ? planSettingsPanel : editorPanel;
                <Sheet Open="true" Resizable="true" Full="editSheetFull" FullChanged="v => editSheetFull = v" OnClose="CloseSidePanel" Label="@sheetLabel" Class="ed-sheet">
                    <aside class="ed-side open" aria-label="@sheetLabel">@activePanel</aside>
                </Sheet>
            }
        }
        else
        {
            var sheetLabel = isPlanSelected ? "Plan settings" : cfg is not null ? "Edit " + LabelOf(cfg) : "Configuration";
            <aside class="ed-side @(sideOpen ? "open" : "")"
                   aria-label="@sheetLabel"
                   aria-hidden="@Aria.Bool(!sideOpen)"
                   @onkeydown="OnSideKey">
                @if (isPlanSelected)
                {
                    @planSettingsPanel
                }
                else if (cfg is not null)
                {
                    @editorPanel
                }
            </aside>
        }
    }
    else if (!DataMode.IsFakeMode && !ApiRun.PreflightDismissed && ApiRun.PreflightState is "Running" or "Failed")
    {
        var pfFailed = ApiRun.PreflightState == "Failed";
        <section class="preflight-view @(pfFailed ? "failed" : "running")" aria-label="Preflight output">
            <div class="preflight-head">
                <span class="pf-badge @(pfFailed ? "bad" : "run")">@(pfFailed ? "Preflight failed" : "Running preflight…")</span>
                <b class="mono">@(ApiRun.PreflightScriptName ?? plan.PreflightScriptId ?? "preflight.cs")</b>
                <span class="spacer"></span>
                <CopyButton GetText="@(() => string.Join("\n", ApiRun.PreflightLogs))" Disabled="@(ApiRun.PreflightLogs.Count == 0)" />
                <WrapToggleButton @bind-Wrapped="preflightWrap" />
                @if (pfFailed)
                {
                    @if (!string.IsNullOrWhiteSpace(plan.PreflightScriptId))
                    {
                        <button type="button" class="btn ghost small" @onclick='() => Nav.NavigateTo($"editor?preflight={Uri.EscapeDataString(plan.PreflightScriptId)}")'>Edit script</button>
                    }
                    <button type="button" class="btn primary small" @onclick="ApiRun.DismissPreflight">Clear &amp; back to overview</button>
                }
                else
                {
                    <button type="button" class="btn danger small" @onclick="Sim.Stop">Cancel</button>
                }
            </div>
            @if (pfFailed)
            {
                <div class="preflight-err-banner" role="alert">
                    <b>Scenarios were not started.</b>
                    @if (!string.IsNullOrWhiteSpace(ApiRun.PreflightError))
                    {
                        <span>@ApiRun.PreflightError</span>
                    }
                </div>
            }
            <div class="preflight-console sl-console @(preflightWrap ? "wrap" : "nowrap")" role="log" aria-live="polite">
                @if (ApiRun.PreflightLogs.Count == 0)
                {
                    <div class="muted">Waiting for preflight output…</div>
                }
                else
                {
                    @foreach (var line in ApiRun.PreflightLogs)
                    {
                        <SerilogLine Raw="@line" />
                    }
                }
            </div>
        </section>
    }
    else
    {
        @* Above the cards, so a failed preflight or shutdown is seen without scrolling past many scenarios (user, brain 0071 update). *@
        <PreflightStrip Run="s.Preflight" />
        <ShutdownStrip Run="s.Shutdown" ScriptId="@plan.ShutdownScriptId" />
        @if (s.Count == 0 && (DataMode.IsFakeMode || ApiRun.HasLoadedPlan || !ApiRun.IsServerReachable))
        {
            <section class="plan-empty" aria-label="Empty plan">
                <h2>This plan is empty</h2>
                <p class="muted">Load a saved preset or edit the current plan to add scenarios.</p>
                <div class="plan-empty-actions">
                    @if (!locked && Sim.PresetNames.Count > 0)
                    {
                        <button type="button" class="btn ghost" @onclick="TogglePresetMenu">Load preset</button>
                    }
                    <button type="button" class="btn secondary" @onclick="EnterEditMode" disabled="@(locked || viewingHistory)">Edit plan</button>
                </div>
            </section>
        }
        else
        {
            <div class="grid" aria-label="Scenarios">
                @for (var i = 0; i < s.Count; i++)
                {
                    var idx = i;
                    <ScenarioCard @key="idx" Index="idx" Label="@s.Labels[idx]" View="s.Scenarios[idx]" Bees="s.Store.Bees(idx)" Running="s.BeesInFlight?[idx]"
                                  Target="s.Plan.Scenarios[idx].EffectiveRatePerMinute()" Shape="@Format.Shape(s.Plan.Scenarios[idx])" Elapsed="s.Elapsed" DurationSeconds="s.Plan.DurationSeconds" IsLive="s.Running && !s.Paused"
                                  ScenarioType="@(Catalog.Find(s.Plan.Scenarios[idx].ScenarioId)?.Name)"
                                  OnOpen="i => OpenScenario(i)"
                                  OnOpenFiltered="t => OpenScenario(t.Index, new(t.Filter))"
                                  OnOpenLogs="i => Logs.Show(entry: i)"
                                  OnEdit="EditEntry" OnInspect="InspectEntry" ActionsDisabled="@s.IsPlanReadOnly"
                                  Steps="s.StepsOf(idx)" FailedPerStep="s.Store.FailedPerStep(idx)"
                                  InFlightPerStep="@(s.StepsOf(idx).Any && s.BeesInFlight is { } bif && idx < bif.Length ? StepLogic.InFlightCounts(s.StepsOf(idx), bif[idx], s.Elapsed) : null)"
                                  OnOpenStep="t => OpenScenario(t.Index, new(FailedStep: t.Step))"
                                  OnOpenStepInFlight="t => OpenScenario(t.Index, new(NowStep: t.Step))"
                                  OnOpenStepLogs="t => Logs.Show(LogFilter.None.WithEntry(t.Index).WithStep(t.Step))" />
                }
            </div>
        }
    }

    @if (!isIdlePlan && inspectEntry is { } ie && ie >= 0 && ie < s.Plan.Scenarios.Count)
    {
        var ic = s.Plan.Scenarios[ie];
        var isc = Catalog.Find(ic.ScenarioId);
        var iLabel = LabelOf(ic);
        var iTotalRate = s.Plan.Scenarios.Sum(c => c.EffectiveRatePerMinute());

        <div class="overlay pe-add-overlay" role="dialog" aria-modal="true" aria-label="@($"Parameters for {iLabel}")"
             @onclick="() => inspectEntry = null" @onkeydown="OnInspectKey" tabindex="-1">
            <PlanEntryCard Index="ie"
                           Config="ic"
                           Scenario="isc"
                           TotalPlanRate="iTotalRate"
                           PlanMaxConcurrency="s.Plan.MaxConcurrency"
                           InspectMode="true"
                           ShowActions="false"
                           OnClose="() => inspectEntry = null" />
        </div>
    }
</div>

@code {
    private sealed record EntryProblems(string? Rate, string? Burst, string? BurstRate, string? MaxInFlight, Dictionary<string, List<string>> Fields)
    {
        public int Count => (Rate is null ? 0 : 1) + (Burst is null ? 0 : 1) + (BurstRate is null ? 0 : 1) + (MaxInFlight is null ? 0 : 1) + Fields.Count;
    }

    private static readonly ScenarioView Empty = new(0, 0, 0, 0, 0, 0);
    private static readonly BeeRecord[] NoBees = [];

    // Overview state
    /// <summary>Opens the scenario page (brain 0059); the overview's scroll position is remembered so the way back lands on the same card.</summary>
    private void OpenScenario(int index, ScenarioFilter filter = default) => Nav.NavigateTo(ScenarioLink.Href(index, filter));
    private bool viewMenuOpen;
    private bool editMenuOpen;
    private bool presetMenuOpen;
    private string presetFilter = string.Empty, addFilter = string.Empty, pickFilter = string.Empty;
    private List<PreflightScriptSummary> preflights = [];
    private List<PreflightScriptSummary> shutdowns = [];
    private bool pickerIsShutdown;

    // Editor drawer state (active whenever Sim.Current.IsIdlePlan)
    private const int PlanSelected = -2;
    private bool preflightPickerOpen;
    private bool preflightWrap = true;
    private bool wasRunning;
    private int selected = -1;
    private int lastPlanMaxInFlight = 50;
    private int lastEntryMaxInFlight = 50;
    private bool editSheetFull;
    private bool addOpen;
    private int? inspectEntry;
    private List<ScenarioRunConfig>? undoEntries;
    private string undoMessage = "";
    private bool disposed;

    // Debounced validation
    private ScenarioRunConfig? snapFor;
    private EntryProblems? snap;
    private Dictionary<string, string>? planSnap;
    private CancellationTokenSource? debounce;

    private string? handledUri;

    /// <summary>
    /// Loading the page always opens in Overview (view mode). Only an explicit assistant link (<c>?edit=&lt;ticks&gt;</c>)
    /// enters edit mode; any stale <c>?edit=1</c> query is stripped so reloads stay in Overview.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (Nav.Uri == handledUri) return;
        handledUri = Nav.Uri;
        var fromAddress = OverviewLink.Parse(Nav.Uri);
        if (fromAddress is not { Edit: true } v) return;

        // Strip ?edit=1 on page load/reload so the page always lands in Overview.
        var isAssistantLink = Nav.Uri.Contains("edit=", StringComparison.OrdinalIgnoreCase)
            && !Nav.Uri.Contains("edit=1", StringComparison.OrdinalIgnoreCase);
        if (!isAssistantLink)
        {
            Nav.NavigateTo("overview", new NavigationOptions { ReplaceHistoryEntry = true });
            return;
        }

        if (!Sim.Current.IsIdlePlan)
        {
            if (Sim.IsRunning || Sim.Current.IsHistorical) return;
            EnterEditMode();
        }
        if (v.Entry is { } e && e < Sim.Plan.Scenarios.Count) { selected = e; addOpen = false; }
    }

    protected override void OnInitialized()
    {
        wasRunning = Sim.IsRunning;

        Sim.Changed += OnChanged;
        DataMode.Changed += OnChanged;
        Catalog.Changed += OnChanged;
        _ = ScriptApi.SyncCatalogAsync();
        _ = LoadPreflightsAsync();
    }

    private async Task LoadPreflightsAsync()
    {
        preflights = await ScriptApi.ListPreflightsAsync();
        shutdowns = await ScriptApi.ListPreflightsAsync(kind: ScriptApiClient.Shutdowns);
        if (!disposed) await InvokeAsync(StateHasChanged);
    }

    private async Task OpenPreflightPickerAsync()
    {
        pickerIsShutdown = false;
        pickFilter = string.Empty;
        preflightPickerOpen = true;
        await LoadPreflightsAsync();
    }

    private async Task OpenShutdownPickerAsync()
    {
        pickerIsShutdown = true;
        pickFilter = string.Empty;
        preflightPickerOpen = true;
        await LoadPreflightsAsync();
    }

    // The picker serves both programs (brain 0052): pickerIsShutdown says which one it is choosing.
    private void PickPreflight(string scriptId)
    {
        if (pickerIsShutdown) Sim.Plan.ShutdownScriptId = scriptId;
        else Sim.Plan.PreflightScriptId = scriptId;
        preflightPickerOpen = false;
        Committed();
        Edited();
    }

    private void RemovePreflight()
    {
        if (pickerIsShutdown) Sim.Plan.ShutdownScriptId = null;
        else Sim.Plan.PreflightScriptId = null;
        preflightPickerOpen = false;
        Committed();
        Edited();
    }

    private void RemoveShutdown()
    {
        Sim.Plan.ShutdownScriptId = null;
        Committed();
        Edited();
    }

    private void StartRun()
    {
        if (Sim.IsRunning || Sim.Plan.Scenarios.Count == 0) return;
        ClearDrawerState();
        Sim.Start();
    }

    private void TogglePresetMenu()
    {
        viewMenuOpen = false;
        editMenuOpen = false;
        presetMenuOpen = !presetMenuOpen;
        presetFilter = string.Empty;
    }

    private void ToggleViewMenu()
    {
        presetMenuOpen = false;
        viewMenuOpen = !viewMenuOpen;
    }

    private void ToggleEditMenu()
    {
        presetMenuOpen = false;
        editMenuOpen = !editMenuOpen;
    }

    private void OnPresetKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") presetMenuOpen = false;
    }

    private void OnAddKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") addOpen = false;
    }

    private void InspectEntry(int idx) => inspectEntry = idx;

    private void OnInspectKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") inspectEntry = null;
    }

    private void EnterEditMode()
    {
        if (Sim.IsRunning || Sim.Current.IsHistorical) return;
        viewMenuOpen = false;
        editMenuOpen = false;
        presetMenuOpen = false;
        Sim.EditPlan();
        selected = -1;
        inspectEntry = null;
        addOpen = false;
        ResetErrors();
        _ = ScriptApi.SyncCatalogAsync();
    }

    private void ClearDrawerState()
    {
        editMenuOpen = false;
        presetMenuOpen = false;
        selected = -1;
        addOpen = false;
        preflightPickerOpen = false;
        undoEntries = null;
        ResetErrors();
    }

    // ---------- Editor selection & validation ----------

    private void CloseSidePanel() { selected = -1; ResetErrors(); }

    private void OnSideKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && selected != -1) CloseSidePanel();
    }

    private void Select(int i)
    {
        selected = selected == i ? -1 : i;
        addOpen = false;
        ResetErrors();
    }

    private void SelectPlan()
    {
        selected = selected == PlanSelected ? -1 : PlanSelected;
        addOpen = false;
        ResetErrors();
        if (selected == PlanSelected && !DataMode.IsFakeMode) _ = LoadPreflightsAsync();
    }

    private void TogglePlanMaxInFlight()
    {
        if (Sim.Plan.MaxConcurrency > 0)
        {
            lastPlanMaxInFlight = Sim.Plan.MaxConcurrency;
            Sim.Plan.MaxConcurrency = 0;
        }
        else
        {
            Sim.Plan.MaxConcurrency = Math.Clamp(lastPlanMaxInFlight, 1, 1000);
        }
        Committed();
        Edited();
    }

    private void SetPlanMaxInFlight(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v) && v >= 1)
        {
            Sim.Plan.MaxConcurrency = Math.Clamp(v, 1, 1000);
            lastPlanMaxInFlight = Sim.Plan.MaxConcurrency;
        }
        Edited();
    }

    private void ToggleEntryMaxInFlight()
    {
        if (selected < 0 || selected >= Sim.Plan.Scenarios.Count) return;
        var entry = Sim.Plan.Scenarios[selected];
        if (entry.MaxInFlight is > 0)
        {
            lastEntryMaxInFlight = entry.MaxInFlight.Value;
            entry.MaxInFlight = null;
        }
        else
        {
            entry.MaxInFlight = Math.Clamp(lastEntryMaxInFlight, 1, 1000);
        }
        Committed();
        Edited();
    }

    private void ResetErrors() { snapFor = null; snap = null; planSnap = null; debounce?.Cancel(); }

    private EntryProblems ShownErrors(ScenarioRunConfig c)
    {
        if (!ReferenceEquals(snapFor, c) || snap is null) { snapFor = c; snap = EntryErrors(c); }
        return snap;
    }

    private void Edited()
    {
        Sim.MarkPlanEdited();
        debounce?.Cancel();
        debounce = new CancellationTokenSource();
        _ = SnapshotLater(debounce.Token);
    }

    private async Task SnapshotLater(CancellationToken ct)
    {
        try { await Task.Delay(300, ct); } catch (TaskCanceledException) { return; }
        if (disposed || ct.IsCancellationRequested) return;
        snap = null; planSnap = null;
        await InvokeAsync(StateHasChanged);
    }

    private void Committed() { debounce?.Cancel(); snap = null; planSnap = null; }

    private void SetRate(ChangeEventArgs e)
    {
        if (selected < 0) return;
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d))
            Sim.Plan.Scenarios[selected].RatePerMinute = d;
        Edited();
    }

    private void SetPattern(SpawningPattern pattern)
    {
        if (selected < 0) return;
        Sim.Plan.Scenarios[selected].Pattern = pattern;
        Committed();
        Edited();
    }

    private void SetBurstSize(ChangeEventArgs e)
    {
        if (selected < 0) return;
        if (int.TryParse(e.Value?.ToString(), out var v)) Sim.Plan.Scenarios[selected].BeesPerBurst = v;
        Edited();
    }

    private void SetBurstRate(ChangeEventArgs e)
    {
        if (selected < 0) return;
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d))
            Sim.Plan.Scenarios[selected].BurstsPerMinute = d;
        Edited();
    }

    private void SetMaxInFlight(ChangeEventArgs e)
    {
        if (selected < 0) return;
        if (int.TryParse(e.Value?.ToString(), out var v) && v >= 1)
        {
            Sim.Plan.Scenarios[selected].MaxInFlight = v;
            lastEntryMaxInFlight = Math.Clamp(v, 1, 1000);
        }
        Edited();
    }

    private void SetPlanInt(ChangeEventArgs e, Action<int> set)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) set(v);
        Edited();
    }

    private void ToggleAdd()
    {
        addOpen = !addOpen;
        addFilter = string.Empty;
        if (addOpen) _ = ScriptApi.SyncCatalogAsync();
    }

    private static string LabelOf(ScenarioRunConfig c) => string.IsNullOrWhiteSpace(c.Label) ? c.ScenarioId : c.Label;

    private static Dictionary<string, string> PlanErrors(LoadPlan plan)
    {
        var m = new Dictionary<string, string>();
        if (plan.DurationSeconds < 1) m["dur"] = "Duration must be at least 1 second.";
        return m;
    }

    private EntryProblems EntryErrors(ScenarioRunConfig c)
    {
        string? rate = null, burst = null, burstRate = null, maxInFlight = null;
        if (c.Pattern == SpawningPattern.Bursts)
        {
            if (c.BeesPerBurst is < 1 or > LoadPlan.MaxBeesPerBurst) burst = $"Bees per burst: between 1 and {LoadPlan.MaxBeesPerBurst:N0}.";
            if (c.BurstsPerMinute <= 0 || double.IsNaN(c.BurstsPerMinute)) burstRate = "Bursts per minute: more than 0.";
            else if (c.EffectiveRatePerMinute() > LoadPlan.MaxRatePerMinute) burstRate = $"Together at most {LoadPlan.MaxRatePerMinute:N0} bees per minute.";
        }
        else if (c.RatePerMinute is <= 0 or > LoadPlan.MaxRatePerMinute || double.IsNaN(c.RatePerMinute))
            rate = $"Between 0 and {LoadPlan.MaxRatePerMinute:N0} per minute.";
        if (c.MaxInFlight is < 1 or > 1000)
            maxInFlight = "Max in-flight: between 1 and 1000.";
        var fields = Catalog.Find(c.ScenarioId) is { } sc ? sc.Spec.ValidateByField(c.Parameters) : new Dictionary<string, List<string>>();
        return new(rate, burst, burstRate, maxInFlight, fields);
    }

    private void Add(IScenario scenario)
    {
        Sim.AddEntry(scenario);
        ResetErrors();
        selected = Sim.Plan.Scenarios.Count - 1;
        addOpen = false;
    }

    private void EditEntry(int idx)
    {
        if (Sim.IsRunning || (!DataMode.IsFakeMode && ApiRun.IsViewingHistory)) return;
        EnterEditMode();
        if (idx >= 0 && idx < Sim.Plan.Scenarios.Count) Select(idx);
    }

    private void OpenPlanSettings()
    {
        if (Sim.IsRunning || (!DataMode.IsFakeMode && ApiRun.IsViewingHistory)) return;
        EnterEditMode();
        SelectPlan();
    }

    private void DuplicateAt(int idx)
    {
        if (Sim.IsRunning || idx < 0 || idx >= Sim.Plan.Scenarios.Count) return;
        Sim.DuplicateEntry(idx);
        selected = idx + 1;
        addOpen = false;
        ResetErrors();
    }

    private void Remove() => RemoveAt(selected);

    private void RemoveAt(int idx)
    {
        if (Sim.IsRunning || idx < 0 || idx >= Sim.Plan.Scenarios.Count) return;
        undoEntries = Sim.Plan.Scenarios.Select(x => x.Clone()).ToList();
        undoMessage = $"Removed “{LabelOf(Sim.Plan.Scenarios[idx])}”.";
        Sim.RemoveEntry(idx);
        if (selected == idx) selected = -1;
        else if (selected > idx) selected--;
        ResetErrors();
    }

    private void StartNewPlan()
    {
        if (Sim.IsRunning || (!DataMode.IsFakeMode && ApiRun.IsViewingHistory)) return;
        EnterEditMode();
        ClearPlan();
    }

    private void ClearPlan()
    {
        if (Sim.IsRunning) return;
        var count = Sim.Plan.Scenarios.Count;
        if (count > 0)
        {
            undoEntries = Sim.Plan.Scenarios.Select(x => x.Clone()).ToList();
            undoMessage = $"Started a new plan (cleared {count} {(count == 1 ? "scenario" : "scenarios")}).";
        }
        Sim.ClearEntries();
        selected = -1;
        addOpen = false;
        ResetErrors();
    }

    private void UndoPlanChange()
    {
        if (undoEntries is null || Sim.IsRunning) return;
        Sim.RestoreEntries(undoEntries);
        undoEntries = null;
        selected = Sim.Plan.Scenarios.Count > 0 ? 0 : -1;
        ResetErrors();
    }

    private void DismissUndo() => undoEntries = null;

    private void DoLoad(string name)
    {
        if (Sim.Plan.Scenarios.Count > 0)
        {
            undoEntries = Sim.Plan.Scenarios.Select(x => x.Clone()).ToList();
            undoMessage = $"Loaded preset “{name}” into plan.";
        }
        Sim.LoadPreset(name);
        selected = -1;
        ResetErrors();
    }

    private void OnChanged()
    {
        if (!wasRunning && Sim.IsRunning)
            ClearDrawerState();
        wasRunning = Sim.IsRunning;

        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        disposed = true;
        debounce?.Cancel();
        Sim.Changed -= OnChanged;
        DataMode.Changed -= OnChanged;
        Catalog.Changed -= OnChanged;
    }
}
