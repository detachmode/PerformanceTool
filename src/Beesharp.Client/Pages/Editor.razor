@* Minimalist full-screen C# Script Editor (/editor):
   Full-viewport syntax-highlighted code editor with a single compact menu bar (file picker for scenario, preflight & shutdown .cs files, Wrap, Save, Try, actions). *@
@page "/editor"
@page "/scripts"
@layout MainLayout
@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Components.Forms
@using Beesharp.Client.Components.Parameters
@using Beesharp.Services.Scenarios
@using Beesharp.Services.Scenarios.Spec
@implements IDisposable
@inject ScriptApiClient Api
@inject ScenarioCatalog Catalog
@inject IRunSource Sim
@inject IEnvironmentSource Envs
@inject DataModeState DataMode

<PageTitle>@fileName · Beesharp</PageTitle>

<div class="script-fullscreen">
    <div class="script-bar" role="toolbar" aria-label="Script editor toolbar">
        <div class="dd">
            <button type="button" class="btn ghost small script-file-btn" aria-haspopup="menu" aria-expanded="@Aria.Bool(filesOpen)"
                    @onclick="() => { filesOpen = !filesOpen; moreOpen = false; }" title="Switch, create, or upload .cs scripts">
                @if (isPreflight)
                {
                    <span class="pf-tag">@(isShutdown ? "END" : "PRE")</span>
                }
                <span class="mono">@fileName</span>
                <span class="caret">▾</span>
            </button>
            @if (filesOpen)
            {
                <div class="dd-backdrop" @onclick="() => filesOpen = false"></div>
                <div class="dd-menu script-files-menu" role="menu" aria-label="C# script files">
                    <div class="dd-lbl">Scenarios (@scripts.Count)</div>
                    @if (scripts.Count == 0)
                    {
                        <div class="muted" style="padding:.3rem .55rem">No scenario .cs files yet.</div>
                    }
                    @foreach (var s in scripts)
                    {
                        var item = s;
                        var isCur = !isPreflight && selectedId == item.ScriptId;
                        <button type="button" class="dd-item" role="menuitem" @onclick="() => PickScenarioFile(item)" style="flex-direction:column;align-items:flex-start;gap:.05rem">
                            <span>@(isCur ? "✓ " : "")<b>@item.FileName</b></span>
                            <span class="muted" style="font-size:.72rem">@item.ScenarioName</span>
                        </button>
                    }
                    <div class="dd-sep" role="separator"></div>
                    <div class="dd-lbl">Preflight scripts (@preflights.Count)</div>
                    @if (preflights.Count == 0)
                    {
                        <div class="muted" style="padding:.3rem .55rem">No preflight scripts yet.</div>
                    }
                    @foreach (var pf in preflights)
                    {
                        var item = pf;
                        var isCur = isPreflight && !isShutdown && selectedId == item.ScriptId;
                        <button type="button" class="dd-item" role="menuitem" @onclick="() => PickPreflightFile(item)">
                            <span>@(isCur ? "✓ " : "")<b>@item.FileName</b></span>
                        </button>
                    }
                    <div class="dd-sep" role="separator"></div>
                    <div class="dd-lbl">Shutdown programs (@shutdowns.Count)</div>
                    @if (shutdowns.Count == 0)
                    {
                        <div class="muted" style="padding:.3rem .55rem">No shutdown programs yet.</div>
                    }
                    @foreach (var sd in shutdowns)
                    {
                        var item = sd;
                        var isCur = isShutdown && selectedId == item.ScriptId;
                        <button type="button" class="dd-item" role="menuitem" @onclick="() => PickShutdownFile(item)">
                            <span>@(isCur ? "✓ " : "")<b>@item.FileName</b></span>
                        </button>
                    }
                    <div class="dd-sep" role="separator"></div>
                    <button type="button" class="dd-item" role="menuitem" @onclick="NewScenarioScript">+ New scenario .cs</button>
                    <button type="button" class="dd-item" role="menuitem" @onclick="NewPreflightScript">+ New preflight .cs</button>
                    <button type="button" class="dd-item" role="menuitem" @onclick="NewShutdownScript">+ New shutdown .cs</button>
                    <label class="dd-item" role="menuitem" style="cursor:pointer">
                        Upload .cs…
                        <InputFile OnChange="OnFileUpload" accept=".cs,.csx" style="display:none" />
                    </label>
                </div>
            }
        </div>

        @if (statusMessage is not null)
        {
            <span class="script-status @(statusIsError ? "field-error" : "saved")" role="status">@statusMessage</span>
        }
        else if (DataMode.IsFakeMode)
        {
            <button type="button" class="chip" @onclick="SwitchToLive" title="Custom scripts compile and run on the server">Switch to Live</button>
        }

        <span class="spacer"></span>

        <WrapToggleButton @bind-Wrapped="wordWrap" />

        <button type="button" class="btn primary small" @onclick="CompileAndSave" disabled="@(busy || string.IsNullOrWhiteSpace(scriptCode))">
            @(compiling ? "Saving…" : "Save")
        </button>

        <button type="button" class="btn ghost small" @onclick="OpenTryDialog" disabled="@(busy || !canTry)"
                title="@(!canTry ? "Save the script first to try it out" : isPreflight ? $"Run this {ProgramName} once and view its log output" : "Configure parameters and run a single test execution")">
            ▶ Try
        </button>

        <div class="dd">
            <button type="button" class="btn ghost small" aria-haspopup="menu" aria-expanded="@Aria.Bool(moreOpen)"
                    @onclick="() => { moreOpen = !moreOpen; filesOpen = false; }" aria-label="More script actions" title="More actions">
                ⋯
            </button>
            @if (moreOpen)
            {
                <div class="dd-backdrop" @onclick="() => moreOpen = false"></div>
                <div class="dd-menu right" role="menu" aria-label="More script actions">
                    <button type="button" class="dd-item" role="menuitem" @onclick="() => { moreOpen = false; renameOpen = true; }">Rename file…</button>
                    @if (!isPreflight)
                    {
                        <button type="button" class="dd-item" role="menuitem" disabled="@(busy || selectedSummary is null || Sim.IsRunning)" @onclick="() => { moreOpen = false; AddToPlan(); }">+ Add to plan</button>
                    }
                    else
                    {
                        <button type="button" class="dd-item" role="menuitem" disabled="@(busy || selectedPreflight is null || Sim.IsRunning)" @onclick="() => { moreOpen = false; UseAsPreflight(); }">Use as plan @ProgramName</button>
                    }
                    <div class="dd-sep" role="separator"></div>
                    <button type="button" class="dd-item bad" role="menuitem" disabled="@(busy || !canTry)" @onclick="() => { moreOpen = false; _ = DeleteCurrent(); }">Delete script</button>
                </div>
            }
        </div>
    </div>

    @if (renameOpen)
    {
        <form class="script-rename-bar" @onsubmit="() => renameOpen = false" @onsubmit:preventDefault="true">
            <label for="script-filename" class="muted">File name:</label>
            <input id="script-filename" class="env-name-input" value="@fileName" placeholder="@(isShutdown ? "cleanup.cs" : isPreflight ? "check-readiness.cs" : "order-stress.cs")" autocomplete="off"
                   @oninput="e => fileName = e.Value?.ToString() ?? string.Empty" />
            <button type="submit" class="btn primary small">OK</button>
        </form>
    }

    <div class="script-editor-fill">
        <CSharpCodeEditor Value="@scriptCode" ValueChanged="v => scriptCode = v" WordWrap="@wordWrap" AriaLabel="C# script" />
    </div>

    @if (diagnostics.Count > 0)
    {
        <div class="diag-list script-diag-dock" role="alert">
            @foreach (var d in diagnostics)
            {
                <div class="diag-row @(d.Severity == "Error" ? "err" : "warn")">
                    <code>(@d.Line,@d.Column) @d.Id</code>
                    <span>@d.Message</span>
                </div>
            }
        </div>
    }
</div>

@if (tryOpen && canTry)
{
    <div class="overlay" tabindex="-1" @onclick="() => tryOpen = false" role="presentation">
        <div class="dialog" style="width:min(720px,100%)" role="dialog" aria-modal="true" aria-labelledby="try-title" @onclick:stopPropagation="true">
            <div class="dlg-head">
                <h2 id="try-title">Try · @(isPreflight ? selectedPreflight!.FileName : selectedSummary!.ScenarioName)</h2>
                <span class="muted">@(Envs.ActiveName is null ? "No environment" : $"Env: {Envs.ActiveName}")</span>
                <span class="spacer"></span>
                <button type="button" class="btn primary small" @onclick="RunTest" disabled="@busy">
                    @(testing ? "Running…" : "▶ Run once")
                </button>
                <button type="button" class="icon-btn" @onclick="() => tryOpen = false" aria-label="Close">✕</button>
            </div>

            <div class="script-try-body">
                @if (!isPreflight && compiledSpec is not null)
                {
                    @if (compiledSpec.Fields.Count > 0)
                    {
                        <div class="form param-grid">
                            <ParameterEditor Spec="compiledSpec" Values="testParams" Disabled="@busy" IdPrefix="script-test" />
                        </div>
                    }
                    else
                    {
                        <p class="muted" style="margin:0">This scenario takes no parameters.</p>
                    }

                    @if (testResult is not null)
                    {
                        <div class="test-result @(testResult.Success ? "ok" : "bad")">
                            <div class="test-result-head">
                                <b>@(testResult.Success ? "Succeeded" : "Failed")</b>
                                @if (testResult.StatusCode is { } sc) { <span class="tag">HTTP @sc</span> }
                                <span class="muted">@testResult.DurationMs.ToString("0.#") ms</span>
                                <span class="muted">@testResult.Bytes B</span>
                                <span class="muted">startup @testResult.StartupDurationMs.ToString("0.#") ms · teardown @testResult.TeardownDurationMs.ToString("0.#") ms</span>
                                <span class="spacer"></span>
                                <WrapToggleButton @bind-Wrapped="tryWrap" />
                            </div>
                            @if (!string.IsNullOrEmpty(testResult.Error))
                            {
                                <div class="field-error">@testResult.Error</div>
                            }
                            @if (testResult.Calls.Count > 0)
                            {
                                <div class="test-calls">
                                    @foreach (var c in testResult.Calls)
                                    {
                                        <div class="test-call-row">
                                            <code>@c.Method</code>
                                            <span class="url">@c.Url</span>
                                            <span class="muted">@(c.StatusCode?.ToString() ?? "err") · @c.DurationMs.ToString("0.#") ms</span>
                                        </div>
                                    }
                                </div>
                            }
                            @if (testResult.Logs.Count > 0)
                            {
                                <div class="sl-console compact @(tryWrap ? "wrap" : "nowrap")">
                                    @foreach (var line in testResult.Logs)
                                    {
                                        <SerilogLine Raw="@line" />
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else if (isPreflight)
                {
                    @if (preflightResult is null)
                    {
                        <p class="muted" style="margin:0">Click <b>▶ Run once</b> to execute this @ProgramName and inspect its log output.</p>
                    }
                    else
                    {
                        <div class="test-result @(preflightResult.Success ? "ok" : "bad")">
                            <div class="test-result-head">
                                <b>@(preflightResult.Success ? $"{ProgramTitle} succeeded" : $"{ProgramTitle} failed")</b>
                                <span class="muted">@preflightResult.DurationMs.ToString("0.#") ms</span>
                                <span class="spacer"></span>
                                <WrapToggleButton @bind-Wrapped="tryWrap" />
                            </div>
                            @if (!string.IsNullOrEmpty(preflightResult.Error))
                            {
                                <div class="field-error">@preflightResult.Error</div>
                            }
                            @if (preflightResult.Logs.Count > 0)
                            {
                                <div class="sl-console compact @(tryWrap ? "wrap" : "nowrap")">
                                    @foreach (var line in preflightResult.Logs)
                                    {
                                        <SerilogLine Raw="@line" />
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "script")]
    public string? RequestedScript { get; set; }

    [SupplyParameterFromQuery(Name = "preflight")]
    public string? RequestedPreflight { get; set; }

    [SupplyParameterFromQuery(Name = "shutdown")]
    public string? RequestedShutdown { get; set; }

    private List<ClientScriptSummary> scripts = [];
    private List<ClientPreflightSummary> preflights = [];
    private List<ClientPreflightSummary> shutdowns = [];
    // isPreflight means "a program script" (preflight or shutdown, brain 0052); isShutdown says which of the two.
    private bool isPreflight;
    private bool isShutdown;
    private string ProgramName => isShutdown ? "shutdown program" : "preflight script";
    private string ProgramTitle => isShutdown ? "Shutdown program" : "Preflight";
    private string ProgramKind => isShutdown ? ScriptApiClient.Shutdowns : ScriptApiClient.Preflights;
    private string? selectedId;
    private ClientScriptSummary? selectedSummary;
    private ClientPreflightSummary? selectedPreflight;
    private ParameterSpec? compiledSpec;
    private JsonObject testParams = new();
    private string fileName = "order-api-stress.cs";
    private string scriptCode = ScenarioTemplate;
    private bool wordWrap = true;
    private bool tryWrap = true;
    private bool filesOpen;
    private bool moreOpen;
    private bool renameOpen;
    private bool tryOpen;
    private List<ClientScriptDiagnostic> diagnostics = [];
    private ClientTestRunResult? testResult;
    private ClientPreflightRunResult? preflightResult;
    private string? statusMessage;
    private bool statusIsError;
    private bool compiling;
    private bool testing;
    private bool busy => compiling || testing;
    private bool canTry => isPreflight ? selectedPreflight is not null : selectedSummary is not null;

    private const string ScenarioTemplate = """
        // 1. Define parameters (reflected by the backend to build the Blazor form)
        public record ApiLoadParams(
            [property: Description("Target endpoint URL")]
            string Endpoint = "https://httpbin.org/post",
            [property: Range(1, 5000)]
            int PayloadSizeBytes = 256,
            bool IncludeRandomJitter = true
        );

        // 2. Register the scenario using the injected 'Scenario' global
        Scenario.Define<ApiLoadParams>("Order API Stress Test", async (p, ctx) =>
        {
            using var request = new HttpRequestMessage(HttpMethod.Post, p.Endpoint);
            request.Content = new StringContent(new string('x', p.PayloadSizeBytes));
            using var response = await ctx.HttpClient.SendAsync(request, ctx.CancellationToken);
            response.EnsureSuccessStatusCode();
        });
        """;

    private const string PreflightTemplate = """
        // Preflight script: runs once before scenarios start.
        // Use Log("...") or Logger.LogInformation("...") to stream output.
        // Call Fail("reason") or throw an exception to prevent scenarios from starting.

        Log("Checking system readiness...");
        await Task.Delay(300, CancellationToken);

        // Example: run an external CLI command
        // var exit = await RunProcessAsync("echo", "hello from preflight");
        // if (exit != 0) Fail($"Command failed with exit code {exit}");

        Log("Preflight checks passed!");
        """;

    private const string ShutdownTemplate = """
        // Shutdown program: always runs at the end of a run (also after Stop, and after a failed preflight).
        // Use it to clean up what the run created. `Data` is the run bag: read what the preflight and the
        // scenarios stored there (context.RunBag in a scenario), and write results for the Environment tab.
        // A failure here shows as failed but does not change the scenarios' results.

        Log("Cleaning up...");
        if (Data.TryGetValue("tenantId", out var tenant))
            Log($"Releasing tenant {tenant}");
        await Task.Delay(300, CancellationToken);

        Data["cleanedUp"] = true;
        Log("Done.");
        """;

    protected override async Task OnInitializedAsync()
    {
        DataMode.Changed += OnStateChanged;
        Sim.Changed += OnStateChanged;
        await ReloadAllAsync();
    }

    private void OnStateChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private async Task ReloadAllAsync()
    {
        try
        {
            scripts = await Api.ListScriptsAsync();
            preflights = await Api.ListPreflightsAsync();
            shutdowns = await Api.ListPreflightsAsync(kind: ScriptApiClient.Shutdowns);

            if (selectedId is null && !string.IsNullOrWhiteSpace(RequestedShutdown))
            {
                if (RequestedShutdown.Equals("new", StringComparison.OrdinalIgnoreCase))
                {
                    NewShutdownScript();
                    return;
                }
                if (shutdowns.FirstOrDefault(p => string.Equals(p.ScriptId, RequestedShutdown, StringComparison.OrdinalIgnoreCase)
                                               || string.Equals(p.FileName, RequestedShutdown, StringComparison.OrdinalIgnoreCase)) is { } reqSd)
                {
                    SelectShutdown(reqSd);
                    return;
                }
            }

            if (selectedId is null && !string.IsNullOrWhiteSpace(RequestedPreflight))
            {
                if (RequestedPreflight.Equals("new", StringComparison.OrdinalIgnoreCase))
                {
                    NewPreflightScript();
                    return;
                }
                if (preflights.FirstOrDefault(p => string.Equals(p.ScriptId, RequestedPreflight, StringComparison.OrdinalIgnoreCase)
                                                || string.Equals(p.FileName, RequestedPreflight, StringComparison.OrdinalIgnoreCase)) is { } reqPf)
                {
                    SelectPreflight(reqPf);
                    return;
                }
            }

            if (selectedId is null && !string.IsNullOrWhiteSpace(RequestedScript)
                && scripts.FirstOrDefault(s => string.Equals(s.ScenarioId, RequestedScript, StringComparison.OrdinalIgnoreCase)
                                            || string.Equals(s.ScriptId, RequestedScript, StringComparison.OrdinalIgnoreCase)
                                            || string.Equals(s.FileName, RequestedScript, StringComparison.OrdinalIgnoreCase)) is { } reqSc)
            {
                SelectScenario(reqSc);
                return;
            }

            if (isShutdown && selectedId is not null && shutdowns.FirstOrDefault(p => p.ScriptId == selectedId) is { } foundSd)
                SelectShutdown(foundSd);
            else if (isPreflight && !isShutdown && selectedId is not null && preflights.FirstOrDefault(p => p.ScriptId == selectedId) is { } foundPf)
                SelectPreflight(foundPf);
            else if (!isPreflight && selectedId is not null && scripts.FirstOrDefault(s => s.ScriptId == selectedId) is { } foundSc)
                SelectScenario(foundSc);
            else if (scripts.Count > 0 && selectedSummary is null && selectedPreflight is null)
                SelectScenario(scripts[0]);
            else if (preflights.Count > 0 && selectedSummary is null && selectedPreflight is null)
                SelectPreflight(preflights[0]);
        }
        catch (Exception ex)
        {
            statusMessage = $"Load error: {ex.Message}";
            statusIsError = true;
        }
    }

    private void PickScenarioFile(ClientScriptSummary s) { filesOpen = false; renameOpen = false; SelectScenario(s); }
    private void PickPreflightFile(ClientPreflightSummary p) { filesOpen = false; renameOpen = false; SelectPreflight(p); }
    private void PickShutdownFile(ClientPreflightSummary p) { filesOpen = false; renameOpen = false; SelectShutdown(p); }

    private void SelectScenario(ClientScriptSummary s)
    {
        isPreflight = false;
        isShutdown = false;
        selectedId = s.ScriptId;
        selectedSummary = s;
        selectedPreflight = null;
        fileName = s.FileName;
        scriptCode = s.Code;
        diagnostics = [];
        testResult = null;
        preflightResult = null;
        compiledSpec = ParameterSpec.FromJsonSchema(s.Parameters);
        testParams = compiledSpec.DefaultJson();
        statusMessage = null;
        statusIsError = false;
    }

    private void SelectShutdown(ClientPreflightSummary p)
    {
        SelectPreflight(p);
        isShutdown = true;
    }

    private void SelectPreflight(ClientPreflightSummary p)
    {
        isPreflight = true;
        isShutdown = false;
        selectedId = p.ScriptId;
        selectedSummary = null;
        selectedPreflight = p;
        fileName = p.FileName;
        scriptCode = p.Code;
        diagnostics = [];
        testResult = null;
        preflightResult = null;
        compiledSpec = null;
        statusMessage = null;
        statusIsError = false;
    }

    private void NewScenarioScript()
    {
        filesOpen = false;
        isPreflight = false;
        isShutdown = false;
        selectedId = null;
        selectedSummary = null;
        selectedPreflight = null;
        compiledSpec = null;
        testParams = new JsonObject();
        fileName = "custom-scenario.cs";
        scriptCode = ScenarioTemplate;
        diagnostics = [];
        testResult = null;
        preflightResult = null;
        statusMessage = null;
        statusIsError = false;
        renameOpen = true;
    }

    private void NewShutdownScript()
    {
        NewPreflightScript();
        isShutdown = true;
        fileName = "cleanup.cs";
        scriptCode = ShutdownTemplate;
    }

    private void NewPreflightScript()
    {
        filesOpen = false;
        isPreflight = true;
        isShutdown = false;
        selectedId = null;
        selectedSummary = null;
        selectedPreflight = null;
        compiledSpec = null;
        fileName = "preflight-check.cs";
        scriptCode = PreflightTemplate;
        diagnostics = [];
        testResult = null;
        preflightResult = null;
        statusMessage = null;
        statusIsError = false;
        renameOpen = true;
    }

    private async Task OnFileUpload(InputFileChangeEventArgs e)
    {
        filesOpen = false;
        var file = e.File;
        if (file is null) return;
        using var stream = file.OpenReadStream(maxAllowedSize: 512 * 1024);
        using var reader = new StreamReader(stream);
        scriptCode = await reader.ReadToEndAsync();
        fileName = file.Name;
        selectedId = null;
        selectedSummary = null;
        selectedPreflight = null;
        compiledSpec = null;
        testResult = null;
        preflightResult = null;
        diagnostics = [];
        await CompileAndSave();
    }

    private async Task CompileAndSave()
    {
        compiling = true;
        renameOpen = false;
        statusMessage = null;
        statusIsError = false;
        diagnostics = [];
        testResult = null;
        preflightResult = null;
        try
        {
            if (isPreflight)
            {
                var res = await Api.SavePreflightAsync(selectedId, fileName, scriptCode, kind: ProgramKind);
                diagnostics = res.Diagnostics.ToList();
                if (res.Success && res.Script is { } saved)
                {
                    var wasShutdown = isShutdown;
                    await ReloadAllAsync();
                    if (wasShutdown) SelectShutdown(saved); else SelectPreflight(saved);
                    statusMessage = "Saved ✓";
                    statusIsError = false;
                }
                else
                {
                    statusMessage = res.Error ?? "Compilation failed.";
                    statusIsError = true;
                }
            }
            else
            {
                var res = await Api.CompileAndSaveAsync(selectedId, fileName, scriptCode);
                diagnostics = res.Diagnostics.ToList();
                if (res.Success && res.Script is { } saved)
                {
                    await ReloadAllAsync();
                    SelectScenario(saved);
                    statusMessage = "Saved ✓";
                    statusIsError = false;
                }
                else
                {
                    statusMessage = res.Error ?? "Compilation failed.";
                    statusIsError = true;
                }
            }
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            statusIsError = true;
        }
        finally { compiling = false; }
    }

    private void OpenTryDialog()
    {
        if (!canTry) return;
        tryOpen = true;
    }

    private async Task RunTest()
    {
        if (!canTry) return;
        testing = true;
        statusMessage = null;
        statusIsError = false;
        testResult = null;
        preflightResult = null;
        try
        {
            if (isPreflight)
                preflightResult = await Api.TestRunPreflightAsync(selectedPreflight!.ScriptId, Envs.ActiveName, kind: ProgramKind);
            else
                testResult = await Api.TestRunAsync(selectedSummary!.ScriptId, testParams, Envs.ActiveName);
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            statusIsError = true;
        }
        finally { testing = false; }
    }

    private void AddToPlan()
    {
        if (selectedSummary is null) return;
        var scenario = Catalog.Find(selectedSummary.ScenarioId);
        if (scenario is null) return;
        Sim.AddEntry(scenario);
        statusMessage = "Added to plan ✓";
        statusIsError = false;
    }

    private void UseAsPreflight()
    {
        if (selectedPreflight is null) return;
        if (isShutdown) Sim.Plan.ShutdownScriptId = selectedPreflight.ScriptId;
        else Sim.Plan.PreflightScriptId = selectedPreflight.ScriptId;
        statusMessage = $"Set as plan {ProgramName} ✓";
        statusIsError = false;
    }

    private async Task DeleteCurrent()
    {
        try
        {
            if (isPreflight && selectedPreflight is not null)
            {
                var wasShutdown = isShutdown;
                if (!wasShutdown && string.Equals(Sim.Plan.PreflightScriptId, selectedPreflight.ScriptId, StringComparison.OrdinalIgnoreCase))
                    Sim.Plan.PreflightScriptId = null;
                if (wasShutdown && string.Equals(Sim.Plan.ShutdownScriptId, selectedPreflight.ScriptId, StringComparison.OrdinalIgnoreCase))
                    Sim.Plan.ShutdownScriptId = null;
                await Api.DeletePreflightAsync(selectedPreflight.ScriptId, kind: ProgramKind);
                if (wasShutdown) NewShutdownScript(); else NewPreflightScript();
            }
            else if (!isPreflight && selectedSummary is not null)
            {
                await Api.DeleteScriptAsync(selectedSummary.ScriptId, selectedSummary.ScenarioId);
                NewScenarioScript();
            }
            renameOpen = false;
            await ReloadAllAsync();
            statusMessage = "Deleted";
            statusIsError = false;
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            statusIsError = true;
        }
    }

    private void SwitchToLive()
    {
        DataMode.SetFakeMode(false);
        _ = ReloadAllAsync();
    }

    public void Dispose()
    {
        DataMode.Changed -= OnStateChanged;
        Sim.Changed -= OnStateChanged;
    }
}
