    private async Task OnFileUpload(InputFileChangeEventArgs e)
    {
        filesOpen = false;
        var file = e.File;
        if (file is null) return;
        using var stream = file.OpenReadStream(maxAllowedSize: 512 * 1024);
        using var reader = new StreamReader(stream);
        scriptCode = await reader.ReadToEndAsync();
        fileName = file.Name;
        selectedId = null;
        selectedSummary = null;
        selectedPreflight = null;
        compiledSpec = null;
        liveTest = null;
        liveTestPopupOpen = false;
        preflightResult = null;
        diagnostics = [];
        await CompileAndSave();
    }

    private async Task CompileAndSave()
    {
        compiling = true;
        renameOpen = false;
        statusMessage = null;
        statusIsError = false;
        diagnostics = [];
        liveTest = null;
        liveTestPopupOpen = false;
        preflightResult = null;
        try
        {
            if (isPreflight)
            {
                var res = await Api.SavePreflightAsync(selectedId, fileName, scriptCode, kind: ProgramKind);
                diagnostics = res.Diagnostics.ToList();
                if (res.Success && res.Script is { } saved)
                {
                    var wasShutdown = isShutdown;
                    await ReloadAllAsync();
                    if (wasShutdown) SelectShutdown(saved); else SelectPreflight(saved);
                    statusMessage = "Saved ✓";
                    statusIsError = false;
                }
                else
                {
                    statusMessage = res.Error ?? "Compilation failed.";
                    statusIsError = true;
                }
            }
            else
            {
                var res = await Api.CompileAndSaveAsync(selectedId, fileName, scriptCode);
                diagnostics = res.Diagnostics.ToList();
                if (res.Success && res.Script is { } saved)
                {
                    await ReloadAllAsync();
                    SelectScenario(saved);
                    statusMessage = "Saved ✓";
                    statusIsError = false;
                }
                else
                {
                    statusMessage = res.Error ?? "Compilation failed.";
                    statusIsError = true;
                }
            }
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            statusIsError = true;
        }
        finally { compiling = false; }
    }

    private void OpenTryDialog()
    {
        if (!canTry) return;
        tryOpen = true;
    }

    private async Task RunTest()
    {
        if (!canTry) return;
        StopLiveTestPolling();
        testing = true;
        statusMessage = null;
        statusIsError = false;
        liveTest = null;
        liveTestPopupOpen = false;
        liveTest = null;
        preflightResult = null;
        try
        {
            if (isPreflight)
            {
                preflightResult = await Api.TestRunPreflightAsync(selectedPreflight!.ScriptId, Envs.ActiveName, kind: ProgramKind);
                testing = false;
            }
            else
            {
                liveTest = await Api.StartLiveTestRunAsync(selectedSummary!.ScriptId, testParams, Envs.ActiveName);
                tryTab = 0;
                tryStepsExpanded = true;
                tryStepsReset++;
                liveTestPopupOpen = true;
                if (liveTest.Running)
                {
                    StartLiveTestPolling(liveTest.TestRunId);
                }
                else
                {
                    testing = false;
                }
            }
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            statusIsError = true;
            testing = false;
        }
    }

    private void StartLiveTestPolling(string testRunId)
    {
        StopLiveTestPolling();
        liveTestPollCts = new CancellationTokenSource();
        var ct = liveTestPollCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                while (!ct.IsCancellationRequested)
                {
                    await Task.Delay(150, ct);
                    var snap = await Api.GetLiveTestRunAsync(testRunId, ct);
                    if (snap is null) break;
                    liveTest = snap;
                    if (!snap.Running)
                    {
                        testing = false;
                        await InvokeAsync(StateHasChanged);
                        break;
                    }
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException) { }
            catch
            {
                testing = false;
                try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { }
            }
        }, CancellationToken.None);
    }

    private void StopLiveTestPolling()
    {
        liveTestPollCts?.Cancel();
        liveTestPollCts?.Dispose();
        liveTestPollCts = null;
    }

    private async Task StopLiveTestRunAsync()
    {
        if (liveTest is { Running: true } lt)
            await Api.StopLiveTestRunAsync(lt.TestRunId);
    }

    private void CloseLiveTestPopup()
    {
        liveTestPopupOpen = false;
        if (liveTest is not { Running: true })
        {
            StopLiveTestPolling();
            testing = false;
        }
    }

    private void AddToPlan()
    {
        if (selectedSummary is null) return;
        var scenario = Catalog.Find(selectedSummary.ScenarioId);
        if (scenario is null) return;
        Sim.AddEntry(scenario);
        statusMessage = "Added to plan ✓";
        statusIsError = false;
    }

    private void UseAsPreflight()
    {
        if (selectedPreflight is null) return;
        if (isShutdown) Sim.Plan.ShutdownScriptId = selectedPreflight.ScriptId;
        else Sim.Plan.PreflightScriptId = selectedPreflight.ScriptId;
        statusMessage = $"Set as plan {ProgramName} ✓";
        statusIsError = false;
    }

    private async Task DeleteCurrent()
    {
        try
        {
            if (isPreflight && selectedPreflight is not null)
            {
                var wasShutdown = isShutdown;
                if (!wasShutdown && string.Equals(Sim.Plan.PreflightScriptId, selectedPreflight.ScriptId, StringComparison.OrdinalIgnoreCase))
                    Sim.Plan.PreflightScriptId = null;
                if (wasShutdown && string.Equals(Sim.Plan.ShutdownScriptId, selectedPreflight.ScriptId, StringComparison.OrdinalIgnoreCase))
                    Sim.Plan.ShutdownScriptId = null;
                await Api.DeletePreflightAsync(selectedPreflight.ScriptId, kind: ProgramKind);
                if (wasShutdown) NewShutdownScript(); else NewPreflightScript();
            }
            else if (!isPreflight && selectedSummary is not null)
            {
                await Api.DeleteScriptAsync(selectedSummary.ScriptId, selectedSummary.ScenarioId);
                NewScenarioScript();
            }
            renameOpen = false;
            await ReloadAllAsync();
            statusMessage = "Deleted";
            statusIsError = false;
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            statusIsError = true;
        }
    }

    private void SwitchToLive()
    {
        DataMode.SetFakeMode(false);
        _ = ReloadAllAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var runId = liveTestPopupOpen ? liveTest?.TestRunId : null;
        if (runId != tryScrollAttachedRunId)
        {
            if (tryScrollHandle is not null)
            {
                try { await tryScrollHandle.InvokeVoidAsync("dispose"); } catch { }
                try { await tryScrollHandle.DisposeAsync(); } catch { }
                tryScrollHandle = null;
            }
            tryScrollAttachedRunId = runId;
            if (runId is not null)
            {
                try { logScrollMod ??= await JS.InvokeAsync<IJSObjectReference>("import", "./log-scroll.js"); } catch { }
                if (logScrollMod is not null)
                {
                    try { tryScrollHandle = await logScrollMod.InvokeAsync<IJSObjectReference>("attach", tryInspectEl); } catch { }
                }
            }
        }
        else if (runId is not null && tryScrollHandle is not null)
        {
            try { await tryScrollHandle.InvokeVoidAsync("follow"); } catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        StopLiveTestPolling();
        DataMode.Changed -= OnStateChanged;
        Sim.Changed -= OnStateChanged;
        if (tryScrollHandle is not null)
        {
            try { await tryScrollHandle.InvokeVoidAsync("dispose"); } catch { }
            try { await tryScrollHandle.DisposeAsync(); } catch { }
            tryScrollHandle = null;
        }
        if (logScrollMod is not null)
        {
            try { await logScrollMod.DisposeAsync(); } catch { }
            logScrollMod = null;
        }
    }
