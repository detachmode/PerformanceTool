@* The Environment page (brain 0057, 0052): one centred column. The selected environment's static values (fixed during a run), then the runtime data below: the run bag and one
   entry bag per scenario entry; a finished run shows the final values. Calm UI (0016): flat panels, thin rows, details (the full value, who wrote it and when) only on expand.
   Every figure drills down (0029): counts expand, writers open the bee or the scenario entry. Colour carries meaning (0018), so runtime data stays neutral. *@
@page "/environment"
@layout MainLayout
@implements IDisposable
@using System.Text.Json.Nodes
@using Beesharp.Services.Environments
@inject IRunSource Sim
@inject IEnvironmentSource Envs
@inject EnvironmentsPopupState EnvPopup
@inject DataModeState DataMode
@inject NavigationManager Nav

<PageTitle>Environment · Beesharp</PageTitle>

@{
    var s = Sim.Current;
    var rt = s.Runtime;
    var env = Envs.Active;
    var staticRows = env is null ? [] : env.Variables.Where(v => v.Key.Trim().Length > 0 && Match(v.Key)).ToList();
    var staticTotal = env?.Variables.Count(v => v.Key.Trim().Length > 0) ?? 0;
    var filtering = filter.Trim().Length > 0;
    var runRows = rt?.Run.Values.Where(v => Match(v.Key)).ToList() ?? [];
    var total = rt?.TotalValues ?? 0;
    var shownTotal = (rt is null ? 0 : runRows.Count + rt.Entries.Sum(e => e.Values.Count(v => Match(v.Key))));
}

<div class="page env-page">
    @if (staticTotal + total >= 8)
    {
        <div class="env-filterrow">
            <input class="rt-filter" type="search" placeholder="Filter keys…" aria-label="Filter keys" autocomplete="off" spellcheck="false"
                   value="@filter" @oninput="e => filter = e.Value?.ToString() ?? string.Empty" />
        </div>
    }

    @* ---------- static values ---------- *@
    <section class="env-sec" aria-labelledby="env-static">
        <div class="env-head">
            <h2 id="env-static">@(env?.Name ?? "Environment")</h2>
            @if (env is not null) { <span class="muted">fixed during a run</span> }
            <span class="spacer"></span>
            <button type="button" class="btn ghost small" @onclick="() => EnvPopup.Show(Envs.ActiveName)">Configure…</button>
        </div>
        @if (env is null)
        {
            <p class="muted rt-quiet">
                No environment selected, so scenarios get no <code>{{Key}}</code> values.
                @if (Envs.Environments.Count > 0)
                {
                    <span class="rt-pick">Use
                    @foreach (var e in Envs.Environments)
                    {
                        var name = e.Name;
                        <button type="button" class="rt-link" @onclick="() => Envs.SetActive(name)">@name</button>
                    }
                    </span>
                }
            </p>
        }
        else if (staticRows.Count == 0)
        {
            <p class="muted rt-quiet">@(filtering ? "No static key matches." : "This environment has no keys yet. Configure… adds some.")</p>
        }
        else
        {
            <div class="env-card rt-rows" role="list" aria-label="Static values">
                @foreach (var v in staticRows)
                {
                    var id = "s:" + v.Key;
                    <RuntimeRow @key="id" Key="@v.Key" Value="JsonValue.Create(v.Value)" Open="expanded.Contains(id)" Revealed="revealed.Contains(id)"
                                OnToggle="() => Toggle(id)" OnReveal="() => ToggleReveal(id)" />
                }
            </div>
        }
    </section>

    @* ---------- runtime data ---------- *@
    <section class="env-sec" aria-labelledby="env-runtime">
        <div class="env-head">
            <h2 id="env-runtime">Runtime data</h2>
            <span class="muted">written during the run</span>
            <span class="spacer"></span>
            <span class="muted env-state">@StateText(s)</span>
        </div>

        @if (rt is null || total == 0)
        {
            <p class="muted rt-quiet">@EmptyText(s, rt)</p>
        }
        else if (filtering && shownTotal == 0)
        {
            <p class="muted rt-quiet">No runtime key matches “@filter.Trim()”.</p>
        }
        else
        {
            <div class="env-card">
                @if (rt.Run.Values.Count > 0 && (!filtering || runRows.Count > 0))
                {
                    <div class="rt-bag" aria-label="Run bag">
                        <button type="button" class="rt-bag-head" aria-expanded="@Aria.Bool(openRun || filtering)" @onclick="() => openRun = !openRun">
                            <span class="rt-bag-name">Run bag</span>
                            <span class="spacer"></span>
                            <span class="rt-count">@Count(runRows.Count, rt.Run.Values.Count)</span><i class="rt-caret" aria-hidden="true">@((openRun || filtering) ? "▾" : "▸")</i>
                        </button>
                        @if (openRun || filtering)
                        {
                            <div class="rt-rows" role="list">
                                @foreach (var v in runRows)
                                {
                                    var id = "r:" + v.Key;
                                    <RuntimeRow @key="v" Key="@v.Key" Value="v.Value" Written="v" WriterText="@WriterText(s, v.Writer)" Fresh="fresh.Contains(v)"
                                                Open="expanded.Contains(id)" Revealed="revealed.Contains(id)"
                                                OnToggle="() => Toggle(id)" OnReveal="() => ToggleReveal(id)" OnWriter="() => OpenWriter(v.Writer)" />
                                }
                            </div>
                        }
                    </div>
                }
                @foreach (var bag in rt.Entries)
                {
                    var entry = bag.Entry;
                    var rows = bag.Values.Where(v => Match(v.Key)).ToList();
                    if (bag.Values.Count == 0 || (filtering && rows.Count == 0)) continue;
                    var open = filtering || openEntries.Contains(entry);
                    <div class="rt-bag" aria-label="Entry bag of @Label(s, entry)">
                        <div class="rt-bag-head">
                            <button type="button" class="rt-link rt-bag-name" title="Open this scenario entry" @onclick="() => OpenEntry(entry, null)">@Label(s, entry)</button>
                            <span class="muted rt-note">entry bag</span>
                            <span class="spacer"></span>
                            <button type="button" class="rt-count rt-count-btn" aria-expanded="@Aria.Bool(open)" @onclick="() => ToggleEntry(entry)">
                                @Count(rows.Count, bag.Values.Count)<i class="rt-caret" aria-hidden="true">@(open ? "▾" : "▸")</i>
                            </button>
                        </div>
                        @if (open)
                        {
                            <div class="rt-rows" role="list">
                                @foreach (var v in rows)
                                {
                                    var id = $"e{entry}:{v.Key}";
                                    <RuntimeRow @key="v" Key="@v.Key" Value="v.Value" Written="v" WriterText="@WriterText(s, v.Writer)" Fresh="fresh.Contains(v)"
                                                Open="expanded.Contains(id)" Revealed="revealed.Contains(id)"
                                                OnToggle="() => Toggle(id)" OnReveal="() => ToggleReveal(id)" OnWriter="() => OpenWriter(v.Writer)" />
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </section>
</div>

@if (openEntry is { } oe && oe < s.Count)
{
    <ScenarioDetailDialog @key="(oe, openBee)" Index="oe" Snapshot="s" InitialBee="openBee" OnClose="CloseDialog" />
}

@if (openProgram is { } kind)
{
    var isShutdown = kind == DataWriterKind.Shutdown;
    <ProgramDialog Kind="@(isShutdown ? "Shutdown program" : "Preflight")" Run="@(isShutdown ? s.Shutdown : s.Preflight)"
                   ScriptId="@(isShutdown ? s.Plan.ShutdownScriptId : s.Plan.PreflightScriptId)" OnClose="() => openProgram = null" />
}

@code {
    private DataWriterKind? openProgram;
    private string filter = "";
    private bool openRun = true;
    private readonly HashSet<int> openEntries = [];
    private readonly HashSet<string> expanded = [], revealed = [];
    private int? openEntry, openBee;

    // Live values (brain 0052): a value that was written since the last update gets a short, neutral fade. Its element is re-created per write (@key = the value).
    private readonly Dictionary<string, RuntimeValue> previous = [];
    private readonly HashSet<RuntimeValue> fresh = new(ReferenceEqualityComparer.Instance);
    private object? previousRun;

    protected override void OnInitialized()
    {
        Remember(initial: true);
        Sim.Changed += OnChanged;
        Envs.Changed += OnChanged;
        DataMode.Changed += OnChanged;
    }

    private void OnChanged()
    {
        try { _ = InvokeAsync(() => { Remember(initial: false); StateHasChanged(); }); }
        catch (ObjectDisposedException) { }
    }

    /// <summary>Compares the values with the ones of the last update to find which were written since.</summary>
    private void Remember(bool initial)
    {
        var s = Sim.Current;
        var runKey = s.Store;
        if (!ReferenceEquals(runKey, previousRun)) { previous.Clear(); fresh.Clear(); previousRun = runKey; }
        var now = new Dictionary<string, RuntimeValue>();
        if (s.Runtime is { } rt)
        {
            foreach (var v in rt.Run.Values) now["r:" + v.Key] = v;
            foreach (var b in rt.Entries) foreach (var v in b.Values) now[$"e{b.Entry}:{v.Key}"] = v;
        }
        if (!initial)
            foreach (var (id, v) in now)
                if (previous.TryGetValue(id, out var old) && !ReferenceEquals(old, v)) fresh.Add(v);
        fresh.IntersectWith(now.Values);
        previous.Clear();
        foreach (var (id, v) in now) previous[id] = v;
    }

    private bool Match(string key) => filter.Trim().Length == 0 || key.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase);

    private static string Count(int shown, int total) => shown == total ? Format.Plural(total, "value", "values") : $"{shown} of {total} values";

    private static string Label(RunSnapshot s, int entry) => entry >= 0 && entry < s.Labels.Count ? s.Labels[entry] : $"Entry {entry + 1}";

    private string StateText(RunSnapshot s) => s.State switch
    {
        FakeRunState.Running => $"Running · {Format.Time(s.Elapsed)} · values update live",
        FakeRunState.Paused => $"Paused · {Format.Time(s.Elapsed)}",
        FakeRunState.Finished => $"Finished run · final values",
        _ => "No run yet"
    };

    private string EmptyText(RunSnapshot s, RuntimeDataSnapshot? rt) =>
        s.State == FakeRunState.Idle ? "Start a run: what the preflight and scenarios write shows up here."
        : rt is null && !DataMode.IsFakeMode ? "Loading runtime data…"
        : s.Running ? "Nothing written yet."
        : "This run wrote no runtime data.";

    private void ToggleEntry(int entry) { if (!openEntries.Remove(entry)) openEntries.Add(entry); }
    private void Toggle(string id) { if (!expanded.Remove(id)) expanded.Add(id); }
    private void ToggleReveal(string id) { if (!revealed.Remove(id)) revealed.Add(id); }
    private void OpenEntry(int entry, int? bee) { openEntry = entry; openBee = bee; }
    private void CloseDialog() { openEntry = null; openBee = null; }

    private void OpenWriter(DataWriter w)
    {
        switch (w.Kind)
        {
            case DataWriterKind.Bee: OpenEntry(w.Entry, w.Bee); break;
            case DataWriterKind.Startup or DataWriterKind.Teardown: OpenEntry(w.Entry, null); break;
            default: openProgram = w.Kind; break; // the preflight and shutdown programs: their output (brain 0029)
        }
    }

    private static string WriterText(RunSnapshot s, DataWriter w) => w.Kind switch
    {
        DataWriterKind.Preflight => "Preflight",
        DataWriterKind.Startup => $"Startup · {Label(s, w.Entry)}",
        DataWriterKind.Bee => $"B{w.Bee + 1} · {Label(s, w.Entry)}",
        DataWriterKind.Teardown => $"Teardown · {Label(s, w.Entry)}",
        _ => "Shutdown"
    };

    public void Dispose()
    {
        Sim.Changed -= OnChanged;
        Envs.Changed -= OnChanged;
        DataMode.Changed -= OnChanged;
    }
}
