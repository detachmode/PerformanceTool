@* 3D Views page (/3d): interactive Canvas 2D 3D terrain (Scenario/Step × Time × Duration), latency distribution surface
   (Latency Band × Time × Bee Count), and Run History comparison across previous runs of one scenario. *@
@page "/3d"
@layout MainLayout
@implements IAsyncDisposable
@inject IRunSource Sim
@inject DataModeState DataMode
@inject ApiRunSource ApiRun
@inject LogsLinks Logs
@inject CallsLinks Calls
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PhoneState Phone

<PageTitle>3D Views · Beesharp</PageTitle>

@{
    var snap = Sim.Current;
    var hasStepsScenarios = HasAnySteps(snap);
    var activeRunHasPlayer = snap.Running || snap.Paused;
    var totalFinished = snap.Scenarios.Sum(x => x.Finished);
    var totalSlow = snap.Scenarios.Sum(x => x.SlowBees);
    var totalFailed = snap.Scenarios.Sum(x => x.Failed);
    var totalOk = Math.Max(0, totalFinished - totalSlow - totalFailed);
    var hasSceneData = activeKind switch
    {
        Views3DKind.Terrain => terrainScene?.HasData ?? false,
        Views3DKind.Surface => surfaceScene?.HasData ?? false,
        _ => historyScene?.HasData ?? false,
    };
}

<div class="v3d-page @(activeRunHasPlayer ? "has-player" : "") @(Phone.IsPhone ? "v3d-phone" : "")">
    <header class="v3d-topbar">
        <div class="seg" role="tablist" aria-label="3D view">
            <button type="button"
                    class="@(activeKind == Views3DKind.Terrain ? "on" : "")"
                    role="tab"
                    aria-selected="@Aria.Bool(activeKind == Views3DKind.Terrain)"
                    @onclick="() => SetViewKind(Views3DKind.Terrain)">
                1. Scenario Terrain
            </button>
            <button type="button"
                    class="@(activeKind == Views3DKind.Surface ? "on" : "")"
                    role="tab"
                    aria-selected="@Aria.Bool(activeKind == Views3DKind.Surface)"
                    @onclick="() => SetViewKind(Views3DKind.Surface)">
                2. Latency Surface
            </button>
            <button type="button"
                    class="@(activeKind == Views3DKind.RunHistory ? "on" : "")"
                    role="tab"
                    aria-selected="@Aria.Bool(activeKind == Views3DKind.RunHistory)"
                    @onclick="() => SetViewKind(Views3DKind.RunHistory)">
                3. Run History
            </button>
        </div>

        <div class="v3d-run-summary tnum" aria-label="Run totals">
            <span class="muted">@(DataMode.IsFakeMode ? "Fake" : ApiRun.IsViewingHistory ? "History" : "Live") · @Format.Time(snap.Elapsed)</span>
            <span class="good">@Format.Num(totalOk) ok</span>
            <span class="warn">@Format.Num(totalSlow) slow</span>
            <span class="bad">@Format.Num(totalFailed) failed</span>
        </div>

        <div class="spacer"></div>

        <div class="seg v3d-cams" role="group" aria-label="Camera presets">
            <button type="button" class="@(activePreset == CameraPreset.Iso ? "on" : "")" @onclick="() => SetCameraAsync(CameraPreset.Iso)">Isometric</button>
            <button type="button" class="@(activePreset == CameraPreset.Top ? "on" : "")" @onclick="() => SetCameraAsync(CameraPreset.Top)">Top-Down (2D)</button>
            <button type="button" class="@(activePreset == CameraPreset.Front ? "on" : "")" @onclick="() => SetCameraAsync(CameraPreset.Front)">Front</button>
            <button type="button" class="@(activePreset == CameraPreset.Side ? "on" : "")" @onclick="() => SetCameraAsync(CameraPreset.Side)">Side</button>
        </div>
    </header>

    <div class="v3d-main">
        <div class="v3d-stage-wrap">
            <div class="v3d-toolbar">
                @if (activeKind == Views3DKind.Terrain)
                {
                    <div class="v3d-sub">
                        <button type="button"
                                class="chip @(terrainGrouping == TerrainGrouping.Scenarios ? "on" : "")"
                                @onclick="() => SetTerrainGrouping(TerrainGrouping.Scenarios)">
                            By Scenario (@snap.Count)
                        </button>
                        @if (hasStepsScenarios)
                        {
                            <button type="button"
                                    class="chip @(terrainGrouping == TerrainGrouping.Steps ? "on" : "")"
                                    @onclick="() => SetTerrainGrouping(TerrainGrouping.Steps)">
                                By Step
                            </button>
                            @if (terrainGrouping == TerrainGrouping.Steps)
                            {
                                var chosenEntry = terrainScene?.ScenarioEntry ?? Views3DProjection.ResolveStepScenarioEntry(snap, selectedStepScenario);
                                <select class="v3d-select" aria-label="Scenario for step breakdown" value="@chosenEntry" @onchange="OnStepScenarioChanged">
                                    @for (var i = 0; i < snap.Count; i++)
                                    {
                                        var idx = i;
                                        if (!snap.StepsOf(idx).Any) continue;
                                        <option value="@idx">@(idx + 1). @snap.Labels[idx] (@snap.StepsOf(idx).Count steps)</option>
                                    }
                                </select>
                            }
                        }
                    </div>
                }
                else if (activeKind == Views3DKind.Surface)
                {
                    <div class="v3d-sub">
                        <button type="button"
                                class="chip @(surfaceScenarioFilter is null ? "on" : "")"
                                @onclick="() => SetSurfaceScenarioFilter(null)">
                            All Scenarios
                        </button>
                        @if (snap.Count > 1)
                        {
                            <select class="v3d-select" aria-label="Filter latency surface by scenario" value="@(surfaceScenarioFilter?.ToString() ?? "")" @onchange="OnSurfaceScenarioChanged">
                                <option value="">Choose scenario…</option>
                                @for (var i = 0; i < snap.Count; i++)
                                {
                                    var idx = i;
                                    <option value="@idx">@(idx + 1). @snap.Labels[idx]</option>
                                }
                            </select>
                        }
                    </div>
                }
                else
                {
                    var chosenHistEntry = historyScene is { ScenarioEntry: >= 0 } hs ? hs.ScenarioEntry : Views3DProjection.ResolveHistoryScenarioEntry(snap, selectedHistoryScenario);
                    <div class="v3d-sub">
                        @if (snap.Count > 0)
                        {
                            <select class="v3d-select" aria-label="Scenario to compare across runs" value="@chosenHistEntry" @onchange="OnHistoryScenarioChanged">
                                @for (var i = 0; i < snap.Count; i++)
                                {
                                    var idx = i;
                                    <option value="@idx">@(idx + 1). @snap.Labels[idx]</option>
                                }
                            </select>
                        }
                        <button type="button"
                                class="chip @(historySameSetupOnly ? "on" : "")"
                                title="Only include previous runs with the same scenario setup (rate / burst shape)"
                                @onclick="ToggleHistorySameSetupAsync">
                            Same setup only
                        </button>
                        @if (!DataMode.IsFakeMode)
                        {
                            <button type="button"
                                    class="chip"
                                    disabled="@historyLoading"
                                    title="Re-scan stored runs from the server"
                                    @onclick="RefreshLiveHistoryAsync">
                                @(historyLoading ? "Loading…" : "Refresh")
                            </button>
                        }
                    </div>
                }

                <div class="v3d-hint">Drag to orbit · Scroll to zoom · Click any bar to inspect</div>
            </div>

            <canvas class="v3d-canvas" @ref="canvasEl" aria-label="Interactive 3D run chart"></canvas>
            <div class="v3d-tooltip" @ref="tooltipEl" role="status" aria-live="off"></div>

            @if (!hasSceneData)
            {
                <div class="v3d-empty">
                    @if (activeKind == Views3DKind.RunHistory && historyLoading)
                    {
                        <p>Loading matching previous runs…</p>
                    }
                    else if (snap.State == FakeRunState.Idle && totalFinished == 0 && !(activeKind == Views3DKind.RunHistory && historyScene is { Lanes.Count: > 1 }))
                    {
                        <p>No run data yet. Start a run from the player bar or pick a stored run to explore it in 3D.</p>
                    }
                    else if (activeKind == Views3DKind.Terrain && terrainGrouping == TerrainGrouping.Steps && !string.IsNullOrEmpty(terrainScene?.Note))
                    {
                        <p>@terrainScene.Note</p>
                    }
                    else if (activeKind == Views3DKind.RunHistory && !string.IsNullOrEmpty(historyScene?.Note))
                    {
                        <p>@historyScene.Note</p>
                    }
                    else
                    {
                        <p>Waiting for finished bees…</p>
                    }
                </div>
            }

            <div class="v3d-legend" aria-hidden="true">
                <span><i class="dot" style="background:var(--good)"></i>Good</span>
                <span><i class="dot" style="background:var(--slow)"></i>Slow (&gt;2× typical)</span>
                <span><i class="dot" style="background:var(--failed)"></i>Failed / Canceled</span>
                @if (activeKind is Views3DKind.Terrain or Views3DKind.RunHistory)
                {
                    <span><i class="dot" style="background:var(--running)"></i>In flight</span>
                }
            </div>
        </div>

        <aside class="v3d-sidebar" aria-label="3D Inspector">
            <section class="v3d-card">
                <h3>Current View</h3>
                @if (activeKind == Views3DKind.Terrain)
                {
                    <div class="v3d-view-title">1. Scenario &amp; Step Terrain</div>
                    <p class="v3d-desc">
                        X = run time, Z = @(terrainGrouping == TerrainGrouping.Steps ? "declared steps" : "scenario entries"), Y = avg duration.
                        Switch to Top-Down (2D) for exact time alignment.
                    </p>
                    @if (!string.IsNullOrEmpty(terrainScene?.Note))
                    {
                        <p class="v3d-note">@terrainScene.Note</p>
                    }
                }
                else if (activeKind == Views3DKind.Surface)
                {
                    <div class="v3d-view-title">2. Latency Distribution Surface</div>
                    <p class="v3d-desc">
                        X = run time, Z = adaptive duration band, Y = bee count.
                        Shows cache-hit ridges vs slow/failed tail mountains over time.
                    </p>
                }
                else
                {
                    <div class="v3d-view-title">3. Run History</div>
                    <p class="v3d-desc">
                        X = shared run time, Z = runs (Current in front), Y = longest bee (<code class="v3d-code">MaxMs</code>).
                        Switch to Front view to stack the 2D scenario bar charts behind one another.
                    </p>
                    @if (historyScene is { ScenarioLabel.Length: > 0 } hsInfo)
                    {
                        <div class="v3d-hist-setup">@hsInfo.ScenarioLabel · @hsInfo.ScenarioSetup</div>
                    }
                    @if (DataMode.IsFakeMode)
                    {
                        <p class="v3d-note">Fake mode: comparing Current against 3 deterministic simulated runs.</p>
                    }
                }
            </section>

            <section class="v3d-card">
                @if (activeKind == Views3DKind.RunHistory)
                {
                    var allCandidates = VisibleHistoryCandidates();
                    var hiddenDiffCount = historySameSetupOnly ? AllHistoryCandidates().Count(c => !c.SetupMatches) : 0;
                    var currentLane = historyScene?.Lanes.FirstOrDefault(l => l.IsCurrent);
                    <h3>Compared Runs (@(historyScene?.Lanes.Count ?? 0)/6)</h3>
                    <div class="v3d-lane-list">
                        @if (currentLane is not null)
                        {
                            var iso = isolatedLane == currentLane.Index;
                            var metaCls = currentLane.FailedBees > 0 ? "bad" : currentLane.SlowBees > 0 ? "warn" : "";
                            <button type="button"
                                    class="v3d-lane-btn @(iso ? "isolated" : "")"
                                    aria-pressed="@Aria.Bool(iso)"
                                    @onclick="() => ToggleIsolatedLaneAsync(currentLane.Index)">
                                <span class="v3d-lane-name">@currentLane.Name</span>
                                <span class="v3d-lane-meta @metaCls">@currentLane.Meta</span>
                            </button>
                        }
                        @foreach (var cand in allCandidates)
                        {
                            var checkedRun = IsCandidateSelected(cand.RunId);
                            var activeLane = historyScene?.Lanes.FirstOrDefault(l => !l.IsCurrent && string.Equals(l.RunId, cand.RunId, StringComparison.Ordinal));
                            var iso = activeLane is not null && isolatedLane == activeLane.Index;
                            var isStopped = string.Equals(cand.State, "Stopped", StringComparison.OrdinalIgnoreCase)
                                || string.Equals(cand.State, "Canceled", StringComparison.OrdinalIgnoreCase);
                            var statusCls = isStopped || cand.FailedBees > 0 ? "bad" : cand.SlowBees > 0 ? "warn" : "";
                            var canCheckMore = checkedRun || SelectedPreviousCount() < 5;
                            <div class="v3d-hist-row @(iso ? "isolated" : "") @(checkedRun ? "checked" : "")">
                                <label class="v3d-hist-chk" title="@(canCheckMore ? "Include or exclude this run (max 5 previous runs)" : "Maximum 5 previous runs selected")">
                                    <input type="checkbox"
                                           checked="@checkedRun"
                                           disabled="@(!canCheckMore)"
                                           @onchange="() => ToggleHistoryCandidateAsync(cand)" />
                                </label>
                                <button type="button"
                                        class="v3d-hist-pick"
                                        @onclick="() => OnHistoryCandidateClickedAsync(cand, activeLane)">
                                    <div class="v3d-hist-top">
                                        <span class="v3d-lane-name">@cand.Label</span>
                                        <span class="v3d-lane-meta @statusCls">
                                            @(isStopped ? $"Stopped @ {Format.Time(cand.ElapsedSeconds)}" : Format.Time(cand.ElapsedSeconds))
                                        </span>
                                    </div>
                                    <div class="v3d-hist-sub">
                                        <span class="v3d-badge @(cand.SetupMatches ? "match" : "diff")">@cand.SetupBadge</span>
                                        <span>@cand.StartedUtc.LocalDateTime.ToString("MMM d HH:mm")</span>
                                        <span>@Format.Num(cand.TotalBees) bees</span>
                                        @if (cand.FailedBees > 0)
                                        {
                                            <span class="bad">@cand.FailedBees failed</span>
                                        }
                                    </div>
                                </button>
                            </div>
                        }
                        @if (allCandidates.Count == 0)
                        {
                            <p class="v3d-desc">
                                @(historyLoading
                                    ? "Scanning stored runs…"
                                    : "No matching previous runs found.")
                            </p>
                        }
                        @if (hiddenDiffCount > 0)
                        {
                            <button type="button" class="chip v3d-hist-more" @onclick="ToggleHistorySameSetupAsync">
                                Show @hiddenDiffCount @(hiddenDiffCount == 1 ? "run" : "runs") with different setup
                            </button>
                        }
                    </div>
                }
                else
                {
                <h3>@(activeKind == Views3DKind.Terrain ? (terrainGrouping == TerrainGrouping.Steps ? "Isolate Step Lane" : "Isolate Scenario Lane") : "Isolate Latency Band")</h3>
                <div class="v3d-lane-list">
                    @if (activeKind == Views3DKind.Terrain && terrainScene is { Lanes.Count: > 0 } ts)
                    {
                        @foreach (var lane in ts.Lanes)
                        {
                            var idx = lane.Index;
                            var iso = isolatedLane == idx;
                            var metaCls = lane.FailedBees > 0 ? "bad" : lane.SlowBees > 0 ? "warn" : "";
                            <button type="button"
                                    class="v3d-lane-btn @(iso ? "isolated" : "")"
                                    aria-pressed="@Aria.Bool(iso)"
                                    @onclick="() => ToggleIsolatedLaneAsync(idx)">
                                <span class="v3d-lane-name">@lane.Name</span>
                                <span class="v3d-lane-meta @metaCls">@lane.Meta</span>
                            </button>
                        }
                    }
                    else if (activeKind == Views3DKind.Surface && surfaceScene is { Bands.Count: > 0 } ss)
                    {
                        @foreach (var band in ss.Bands)
                        {
                            var idx = band.Index;
                            var iso = isolatedLane == idx;
                            <button type="button"
                                    class="v3d-lane-btn @(iso ? "isolated" : "")"
                                    aria-pressed="@Aria.Bool(iso)"
                                    @onclick="() => ToggleIsolatedLaneAsync(idx)">
                                <span class="v3d-lane-name">@band.Label</span>
                                <span class="v3d-lane-meta @(band.IsSlow ? "warn" : "good")">@(band.IsSlow ? "slow band" : "typical")</span>
                            </button>
                        }
                    }
                    else
                    {
                        <p class="v3d-desc">No lanes available yet.</p>
                    }
                </div>
                }
            </section>

            <section class="v3d-card">
                <h3>Selection Inspector</h3>
                @if (activeKind == Views3DKind.Terrain && selectedTerrainCell is { } tc)
                {
                    var laneName = terrainScene is not null && tc.LaneIndex < terrainScene.Lanes.Count
                        ? terrainScene.Lanes[tc.LaneIndex].Name
                        : $"Scenario {tc.Entry + 1}";
                    var durCls = tc.FailedCount > 0 ? "bad" : tc.SlowCount > 0 || tc.Ratio >= SlowCallRule.Factor ? "warn" : "good";
                    var scnFilter = BuildTerrainScenarioFilter(tc);
                    <div class="v3d-sel-title">@laneName</div>
                    <div class="v3d-desc">Window @tc.TimeLabel</div>
                    <div class="v3d-stat-grid">
                        <div class="v3d-stat">
                            <div class="k">Avg duration</div>
                            <div class="v @durCls">@(tc.BeeCount > 0 ? Format.Ms(tc.AvgDurationMs) : "–")</div>
                        </div>
                        <div class="v3d-stat">
                            <div class="k">Max duration</div>
                            <div class="v @durCls">@Format.Ms(tc.MaxDurationMs)</div>
                        </div>
                        <div class="v3d-stat">
                            <div class="k">Bees</div>
                            <div class="v">@Format.Num(tc.BeeCount)@(tc.InFlightCount > 0 ? $" (+{tc.InFlightCount})" : "")</div>
                        </div>
                        <div class="v3d-stat">
                            <div class="k">Slow / Failed</div>
                            <div class="v">
                                <span class="@(tc.SlowCount > 0 ? "warn" : "")">@tc.SlowCount</span>
                                <span class="muted"> / </span>
                                <span class="@(tc.FailedCount > 0 ? "bad" : "")">@tc.FailedCount</span>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(tc.SampleError))
                    {
                        <div class="v3d-err-box">@tc.SampleError</div>
                    }
                    <div class="v3d-actions">
                        <a class="chip" href="@ScenarioLink.Href(tc.Entry, scnFilter)">Open /scenario/@(tc.Entry + 1) →</a>
                        @if (tc.SampleBeeSequence is { } seq)
                        {
                            <a class="chip" href="@ScenarioLink.Href(tc.Entry, new ScenarioFilter(Bee: seq))">Bee B@(seq + 1) →</a>
                        }
                        <button type="button" class="chip" @onclick="() => OpenTerrainLogs(tc)">View Logs →</button>
                    </div>
                }
                else if (activeKind == Views3DKind.Surface && selectedSurfaceCell is { } sc)
                {
                    var statusCls = sc.FailedCount > 0 ? "bad" : sc.SlowCount > 0 ? "warn" : "good";
                    var targetEntry = sc.ScenarioEntryFilter ?? sc.DominantEntry;
                    <div class="v3d-sel-title">Latency Band: @sc.BandLabel</div>
                    <div class="v3d-desc">Window @sc.TimeLabel</div>
                    <div class="v3d-stat-grid">
                        <div class="v3d-stat">
                            <div class="k">Bees in band</div>
                            <div class="v">@Format.Num(sc.Count)</div>
                        </div>
                        <div class="v3d-stat">
                            <div class="k">Slow / Failed</div>
                            <div class="v">
                                <span class="@(sc.SlowCount > 0 ? "warn" : "")">@sc.SlowCount</span>
                                <span class="muted"> / </span>
                                <span class="@(sc.FailedCount > 0 ? "bad" : "")">@sc.FailedCount</span>
                            </div>
                        </div>
                        <div class="v3d-stat">
                            <div class="k">Avg duration</div>
                            <div class="v @statusCls">@Format.Ms(sc.AvgDurationMs)</div>
                        </div>
                        <div class="v3d-stat">
                            <div class="k">Max duration</div>
                            <div class="v @statusCls">@Format.Ms(sc.MaxDurationMs)</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(sc.SampleError))
                    {
                        <div class="v3d-err-box">@sc.SampleError</div>
                    }
                    <div class="v3d-actions">
                        @if (targetEntry is { } entry)
                        {
                            var sf = sc.FailedCount > 0 ? new ScenarioFilter(DetailFilter.Failed)
                                : sc.SlowCount > 0 ? new ScenarioFilter(DetailFilter.Slow)
                                : ScenarioFilter.Default;
                            <a class="chip" href="@ScenarioLink.Href(entry, sf)">Open /scenario/@(entry + 1) →</a>
                        }
                        @if (sc.SampleBeeSequence is { } seq && targetEntry is { } bEntry)
                        {
                            <a class="chip" href="@ScenarioLink.Href(bEntry, new ScenarioFilter(Bee: seq))">Bee B@(seq + 1) →</a>
                        }
                        <button type="button" class="chip" @onclick="() => OpenSurfaceLogs(sc)">View Logs →</button>
                        <button type="button" class="chip" @onclick="() => OpenSurfaceCalls(sc)">Filter /calls →</button>
                    </div>
                }
                else if (activeKind == Views3DKind.RunHistory && selectedHistoryCell is { } hc && historyScene is not null && hc.LaneIndex < historyScene.Lanes.Count)
                {
                    var lane = historyScene.Lanes[hc.LaneIndex];
                    var durCls = hc.FailedCount > 0 ? "bad" : hc.SlowCount > 0 || hc.Step >= SlowCallRule.MaxStep ? "warn" : "good";
                    <div class="v3d-hist-sel-meta">
                        <span class="v3d-badge @(lane.IsStopped ? "bad" : lane.IsCurrent ? "match" : "")">@(lane.EndLabel ?? lane.State)</span>
                        <span>@lane.Name</span>
                        <span class="muted">@lane.StartedUtc.LocalDateTime.ToString("MMM d HH:mm")</span>
                    </div>
                    @if (hc.IsSingleBee && hc.BeeSequence is { } seq)
                    {
                        <div class="v3d-sel-title">Bee #@(seq + 1) · @Format.Ms(hc.MaxDurationMs)</div>
                        <div class="v3d-desc">Single bee · started @Format.Time(hc.StartSec)</div>
                    }
                    else
                    {
                        <div class="v3d-sel-title">Group · @Format.Num(hc.BeeCount + hc.RunningCount) bees · longest @Format.Ms(hc.MaxDurationMs)</div>
                        <div class="v3d-desc">@hc.FailedCount failed · @hc.SlowCount slow · window @hc.TimeLabel</div>
                    }
                    <div class="v3d-stat-grid">
                        <div class="v3d-stat">
                            <div class="k">Longest bee</div>
                            <div class="v @durCls">@Format.Ms(hc.MaxDurationMs)</div>
                        </div>
                        <div class="v3d-stat">
                            <div class="k">Bees</div>
                            <div class="v">@(hc.IsSingleBee ? "1" : Format.Num(hc.BeeCount))@(hc.RunningCount > 0 ? $" (+{hc.RunningCount})" : "")</div>
                        </div>
                        <div class="v3d-stat">
                            <div class="k">Slow / Failed</div>
                            <div class="v">
                                <span class="@(hc.SlowCount > 0 ? "warn" : "")">@hc.SlowCount</span>
                                <span class="muted"> / </span>
                                <span class="@(hc.FailedCount > 0 ? "bad" : "")">@hc.FailedCount</span>
                            </div>
                        </div>
                        <div class="v3d-stat">
                            <div class="k">@(hc.IsSingleBee ? "Started" : "Window")</div>
                            <div class="v">@(hc.IsSingleBee ? Format.Time(hc.StartSec) : hc.TimeLabel)</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(hc.SampleError))
                    {
                        <div class="v3d-err-box">@hc.SampleError</div>
                    }
                    <div class="v3d-actions">
                        @if (lane.IsCurrent)
                        {
                            <a class="chip" href="@ScenarioLink.Href(hc.Entry, BuildHistoryScenarioFilter(hc))">Open /scenario/@(hc.Entry + 1) →</a>
                            @if (hc.BeeSequence is { } bseq)
                            {
                                <a class="chip" href="@ScenarioLink.Href(hc.Entry, new ScenarioFilter(Bee: bseq))">Bee B@(bseq + 1) →</a>
                            }
                            <button type="button" class="chip" @onclick="() => OpenHistoryLogs(hc)">View Logs →</button>
                        }
                        else if (!DataMode.IsFakeMode && !string.IsNullOrEmpty(lane.RunId))
                        {
                            <button type="button"
                                    class="chip"
                                    disabled="@(Sim.IsRunning || loadingStoredRun)"
                                    title="@(Sim.IsRunning ? "Stop the active run before loading a stored run" : $"Load run {lane.RunId} and open /scenario/{hc.Entry + 1}")"
                                    @onclick="() => LoadAndOpenStoredRunAsync(lane, hc)">
                                @(loadingStoredRun ? "Loading…" : $"Load run & open /scenario/{hc.Entry + 1} →")
                            </button>
                        }
                        else
                        {
                            <span class="v3d-desc">Simulated previous run (stored-run drill-down works in Live mode).</span>
                        }
                    </div>
                }
                else
                {
