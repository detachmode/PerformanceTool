    private void RebuildScene()
    {
        var snap = Sim.Current;
        var fakeModeChanged = lastFakeMode != DataMode.IsFakeMode;
        var modeOrRunChanged = fakeModeChanged
            || !string.Equals(lastRunId, ApiRun.CurrentRunId, StringComparison.Ordinal)
            || (lastRunState != FakeRunState.Finished && snap.State == FakeRunState.Finished);
        lastRebuildTick = Environment.TickCount64;
        lastRunState = snap.State;
        lastFakeMode = DataMode.IsFakeMode;
        lastRunId = ApiRun.CurrentRunId;

        if (modeOrRunChanged)
        {
            historyLoadedForKey = null;
            callsMatrixLoadedForKey = null;
            lastCallsMatrixFetchTick = 0;
            liveCallEndpointsByEntry.Clear();
            if (fakeModeChanged)
                selectedHistoryRunIds = null;
        }

        if (activeKind == Views3DKind.Terrain)
        {
            terrainScene = Views3DProjection.BuildTerrain(snap, terrainGrouping, selectedStepScenario, gridBucketOverride);
            if (terrainGrouping == TerrainGrouping.Steps && terrainScene.ScenarioEntry is { } resolved)
                selectedStepScenario = resolved;
            currentPayload = Views3DProjection.ToJsPayload(terrainScene);
            MaybePrefetchStepDetails(snap, terrainScene);
        }
        else if (activeKind == Views3DKind.Surface)
        {
            surfaceScene = Views3DProjection.BuildSurface(snap, surfaceScenarioFilter, gridBucketOverride);
            currentPayload = Views3DProjection.ToJsPayload(surfaceScene);
        }
        else if (activeKind == Views3DKind.RunHistory)
        {
            var entry = Views3DProjection.ResolveHistoryScenarioEntry(snap, selectedHistoryScenario);
            if (entry >= 0) selectedHistoryScenario = entry;

            IReadOnlyList<HistoryRunInput> previousInputs;
            if (DataMode.IsFakeMode)
            {
                fakeHistoryInputs = entry >= 0 ? Views3DProjection.SynthesizeFakeHistoryRuns(snap, entry) : [];
                fakeCandidates = fakeHistoryInputs
                    .Select(r => new HistoryRunCandidate(r.RunId, r.Label, r.StartedUtc, r.State, r.ElapsedSeconds, r.Entry, r.SetupMatches, r.SetupBadge, r.TotalBeesOverride ?? r.Bees.Count, r.FailedBeesOverride ?? 0, r.SlowBeesOverride ?? 0))
                    .ToList();
                previousInputs = fakeHistoryInputs
                    .Where(r => (!historySameSetupOnly || r.SetupMatches) && IsCandidateSelected(r.RunId))
                    .Take(5)
                    .ToList();
            }
            else
            {
                var key = $"{ApiRun.CurrentRunId}|{entry}";
                if (entry >= 0 && !string.Equals(historyLoadedForKey, key, StringComparison.Ordinal))
                {
                    historyLoadedForKey = key;
                    _ = LoadLiveHistoryAsync(entry);
                }

                var selected = VisibleHistoryCandidates()
                    .Where(c => IsCandidateSelected(c.RunId))
                    .Take(5);
                var list = new List<HistoryRunInput>();
                foreach (var cand in selected)
                {
                    if (liveRunInputs.TryGetValue(cand.RunId, out var input))
                        list.Add(input);
                }
                previousInputs = list;
            }

            historyScene = Views3DProjection.BuildRunHistory(
                snap,
                entry,
                previousInputs,
                DataMode.IsFakeMode ? "fake-current" : ApiRun.CurrentRunId,
                DataMode.IsFakeMode ? DateTimeOffset.UtcNow : ApiRun.ActiveStartedUtc,
                gridBucketOverride);
            currentPayload = Views3DProjection.ToJsPayload(historyScene);
        }
        else if (activeKind == Views3DKind.ErrorCascade)
        {
            errorScene = Views3DProjection.BuildErrorCascade(snap, errorSort, errorScenarioFilter, gridBucketOverride);
            currentPayload = Views3DProjection.ToJsPayload(errorScene);
        }
        else if (activeKind == Views3DKind.CallsMatrix)
        {
            if (!DataMode.IsFakeMode && !string.IsNullOrEmpty(ApiRun.CurrentRunId) && snap.Count > 0)
            {
                var key = $"{ApiRun.CurrentRunId}|{snap.Count}";
                var nowTick = Environment.TickCount64;
                if (!string.Equals(callsMatrixLoadedForKey, key, StringComparison.Ordinal)
                    || (snap.Running && nowTick - lastCallsMatrixFetchTick >= 1500)
                    || modeOrRunChanged)
                {
                    callsMatrixLoadedForKey = key;
                    lastCallsMatrixFetchTick = nowTick;
                    _ = LoadLiveCallsMatrixAsync(snap.Count);
                }
            }

            callsMatrixScene = Views3DProjection.BuildCallsMatrix(
                snap,
                callsMatrixMetric,
                !DataMode.IsFakeMode && liveCallEndpointsByEntry.Count > 0 ? liveCallEndpointsByEntry : null);
            currentPayload = Views3DProjection.ToJsPayload(callsMatrixScene);
        }
        else
        {
            swarmScene = Views3DProjection.BuildSwarmMatrix(snap, swarmMode);
            currentPayload = Views3DProjection.ToJsPayload(swarmScene);
        }

        var bucketCount = CurrentBucketCount();
        var laneCount = CurrentLaneCount();
        if (selectedKey is { } sk && (sk.LaneIndex < 0 || sk.LaneIndex >= laneCount || sk.BucketIndex < 0 || sk.BucketIndex >= bucketCount))
            selectedKey = null;
        if (activeKind == Views3DKind.SwarmMatrix && selectedSwarmCell is null)
            selectedKey = null;
        if (activeKind == Views3DKind.CallsMatrix && selectedCallsMatrixCell is null)
            selectedKey = null;
        if (isolatedLane is { } iso && (iso < 0 || iso >= laneCount))
            isolatedLane = null;

        sceneRevision++;
    }

    private async Task LoadLiveHistoryAsync(int entry)
    {
        if (disposed || DataMode.IsFakeMode || entry < 0) return;
        var snap = Sim.Current;
        if (entry >= snap.Count) return;

        historyCts?.Cancel();
        historyCts?.Dispose();
        historyCts = new CancellationTokenSource();
        var ct = historyCts.Token;

        historyLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var cfg = snap.Plan.Scenarios[entry];
            var targetLabel = entry < snap.Labels.Count ? snap.Labels[entry] : cfg.ScenarioId;
            var runs = await ApiRun.ListRunsAsync(limit: 30, ct);
            if (ct.IsCancellationRequested || disposed) return;

            var summaryTasks = runs
                .Where(r => !string.Equals(r.RunId, ApiRun.CurrentRunId, StringComparison.Ordinal))
                .Select(r => ApiRun.GetRunSummaryAsync(r.RunId, ct))
                .ToArray();
            var summaries = await Task.WhenAll(summaryTasks);
            if (ct.IsCancellationRequested || disposed) return;

            var candidates = new List<HistoryRunCandidate>();
            foreach (var s in summaries)
            {
                if (s is null) continue;
                var match = Views3DProjection.MatchHistoryEntry(cfg, targetLabel, s, entry);
                if (match is null) continue;
                var (matchedEntry, setupMatches, badge) = match.Value;
                var shortId = s.RunId.Length > 8 ? s.RunId[..8] : s.RunId;
                candidates.Add(new HistoryRunCandidate(
                    s.RunId,
                    $"Run {shortId}",
                    s.StartedUtc,
                    s.State,
                    s.ElapsedSeconds,
                    matchedEntry.Entry,
                    setupMatches,
                    badge,
                    matchedEntry.Finished,
                    matchedEntry.Failed,
                    matchedEntry.SlowBees));
            }

            candidates.Sort((a, b) => b.StartedUtc.CompareTo(a.StartedUtc));
            liveCandidates.Clear();
            liveCandidates.AddRange(candidates);
            liveRunInputs.Clear();

            await FetchSelectedCandidateBeesAsync(ct);
        }
        catch (OperationCanceledException) { }
        finally
        {
            historyLoading = false;
            if (!disposed)
            {
                await InvokeAsync(() =>
                {
                    if (disposed) return;
                    RebuildScene();
                    StateHasChanged();
                });
            }
        }
    }

    private async Task EnsureSelectedLiveRunBeesLoadedAsync()
    {
        if (disposed || DataMode.IsFakeMode) return;
        historyCts?.Cancel();
        historyCts?.Dispose();
        historyCts = new CancellationTokenSource();
        var ct = historyCts.Token;
        historyLoading = true;
        try
        {
            await FetchSelectedCandidateBeesAsync(ct);
        }
        catch (OperationCanceledException) { }
        finally
        {
            historyLoading = false;
            if (!disposed)
            {
                await InvokeAsync(() =>
                {
                    if (disposed) return;
                    RebuildScene();
                    StateHasChanged();
                });
            }
        }
    }

    private async Task FetchSelectedCandidateBeesAsync(CancellationToken ct)
    {
        var selected = VisibleHistoryCandidates()
            .Where(c => IsCandidateSelected(c.RunId))
            .Take(5)
            .Where(c => !liveRunInputs.ContainsKey(c.RunId))
            .ToList();
        if (selected.Count == 0) return;

        var tasks = selected.Select(async cand =>
        {
            var page = await ApiRun.GetRunBeesAsync(cand.RunId, cand.Entry, 5000, ct);
            return (cand, page);
        }).ToArray();

        var results = await Task.WhenAll(tasks);
        foreach (var (cand, page) in results)
        {
            if (page is null) continue;
            var (records, _) = Views3DProjection.ToBeeRecords(page.Items, cand.Entry);
            liveRunInputs[cand.RunId] = new HistoryRunInput(
                cand.RunId,
                cand.Label,
                cand.StartedUtc,
                cand.State,
                cand.ElapsedSeconds,
                cand.Entry,
                IsCurrent: false,
                cand.SetupMatches,
                cand.SetupBadge,
                records,
                records.Count,
                TotalBeesOverride: Math.Max(cand.TotalBees, records.Count),
                FailedBeesOverride: cand.FailedBees,
                SlowBeesOverride: cand.SlowBees);
        }
    }

    private void MaybePrefetchStepDetails(RunSnapshot snap, TerrainScene scene)
    {
        if (DataMode.IsFakeMode || string.IsNullOrEmpty(ApiRun.CurrentRunId) || scene.MissingDetailCount <= 0 || scene.ScenarioEntry is not { } entry)
            return;

        stepDetailCts?.Cancel();
        stepDetailCts?.Dispose();
        stepDetailCts = new CancellationTokenSource();
        var ct = stepDetailCts.Token;

        var bees = snap.Store.Bees(entry);
        var count = entry < snap.Scenarios.Length ? Math.Min(bees.Count, snap.Scenarios[entry].Finished) : bees.Count;
        if (count <= 0) return;

        // Pick up to 48 evenly distributed bees whose detail is still a placeholder.
        var toFetch = new List<int>(48);
        var stride = Math.Max(1, count / 48);
        for (var i = 0; i < count && toFetch.Count < 48; i += stride)
        {
            var seq = bees[i].Sequence;
            var d = snap.Store.Detail(seq);
            if (d is null || Views3DProjection.IsPlaceholderDetail(d))
                toFetch.Add(seq);
        }
        if (toFetch.Count == 0) return;

        _ = Task.Run(async () =>
        {
            foreach (var seq in toFetch)
            {
                if (ct.IsCancellationRequested) break;
                try { await ApiRun.EnsureBeeDetailLoadedAsync(seq, ct); }
                catch (OperationCanceledException) { break; }
                catch { }
            }
        }, CancellationToken.None);
    }

    private void OnRunChanged()
    {
        if (disposed) return;
        var now = Environment.TickCount64;
        var stateChanged = Sim.Current.State != lastRunState;

        if (stateChanged || now - lastRebuildTick >= 250)
        {
            throttleCts?.Cancel();
            throttleCts?.Dispose();
            throttleCts = null;
            _ = InvokeAsync(() =>
            {
                if (disposed) return;
                RebuildScene();
                StateHasChanged();
            });
            return;
        }

        if (throttleCts is not null) return;
        throttleCts = new CancellationTokenSource();
        var ct = throttleCts.Token;
        var delay = (int)Math.Clamp(250 - (now - lastRebuildTick), 50, 250);
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(delay, ct);
                if (ct.IsCancellationRequested || disposed) return;
                await InvokeAsync(() =>
                {
                    if (disposed) return;
                    throttleCts?.Dispose();
                    throttleCts = null;
                    RebuildScene();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) { }
        }, CancellationToken.None);
    }

