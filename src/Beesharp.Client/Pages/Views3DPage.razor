                    .Select(r => new HistoryRunCandidate(r.RunId, r.Label, r.StartedUtc, r.State, r.ElapsedSeconds, r.Entry, r.SetupMatches, r.SetupBadge, r.TotalBeesOverride ?? r.Bees.Count, r.FailedBeesOverride ?? 0, r.SlowBeesOverride ?? 0))
                    .ToList();
                previousInputs = fakeHistoryInputs
                    .Where(r => (!historySameSetupOnly || r.SetupMatches) && IsCandidateSelected(r.RunId))
                    .Take(5)
                    .ToList();
            }
            else
            {
                var key = $"{ApiRun.CurrentRunId}|{entry}";
                if (entry >= 0 && !string.Equals(historyLoadedForKey, key, StringComparison.Ordinal))
                {
                    historyLoadedForKey = key;
                    _ = LoadLiveHistoryAsync(entry);
                }

                var selected = VisibleHistoryCandidates()
                    .Where(c => IsCandidateSelected(c.RunId))
                    .Take(5);
                var list = new List<HistoryRunInput>();
                foreach (var cand in selected)
                {
                    if (liveRunInputs.TryGetValue(cand.RunId, out var input))
                        list.Add(input);
                }
                previousInputs = list;
            }

            historyScene = Views3DProjection.BuildRunHistory(
                snap,
                entry,
                previousInputs,
                DataMode.IsFakeMode ? "fake-current" : ApiRun.CurrentRunId,
                DataMode.IsFakeMode ? DateTimeOffset.UtcNow : ApiRun.ActiveStartedUtc);
            currentPayload = Views3DProjection.ToJsPayload(historyScene);
        }

        sceneRevision++;
    }

    private async Task LoadLiveHistoryAsync(int entry)
    {
        if (disposed || DataMode.IsFakeMode || entry < 0) return;
        var snap = Sim.Current;
        if (entry >= snap.Count) return;

        historyCts?.Cancel();
        historyCts?.Dispose();
        historyCts = new CancellationTokenSource();
        var ct = historyCts.Token;

        historyLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var cfg = snap.Plan.Scenarios[entry];
            var targetLabel = entry < snap.Labels.Count ? snap.Labels[entry] : cfg.ScenarioId;
            var runs = await ApiRun.ListRunsAsync(limit: 30, ct);
            if (ct.IsCancellationRequested || disposed) return;

            var summaryTasks = runs
                .Where(r => !string.Equals(r.RunId, ApiRun.CurrentRunId, StringComparison.Ordinal))
                .Select(r => ApiRun.GetRunSummaryAsync(r.RunId, ct))
                .ToArray();
            var summaries = await Task.WhenAll(summaryTasks);
            if (ct.IsCancellationRequested || disposed) return;

            var candidates = new List<HistoryRunCandidate>();
            foreach (var s in summaries)
            {
                if (s is null) continue;
                var match = Views3DProjection.MatchHistoryEntry(cfg, targetLabel, s, entry);
                if (match is null) continue;
                var (matchedEntry, setupMatches, badge) = match.Value;
                var shortId = s.RunId.Length > 8 ? s.RunId[..8] : s.RunId;
                candidates.Add(new HistoryRunCandidate(
                    s.RunId,
                    $"Run {shortId}",
                    s.StartedUtc,
                    s.State,
                    s.ElapsedSeconds,
                    matchedEntry.Entry,
                    setupMatches,
                    badge,
                    matchedEntry.Finished,
                    matchedEntry.Failed,
                    matchedEntry.SlowBees));
            }

            candidates.Sort((a, b) => b.StartedUtc.CompareTo(a.StartedUtc));
            liveCandidates.Clear();
            liveCandidates.AddRange(candidates);
            liveRunInputs.Clear();

            await FetchSelectedCandidateBeesAsync(ct);
        }
        catch (OperationCanceledException) { }
        finally
        {
            historyLoading = false;
            if (!disposed)
            {
                await InvokeAsync(() =>
                {
                    if (disposed) return;
                    RebuildScene();
                    StateHasChanged();
                });
            }
        }
    }

    private async Task EnsureSelectedLiveRunBeesLoadedAsync()
    {
        if (disposed || DataMode.IsFakeMode) return;
        historyCts?.Cancel();
        historyCts?.Dispose();
        historyCts = new CancellationTokenSource();
        var ct = historyCts.Token;
        historyLoading = true;
        try
        {
            await FetchSelectedCandidateBeesAsync(ct);
        }
        catch (OperationCanceledException) { }
        finally
        {
            historyLoading = false;
            if (!disposed)
            {
                await InvokeAsync(() =>
                {
                    if (disposed) return;
                    RebuildScene();
                    StateHasChanged();
                });
            }
        }
    }

    private async Task FetchSelectedCandidateBeesAsync(CancellationToken ct)
    {
        var selected = VisibleHistoryCandidates()
            .Where(c => IsCandidateSelected(c.RunId))
            .Take(5)
            .Where(c => !liveRunInputs.ContainsKey(c.RunId))
            .ToList();
        if (selected.Count == 0) return;

        var tasks = selected.Select(async cand =>
        {
            var page = await ApiRun.GetRunBeesAsync(cand.RunId, cand.Entry, 5000, ct);
            return (cand, page);
        }).ToArray();

        var results = await Task.WhenAll(tasks);
        foreach (var (cand, page) in results)
        {
            if (page is null) continue;
            var (records, _) = Views3DProjection.ToBeeRecords(page.Items, cand.Entry);
            liveRunInputs[cand.RunId] = new HistoryRunInput(
                cand.RunId,
                cand.Label,
                cand.StartedUtc,
                cand.State,
                cand.ElapsedSeconds,
                cand.Entry,
                IsCurrent: false,
                cand.SetupMatches,
                cand.SetupBadge,
                records,
                records.Count,
                TotalBeesOverride: Math.Max(cand.TotalBees, records.Count),
                FailedBeesOverride: cand.FailedBees,
                SlowBeesOverride: cand.SlowBees);
        }
    }

    private void MaybePrefetchStepDetails(RunSnapshot snap, TerrainScene scene)
    {
        if (DataMode.IsFakeMode || string.IsNullOrEmpty(ApiRun.CurrentRunId) || scene.MissingDetailCount <= 0 || scene.ScenarioEntry is not { } entry)
            return;

        stepDetailCts?.Cancel();
        stepDetailCts?.Dispose();
        stepDetailCts = new CancellationTokenSource();
        var ct = stepDetailCts.Token;

        var bees = snap.Store.Bees(entry);
        var count = entry < snap.Scenarios.Length ? Math.Min(bees.Count, snap.Scenarios[entry].Finished) : bees.Count;
        if (count <= 0) return;

        // Pick up to 48 evenly distributed bees whose detail is still a placeholder.
        var toFetch = new List<int>(48);
        var stride = Math.Max(1, count / 48);
        for (var i = 0; i < count && toFetch.Count < 48; i += stride)
        {
            var seq = bees[i].Sequence;
            var d = snap.Store.Detail(seq);
            if (d is null || Views3DProjection.IsPlaceholderDetail(d))
                toFetch.Add(seq);
        }
        if (toFetch.Count == 0) return;

        _ = Task.Run(async () =>
        {
            foreach (var seq in toFetch)
            {
                if (ct.IsCancellationRequested) break;
                try { await ApiRun.EnsureBeeDetailLoadedAsync(seq, ct); }
                catch (OperationCanceledException) { break; }
                catch { }
            }
        }, CancellationToken.None);
    }

    private void OnRunChanged()
    {
        if (disposed) return;
        var now = Environment.TickCount64;
        var stateChanged = Sim.Current.State != lastRunState;

        if (stateChanged || now - lastRebuildTick >= 250)
        {
            throttleCts?.Cancel();
            throttleCts?.Dispose();
            throttleCts = null;
            _ = InvokeAsync(() =>
            {
                if (disposed) return;
                RebuildScene();
                StateHasChanged();
            });
            return;
        }

        if (throttleCts is not null) return;
        throttleCts = new CancellationTokenSource();
        var ct = throttleCts.Token;
        var delay = (int)Math.Clamp(250 - (now - lastRebuildTick), 50, 250);
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(delay, ct);
                if (ct.IsCancellationRequested || disposed) return;
                await InvokeAsync(() =>
                {
                    if (disposed) return;
                    throttleCts?.Dispose();
                    throttleCts = null;
                    RebuildScene();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) { }
        }, CancellationToken.None);
    }

    private void OnPhoneChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private static bool HasAnySteps(RunSnapshot snap)
    {
        for (var i = 0; i < snap.Count; i++)
            if (snap.StepsOf(i).Any) return true;
        return false;
    }

    private static ScenarioFilter BuildTerrainScenarioFilter(TerrainCell tc)
    {
        if (tc.FailedCount > 0)
            return tc.StepIndex is { } st
                ? new ScenarioFilter(DetailFilter.Failed, FailedStep: st)
                : new ScenarioFilter(DetailFilter.Failed);
        if (tc.SlowCount > 0)
            return new ScenarioFilter(DetailFilter.Slow);
        return ScenarioFilter.Default;
    }

    private void OpenTerrainLogs(TerrainCell tc)
    {
        var outcome = tc.FailedCount > 0 ? BeeShow.Failed : tc.SlowCount > 0 ? BeeShow.Slow : BeeShow.All;
        var filter = LogFilter.None
            .WithEntry(tc.Entry)
            .WithStep(tc.StepIndex)
            .WithOutcome(outcome);
        Logs.Show(filter);
    }

    private void OpenSurfaceLogs(SurfaceCell sc)
    {
        var outcome = sc.FailedCount > 0 ? BeeShow.Failed : sc.SlowCount > 0 ? BeeShow.Slow : BeeShow.All;
        var filter = LogFilter.None
            .WithEntry(sc.ScenarioEntryFilter ?? sc.DominantEntry)
            .WithOutcome(outcome);
        Logs.Show(filter);
    }

    private void OpenSurfaceCalls(SurfaceCell sc)
    {
        var maxMs = double.IsInfinity(sc.BandMaxMs) ? (double?)null : sc.BandMaxMs;
        var outcome = sc.FailedCount > 0 ? BeeShow.Failed : sc.SlowCount > 0 ? BeeShow.Slow : BeeShow.All;
        var filter = CallsFilter.None
            .WithEntry(sc.ScenarioEntryFilter)
            .WithOutcome(outcome)
            .WithDurationRange(sc.BandMinMs > 0 ? sc.BandMinMs : null, maxMs)
            .WithTimeWindow(sc.FromSec, sc.ToSec);
        Calls.Show(filter);
    }

    private static ScenarioFilter BuildHistoryScenarioFilter(HistoryCell hc)
    {
        if (hc.IsSingleBee && hc.BeeSequence is { } seq)
            return new ScenarioFilter(Bee: seq);
        if (hc.FailedCount > 0)
            return new ScenarioFilter(DetailFilter.Failed);
        if (hc.SlowCount > 0)
            return new ScenarioFilter(DetailFilter.Slow);
        return ScenarioFilter.Default;
    }

    private void OpenHistoryLogs(HistoryCell hc)
    {
        var outcome = hc.FailedCount > 0 ? BeeShow.Failed : hc.SlowCount > 0 ? BeeShow.Slow : BeeShow.All;
        var filter = LogFilter.None
            .WithEntry(hc.Entry)
            .WithBee(hc.IsSingleBee ? hc.BeeSequence : null)
            .WithOutcome(hc.IsSingleBee ? BeeShow.All : outcome);
        Logs.Show(filter);
    }

    private async Task LoadAndOpenStoredRunAsync(HistoryLane lane, HistoryCell hc)
    {
        if (Sim.IsRunning || loadingStoredRun || string.IsNullOrEmpty(lane.RunId)) return;
        loadingStoredRun = true;
        try
        {
            await ApiRun.LoadStoredRunAsync(lane.RunId);
            Nav.NavigateTo(ScenarioLink.Href(hc.Entry, BuildHistoryScenarioFilter(hc)));
        }
        finally
        {
            loadingStoredRun = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        Sim.Changed -= OnRunChanged;
        Phone.Changed -= OnPhoneChanged;

        throttleCts?.Cancel();
        throttleCts?.Dispose();
        throttleCts = null;

        stepDetailCts?.Cancel();
        stepDetailCts?.Dispose();
        stepDetailCts = null;

        historyCts?.Cancel();
        historyCts?.Dispose();
        historyCts = null;

        if (handle is not null)
        {
            var h = handle;
            handle = null;
            try { await h.InvokeVoidAsync("dispose"); } catch (JSException) { } catch (JSDisconnectedException) { } catch (InvalidOperationException) { }
            try { await h.DisposeAsync(); } catch (JSException) { } catch (JSDisconnectedException) { } catch (InvalidOperationException) { }
        }
        if (module is not null)
        {
            try { await module.DisposeAsync(); } catch (JSException) { } catch (JSDisconnectedException) { } catch (InvalidOperationException) { }
        }
        self?.Dispose();
    }
