    private void RebuildScene()
    {
        var snap = Sim.Current;
        var fakeModeChanged = lastFakeMode != DataMode.IsFakeMode;
        var modeOrRunChanged = fakeModeChanged
            || !string.Equals(lastRunId, ApiRun.CurrentRunId, StringComparison.Ordinal)
            || (lastRunState != FakeRunState.Finished && snap.State == FakeRunState.Finished);
        lastRebuildTick = Environment.TickCount64;
        lastRunState = snap.State;
        lastFakeMode = DataMode.IsFakeMode;
        lastRunId = ApiRun.CurrentRunId;

        if (modeOrRunChanged)
        {
            historyLoadedForKey = null;
            if (fakeModeChanged)
                selectedHistoryRunIds = null;
        }

        if (activeKind == Views3DKind.Terrain)
        {
            terrainScene = Views3DProjection.BuildTerrain(snap, terrainGrouping, selectedStepScenario);
            if (terrainGrouping == TerrainGrouping.Steps && terrainScene.ScenarioEntry is { } resolved)
                selectedStepScenario = resolved;
            currentPayload = Views3DProjection.ToJsPayload(terrainScene);
            MaybePrefetchStepDetails(snap, terrainScene);
        }
        else if (activeKind == Views3DKind.Surface)
        {
            surfaceScene = Views3DProjection.BuildSurface(snap, surfaceScenarioFilter);
            currentPayload = Views3DProjection.ToJsPayload(surfaceScene);
        }
        else
        {
            var entry = Views3DProjection.ResolveHistoryScenarioEntry(snap, selectedHistoryScenario);
            if (entry >= 0) selectedHistoryScenario = entry;

            IReadOnlyList<HistoryRunInput> previousInputs;
            if (DataMode.IsFakeMode)
            {
