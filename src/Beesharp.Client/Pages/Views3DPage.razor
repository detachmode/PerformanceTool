    private static ScenarioFilter BuildTerrainScenarioFilter(TerrainCell tc)
    {
        if (tc.FailedCount > 0)
            return tc.StepIndex is { } st
                ? new ScenarioFilter(DetailFilter.Failed, FailedStep: st)
                : new ScenarioFilter(DetailFilter.Failed);
        if (tc.SlowCount > 0)
            return new ScenarioFilter(DetailFilter.Slow);
        return ScenarioFilter.Default;
    }

    private void OpenTerrainLogs(TerrainCell tc)
    {
        var outcome = tc.FailedCount > 0 ? BeeShow.Failed : tc.SlowCount > 0 ? BeeShow.Slow : BeeShow.All;
        var filter = LogFilter.None
            .WithEntry(tc.Entry)
            .WithStep(tc.StepIndex)
            .WithOutcome(outcome);
        Logs.Show(filter);
    }

    private void OpenSurfaceLogs(SurfaceCell sc)
    {
        var outcome = sc.FailedCount > 0 ? BeeShow.Failed : sc.SlowCount > 0 ? BeeShow.Slow : BeeShow.All;
        var filter = LogFilter.None
            .WithEntry(sc.ScenarioEntryFilter ?? sc.DominantEntry)
            .WithOutcome(outcome);
        Logs.Show(filter);
    }

    private void OpenSurfaceCalls(SurfaceCell sc)
    {
        var maxMs = double.IsInfinity(sc.BandMaxMs) ? (double?)null : sc.BandMaxMs;
        var outcome = sc.FailedCount > 0 ? BeeShow.Failed : sc.SlowCount > 0 ? BeeShow.Slow : BeeShow.All;
        var filter = CallsFilter.None
            .WithEntry(sc.ScenarioEntryFilter)
            .WithOutcome(outcome)
            .WithDurationRange(sc.BandMinMs > 0 ? sc.BandMinMs : null, maxMs)
            .WithTimeWindow(sc.FromSec, sc.ToSec);
        Calls.Show(filter);
    }

    private static ScenarioFilter BuildHistoryScenarioFilter(HistoryCell hc)
    {
        if (hc.IsSingleBee && hc.BeeSequence is { } seq)
            return new ScenarioFilter(Bee: seq);
        if (hc.FailedCount > 0)
            return new ScenarioFilter(DetailFilter.Failed);
        if (hc.SlowCount > 0)
            return new ScenarioFilter(DetailFilter.Slow);
        return ScenarioFilter.Default;
    }

    private void OpenHistoryLogs(HistoryCell hc)
    {
        var outcome = hc.FailedCount > 0 ? BeeShow.Failed : hc.SlowCount > 0 ? BeeShow.Slow : BeeShow.All;
        var filter = LogFilter.None
            .WithEntry(hc.Entry)
            .WithBee(hc.IsSingleBee ? hc.BeeSequence : null)
            .WithOutcome(hc.IsSingleBee ? BeeShow.All : outcome);
        Logs.Show(filter);
    }

    private LogFilter BuildErrorLogFilter(ErrorCascadeCell ec)
    {
        var entry = errorScenarioFilter ?? (ec.AffectedEntries.Count == 1 ? ec.AffectedEntries[0] : (int?)null);
        var filter = LogFilter.None
            .WithEntry(entry)
            .WithLevels(["Error"]);

        if (string.Equals(ec.Signature, "(No error message)", StringComparison.Ordinal))
            return filter.WithOutcome(BeeShow.Failed);

        var firstLine = ec.Signature.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Trim() ?? "";
        if (firstLine.Length > 120) firstLine = firstLine[..120].TrimEnd();
        return firstLine.Length > 0 ? filter.WithSearch(firstLine) : filter.WithOutcome(BeeShow.Failed);
    }

    private static ScenarioFilter BuildErrorScenarioFilter(RunSnapshot snap, int entry, ErrorCascadeCell ec)
    {
        if (ec.SampleStep is { } st && st >= 0 && snap.StepsOf(entry).Any && st < snap.StepsOf(entry).Count)
            return new ScenarioFilter(DetailFilter.Failed, FailedStep: st);
        return new ScenarioFilter(DetailFilter.Failed);
    }

    private static LogFilter BuildSwarmLogFilter(RunSnapshot snap, SwarmStepCell swc)
    {
        var hasSteps = snap.StepsOf(swc.Entry).Any;
        var filter = LogFilter.None
            .WithEntry(swc.Entry)
            .WithStep(hasSteps ? swc.StepIndex : null);
        return swc.FailedCount > 0 ? filter.WithOutcome(BeeShow.Failed) : filter;
    }

    private static ScenarioFilter BuildSwarmScenarioFilter(RunSnapshot snap, SwarmStepCell swc)
    {
        var hasSteps = snap.StepsOf(swc.Entry).Any && swc.StepIndex < snap.StepsOf(swc.Entry).Count;
        if (swc.FailedCount > 0)
            return hasSteps ? new ScenarioFilter(DetailFilter.Failed, FailedStep: swc.StepIndex) : new ScenarioFilter(DetailFilter.Failed);
        if (swc.ActiveCount > 0 && hasSteps)
            return new ScenarioFilter(DetailFilter.All, NowStep: swc.StepIndex);
        return ScenarioFilter.Default;
    }

    private async Task LoadLiveCallsMatrixAsync(int entryCount)
    {
        if (disposed || DataMode.IsFakeMode || string.IsNullOrEmpty(ApiRun.CurrentRunId) || entryCount <= 0) return;

        callsMatrixCts?.Cancel();
        callsMatrixCts?.Dispose();
        callsMatrixCts = new CancellationTokenSource();
        var ct = callsMatrixCts.Token;

        if (liveCallEndpointsByEntry.Count == 0)
        {
            callsMatrixLoading = true;
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            var tasks = Enumerable.Range(0, entryCount)
                .Select(async entry =>
                {
                    var res = await ApiRun.QueryCallEndpointsAsync(entry, slowOnly: false, failedOnly: false, minMs: null, search: null, ct: ct);
                    return (entry, res);
                })
                .ToArray();

            var results = await Task.WhenAll(tasks);
            if (ct.IsCancellationRequested || disposed) return;

            foreach (var (entry, res) in results)
            {
                if (res is not null)
                    liveCallEndpointsByEntry[entry] = res;
            }
        }
        catch (OperationCanceledException) { }
        catch { }
        finally
        {
            callsMatrixLoading = false;
            if (!disposed)
            {
                await InvokeAsync(() =>
                {
                    if (disposed) return;
                    RebuildScene();
                    StateHasChanged();
                });
            }
        }
    }

    private void OpenCallsMatrixCalls(CallsMatrixCell cell)
    {
        var filter = CallsFilter.None
            .WithEndpoint(cell.Endpoint)
            .WithEntry(cell.Entry);
        Calls.Show(filter);
    }

    private static ScenarioFilter BuildCallsMatrixScenarioFilter(CallsMatrixCell cell)
    {
        if (cell.FailedCount > 0) return new ScenarioFilter(DetailFilter.Failed);
        if (cell.SlowCount > 0) return new ScenarioFilter(DetailFilter.Slow);
        return ScenarioFilter.Default;
    }

    private async Task LoadAndOpenStoredRunAsync(HistoryLane lane, HistoryCell hc)
    {
        if (Sim.IsRunning || loadingStoredRun || string.IsNullOrEmpty(lane.RunId)) return;
        loadingStoredRun = true;
        try
        {
            await ApiRun.LoadStoredRunAsync(lane.RunId);
            Nav.NavigateTo(ScenarioLink.Href(hc.Entry, BuildHistoryScenarioFilter(hc)));
        }
        finally
        {
            loadingStoredRun = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        Sim.Changed -= OnRunChanged;
        Phone.Changed -= OnPhoneChanged;

        throttleCts?.Cancel();
        throttleCts?.Dispose();
        throttleCts = null;

        stepDetailCts?.Cancel();
        stepDetailCts?.Dispose();
        stepDetailCts = null;

        historyCts?.Cancel();
        historyCts?.Dispose();
        historyCts = null;

        callsMatrixCts?.Cancel();
        callsMatrixCts?.Dispose();
        callsMatrixCts = null;

        if (handle is not null)
        {
            var h = handle;
            handle = null;
            try { await h.InvokeVoidAsync("dispose"); } catch (JSException) { } catch (JSDisconnectedException) { } catch (InvalidOperationException) { }
            try { await h.DisposeAsync(); } catch (JSException) { } catch (JSDisconnectedException) { } catch (InvalidOperationException) { }
        }
        if (module is not null)
        {
            try { await module.DisposeAsync(); } catch (JSException) { } catch (JSDisconnectedException) { } catch (InvalidOperationException) { }
        }
        self?.Dispose();
    }
}
