<Project Sdk="Microsoft.NET.Sdk">

  <!-- The AI assistant (brain 0047): an agent on Microsoft.Extensions.AI whose tools do what the UI does. It talks to the app
       only through the port interfaces in Ports/ (the host implements them) and never references the host project. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Beesharp.Ai</RootNamespace>
    <PackageId>Beesharp.Ai</PackageId>
    <Description>AI assistant module for Beesharp built on Microsoft.Extensions.AI.</Description>
    <PackageTags>beesharp;load-testing;performance;ai</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="11.0.1" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.1" />
    <ProjectReference Include="../Beesharp.Core/Beesharp.Core.csproj" />
    <ProjectReference Include="../Beesharp.Ai.Contracts/Beesharp.Ai.Contracts.csproj" />
  </ItemGroup>

</Project>
