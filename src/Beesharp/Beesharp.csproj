<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Standalone Beesharp executable / Docker host (brain 0015, 0054, 0058): delegates everything to Beesharp.Host. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Beesharp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime-uploaded custom scenario .cs files are compiled by Roslyn at runtime, not by MSBuild. -->
    <Compile Remove="scripts/**" />
    <Content Remove="scripts/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Beesharp.Host/Beesharp.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Beesharp.Contracts" />
  </ItemGroup>

  <!-- The same build sha as the client (the Dockerfile passes -p:BuildSha to the whole publish), served as /build-info.json (brain 0025). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildSha</_Parameter1>
      <_Parameter2>$(BuildSha)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Pack Beesharp.Core into $(OutputPath)sdk so local runs auto-drop the SDK into scripts/.beesharp/ (brain 0057). -->
  <Target Name="PackBeesharpCoreSdk"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipPackBeesharpCoreSdk)' != 'true' and '$(RuntimeIdentifier)' == ''"
          Inputs="$(OutputPath)Beesharp.Core.dll;$(MSBuildProjectDirectory)/../Beesharp.Core/buildTransitive/Beesharp.Core.props"
          Outputs="$(OutputPath)sdk/Beesharp.Core.0.1.0.nupkg">
    <Exec Command="dotnet pack &quot;$(MSBuildProjectDirectory)/../Beesharp.Core/Beesharp.Core.csproj&quot; -c $(Configuration) --no-build --no-restore -o &quot;$(OutputPath)sdk&quot; /nologo -v:q" />
  </Target>

</Project>
