<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ASP.NET Core host (brain 0015, 0054): wiring only. REST endpoints in Api/; the modules (Engine, Scripting, Storage, Ai) are composed in Program.cs. It also serves the WebAssembly client. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Beesharp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime-uploaded custom scenario .cs files are compiled by Roslyn at runtime, not by MSBuild. -->
    <Compile Remove="scripts/**" />
    <Content Remove="scripts/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Beesharp.Core/Beesharp.Core.csproj" />
    <ProjectReference Include="../Beesharp.Contracts/Beesharp.Contracts.csproj" />
    <ProjectReference Include="../Beesharp.Storage/Beesharp.Storage.csproj" />
    <ProjectReference Include="../Beesharp.Storage.DuckDb/Beesharp.Storage.DuckDb.csproj" />
    <ProjectReference Include="../Beesharp.Scripting/Beesharp.Scripting.csproj" />
    <ProjectReference Include="../Beesharp.Engine/Beesharp.Engine.csproj" />
    <ProjectReference Include="../Beesharp.Client/Beesharp.Client.csproj" />
    <ProjectReference Include="../Beesharp.Ai/Beesharp.Ai.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Beesharp.Contracts" />
  </ItemGroup>

  <!-- The same build sha as the client (the Dockerfile passes -p:BuildSha to the whole publish), served as /build-info.json (brain 0025). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildSha</_Parameter1>
      <_Parameter2>$(BuildSha)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
