@* Editor for one entry of the scenario mix: label, rate and the scenario's own parameters. *@
<div class="entry" style="--series:@Color">
    <div class="entry-head">
        <span class="swatch"></span>
        <input class="entry-label" @bind="Config.Label" disabled="@Disabled" aria-label="Label" />
        @if (Scenario is null || !Config.Label.StartsWith(Scenario.Name, StringComparison.Ordinal))
        {
            <span class="entry-kind" title="@Scenario?.Description">@(Scenario?.Name ?? $"Unknown: {Config.ScenarioId}")</span>
        }
        <button class="icon-btn" @onclick="OnRemove" disabled="@Disabled" title="Remove scenario">✕</button>
    </div>

    @if (Scenario is not null)
    {
        <div class="entry-body">
            <div class="field rate">
                <label for="@($"{idPrefix}-rate")">Runs / minute</label>
                <input id="@($"{idPrefix}-rate")" type="number" min="0.1" step="any" @bind="Config.RatePerMinute" disabled="@Disabled" />
            </div>
            <ParameterEditor Spec="Scenario.Spec" Values="Config.Parameters" Disabled="Disabled" IdPrefix="@idPrefix" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ScenarioRunConfig Config { get; set; } = default!;
    [Parameter] public IScenario? Scenario { get; set; }
    [Parameter] public string Color { get; set; } = "#888";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    // Unique per card so labels/ids don't collide when the same scenario is added twice.
    private readonly string idPrefix = "e" + Guid.NewGuid().ToString("N")[..8];
}
