@* DRAFT scenario card, modelled on the Aspire 17 Metrics instrument cards (docs/brain/0008, 0011).
   The little box chart is a fixed grid of Slots one-second slots, newest on the right: bars stay thin however few
   executions there are, and empty slots on the left fill up over time. Bar height = slowest execution in that second,
   hatched red if any failed. Click or Enter opens the details popup. *@

<div class="dr-card @(Active ? "active" : "")" style="--series:@Color" role="button" tabindex="0"
     aria-label="@Label: @(stats.Count == 0 ? "no executions yet" : $"p95 {valueText}, {stats.Count} runs, {stats.Errors} errors"). Open details."
     data-card="@Index" @onclick="Open" @onkeydown="OnKey">
    <div class="chips">
        <span class="chip"><i class="dot"></i>@TypeName</span>
        <span class="chip" title="Target rate">@DraftFormat.Rate(TargetPerMinute) exec/min</span>
    </div>
    <div class="dr-title" title="@Label">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2 12.5l3.5-4 2.5 2.5L13.5 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 14h12" stroke="currentColor" stroke-width="1" opacity=".5"/></svg>
        <span>@Label</span>
    </div>
    <div class="dr-desc" title="@Description">@Description</div>

    <div class="dr-value">
        @if (stats.Count == 0)
        {
            <b class="none">—</b><span class="unit">no runs yet</span>
        }
        else
        {
            <b>@valueParts.Value</b><span class="unit">@valueParts.Unit p95</span>
        }
        @if (stats.Errors > 0)
        {
            <span class="badge bad" title="@stats.Errors failed executions">@stats.Errors err</span>
        }
    </div>

    <div class="dr-chart" aria-hidden="true">
        @for (var i = 0; i < Slots; i++)
        {
            var b = buckets[i];
            <span class="slot" title="@SlotTitle(i)">
                @if (b.Count > 0)
                {
                    <i class="@(b.Failed > 0 ? "failed" : "")" style="height:@Height(b.MaxMs)"></i>
                }
            </span>
        }
    </div>

    <div class="dr-foot">
        @if (Running)
        {
            <span class="inflight @(InFlight > 0 ? "on" : "")"><i class="pulse-dot"></i>@InFlight in flight</span>
        }
        else
        {
            <span class="dr-last">last @(Slots) s</span>
        }
        <span class="dr-rate" title="Executions started per minute: actual / target">
            <b>@DraftFormat.Rate(ActualPerMinute)</b> / @DraftFormat.Rate(TargetPerMinute) exec/min
            @if (Dropped > 0) { <span class="badge warn">@Dropped dropped</span> }
        </span>
    </div>
</div>

@code {
    public const int Slots = 60;

    [Parameter, EditorRequired] public int Index { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string TypeName { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public double TargetPerMinute { get; set; }
    [Parameter] public IReadOnlyList<ExecutionResult> Results { get; set; } = [];
    [Parameter] public int Dropped { get; set; }
    [Parameter] public int InFlight { get; set; }
    [Parameter] public int Starts { get; set; }
    [Parameter] public double? SinceLastStart { get; set; }
    [Parameter] public double ElapsedSeconds { get; set; }
    [Parameter] public double DurationSeconds { get; set; }
    [Parameter] public bool Running { get; set; }
    [Parameter] public EventCallback<int> OnOpen { get; set; }

    private readonly record struct Bucket(int Count, int Failed, double MaxMs);

    private LatencyStats stats = LatencyStats.Empty;
    private int statsCount = -1;
    private Bucket[] buckets = new Bucket[Slots];
    private int firstBucket;
    private double scale = 1;
    private (string Value, string Unit) valueParts = ("", "");
    private string valueText = "";

    private string Color => SeriesPalette.For(Index);

    /// <summary>Lit while an execution is in flight, and briefly after a start (fast requests finish between renders).</summary>
    private bool Active => Running && (InFlight > 0 || SinceLastStart is < 0.3);

    private double ActualPerMinute => Starts / Math.Max(ElapsedSeconds / 60, 1e-6);

    protected override void OnParametersSet()
    {
        if (Results.Count != statsCount)
        {
            statsCount = Results.Count;
            stats = LatencyStats.From(Results is IReadOnlyCollection<ExecutionResult> c ? c : Results.ToList());
            valueParts = LiveChart.FmtParts(stats.P95);
            valueText = LiveChart.Fmt(stats.P95);
        }

        // Newest slot = the second we are in (or the last second of a finished run).
        var last = Math.Max(0, (int)Math.Floor(Math.Min(ElapsedSeconds, Math.Max(DurationSeconds, 1) - 1e-6)));
        firstBucket = last - Slots + 1;
        var counts = new int[Slots]; var failed = new int[Slots]; var max = new double[Slots];
        foreach (var r in Results)
        {
            var slot = (int)Math.Floor(r.StartedAtSeconds) - firstBucket;
            if (slot < 0 || slot >= Slots) continue;
            counts[slot]++;
            if (!r.Success) failed[slot]++;
            if (r.ElapsedMs > max[slot]) max[slot] = r.ElapsedMs;
        }
        scale = 1;
        for (var i = 0; i < Slots; i++)
        {
            buckets[i] = new(counts[i], failed[i], max[i]);
            if (max[i] > scale) scale = max[i];
        }
    }

    private string Height(double ms) => (Math.Clamp(ms / scale, 0.06, 1) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private string SlotTitle(int i)
    {
        var b = buckets[i];
        if (b.Count == 0) return "";
        return $"{firstBucket + i} s: {b.Count} runs, slowest {LiveChart.Fmt(b.MaxMs)}" + (b.Failed > 0 ? $", {b.Failed} failed" : "");
    }

    private Task Open() => OnOpen.InvokeAsync(Index);

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") await Open();
    }
}
