@* DRAFT: small Aspire-style toolbar dropdown (sort / group). A transparent backdrop closes it on an outside click, Esc closes it too. *@
<div class="dr-dd" @onkeydown="OnKey">
    <button class="dr-dd-btn @(open ? "open" : "")" aria-haspopup="menu" aria-expanded="@open" @onclick="() => open = !open">
        <span class="k">@Label</span><b>@Value</b><span class="caret" aria-hidden="true">▾</span>
    </button>
    @if (open)
    {
        <div class="dr-backdrop" @onclick="() => open = false"></div>
        <ul class="dr-menu" role="menu">
            @foreach (var (key, text) in Items)
            {
                var k = key;
                <li role="none">
                    <button role="menuitemradio" aria-checked="@(k == Selected)" class="@(k == Selected ? "on" : "")" @onclick="() => Pick(k)">
                        <span class="tick">@(k == Selected ? "✓" : "")</span>@text
                        @if (k == Selected && Suffix is not null) { <span class="suffix">@Suffix</span> }
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string? Suffix { get; set; }
    [Parameter] public string Selected { get; set; } = "";
    [Parameter] public IReadOnlyList<(string Key, string Text)> Items { get; set; } = [];
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    private bool open;

    private async Task Pick(string key)
    {
        // Picking the already selected item keeps the menu open so a repeated click can flip a sort direction.
        if (key != Selected) open = false;
        await OnSelect.InvokeAsync(key);
    }

    private void OnKey(KeyboardEventArgs e) { if (e.Key == "Escape") open = false; }
}
