@* Live tile for one scenario entry, modelled on the Aspire 17 Metrics instrument cards (docs/brain/0008).
   Chips, title, one-line description, big value + unit, badges and a bar sparkline (one bar per instance,
   newest right). Highlights while the scenario is executing. Click or Enter/Space opens the details dialog. *@
@using System.Globalization

<div class="tile @(Active ? "active" : "") @(Running && Active ? (Starts % 2 == 0 ? "ping-a" : "ping-b") : "")"
     style="--series:@Color" role="button" tabindex="0"
     aria-label="@Label: @(stats.Count == 0 ? "no actors yet" : $"p95 {valueText}, {stats.Count} actors, {stats.Errors} errors"). Open details."
     data-tile="@Index" @onclick="Open" @onkeydown="OnKey">
    <div class="chips">
        <span class="chip"><i class="dot"></i>@(Scenario?.Name ?? Config.ScenarioId)</span>
        <span class="chip" title="Target rate">@Config.RatePerMinute.ToString("0.#", CultureInfo.InvariantCulture) actors/min</span>
    </div>
    <div class="tile-title" title="@Label">@Label</div>
    <div class="tile-desc" title="@Scenario?.Description">@(Scenario?.Description ?? "Scenario no longer exists in code.")</div>

    <div class="tile-value">
        @if (stats.Count == 0)
        {
            <b class="none">—</b><span class="unit">no actors yet</span>
        }
        else
        {
            <b>@valueParts.Value</b><span class="unit">@valueParts.Unit p95</span>
        }
    </div>

    <div class="tile-meta">
        @if (Running)
        {
            <span class="inflight @(InFlight > 0 ? "on" : "")"><i class="pulse-dot"></i>@InFlight in flight</span>
        }
        <span class="rate" title="Actors started per minute: actual vs target">
            @ActualPerMinute.ToString("0.#", CultureInfo.InvariantCulture) / @Config.RatePerMinute.ToString("0.#", CultureInfo.InvariantCulture) actors/min
        </span>
        @if (stats.Errors > 0)
        {
            <span class="badge bad">@stats.Errors err</span>
        }
        @if (Dropped > 0)
        {
            <span class="badge warn">@Dropped dropped</span>
        }
    </div>

    <div class="spark" aria-hidden="true">
        @foreach (var r in recent)
        {
            <i class="sb @(r.Success ? "" : "failed")" style="height:@Height(r.ElapsedMs)"></i>
        }
        @if (recent.Count == 0)
        {
            <span class="spark-empty">@(Running ? "waiting for the first run…" : "no data")</span>
        }
    </div>
</div>

@code {
    public const int MaxBars = 100;

    [Parameter, EditorRequired] public int Index { get; set; }
    [Parameter, EditorRequired] public ScenarioRunConfig Config { get; set; } = default!;
    [Parameter] public IScenario? Scenario { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public IReadOnlyList<ExecutionResult> Results { get; set; } = [];
    [Parameter] public int Dropped { get; set; }
    [Parameter] public int InFlight { get; set; }
    /// <summary>Instances started so far; also drives the start pulse.</summary>
    [Parameter] public int Starts { get; set; }
    /// <summary>Seconds since this scenario last started an instance, or null if it has not.</summary>
    [Parameter] public double? SinceLastStart { get; set; }
    [Parameter] public double ElapsedSeconds { get; set; }
    [Parameter] public bool Running { get; set; }
    [Parameter] public EventCallback<int> OnOpen { get; set; }

    private LatencyStats stats = LatencyStats.Empty;
    private int statsCount = -1;
    private List<ExecutionResult> recent = [];
    private double max = 1;
    private (string Value, string Unit) valueParts = ("", "");
    private string valueText = "";

    private string Color => SeriesPalette.For(Index);

    /// <summary>Lit while an instance is running, and for a moment after a start (fast requests finish between renders).</summary>
    private bool Active => Running && (InFlight > 0 || SinceLastStart is < 0.6);

    private double ActualPerMinute => Starts / Math.Max(ElapsedSeconds / 60, 1e-6);

    protected override void OnParametersSet()
    {
        var count = Results.Count;
        // Stats sort all results, so only recompute when something new arrived.
        if (count != statsCount)
        {
            statsCount = count;
            stats = LatencyStats.From(Results is IReadOnlyCollection<ExecutionResult> c ? c : Results.ToList());
            valueParts = LiveChart.FmtParts(stats.P95);
            valueText = LiveChart.Fmt(stats.P95);
        }
        var skip = Math.Max(0, count - MaxBars);
        recent = new List<ExecutionResult>(Math.Min(count, MaxBars));
        for (var i = skip; i < count; i++) recent.Add(Results[i]);
        max = recent.Count == 0 ? 1 : Math.Max(1, recent.Max(r => r.ElapsedMs));
    }

    private string Height(double ms) => (Math.Clamp(ms / max, 0.04, 1) * 100).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    private Task Open() => OnOpen.InvokeAsync(Index);

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") await Open();
    }
}
