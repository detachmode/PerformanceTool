<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Embedded Aspire-style host (brain 0058): bundles the engine, REST API, DuckDB/in-memory storage,
       AI assistant, and the Blazor WebAssembly UI static assets so any C# load-test project can
       call BeesharpApp.CreateBuilder(args) and run with F5 or headless CLI. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Beesharp</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Beesharp.Host</PackageId>
    <Version>0.1.0</Version>
    <Authors>Dennis</Authors>
    <Description>Embedded Beesharp load-testing host with REST API, DuckDB/memory storage, and Blazor WebAssembly UI.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>beesharp;load-testing;performance;host;blazor</PackageTags>
    <PackageProjectUrl>https://github.com/detachmode/PerformanceTool</PackageProjectUrl>
    <RepositoryUrl>https://github.com/detachmode/PerformanceTool</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Beesharp.Core/Beesharp.Core.csproj" />
    <ProjectReference Include="../Beesharp.Contracts/Beesharp.Contracts.csproj" />
    <ProjectReference Include="../Beesharp.Storage/Beesharp.Storage.csproj" />
    <ProjectReference Include="../Beesharp.Storage.DuckDb/Beesharp.Storage.DuckDb.csproj" />
    <ProjectReference Include="../Beesharp.Scripting/Beesharp.Scripting.csproj" />
    <ProjectReference Include="../Beesharp.Engine/Beesharp.Engine.csproj" />
    <ProjectReference Include="../Beesharp.Client/Beesharp.Client.csproj" />
    <ProjectReference Include="../Beesharp.Ai/Beesharp.Ai.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Beesharp.Contracts" />
  </ItemGroup>

</Project>
