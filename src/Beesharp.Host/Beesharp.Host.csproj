<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Embedded Aspire-style host (brain 0058): bundles the engine, REST API, DuckDB/in-memory storage,
       AI assistant, and the Blazor WebAssembly UI static assets so any C# load-test project can
       call BeesharpApp.CreateBuilder(args) and run with F5 or headless CLI. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Beesharp</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>Beesharp.Host</PackageId>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeInternalBeesharpAssemblies</TargetsForTfmSpecificBuildOutput>
    <Authors>detachmode</Authors>
    <Description>Embedded Beesharp load-testing host with REST API, DuckDB/memory storage, and Blazor WebAssembly UI.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>beesharp;load-testing;performance;host;blazor</PackageTags>
    <PackageProjectUrl>https://github.com/detachmode/PerformanceTool</PackageProjectUrl>
    <RepositoryUrl>https://github.com/detachmode/PerformanceTool</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Public NuGet dependency: shared by single-file scripts and host consumers. -->
    <ProjectReference Include="../Beesharp.Core/Beesharp.Core.csproj" />

    <!-- Internal modules bundled directly inside Beesharp.Host.nupkg so NuGet.org only ships Beesharp.Core + Beesharp.Host. -->
    <ProjectReference Include="../Beesharp.Contracts/Beesharp.Contracts.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Beesharp.Ai.Contracts/Beesharp.Ai.Contracts.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Beesharp.Storage/Beesharp.Storage.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Beesharp.Storage.DuckDb/Beesharp.Storage.DuckDb.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Beesharp.Scripting/Beesharp.Scripting.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Beesharp.Engine/Beesharp.Engine.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Beesharp.Ai/Beesharp.Ai.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Beesharp.Client/Beesharp.Client.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Third-party dependencies of the bundled internal modules, declared here so they flow as normal NuGet dependencies. -->
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.6.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.12.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="11.0.1" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Beesharp.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive/Beesharp.Host.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <!-- Publish Beesharp.Client (Release, trimmed, fingerprinted) only during `dotnet pack` so normal builds/tests stay fast. -->
  <Target Name="BundleBeesharpClientUi"
          BeforeTargets="_GetPackageFiles;GenerateNuspec"
          Condition="'$(IsPackable)' == 'true'">
    <PropertyGroup>
      <_ClientUiDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)client-ui\'))</_ClientUiDir>
      <_ClientUiWwwroot Condition="'$(BeesharpClientWwwroot)' != ''">$([System.IO.Path]::GetFullPath('$(BeesharpClientWwwroot)'))</_ClientUiWwwroot>
      <_ClientUiWwwroot Condition="'$(_ClientUiWwwroot)' == ''">$(_ClientUiDir)wwwroot</_ClientUiWwwroot>
    </PropertyGroup>
    <RemoveDir Directories="$(_ClientUiDir)" Condition="'$(BeesharpClientWwwroot)' == ''" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Beesharp.Client/Beesharp.Client.csproj&quot; -c Release -o &quot;$(_ClientUiDir)&quot; -p:BuildSha=$(BuildSha) /nologo -v:m"
          Condition="'$(BeesharpClientWwwroot)' == ''" />
    <ItemGroup>
      <_ClientUiFiles Include="$(_ClientUiWwwroot)\**\*"
                      Exclude="$(_ClientUiWwwroot)\**\*.br;$(_ClientUiWwwroot)\**\*.gz" />
      <None Include="@(_ClientUiFiles)"
            Pack="true"
            PackagePath="beesharp-ui/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <!-- Include the 7 internal Beesharp.* DLLs in lib/net11.0/ of Beesharp.Host.nupkg. -->
  <Target Name="IncludeInternalBeesharpAssemblies">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)Beesharp.Contracts.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Beesharp.Ai.Contracts.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Beesharp.Storage.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Beesharp.Storage.DuckDb.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Beesharp.Scripting.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Beesharp.Engine.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Beesharp.Ai.dll" />
    </ItemGroup>
  </Target>

</Project>
