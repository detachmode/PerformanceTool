@* Run player bar (brain 0027): fixed at the bottom of every page, like a music player with cockpit-style readouts.
   Play/Pause is the main control, Stop is secondary. Calm UI (0016): the phone layout shows play, time and the two most
   important readouts; the rest opens with the "details" button. *@
@implements IDisposable
@implements IAsyncDisposable
@inject IRunSource Sim
@inject LogsPopupState Logs
@inject IJSRuntime JS

@{
    var s = Sim.Current;
    var active = s.Running;
    var duration = s.Plan.DurationSeconds;
    var pct = s.State == FakeRunState.Finished ? 100 : duration > 0 ? Math.Min(100, s.Elapsed / duration * 100) : 0;
    var views = s.Scenarios;
    var inFlight = views.Sum(v => v.InFlight);
    var failed = views.Sum(v => v.Failed);
    var slow = views.Sum(v => v.SlowActors);
    var target = s.Plan.Scenarios.Sum(x => x.RatePerMinute);
    var actual = s.Elapsed >= 3 ? views.Sum(v => v.Starts) / (s.Elapsed / 60) : 0;
    var (stateText, stateCss) = s.State switch
    {
        FakeRunState.Running => ("Running", "run"),
        FakeRunState.Paused => ("Paused", "paused"),
        FakeRunState.Finished => ("Finished", "done"),
        _ => ("Idle", "idle"),
    };
    var playLabel = s.State switch { FakeRunState.Running => "Pause run", FakeRunState.Paused => "Resume run", _ => "Start run" };
}
<section class="player @(open ? "open" : "")" aria-label="Run player">
    <div class="pl-main">
        <button class="play @stateCss" @onclick="Toggle" aria-label="@playLabel" title="@playLabel (space)">
            @if (s.State == FakeRunState.Running)
            {
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="6" y="5" width="4.2" height="14" rx="1" fill="currentColor"/><rect x="13.8" y="5" width="4.2" height="14" rx="1" fill="currentColor"/></svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M8 5.2v13.6a.8.8 0 0 0 1.2.7l11-6.8a.8.8 0 0 0 0-1.4l-11-6.8A.8.8 0 0 0 8 5.2z" fill="currentColor"/></svg>
            }
        </button>
        <button class="stop-btn" @onclick="Sim.Stop" disabled="@(!active)" aria-label="Stop run" title="Stop run">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2" fill="currentColor"/></svg>
        </button>
        <div class="state-lamp @stateCss" title="Run state: @stateText"><i aria-hidden="true"></i><span>@stateText</span></div>
    </div>

    <div class="inst clock" role="group" aria-label="Run time">
        <span class="lbl" title="@Sim.PresetName">@Sim.PresetName</span>
        <span class="val" role="timer" aria-live="off"><b>@Format.Time(s.Elapsed)</b><em> / @Format.Time(duration)</em></span>
        <div class="gauge" role="progressbar" aria-label="Run progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)pct)"><i style="width:@pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></i></div>
    </div>

    <div class="inst key" role="group" aria-label="Actors running"><span class="lbl">Running</span><span class="val run">@Format.Num(inFlight)</span></div>
    <div class="inst extra" role="group" aria-label="Actors per minute"><span class="lbl">Actors/min</span><span class="val">@(active || s.State == FakeRunState.Finished ? Format.Num(actual) : "–")<em> / @Format.Num(target)</em></span></div>
    <div class="inst key" role="group" aria-label="Errors"><span class="lbl">Errors</span><span class="val @(failed > 0 ? "bad" : "")">@Format.Num(failed)</span></div>
    <div class="inst extra" role="group" aria-label="Slow actors"><span class="lbl">Slow</span><span class="val @(slow > 0 ? "warn" : "")">@Format.Num(slow)</span></div>

    <div class="pl-end">
        <button class="btn ghost small logs-btn" @onclick="() => Logs.Show()" aria-haspopup="dialog">Logs</button>
        <button class="btn ghost small more-btn" @onclick="() => open = !open" aria-expanded="@Aria.Bool(open)" aria-label="Run details">@(open ? "✕" : "⋯")</button>
    </div>
    <span class="visually-hidden" role="status" aria-live="polite">Run @stateText.ToLowerInvariant()</span>
</section>

@code {
    private bool open;
    private DotNetObjectReference<PlayerBar>? self;
    private IJSObjectReference? module;

    protected override void OnInitialized() => Sim.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./player-bar.js");
            self = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("listen", self);
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private void OnChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private void Toggle()
    {
        switch (Sim.Current.State)
        {
            case FakeRunState.Running: Sim.Pause(); break;
            case FakeRunState.Paused: Sim.Resume(); break;
            default: Sim.Start(); break;
        }
    }

    /// <summary>Called by the space bar handler (player-bar.js) when focus is not in an input.</summary>
    [JSInvokable] public void ToggleFromKey() => Toggle();

    public void Dispose() => Sim.Changed -= OnChanged;

    public async ValueTask DisposeAsync()
    {
        try { if (module is not null) { await module.InvokeVoidAsync("unlisten"); await module.DisposeAsync(); } }
        catch (Exception) { }
        self?.Dispose();
    }
}
