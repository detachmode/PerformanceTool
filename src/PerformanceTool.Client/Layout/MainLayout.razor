@* Top bar shared by all pages (brain 0020): app name, Overview / Editor, and on the right the run controls: preset, Start/Stop, elapsed / duration, Logs. *@
@inherits LayoutComponentBase
@implements IDisposable
@inject IRunSource Sim
@inject LogsPopupState Logs

@{ var s = Sim.Current; }
<div class="shell">
    <header class="top">
        <a class="brand" href="overview" aria-label="PerformanceTool, overview">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 20 12 3l9 17h-5l-4-8-4 8z" fill="#7b68ee"/><path d="M9 20l3-6 3 6z" fill="#b7b0d9"/></svg>
            <span class="brand-name">Performance<b>Tool</b></span>
        </a>
        <nav class="nav" aria-label="Main">
            <NavLink class="nav-item" href="overview" Match="NavLinkMatch.Prefix">Overview</NavLink>
            <NavLink class="nav-item" href="editor" Match="NavLinkMatch.Prefix">Editor</NavLink>
        </nav>
        <div class="run-controls" role="group" aria-label="Run">
            <span class="preset-name" title="Preset: @Sim.PresetName">@Sim.PresetName</span>
            @if (s.Running)
            {
                <button class="btn stop" @onclick="Sim.Stop">■ Stop</button>
            }
            else
            {
                <button class="btn start" @onclick="Sim.Start">▶ Start</button>
            }
            <span class="time" title="Elapsed / duration">@Format.Time(s.Elapsed) / @Format.Time(s.Plan.DurationSeconds)</span>
            <button class="btn ghost" @onclick="() => Logs.Show()" aria-haspopup="dialog">Logs</button>
        </div>
        <BuildStamp />
    </header>
    <main class="main">@Body</main>
</div>

@if (Logs.IsOpen)
{
    <LogsDialog @key="Logs.Version" />
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Sim.Changed += OnChanged;
        Logs.Changed += OnChanged;
    }

    private void OnChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        Sim.Changed -= OnChanged;
        Logs.Changed -= OnChanged;
    }
}
