@* Top bar shared by all pages (brain 0020): app name, Overview / Editor, and the build stamp. The run controls live in the player bar at the bottom (brain 0027). *@
@inherits LayoutComponentBase
@implements IDisposable
@inject LogsPopupState Logs
@inject ViewSettings Settings

<div class="shell">
    <header class="top">
        <a class="brand" href="overview" aria-label="PerformanceTool, overview">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 20 12 3l9 17h-5l-4-8-4 8z" fill="#7b68ee"/><path d="M9 20l3-6 3 6z" fill="#b7b0d9"/></svg>
            <span class="brand-name">Performance<b>Tool</b></span>
        </a>
        <nav class="nav" aria-label="Main">
            <NavLink class="nav-item" href="overview" Match="NavLinkMatch.Prefix">Overview</NavLink>
            <NavLink class="nav-item" href="editor" Match="NavLinkMatch.Prefix">Editor</NavLink>
        </nav>
        <BuildStamp />
        <button class="icon-btn gear" @onclick="Settings.Open" aria-label="Settings" title="Settings"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg></button>
    </header>
    <main class="main">@Body</main>
    <PlayerBar />
</div>

@if (Settings.IsOpen)
{
    <SettingsDialog />
}

@if (Logs.IsOpen)
{
    <LogsDialog @key="Logs.Version" />
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Logs.Changed += OnChanged;
        Settings.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Settings.LoadAsync();
    }

    private void OnChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        Logs.Changed -= OnChanged;
        Settings.Changed -= OnChanged;
    }
}
