@* One calm card per scenario (brain 0020): name, actors running, actors/min (actual / target) and a little bar chart of the latest actors.
   Neutral by default; red when errors occurred, amber when only slow calls occurred (brain 0018). The chart is bounded to the latest actors (brain 0021). *@
@using System.Globalization
@{
    var cls = View.Failed > 0 ? "bad" : View.SlowCalls > 0 ? "warn" : !Idle && View.Finished > 0 ? "calm-ok" : "";
    var actual = Elapsed > 0 ? View.Starts / (Elapsed / 60) : 0;
    var runNow = Running is { Count: > 0 } ? Running.Skip(Math.Max(0, Running.Count - 12)).ToList() : [];
    var take = Math.Min(View.Finished, MaxBars - runNow.Count);
    var recent = new ActorRecord[take];
    for (var i = 0; i < take; i++) recent[i] = Actors[View.Finished - take + i];
    var max = recent.Length == 0 ? 5000 : Math.Max(1, recent.Max(a => a.DurationMs));
    var reason = View.Failed > 0
        ? Format.Plural(View.Failed, "error", "errors") + (View.SlowCalls > 0 ? " · " + Format.Plural(View.SlowCalls, "slow call", "slow calls") : "")
        : View.SlowCalls > 0 ? Format.Plural(View.SlowCalls, "slow call", "slow calls") : "";
    var aria = Label + ": "
        + (Idle ? Format.Rate(Target) + " actors per minute" : View.InFlight + " actors running, " + Format.Rate(actual) + " of " + Format.Rate(Target) + " actors per minute")
        + (reason.Length > 0 ? ", " + reason : "")
        + (Idle ? ". Edit settings" : ". Open details")
        + (Edited ? ". Changed since the preset was loaded" : "");
}
<button class="card @cls @(Selected ? "selected" : "") @(Edited ? "edited" : "")" aria-pressed="@(Selectable ? Aria.Bool(Selected) : null)" @onclick="() => OnOpen.InvokeAsync(Index)"
        aria-label="@aria">
    <span class="card-title">@Label@if (Edited) { <i class="edit-dot" title="Changed since the preset was loaded"></i> }</span>
    @if (Idle)
    {
        <span class="card-figures">
            <span class="fig"><b>@Format.Rate(Target)</b><small>@Terms.PerMinuteShort</small></span>
        </span>
        <span class="card-kind">@Subtitle</span>
    }
    else
    {
        <span class="card-figures">
            <span class="fig"><b>@View.InFlight</b><small>actors running</small></span>
            <span class="fig"><b>@Format.Rate(actual)</b><small>/ @Format.Rate(Target) @Terms.PerMinuteShort</small></span>
        </span>
        @if (stats.HasData)
        {
            var fin = Math.Max(1, View.Finished);
            var errPct = 100.0 * View.Failed / fin;
            var slowPct = 100.0 * View.SlowActors / fin;
            <span class="card-stats" title="Typical duration, slowest 5 %, longest, errors and slow actors of finished actors. Click to open details.">
                <span class="st"><small>typical</small> <b>@Format.Ms(stats.Median)</b></span>
                <span class="st @(stats.P95Slow ? "warn" : "")"><small>slowest 5%</small> <b>@Format.Ms(stats.P95)</b></span>
                <span class="st @(stats.LongestSlow ? "warn" : "")"><small>longest</small> <b>@Format.Ms(stats.Longest)</b></span>
                <span class="st @(View.Failed > 0 ? "bad" : "")"><small>errors</small> <b>@Pc(errPct)</b></span>
                <span class="st @(View.SlowActors > 0 ? "warn" : "")"><small>slow</small> <b>@Pc(slowPct)</b></span>
            </span>
        }
    }
    <DockZoom Tag="span" Magnify="false" class="spark" aria-hidden="true" data-elapsed="@((Elapsed * 1000).ToString("0", CultureInfo.InvariantCulture))" data-scale="@max.ToString("0", CultureInfo.InvariantCulture)">
        @foreach (var a in recent)
        {
            <i class="@(a.Failed ? "bad" : a.SlowCalls > 0 ? "warn" : "good")" style="height:@(Pct(a.DurationMs / max))%"></i>
        }
        @foreach (var r in runNow)
        {
            <i class="run" data-start="@((r.StartedAt * 1000).ToString("0", CultureInfo.InvariantCulture))"></i>
        }
        @if (recent.Length == 0 && runNow.Count == 0) { <em>@(Idle ? "Not run yet" : "No actors started yet")</em> }
    </DockZoom>
    <span class="card-reason">@(reason.Length > 0 ? reason : " ")</span>
</button>

@code {
    private const int MaxBars = 32;

    [Parameter, EditorRequired] public int Index { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public ScenarioView View { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<ActorRecord> Actors { get; set; } = default!;
    [Parameter] public double Target { get; set; }
    [Parameter] public IReadOnlyList<RunningActor>? Running { get; set; }
    [Parameter] public double Elapsed { get; set; }
    /// <summary>Editor mode (brain 0024): the card shows the configured scenario, not run data.</summary>
    [Parameter] public bool Idle { get; set; }
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public bool Selectable { get; set; }
    [Parameter] public bool Selected { get; set; }
    /// <summary>Changed since the preset was loaded or last saved.</summary>
    [Parameter] public bool Edited { get; set; }
    [Parameter] public EventCallback<int> OnOpen { get; set; }

    private readonly ScenarioStats stats = new();

    protected override void OnParametersSet()
    {
        if (!Idle) stats.Update(Actors, View.Finished);
    }

    private static string Pc(double p) => p <= 0 ? "0%" : p < 10 ? p.ToString("0.0", CultureInfo.InvariantCulture) + "%" : p.ToString("0", CultureInfo.InvariantCulture) + "%";

    private static string Pct(double f) => Math.Clamp(f * 100, 4, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
