@* One calm card per scenario (brain 0020): name, actors running, actors/min (actual / target) and a little bar chart of the latest actors.
   Neutral by default; red when errors occurred, amber when only slow calls occurred (brain 0018). The chart is bounded to the latest actors (brain 0021). *@
@{
    var cls = View.Failed > 0 ? "bad" : View.SlowCalls > 0 ? "warn" : "";
    var actual = Elapsed > 0 ? View.Starts / (Elapsed / 60) : 0;
    var take = Math.Min(View.Finished, MaxBars);
    var recent = new ActorRecord[take];
    for (var i = 0; i < take; i++) recent[i] = Actors[View.Finished - take + i];
    var max = recent.Length == 0 ? 1 : Math.Max(1, recent.Max(a => a.DurationMs));
    var reason = View.Failed > 0
        ? Format.Plural(View.Failed, "error", "errors") + (View.SlowCalls > 0 ? " · " + Format.Plural(View.SlowCalls, "slow call", "slow calls") : "")
        : View.SlowCalls > 0 ? Format.Plural(View.SlowCalls, "slow call", "slow calls") : "";
}
<button class="card @cls" @onclick="() => OnOpen.InvokeAsync(Index)"
        aria-label="@Label: @View.InFlight actors running, @Format.Rate(actual) of @Format.Rate(Target) actors per minute@(reason.Length > 0 ? ", " + reason : ""). Open details">
    <span class="card-title">@Label</span>
    <span class="card-figures">
        <span class="fig"><b>@View.InFlight</b><small>actors running</small></span>
        <span class="fig"><b>@Format.Rate(actual)</b><small>/ @Format.Rate(Target) @Terms.PerMinuteShort</small></span>
    </span>
    <DockZoom Tag="span" class="spark" aria-hidden="true">
        @foreach (var a in recent)
        {
            <i class="@(a.Failed ? "bad" : a.SlowCalls > 0 ? "warn" : "")" style="height:@(Pct(a.DurationMs / max))%"></i>
        }
        @if (recent.Length == 0) { <em>No actors finished yet</em> }
    </DockZoom>
    <span class="card-reason">@(reason.Length > 0 ? reason : " ")</span>
</button>

@code {
    private const int MaxBars = 32;

    [Parameter, EditorRequired] public int Index { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public ScenarioView View { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<ActorRecord> Actors { get; set; } = default!;
    [Parameter] public double Target { get; set; }
    [Parameter] public double Elapsed { get; set; }
    [Parameter] public EventCallback<int> OnOpen { get; set; }

    private static string Pct(double f) => Math.Clamp(f * 100, 4, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
