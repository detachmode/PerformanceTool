@* Scenario popup (brain 0020, 0017, 0021): inspect the run of one scenario. One bounded actor chart (a bar per actor, or per time bucket when
   there are many), a quick Show: All / Failed / Slow switch with stepping, and the calls of the selected actor. Logs are one click away. *@
@using System.Globalization
@implements IDisposable
@inject LogsPopupState Logs

@{
    var s = Snapshot;
    var view = s.Scenarios[Index];
    var actors = s.Store.Actors(Index);
    var label = s.Labels[Index];
    var actual = s.Elapsed > 0 ? view.Starts / (s.Elapsed / 60) : 0;
    var target = s.Plan.Scenarios[Index].RatePerMinute;
    var bars = ActorBars.Build(actors, view.Finished, show, out var total, out var width);
    var bucketed = width > 0;
    var runningNow = s.ActorsInFlight is { } rn && Index < rn.Length ? rn[Index] : [];
    var scale = bars.Count == 0 ? 1 : Math.Max(1, bars.Where(b => b.Running == 0).Select(b => b.MaxMs).DefaultIfEmpty(0).Max());
    if (show == ActorShow.All) bars = ActorBars.WithRunning(bars, runningNow, width, s.Elapsed);
    if (bars.Count > 0 && scale <= 1) scale = Math.Max(1, bars.Max(b => b.MaxMs));
    var selBucketActors = bucketed && bucket is { } bs ? BucketList(actors, view.Finished, bs, width) : null;
    var selectedBucket = selected is { } sa0 && bucketed ? ActorBars.BucketOf(sa0.StartedAt, width) : bucket;
}

<div class="overlay" tabindex="-1" @ref="root" @onkeydown="OnKey" @onclick="OnClose" role="presentation">
    <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="scn-title" @onclick:stopPropagation="true">
        <div class="dlg-head">
            <h2 id="scn-title">@label</h2>
            <button class="icon-btn" @onclick="OnClose" aria-label="Close">✕</button>
        </div>

        <p class="figures">
            <span>@Format.Plural(view.Finished, "actor", "actors")</span>
            <span class="@(view.Failed > 0 ? "bad" : "")">@Format.Plural(view.Failed, "error", "errors")</span>
            <span class="@(view.SlowCalls > 0 ? "warn" : "")">@Format.Plural(view.SlowCalls, "slow call", "slow calls")</span>
            <span>@Format.Rate(actual) / @Format.Rate(target) @Terms.PerMinuteShort</span>
        </p>

        <div class="actors-bar">
            <div class="seg" role="group" aria-label="Show actors">
                <button class="@(show == ActorShow.All ? "on" : "")" aria-pressed="@Aria.Bool(show == ActorShow.All)" @onclick="() => SetShow(ActorShow.All)">All</button>
                <button class="@(show == ActorShow.Failed ? "on" : "")" aria-pressed="@Aria.Bool(show == ActorShow.Failed)" @onclick="() => SetShow(ActorShow.Failed)">Failed <span class="n">@Format.Num(view.Failed)</span></button>
                <button class="@(show == ActorShow.Slow ? "on" : "")" aria-pressed="@Aria.Bool(show == ActorShow.Slow)" @onclick="() => SetShow(ActorShow.Slow)">Slow <span class="n">@Format.Num(view.SlowActors)</span></button>
            </div>
            <div class="step" role="group" aria-label="Step through @StepWord actors">
                <button class="btn ghost small" @onclick="() => StepTo(-1)" disabled="@(StepCount(view) == 0)" title="Previous @StepWord actor">‹ Previous @StepWord</button>
                <button class="btn ghost small" @onclick="() => StepTo(1)" disabled="@(StepCount(view) == 0)" title="Next @StepWord actor">Next @StepWord ›</button>
            </div>
        </div>

        @if (bars.Count == 0)
        {
            <div class="chart-empty muted">@(show == ActorShow.All ? "No actors have started yet." : $"No {StepWord} actors.")</div>
        }
        else
        {
            <div class="chart-scroll">
                <DockZoom Select="true" OnPick="i => PickAt(bars, i)" class="chart" style="@($"min-width:{bars.Count * (bars.Count > 60 ? 4 : 14)}px")" role="group" aria-label="Actors" data-elapsed="@Ms(s.Elapsed * 1000)" data-scale="@Ms(scale)">
                    <span class="chart-max">@Format.Ms(scale)</span>
                    <span class="dz-label" aria-hidden="true"></span>
                    @foreach (var b in bars)
                    {
                        var bar = b;
                        @if (bar.Total == 0)
                        {
                            <span class="bar-hit empty"></span>
                        }
                        else
                        {
                            var on = bar.IsBucket ? (selectedBucket is { } sb && sb == bar.BucketStart) : bar.IsRunningActor ? selRunning == bar.Sequence : (selected is { } sel && sel.Sequence == bar.Sequence);
                            <button class="bar-hit @(on ? "on" : "")" data-l1="@LabelTop(bar, width)" data-l2="@LabelSub(bar, width)" aria-pressed="@Aria.Bool(on)" title="@BarTitle(bar, width)" aria-label="@BarTitle(bar, width)" @onclick="() => PickBar(bar)">
                                @if (bar.IsRunningActor)
                                {
                                    <i class="bar run" data-start="@Ms(bar.BucketStart * 1000)"></i>
                                }
                                else if (bar.Running > 0)
                                {
                                    <span class="bar-stack" style="height:@Pct(bar.MaxMs / scale)%">
                                        <i class="bar run" style="flex:@bar.Running"></i>
                                        @if (bar.Count > 0) { <i class="bar @BarCls(bar.Outcome)" style="flex:@bar.Count"></i> }
                                    </span>
                                }
                                else
                                {
                                    <i class="bar @BarCls(bar.Outcome)" style="height:@Pct(bar.MaxMs / scale)%"></i>
                                }
                            </button>
                        }
                    }
                </DockZoom>
            </div>
            <p class="chart-note muted">
                @if (bucketed) { <text>@Format.Plural(total, "actor", "actors") in time buckets of @Format.Time(width); a bar is red or yellow if any actor in it failed or was slow. Click a bar to list its actors.</text> }
                else { <text>One bar per actor, taller = slower. Click an actor to see its calls.</text> }
            </p>
        }

        @if (selBucketActors is not null)
        {
            <section class="bucket" aria-label="Actors in this time bucket">
                <h3>@Format.Plural(selBucketActors.Count, "actor", "actors") from @Format.Time(bucket!.Value) to @Format.Time(bucket.Value + width)</h3>
                <VirtualList Class="actor-list" Items="selBucketActors" RowHeight="34" ResetKey="@bucket">
                    <ItemContent Context="a">
                        <button class="actor-row @(selected is { } sel2 && sel2.Sequence == a.Sequence ? "on" : "")" aria-pressed="@Aria.Bool(selected is { } sel3 && sel3.Sequence == a.Sequence)" @onclick="() => selected = a">
                            <span class="name">@a.Name</span>
                            <span class="dur">@Format.Ms(a.DurationMs)</span>
                            <span class="state @Cls(a.Outcome)">@(a.Failed ? "Failed" : a.SlowCalls > 0 ? "Slow" : "")</span>
                        </button>
                    </ItemContent>
                </VirtualList>
            </section>
        }

        @if (selRunning is { } rseq && runningNow.FirstOrDefault(r => r.Sequence == rseq) is { } ra)
        {
            var elapsedMs = Math.Max(0, (s.Elapsed - ra.StartedAt) * 1000);
            var denom = Math.Max(1, Math.Max(scale, elapsedMs));
            <section class="actor-panel p-run" aria-label="@ra.Name">
                <div class="actor-head">
                    <b>@ra.Name</b>
                    <span class="state run">Running</span>
                    <span class="muted">@Format.Ms(elapsedMs) so far · started @Format.Time(ra.StartedAt)</span>
                    <span class="spacer"></span>
                    <button class="btn ghost small" @onclick="() => Logs.Show(Index, ra.Sequence)">Open logs for this actor</button>
                    <button class="icon-btn" @onclick="() => selRunning = null" aria-label="Deselect actor">✕</button>
                </div>
                <ol class="calls" aria-label="Calls of @ra.Name so far">
                    @foreach (var call in ra.Calls.Where(c => !c.Skipped && c.OffsetMs <= elapsedMs))
                    {
                        var done = call.OffsetMs + call.DurationMs <= elapsedMs;
                        var cls = !done ? "run" : call.Failed ? "bad" : "good";
                        var w = (done ? call.DurationMs : elapsedMs - call.OffsetMs) / denom * 100;
                        <li class="call @cls">
                            <span class="call-name" title="@call.Name">@call.Name</span>
                            <span class="track"><i style="left:@Pct(call.OffsetMs / denom)%;width:@(Math.Max(0.8, w).ToString("0.##", CultureInfo.InvariantCulture))%"></i></span>
                            <span class="call-dur">@(done ? Format.Ms(call.DurationMs) : "")</span>
                            <span class="call-status">@(!done ? "running" : call.Failed ? (call.Status?.ToString() ?? "timeout") : call.Status?.ToString() ?? "")</span>
                        </li>
                    }
                </ol>
            </section>
        }

        @if (selected is { } actor)
        {
            var detail = s.Store.Detail(actor.Sequence);
            <section class="actor-panel p-@Cls(actor.Outcome)" aria-label="@actor.Name">
                <div class="actor-head">
                    <b>@actor.Name</b>
                    <span class="state @Cls(actor.Outcome)">@(actor.Failed ? "Failed" : actor.SlowCalls > 0 ? "Slow" : "Ok")</span>
                    <span class="muted">@Format.Ms(actor.DurationMs) · started @Format.Time(actor.StartedAt)</span>
                    <span class="spacer"></span>
                    <button class="btn ghost small" @onclick="() => Logs.Show(Index, actor.Sequence)">Open logs for this actor</button>
                    <button class="icon-btn" @onclick="() => selected = null" aria-label="Deselect actor">✕</button>
                </div>
                @if (actor.Error is not null) { <p class="actor-error bad">@actor.Error</p> }
                @if (detail is null)
                {
                    <p class="muted">The calls of this actor are no longer kept (only the latest @Format.Num(RunStore.DetailPerScenario) actors of each scenario keep their calls and logs).</p>
                }
                else
                {
                    <ol class="calls" aria-label="Calls of @actor.Name">
                        @foreach (var c in detail.Calls)
                        {
                            var call = c;
                            var cls = call.Failed ? "bad" : call.Slow ? "warn" : call.Skipped ? "" : "good";
                            <li class="call @cls @(call.Skipped ? "skipped" : "")">
                                <span class="call-name" title="@call.Name">@call.Name</span>
                                <span class="track"><i style="left:@Pct(call.OffsetMs / Math.Max(1, actor.DurationMs))%;width:@(Math.Max(0.8, call.DurationMs / Math.Max(1, actor.DurationMs) * 100).ToString("0.##", CultureInfo.InvariantCulture))%"></i></span>
                                <span class="call-dur">@(call.Skipped ? "" : Format.Ms(call.DurationMs))</span>
                                <span class="call-status" title="@(call.Slow ? $"Typical for this call: {Format.Ms(call.TypicalMs ?? 0)}" : call.Error)">@CallStatus(call)</span>
                            </li>
                        }
                    </ol>
                }
            </section>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public int Index { get; set; }
    [Parameter, EditorRequired] public RunSnapshot Snapshot { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference root;
    private ActorShow show = ActorShow.All;
    private ActorRecord? selected;
    private int? selRunning;
    private double? bucket;
    private bool refocus = true;
    private List<ActorRecord>? bucketCache;
    private (double, double, ActorShow, int) bucketKey;

    private string StepWord => show == ActorShow.Slow ? "slow" : "failed";
    private ActorOutcome StepOutcome => show == ActorShow.Slow ? ActorOutcome.Slow : ActorOutcome.Failed;
    private int StepCount(ScenarioView v) => show == ActorShow.Slow ? v.SlowActors : v.Failed;

    protected override void OnInitialized() => Logs.Changed += OnLogsChanged;

    // A selected running actor turns into its finished record in place once it completes.
    protected override void OnParametersSet()
    {
        if (selRunning is not { } seq) return;
        var running = Snapshot.ActorsInFlight is { } rn && Index < rn.Length ? rn[Index] : [];
        if (running.Any(r => r.Sequence == seq)) return;
        var actors = Snapshot.Store.Actors(Index);
        for (var i = Snapshot.Scenarios[Index].Finished - 1; i >= 0; i--)
            if (actors[i].Sequence == seq) { selected = actors[i]; break; }
        selRunning = null;
    }

    // When the Logs popup (which sits on top of this one) closes, take the keyboard focus back so Esc keeps working.
    private void OnLogsChanged()
    {
        if (!Logs.IsOpen) { refocus = true; InvokeAsync(StateHasChanged); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!refocus || Logs.IsOpen) return;
        refocus = false;
        try { await root.FocusAsync(); } catch (Exception) { }
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") OnClose.InvokeAsync();
    }

    private void SetShow(ActorShow s) { show = s; bucket = null; }

    private void PickAt(List<ActorBar> bars, int index)
    {
        if (index >= 0 && index < bars.Count && bars[index].Total > 0) PickBar(bars[index]);
    }

    private void PickBar(ActorBar bar)
    {
        if (bar.IsBucket) { bucket = bucket == bar.BucketStart ? null : bar.BucketStart; selected = null; selRunning = null; }
        else if (bar.IsRunningActor) { selected = null; selRunning = selRunning == bar.Sequence ? null : bar.Sequence; }
        else
        {
            var actors = Snapshot.Store.Actors(Index);
            for (var i = 0; i < Snapshot.Scenarios[Index].Finished; i++)
                if (actors[i].Sequence == bar.Sequence) { selRunning = null; selected = selected is { } s && s.Sequence == bar.Sequence ? null : actors[i]; break; }
        }
    }

    private void StepTo(int direction)
    {
        var found = ActorBars.Step(Snapshot.Store.Actors(Index), Snapshot.Scenarios[Index].Finished, StepOutcome, selected?.Sequence, direction);
        if (found is null) return;
        selected = found;
        selRunning = null;
        bucket = null;
    }

    /// <summary>The actors of the selected time bucket, rebuilt only when the bucket, filter or number of actors changes.</summary>
    private List<ActorRecord> BucketList(IReadOnlyList<ActorRecord> actors, int count, double start, double width)
    {
        var key = (start, width, show, count);
        if (bucketCache is null || bucketKey != key) { bucketCache = ActorBars.BucketActors(actors, count, show, start, width); bucketKey = key; }
        return bucketCache;
    }

    private static string BarCls(ActorOutcome o) => o switch { ActorOutcome.Failed => "bad", ActorOutcome.Slow => "warn", _ => "good" };
    private static string Cls(ActorOutcome o) => o switch { ActorOutcome.Failed => "bad", ActorOutcome.Slow => "warn", _ => "" };
    private static string Ms(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string Pct(double f) => Math.Clamp(f * 100, 3, 100).ToString("0.#", CultureInfo.InvariantCulture);

    /// <summary>Label inside the hovered bar (brain 0023): actor number or time range, then start time and duration or actor count. Times are run time (m:ss).</summary>
    private static string LabelTop(ActorBar b, double width) => b.IsBucket ? $"{Format.Time(b.BucketStart)}–{Format.Time(b.BucketStart + width)}" : $"#{b.Sequence + 1}";

    private static string LabelSub(ActorBar b, double width)
    {
        if (b.IsBucket) return Format.Plural(b.Total, "actor", "actors");
        return b.IsRunningActor ? $"{Format.Time(b.BucketStart)} · running" : $"{Format.Time(b.BucketStart)} · {Format.Ms(b.MaxMs)}";
    }

    private static string BarTitle(ActorBar b, double width)
    {
        if (b.IsRunningActor) return $"Actor #{b.Sequence + 1}, running, {Format.Ms(b.MaxMs)} so far";
        if (!b.IsBucket) return $"Actor #{b.Sequence + 1}, {Format.Ms(b.MaxMs)}" + (b.Failed > 0 ? ", failed" : b.Slow > 0 ? ", slow" : "");
        var text = $"{Format.Time(b.BucketStart)} to {Format.Time(b.BucketStart + width)}: {Format.Plural(b.Count, "actor", "actors")}";
        if (b.Failed > 0) text += $", {b.Failed} failed";
        if (b.Slow > 0) text += $", {b.Slow} slow";
        if (b.Running > 0) text += $", {b.Running} running";
        return text;
    }

    private static string CallStatus(FakeCall c) =>
        c.Skipped ? "skipped" : c.Failed ? (c.Status?.ToString() ?? "timeout") : c.Slow ? "slow" : c.Status?.ToString() ?? "";

    public void Dispose() => Logs.Changed -= OnLogsChanged;
}
