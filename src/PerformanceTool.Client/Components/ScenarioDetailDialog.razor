    /// <summary>Statistics of the actors in the visible window (brain 0030), recomputed when the window changes and at most every 0.7 s otherwise.</summary>
    private ActorStats StatsFor(IReadOnlyList<ActorRecord> actors, int count, double from, double to)
    {
        var key = (from, to);
        if (key == statsKey && (count == statsCount || Environment.TickCount64 - statsAt < 700)) return statsCache;
        statsCache = ActorStats.Compute(actors, count, from, to);
        statsKey = key; statsCount = count; statsAt = Environment.TickCount64;
        return statsCache;
    }

    private static string Pc(double v) => v == 0 ? "0%" : v < 10 ? v.ToString("0.0", CultureInfo.InvariantCulture) + "%" : v.ToString("0", CultureInfo.InvariantCulture) + "%";

    private void SelectIndex(int index)
    {
        var actors = Snapshot.Store.Actors(Index);
        if (index >= 0 && index < actors.Count) { selRunning = null; selected = actors[index]; }
    }

    private void TailOnly(double ms) { tailMs = tailMs is null ? ms : null; show = ActorShow.All; bucket = null; }
    private bool refocus = true;
    private DockZoom? zoom;
    // Freeze while aiming (brain 0026): the chart data of the last normal render, and the data held while the user aims.
    private sealed record ChartData(List<ActorBar> Bars, double Scale, double Width, int Total, double ElapsedMs, int Starts, int Finished, IReadOnlyList<RunningActor> Running, double? GridFrom = null);
    private ChartData? lastChart, fz;
