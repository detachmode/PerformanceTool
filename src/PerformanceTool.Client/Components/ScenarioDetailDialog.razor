    /// <summary>The chart's width in CSS pixels, reported by the script (0 until known): bursts unfold when their actors fit (brain 0040).</summary>
    private double chartPx;
    /// <summary>Hysteresis of unfolding (brain 0040): a burst folds again only when its bars are clearly narrower than where it unfolded.</summary>
    private readonly UnfoldHysteresis unfoldPlay = new();
    private void SetChartSize(double px) { if (Math.Abs(px - chartPx) >= 1) { chartPx = px; fz = null; } }
    /// <summary>Grid slots (their start, run seconds) whose burst is unfolded in the chart at the last render (brain 0038), for stepping through failed actors.</summary>
    private Dictionary<double, int> unfoldedSlots = [];     // slot -> size of the burst's even groups (brain 0043)

    private string StepWord => show == ActorShow.Slow ? "slow" : "failed";
    private ActorOutcome StepOutcome => show == ActorShow.Slow ? ActorOutcome.Slow : ActorOutcome.Failed;
    private int StepCount(ScenarioView v) => show == ActorShow.Slow ? v.SlowActors : v.Failed;

    protected override void OnInitialized()
    {
        Logs.Changed += OnLogsChanged; Settings.Changed += OnSettingsChanged;
        switch (InitialShow)
        {
            case DetailFilter.Failed: show = ActorShow.Failed; break;
            case DetailFilter.Slow: show = ActorShow.Slow; break;
            case DetailFilter.Slowest5Pct:
                var st = ActorStats.Compute(Snapshot.Store.Actors(Index), Snapshot.Scenarios[Index].Finished, double.NegativeInfinity, double.PositiveInfinity);
                if (st.Count > 0) tailMs = st.P95;
                break;
        }
    }

    private void OnSettingsChanged()
    {
        fz = null;
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    // A selected running actor turns into its finished record in place once it completes.
    protected override void OnParametersSet()
    {
        if (selRunning is not { } seq) return;
        var running = Snapshot.ActorsInFlight is { } rn && Index < rn.Length ? rn[Index] : [];
        if (running.Any(r => r.Sequence == seq)) return;
        var actors = Snapshot.Store.Actors(Index);
        for (var i = Snapshot.Scenarios[Index].Finished - 1; i >= 0; i--)
            if (actors[i].Sequence == seq) { selected = actors[i]; break; }
        selRunning = null;
    }

    // When the Logs popup (which sits on top of this one) closes, take the keyboard focus back so Esc keeps working.
    private void OnLogsChanged()
    {
        if (!Logs.IsOpen) { refocus = true; InvokeAsync(StateHasChanged); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!refocus || Logs.IsOpen) return;
        refocus = false;
        try { await root.FocusAsync(); } catch (Exception) { }
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") OnClose.InvokeAsync();
    }

    private void SetShow(ActorShow s, bool keepBucket = false) { show = s; tailMs = null; if (!keepBucket) bucket = null; fz = null; }

    private void Brush(BrushRange r)
    {
        win = new Win(Math.Max(0, r.From), r.To, r.ToEnd);
        bucket = null; fz = null; tailMs = null;
    }
    /// <summary>Pinch on the chart (brain 0031): the same window as the brush, clamped to the run. As wide as the run it means the whole run; reaching the newest end follows the live edge.</summary>
    private void PinchZoom(BrushRange r)
    {
        var elapsed = Snapshot.Elapsed;
        var span = r.To - r.From;
        if (span >= elapsed * 0.98) { ResetZoom(); return; }
        var from = r.From < 0 ? 0 : r.From;
        var to = from + span;
        // a pan (same span: swipe on the bars, edge pan, overview strip) keeps the bucket width, so a selected group stays selected (brain 0037)
        var pan = win is { } ow && Math.Abs(ow.To - ow.From - span) <= 1e-6 * Math.Max(1, span);
        if (to >= elapsed - 0.02 * span) win = new Win(Math.Max(0, elapsed - span), elapsed, true);
        else win = new Win(from, to, false);
        if (!pan) bucket = null;
        fz = null; tailMs = null;
    }
    private void ZoomTo(double from, double to) { win = new Win(from, to, false); bucket = null; fz = null; tailMs = null; }
    private void ResetZoom() { win = null; bucket = null; fz = null; tailMs = null; }

    private void SelectRow(ActorRow row)
    {
        if (row.IsRunning) { selected = null; selRunning = row.Sequence; return; }
        var actors = Snapshot.Store.Actors(Index);
        if (row.Index >= 0 && row.Index < actors.Count) { selRunning = null; selected = actors[row.Index]; }
    }

    /// <summary>
    /// The side list rows (failed, slow, running, ok; each by time) for the visible time frame, narrowed to the selected bucket. Rebuilt when the frame or filter
    /// changes, and at most every 0.7 s when actors finished; held still while the pointer is over the list (like brain 0026).
    /// </summary>
    private List<ActorRow> SideRows(IReadOnlyList<ActorRecord> actors, int count, IReadOnlyList<RunningActor> running, ActorShow sh, double from, double to, double? bucketStart, double width)
    {
        var lo = bucketStart is { } b ? Math.Max(from, b) : from;
        var hi = bucketStart is { } b2 ? Math.Min(to, b2 + width) : to;
        var key = (lo, hi, sh, tailMs, groupSel is { } gs0 ? ((double, int, int)?)(gs0.Slot, gs0.Lo, gs0.Hi) : null);
        var countKey = (count, running.Count);
        var stale = key != sideKey || (countKey != sideCountKey && !listHover && Environment.TickCount64 - sideAt > 700);
        if (!stale) return sideCache;
        sideCache = ActorOrder.Rows(actors, count, running, sh, lo, hi, tailMs ?? 0);
        if (groupSel is { } gf) sideCache = sideCache.Where(r => r.Sequence >= gf.Lo && r.Sequence <= gf.Hi).ToList();
        sideKey = key; sideCountKey = countKey; sideAt = Environment.TickCount64;
        sideReset = $"{lo}|{hi}|{sh}|{tailMs}|{groupSel}";
        sideCounts = new int[4];
        foreach (var r in sideCache) sideCounts[(int)r.State]++;
        return sideCache;
    }

    private void SetAiming(bool on)
    {
        aiming = on;
        fz = on ? lastChart : null;
    }

    private async Task Resume()
    {
        aiming = false; fz = null;
        if (zoom is not null) await zoom.ReleaseAsync();
    }

    /// <summary>A bar was picked (on pointer-down): "a12" actor, "r12" running actor, "bNN" time bucket. Actors are found by sequence, so the pick is right even if the bar has changed since (a running actor may have finished).</summary>
    private void PickKey(string key)
    {
        if (key.Length < 2) return;
        if (key[0] == 'b')
        {
            if (double.TryParse(key.AsSpan(1), NumberStyles.Float, CultureInfo.InvariantCulture, out var start)) PickBar(new ActorBar(0, 0, 0, 0, -1, start));
        }
        else if (key[0] == 'g')
        {
            var p = key.Substring(1).Split(':');
            if (p.Length == 3 && double.TryParse(p[0], NumberStyles.Float, CultureInfo.InvariantCulture, out var slot) && int.TryParse(p[1], out var glo) && int.TryParse(p[2], out var ghi))
                PickBar(new ActorBar(0, 0, 0, 0, -1, slot, Slot: slot, GroupLo: glo, GroupHi: ghi));
        }
        else if (int.TryParse(key.AsSpan(1), out var seq))
        {
            var inFlight = Snapshot.ActorsInFlight is { } rn && Index < rn.Length && rn[Index].Any(r => r.Sequence == seq);
            PickBar(new ActorBar(inFlight ? 0 : 1, 0, 0, 0, seq, 0, inFlight ? 1 : 0));
        }
    }

    private void PickBar(ActorBar bar)
    {
        if (bar.IsBurstGroup)
        {
            var same = groupSel is { } g0 && g0.Slot == bar.Slot && g0.Lo == bar.GroupLo && g0.Hi == bar.GroupHi;
            bucket = null; selected = null; selRunning = null;
            if (!same) groupSel = (bar.Slot, bar.GroupLo, bar.GroupHi);
        }
        else if (bar.IsBucket) { bucket = bucket == bar.BucketStart ? null : bar.BucketStart; selected = null; selRunning = null; }
        else if (bar.IsRunningActor) { groupSel = null; selected = null; selRunning = selRunning == bar.Sequence ? null : bar.Sequence; }
        else
        {
            var actors = Snapshot.Store.Actors(Index);
            groupSel = null;
            for (var i = 0; i < Snapshot.Scenarios[Index].Finished; i++)
                if (actors[i].Sequence == bar.Sequence) { selRunning = null; selected = selected is { } s && s.Sequence == bar.Sequence ? null : actors[i]; break; }
        }
    }

    /// <summary>
    /// Previous / next failed (or slow) actor in time order, wrapping around. With grouped bars (brain 0032) it steps to the previous / next group that
    /// holds one and selects the group; when zoomed in and the target is outside the view, the view moves to it (same span, brain 0036).
    /// </summary>
    private void StepTo(int direction)
    {
        var actors = Snapshot.Store.Actors(Index);
        var count = Snapshot.Scenarios[Index].Finished;
        var outcome = StepOutcome;
        var list = new List<ActorRecord>();
        for (var i = 0; i < count; i++) if (actors[i].Outcome == outcome) list.Add(actors[i]);
        if (list.Count == 0) return;
        list.Sort((x, y) => x.StartedAt != y.StartedAt ? x.StartedAt.CompareTo(y.StartedAt) : x.Sequence.CompareTo(y.Sequence));
        var w = lastChart?.Width ?? 0;
        var elapsed = Snapshot.Elapsed;
        double vf = double.NegativeInfinity, vt = double.PositiveInfinity;
        if (win is { } wv) { var sp = wv.To - wv.From; if (wv.Follow) { vt = elapsed; vf = Math.Max(0, vt - sp); } else { vf = wv.From; vt = wv.To; } }

        ActorRecord? FromView() => direction > 0
            ? list.Cast<ActorRecord?>().FirstOrDefault(a => a!.Value.StartedAt >= (double.IsNegativeInfinity(vf) ? 0 : vf))
            : list.Cast<ActorRecord?>().LastOrDefault(a => a!.Value.StartedAt < (double.IsPositiveInfinity(vt) ? double.MaxValue : vt));
        // the key of the current position: a group start (grouped bars) or an actor (start time, sequence)
        // Unfolded bursts (brain 0038) step actor by actor: inside one the key is (slot, sequence + 1), a group bar or the whole burst is (slot, 0).
        ActorRecord? tg = null;
        // brain 0043: a burst in even groups steps group by group (the key is the group number), a burst of single bars actor by actor
        var order = new Dictionary<double, List<int>>();
        if (w > 0 && unfoldedSlots.Count > 0)
        {
            var tmp = new Dictionary<double, List<(double, int)>>();
            void Note(double start, int seq) { var sl = ActorBars.BucketOf(start, w); if (!unfoldedSlots.ContainsKey(sl)) return; if (!tmp.TryGetValue(sl, out var l)) tmp[sl] = l = []; l.Add((start, seq)); }
            for (var i = 0; i < count; i++) Note(actors[i].StartedAt, actors[i].Sequence);
            if (Snapshot.ActorsInFlight is { } rn && Index < rn.Length) foreach (var r in rn[Index]) Note(r.StartedAt, r.Sequence);
            foreach (var (sl, l) in tmp) { l.Sort(); order[sl] = l.Select(x => x.Item2).ToList(); }
        }
        long Pos(double sl, int seq)
        {
            if (!order.TryGetValue(sl, out var l)) return 0;
            var r = Math.Max(0, l.IndexOf(seq));
            return unfoldedSlots[sl] > 1 ? r / unfoldedSlots[sl] + 1L : r + 1L;
        }
        (double, long) GKey(ActorRecord a) { var sl = ActorBars.BucketOf(a.StartedAt, w); return (sl, unfoldedSlots.ContainsKey(sl) ? Pos(sl, a.Sequence) : 0L); }
        if (w > 0)
        {
            (double, long)? cur = bucket is { } bk ? (bk, 0L) : groupSel is { } gk ? (gk.Slot, Pos(gk.Slot, gk.Lo)) : selected is { } sa ? GKey(sa) : null;
            if (cur is { } c)
                tg = direction > 0 ? list.Cast<ActorRecord?>().FirstOrDefault(a => GKey(a!.Value).CompareTo(c) > 0) : list.Cast<ActorRecord?>().LastOrDefault(a => GKey(a!.Value).CompareTo(c) < 0);
            else
                tg = FromView();
        }
        else if (selected is { } cs)
        {
            tg = direction > 0 ? list.Cast<ActorRecord?>().FirstOrDefault(a => a!.Value.StartedAt > cs.StartedAt || (a.Value.StartedAt == cs.StartedAt && a.Value.Sequence > cs.Sequence))
                : list.Cast<ActorRecord?>().LastOrDefault(a => a!.Value.StartedAt < cs.StartedAt || (a.Value.StartedAt == cs.StartedAt && a.Value.Sequence < cs.Sequence));
        }
        else tg = FromView();
        var target = tg ?? (direction > 0 ? list[0] : list[^1]);     // wrap around

        double t0 = target.StartedAt, t1 = target.StartedAt;
        if (w > 0) { t0 = ActorBars.BucketOf(target.StartedAt, w); t1 = t0 + w; }
        if (win is not null && (t0 < vf || t1 > vt) && vt - vf > 0)
        {
            var span = vt - vf;
            var from = Math.Clamp((t0 + t1) / 2 - span / 2, 0, Math.Max(0, elapsed - span));
            var to = from + span;
            win = to >= elapsed - 0.02 * span ? new Win(Math.Max(0, elapsed - span), elapsed, true) : new Win(from, to, false);
        }
        tailMs = null; fz = null; selRunning = null;
        if (w > 0 && unfoldedSlots.TryGetValue(t0, out var gsz) && gsz > 1 && order.TryGetValue(t0, out var ord))
        {
            var at = ord.IndexOf(target.Sequence) / gsz * gsz;
            var part = ord.Skip(at).Take(gsz).ToList();
            bucket = null; selected = null;
            groupSel = (t0, part.Min(), part.Max());
        }
        else if (w > 0 && !unfoldedSlots.ContainsKey(t0) && !(win is not null && ActorBars.BucketActors(actors, count, show, t0, w).Count <= 1))
        {
            bucket = t0; selected = null;
        }
        else { bucket = null; selected = target; }
    }

    /// <summary>A bar that stands for several actors (brain 0032): lighter fill, outline and a count badge.</summary>
    private static bool IsGroup(ActorBar b) => b.IsBucket && b.Total > 1;

    private static string BarCls(ActorBar b) => b.Failed > 0 ? "bad" : b.Slow > 0 ? "warn" : ActorOrder.Good(b.Step);
    private static string Cls(ActorOutcome o) => o switch { ActorOutcome.Failed => "bad", ActorOutcome.Slow => "warn", _ => "" };
    private static string Ms(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string Pct(double f) => Math.Clamp(f * 100, 3, 100).ToString("0.#", CultureInfo.InvariantCulture);

    /// <summary>Label inside the hovered bar (brain 0023): actor number or time range, then start time and duration or actor count. Times are run time (m:ss).</summary>
    private static string LabelTop(ActorBar b, double width) => b.IsBurstGroup ? $"#{b.GroupLo + 1}–#{b.GroupHi + 1}" : b.IsBucket ? $"{FT(b.BucketStart, width)}–{FT(b.BucketStart + width, width)}" : $"#{b.Sequence + 1}";

    /// <summary>Run time m:ss, with decimals when the bucket width is below a second (zoomed in far).</summary>
    private static string FT(double seconds, double width)
    {
        if (width >= 1) return Format.Time(seconds);
        var d = width < 0.1 ? 2 : 1;
        var whole = Math.Floor(seconds);
        var frac = (int)Math.Floor((seconds - whole) * (d == 2 ? 100 : 10) + 1e-6);
        return Format.Time(whole) + "." + frac.ToString(d == 2 ? "00" : "0", CultureInfo.InvariantCulture);
    }

    private static string T(double seconds) => seconds.ToString("0.###", CultureInfo.InvariantCulture);
    private static string K(double cover) => cover.ToString("0.######", CultureInfo.InvariantCulture);

    /// <summary>Right-hand figure of the hover label: duration (with the outcome in words, brain 0018), or the actor count of a bucket.</summary>
    private static string LabelMeta(ActorBar b)
    {
        if (b.IsBucket) return Format.Plural(b.Total, "actor", "actors");
        if (b.IsRunningActor) return "running";
        return Format.Ms(b.MaxMs) + (b.Failed > 0 ? " · failed" : b.Slow > 0 ? " · slow" : Format.OverTypical(b.Ratio) ? " · " + Format.Times(b.Ratio) : "");
    }

    private static string LabelSub(ActorBar b)
    {
        if (!b.IsBucket) return $"started {Format.Time(b.BucketStart)}";
        return "";   // buckets show coloured counts instead (data-bad / data-slow / data-ok / data-runn, drawn by dock-magnify.js)
    }

    private static string Status(ActorBar b) => b.Failed > 0 ? "bad" : b.Slow > 0 ? "warn" : b.Running > 0 && b.Count == 0 ? "run" : ActorOrder.Good(b.Step);

    /// <summary>Compact text for the faint labels of the neighbours of the hovered bar.</summary>
    private static string Near1(ActorBar b, double width) => b.IsBurstGroup ? $"#{b.GroupLo + 1}–{b.GroupHi + 1}" : b.IsBucket ? FT(b.BucketStart, width) : $"#{b.Sequence + 1}";
    private static string Near2(ActorBar b) => b.IsBucket ? Format.Num(b.Total) : b.IsRunningActor ? "…" : b.MaxMs < 1000 ? $"{b.MaxMs:0}ms" : b.MaxMs < 60_000 ? $"{b.MaxMs / 1000:0.0}s" : Format.Time(b.MaxMs / 1000);

    private static string BarTitle(ActorBar b, double width)
    {
        if (b.IsRunningActor) return $"Actor #{b.Sequence + 1}, running, {Format.Ms(b.MaxMs)} so far";
        if (!b.IsBucket) return $"Actor #{b.Sequence + 1}, {Format.Ms(b.MaxMs)}" + (b.Failed > 0 ? ", failed" : b.Slow > 0 ? ", slow" : Format.OverTypical(b.Ratio) ? $", {Format.Times(b.Ratio)} typical" : "");
        var text = b.IsBurstGroup ? $"Actors #{b.GroupLo + 1}–#{b.GroupHi + 1} of the burst at {FT(b.Slot, width)}: {Format.Plural(b.Count, "actor", "actors")}"
            : $"{FT(b.BucketStart, width)} to {FT(b.BucketStart + width, width)}: {Format.Plural(b.Count, "actor", "actors")}";
        if (b.Failed > 0) text += $", {b.Failed} failed";
        if (b.Slow > 0) text += $", {b.Slow} slow";
        else if (Format.OverTypical(b.Ratio)) text += $", the slowest {Format.Times(b.Ratio)} typical";
        if (b.Running > 0) text += $", {b.Running} running";
        return text;
    }

    private static string CallStatus(FakeCall c) =>
        c.Skipped ? "skipped" : c.Failed ? (c.Status?.ToString() ?? "timeout") : c.Slow ? "slow" : c.Status?.ToString() ?? "";

    public void Dispose() { Logs.Changed -= OnLogsChanged; Settings.Changed -= OnSettingsChanged; }
