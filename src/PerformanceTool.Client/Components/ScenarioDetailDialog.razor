@* Scenario popup (brain 0020, 0017, 0021): inspect the run of one scenario. One bounded actor chart (a bar per actor, or per time bucket when
   there are many), a quick Show: All / Failed / Slow switch with stepping, and the calls of the selected actor. Logs are one click away. *@
@using System.Globalization
@implements IDisposable
@inject LogsPopupState Logs
@inject ViewSettings Settings
@inject ScenarioCatalog Catalog
@inject CustomScriptsPopupState ScriptsPopup

@{
    var s = Snapshot;
    var view = s.Scenarios[Index];
    var actors = s.Store.Actors(Index);
    var label = s.Labels[Index];
    var actual = s.Elapsed > 0 ? view.Starts / (s.Elapsed / 60) : 0;
    var target = s.Plan.Scenarios[Index].EffectiveRatePerMinute();
    var shape = Format.Shape(s.Plan.Scenarios[Index]);
    var runningAll = s.ActorsInFlight is { } rn && Index < rn.Length ? rn[Index] : [];
    // The brushed time window (brain 0023, update 3): actors that started in [from, to). A window that reaches the live edge follows it (to = open).
    // The view [vf, vt]: a following window keeps its width and slides with the live edge.
    double vf = 0, vt = 0;
    if (win is { } w0) { var sp0 = w0.To - w0.From; if (w0.Follow) { vt = s.Elapsed; vf = Math.Max(0, vt - sp0); } else { vf = w0.From; vt = w0.To; } }
    var from = win is null ? double.NegativeInfinity : vf;
    var to = win is { Follow: false } ? vt : double.PositiveInfinity;
    IReadOnlyList<RunningActor> runningNow = win is null ? runningAll : runningAll.Where(r => r.StartedAt >= from && r.StartedAt < to).ToList();
    // While the user aims at the chart (brain 0026) the bars of the moment of aiming are shown again; running bars still grow with the clock,
    // and actors that were running at that moment get their final colour in place once they finish.
    ChartData cd;
    if (aiming && fz is not null)
    {
        var resolved = show == ActorShow.All ? ActorBars.ResolveFinished(fz.Bars, fz.Running, actors, fz.Finished, view.Finished, fz.Width, fz.GridFrom) : fz.Bars;
        cd = ReferenceEquals(resolved, fz.Bars) ? fz : fz with { Bars = resolved };
    }
    else
    {
        List<ActorBar> b0; int total0; double width0; double? gridFrom = null; IReadOnlyList<RunningActor> runningBars = runningNow;
        if (win is not null)
        {
            // zoomed: bars on the stable time grid, buffered beyond both edges of the view (the script slides them while panning)
            grid.Ensure(vf, vt, s.Elapsed, Settings.MaxBars);
            width0 = grid.Width; gridFrom = grid.From;
            b0 = ActorBars.BuildGrid(actors, view.Finished, show, width0, grid.First, grid.LastNow(s.Elapsed), vf, vt, out total0);
            var gTo = grid.To;
            runningBars = runningAll.Where(r => r.StartedAt >= gridFrom && r.StartedAt < gTo).ToList();
        }
        else b0 = ActorBars.Build(actors, view.Finished, show, out total0, out width0, from, to, Settings.MaxBars);
        var scale0 = b0.Count == 0 ? 1 : Math.Max(1, b0.Where(b => b.Running == 0).Select(b => b.MaxMs).DefaultIfEmpty(0).Max());
        if (show == ActorShow.All) b0 = ActorBars.WithRunning(b0, runningBars, width0, s.Elapsed, gridFrom);
        if (b0.Count > 0 && scale0 <= 1) scale0 = Math.Max(1, b0.Max(b => b.MaxMs));
        cd = new(b0, scale0, width0, total0, s.Elapsed * 1000, view.Starts, view.Finished, runningBars, gridFrom);
        lastChart = cd;
        if (aiming) fz = cd;
    }
    var bars = cd.Bars; var scale = cd.Scale; var width = cd.Width; var total = cd.Total;
    // As soon as there is room, bursts unfold into single-actor bars (brain 0038, rule of brain 0040: pixels per actor, with hysteresis); the grid stays
    // the one the script knows (cd.Bars), only this list changes, and the unfolded bars share the empty slots they borrow, so x stays linear in time.
    List<BurstSpan> burstSpans = [];
    if (win is null) unfoldPlay.Reset();
    else if (cd.GridFrom is { } gridStart && width > 0)
    {
        var room = UnfoldRoom.For(chartPx, vt - vf, unfoldPlay.Update(vt - vf), width, Settings.MaxBars);
        bars = ActorBars.Unfold(bars, actors, cd.Finished, show, cd.Running, width, ActorBars.SlotIndex(gridStart, width), cd.ElapsedMs / 1000, (vf + vt) / 2,
            ActorBars.UnfoldPerBurst(Settings.MaxBars), ActorBars.UnfoldBudget(Settings.MaxBars), room, out burstSpans);
    }
    var ovMarks = OverviewMarks(actors, view.Finished, s.Elapsed);
    unfoldedSlots = burstSpans.Count == 0 ? [] : burstSpans.ToDictionary(b => b.Slot, b => b.GroupSize);
    var bucketed = width > 0;
    var newCount = aiming && win is not { Follow: false } ? Math.Max(0, view.Starts - cd.Starts) : 0;
    var selSeq = selected?.Sequence ?? selRunning;
    var stats = StatsFor(actors, view.Finished, from, to);
    var activeBucket = bucketed ? bucket : null;
    var sideRows = SideRows(actors, view.Finished, runningNow, show, from, to, activeBucket, width);
    // The selected actor stays selected when it is folded into a time bucket: that bucket shows as selected.
    double? selStart = selected?.StartedAt ?? (selRunning is { } rs0 ? runningNow.FirstOrDefault(r => r.Sequence == rs0)?.StartedAt : null);
    var selectedBucket = selStart is { } sa0 && bucketed ? ActorBars.BucketOf(sa0, width) : bucket;
}

<div class="overlay" tabindex="-1" @ref="root" @onkeydown="OnKey" @onclick="OnClose" role="presentation">
    <div class="dialog wide" role="dialog" aria-modal="true" aria-labelledby="scn-title" @onclick:stopPropagation="true">
        <div class="dlg-head">
            <h2 id="scn-title">@label</h2>
            <span class="spacer"></span>
            @if (Index < s.Plan.Scenarios.Count && Catalog.IsCustom(s.Plan.Scenarios[Index].ScenarioId))
            {
                <button class="btn ghost small" @onclick="() => ScriptsPopup.Show(s.Plan.Scenarios[Index].ScenarioId)" title="View and edit this scenario's .cs file on the server">Edit .cs</button>
            }
            <button class="icon-btn gear" @onclick="Settings.Open" aria-label="Settings" title="Zoom strength and bars before grouping">⚙</button>
            <button class="icon-btn" @onclick="OnClose" aria-label="Close">✕</button>
        </div>

        <div class="pop-body">
        <div class="pop-main">
        <p class="figures">
            <button class="fig" @onclick="() => SetShow(ActorShow.All)" title="Show all actors" aria-pressed="@Aria.Bool(show == ActorShow.All)">@Format.Plural(view.Finished, "actor", "actors")</button>
            <button class="fig @(view.Failed > 0 ? "bad" : "")" @onclick="() => SetShow(ActorShow.Failed)" disabled="@(view.Failed == 0)" title="Show only the failed actors" aria-pressed="@Aria.Bool(show == ActorShow.Failed)">@Format.Plural(view.Failed, "error", "errors")</button>
            <button class="fig @(view.SlowCalls > 0 ? "warn" : "")" @onclick="() => SetShow(ActorShow.Slow)" disabled="@(view.SlowActors == 0)" title="Show only the slow actors" aria-pressed="@Aria.Bool(show == ActorShow.Slow)">@Format.Plural(view.SlowCalls, "slow call", "slow calls")</button>
            <span>@Format.Rate(actual) / @Format.Rate(target) @Terms.PerMinuteShort@(shape.Length > 0 ? " · " + shape : "")</span>
            @if (stats.Count > 0)
            {
                <span class="fig-sep" aria-hidden="true"></span>
                <button class="fig" @onclick="() => SelectIndex(stats.MedianIndex)" title="Typical duration (median of @Format.Plural(stats.Count, "actor", "actors")): open the actor in the middle">typical <b>@Format.Ms(stats.Median)</b></button>
                <button class="fig @(stats.TailIsSlow ? "warn" : "")" @onclick="() => TailOnly(stats.P95)" title="The slowest 5 % take at least @Format.Ms(stats.P95): list them" aria-pressed="@Aria.Bool(tailMs is not null)">slowest 5% <b>@Format.Ms(stats.P95)</b></button>
                <button class="fig @(stats.LongestIsSlow ? "warn" : "")" @onclick="() => SelectIndex(stats.LongestIndex)" title="Open the longest actor">longest <b>@Format.Ms(stats.Longest)</b></button>
                <button class="fig @(stats.Failed > 0 ? "bad" : "good")" @onclick="() => SetShow(ActorShow.Failed)" disabled="@(stats.Failed == 0)" title="Failed actors: @stats.Failed of @stats.Count">error rate <b>@Pc(stats.ErrorRate)</b></button>
                <button class="fig @(stats.Slow > 0 ? "warn" : "good")" @onclick="() => SetShow(ActorShow.Slow)" disabled="@(stats.Slow == 0)" title="Slow actors: @stats.Slow of @stats.Count">slow rate <b>@Pc(stats.SlowRate)</b></button>
            }
        </p>

        <div class="actors-bar">
            <div class="seg" role="group" aria-label="Show actors">
                <button class="@(show == ActorShow.All ? "on" : "")" aria-pressed="@Aria.Bool(show == ActorShow.All)" @onclick="() => SetShow(ActorShow.All)">All</button>
                <button class="@(show == ActorShow.Failed ? "on" : "")" aria-pressed="@Aria.Bool(show == ActorShow.Failed)" @onclick="() => SetShow(ActorShow.Failed)">Failed <span class="n">@Format.Num(view.Failed)</span></button>
                <button class="@(show == ActorShow.Slow ? "on" : "")" aria-pressed="@Aria.Bool(show == ActorShow.Slow)" @onclick="() => SetShow(ActorShow.Slow)">Slow <span class="n">@Format.Num(view.SlowActors)</span></button>
            </div>
            <div class="step" role="group" aria-label="Step through @StepWord actors">
                <button class="btn ghost small" @onclick="() => StepTo(-1)" disabled="@(StepCount(view) == 0)" title="Previous @StepWord actor">‹ Previous @StepWord</button>
                <button class="btn ghost small" @onclick="() => StepTo(1)" disabled="@(StepCount(view) == 0)" title="Next @StepWord actor">Next @StepWord ›</button>
            </div>
        </div>

        @if (bars.Count == 0)
        {
            <div class="chart-empty muted">@(show == ActorShow.All ? "No actors have started yet." : $"No {StepWord} actors.")</div>
        }
        else
        {
            <div class="chart-wrap">
            <div class="chart-status">
                @if (win is { } wz)
                {
                    <span class="zoom-chip"><span class="muted">Zoomed to</span> <b>@Format.Time(wz.From)@(wz.Follow ? " → now" : $" – {Format.Time(wz.To)}")</b>@(wz.Follow ? " (follows live)" : "")<button class="link-btn" @onclick="ResetZoom" title="Back to the whole run (live)">Reset zoom</button></span>
                }
                @if (aiming && newCount >= 0 && win is not { Follow: false })
                {
                    <button class="live-paused" @onclick="Resume" title="Show the newest actors now">● Live paused · @(newCount == 0 ? "no new actors" : Format.Plural(newCount, "new actor", "new actors"))</button>
                }
            </div>
            <div class="chart-scroll">
                <DockZoom @ref="zoom" Select="true" OnPick="PickKey" OnAim="SetAiming" OnSize="SetChartSize" class="@(cd.GridFrom is not null ? "chart dense grid" : bars.Count > 60 ? "chart dense" : "chart")" style="@(cd.GridFrom is not null ? $"--p:{(width / Math.Max(1e-6, vt - vf) * 100).ToString("0.######", CultureInfo.InvariantCulture)}%" : bars.Count > 60 ? null : $"min-width:{bars.Count * 14}px")" data-grid="@(cd.GridFrom is not null ? T(width) : null)" data-buf="@(cd.GridFrom is { } gf ? T(gf) : null)" OnBrush="Brush" OnZoom="PinchZoom" data-zoom="@Settings.Zoom.ToString(CultureInfo.InvariantCulture)" data-zoomed="@(win is not null ? "1" : null)" data-win="@(win is not null ? $"{vf.ToString("R", CultureInfo.InvariantCulture)} {vt.ToString("R", CultureInfo.InvariantCulture)}" : null)" role="group" aria-label="Actors" data-ov="@ovMarks" data-elapsed="@Ms(cd.ElapsedMs)" data-scale="@Ms(scale)">
                    <span class="chart-max">@Format.Ms(scale)</span>
                    <span class="dz-label" aria-hidden="true"></span>
                    <span class="dz-strip" aria-hidden="true"></span>
                    <span class="dz-axis" aria-hidden="true"></span>
                    <span class="dz-brush" aria-hidden="true"><span></span></span>
                    <span class="dz-over" tabindex="@(win is not null ? "0" : null)" role="@(win is not null ? "slider" : null)" aria-label="@(win is not null ? "Part of the run in view" : null)" aria-valuemin="@(win is not null ? "0" : null)" aria-valuemax="@(win is not null ? Ms(s.Elapsed) : null)" aria-valuenow="@(win is not null ? Ms((vf + vt) / 2) : null)" aria-valuetext="@(win is not null ? $"{Format.Time(vf)} to {Format.Time(vt)} of {Format.Time(s.Elapsed)}" : null)" aria-hidden="@(win is null ? "true" : null)" title="@(win is not null ? "The whole run; the outlined window is in view. Drag it or tap the strip to move the view (arrow keys too)." : "The whole run: red and amber marks show where actors failed or were slow. Tap a spot to zoom in there.")"></span>
                    <div class="dz-bars">
                    @foreach (var b in bars)
                    {
                        var bar = b;
                        @if (bar.Total == 0)
                        {
                            <span class="bar-hit empty" data-t0="@T(bar.BucketStart)" data-t1="@T(bar.BucketStart + width)"></span>
                        }
                        else
                        {
                            var on = bar.IsBurstGroup ? groupSel is { } gsel && gsel.Slot == bar.Slot && gsel.Lo == bar.GroupLo && gsel.Hi == bar.GroupHi : bar.InBurst && bar.IsBucket ? bucket == bar.BucketStart : bar.IsBucket ? (selectedBucket is { } sb && sb == bar.BucketStart) : selSeq == bar.Sequence;
                            var key = bar.IsBurstGroup ? $"g{T(bar.Slot)}:{bar.GroupLo}:{bar.GroupHi}" : bar.IsBucket ? "b" + T(bar.BucketStart) : (bar.IsRunningActor ? "r" : "a") + bar.Sequence;
                            <button class="bar-hit @(on ? "on" : "") @(bar.InBurst && bucket == bar.Slot ? "inb" : "")" data-key="@key" data-ub="@(bar.InBurst ? T(bar.Slot) : null)" data-k="@(bar.InBurst ? K(bar.Cover) : null)" style="@(bar.InBurst ? "--k:" + K(bar.Cover) : null)" data-ts="@(bar.InBurst ? T(bar.Slot) : null)" data-te="@(bar.InBurst ? T(bar.Slot + width) : null)" data-l1="@LabelTop(bar, width)" data-l2="@LabelMeta(bar)" data-l3="@LabelSub(bar)" data-s="@Status(bar)" data-ns="@(bar.IsBucket ? null : Status(bar))" data-bad="@(bar.IsBucket ? bar.Failed : null)" data-slow="@(bar.IsBucket ? bar.Slow : null)" data-ok="@(bar.IsBucket ? Math.Max(0, bar.Count - bar.Failed - bar.Slow) : null)" data-runn="@(bar.IsBucket ? bar.Running : null)" data-st="@(IsGroup(bar) ? ActorBars.StripeData(bar) : null)" data-n1="@Near1(bar, width)" data-n2="@Near2(bar)" data-t0="@T(bar.BucketStart)" data-t1="@T(bar.IsBucket ? bar.BucketStart + width : bar.BucketStart + bar.MaxMs / 1000)" data-run="@(bar.IsRunningActor ? "1" : null)" data-bucket="@(bar.IsBucket ? "1" : null)" aria-pressed="@Aria.Bool(on)" title="@BarTitle(bar, width)" aria-label="@BarTitle(bar, width)" @onclick="() => PickBar(bar)">
                                @if (bar.IsRunningActor)
                                {
                                    <i class="bar run" data-start="@Ms(bar.BucketStart * 1000)"></i>
                                }
                                else if (bar.Running > 0)
                                {
                                    <span class="bar-stack @(IsGroup(bar) ? "grp " + BarCls(bar) : null)" style="height:@Pct(bar.MaxMs / scale)%">
                                        <i class="bar run" style="flex:@bar.Running"></i>
                                        @if (bar.Count > 0) { <i class="bar @BarCls(bar) @(IsGroup(bar) ? "grp" : null)" style="flex:@bar.Count"></i> }
                                        @if (IsGroup(bar)) { <b class="grp-n" aria-hidden="true">@Format.Num(bar.Total)</b> }
                                    </span>
                                }
                                else
                                {
                                    <i class="bar @BarCls(bar) @(IsGroup(bar) ? "grp" : null)" style="height:@Pct(bar.MaxMs / scale)%">@if (IsGroup(bar)) { <b class="grp-n" aria-hidden="true">@Format.Num(bar.Total)</b> }</i>
                                }
                            </button>
                        }
                    }
                    @foreach (var bs in burstSpans)
                    {
                        var burst = bs;
                        <button class="burst-tag @(bucket == burst.Slot ? "on" : "")" data-ub="@T(burst.Slot)" title="Burst at @FT(burst.Slot, width): @Format.Plural(burst.Actors, "actor", "actors") started together@(burst.GroupSize > 1 ? ", shown in groups of " + burst.GroupSize : ""). Click to list them." aria-label="Burst at @FT(burst.Slot, width), @Format.Plural(burst.Actors, "actor", "actors"): select them as a group" @onclick="() => PickBar(new ActorBar(0, 0, 0, 0, -1, burst.Slot))">burst · @Format.Plural(burst.Actors, "actor", "actors")</button>
                    }
                    </div>
                </DockZoom>
            </div>
            </div>
            <p class="chart-note muted">
                @if (bucketed) { <text>@Format.Plural(total, "actor", "actors") in time buckets of @FT(width, width); a bar is red or yellow if any actor in it failed or was slow. Click a bar to list its actors.</text> }
                else { <text>One bar per actor, taller = slower. The axis shows the run time of the actors at that position. Click an actor to see its calls.</text> }
                <text> Drag across the chart to zoom into a time frame (touch: swipe the time axis to magnify, swipe the bars to scroll, pinch or double tap to zoom).</text>
            </p>
        }

        @if (selRunning is { } rseq && runningNow.FirstOrDefault(r => r.Sequence == rseq) is { } ra)
        {
            var elapsedMs = Math.Max(0, (s.Elapsed - ra.StartedAt) * 1000);
            var denom = Math.Max(1, Math.Max(scale, elapsedMs));
            <section class="actor-panel p-run" aria-label="@ra.Name">
                <div class="actor-head">
                    <b class="actor-title">Actor <ActorChip Sequence="ra.Sequence" State="ActorState.Running" /></b>
                    <span class="state run">Running</span>
                    <span class="muted">@Format.Ms(elapsedMs) so far · started @Format.Time(ra.StartedAt)</span>
                    <span class="spacer"></span>
                    <button class="btn ghost small" @onclick="() => Logs.Show(Index, ra.Sequence)">Open logs for this actor</button>
                    <button class="icon-btn" @onclick="() => selRunning = null" aria-label="Deselect actor">✕</button>
                </div>
                <ol class="calls" aria-label="Calls of @ra.Name so far">
                    @foreach (var call in ra.Calls.Where(c => !c.Skipped && c.OffsetMs <= elapsedMs))
                    {
                        var done = call.OffsetMs + call.DurationMs <= elapsedMs;
                        var cls = !done ? "run" : call.Failed ? "bad" : "good";
                        var w = (done ? call.DurationMs : elapsedMs - call.OffsetMs) / denom * 100;
                        <li class="call @cls">
                            <span class="call-name" title="@call.Name">@call.Name</span>
                            <span class="track"><i style="left:@Pct(call.OffsetMs / denom)%;width:@(Math.Max(0.8, w).ToString("0.##", CultureInfo.InvariantCulture))%"></i></span>
                            <span class="call-dur">@(done ? Format.Ms(call.DurationMs) : "")</span>
                            <span class="call-status">@(!done ? "running" : call.Failed ? (call.Status?.ToString() ?? "timeout") : call.Status?.ToString() ?? "")</span>
                        </li>
                    }
                </ol>
            </section>
        }

        @if (selected is { } actor)
        {
            var detail = s.Store.Detail(actor.Sequence);
            <section class="actor-panel p-@Cls(actor.Outcome)" aria-label="@actor.Name">
                <div class="actor-head">
                    <b class="actor-title">Actor <ActorChip Sequence="actor.Sequence" State="ActorOrder.StateOf(actor.Outcome)" Tint="actor.Tint" /></b>
                    <span class="state @Cls(actor.Outcome)">@(actor.Failed ? "Failed" : actor.SlowCalls > 0 ? "Slow" : "Ok")</span>
                    @if (!actor.Failed && Format.OverTypical(actor.Ratio))
                    {
                        <button class="fig-ratio @ActorOrder.Good(actor.Tint)" @onclick="() => showTypicals = !showTypicals" aria-pressed="@Aria.Bool(showTypicals)" title="Its slowest call took @Format.Times(actor.Ratio) its typical time. Click to @(showTypicals ? "hide" : "show") the typical time of each call">@Format.Times(actor.Ratio) typical</button>
                    }
                    <span class="muted">@Format.Ms(actor.DurationMs) · started @Format.Time(actor.StartedAt)</span>
                    <span class="spacer"></span>
                    <button class="btn ghost small" @onclick="() => Logs.Show(Index, actor.Sequence)">Open logs for this actor</button>
                    <button class="icon-btn" @onclick="() => selected = null" aria-label="Deselect actor">✕</button>
                </div>
                @if (actor.Error is not null) { <p class="actor-error bad">@actor.Error</p> }
                @if (detail is null)
                {
                    <p class="muted">The calls and logs of this actor are no longer kept (details of older successful actors are dropped first).</p>
                }
                else
                {
                    <ol class="calls" aria-label="Calls of @actor.Name">
                        @foreach (var c in detail.Calls)
                        {
                            var call = c;
                            var callRatio = call.Skipped || call.Failed ? 1 : SlowCallRule.Ratio(call.DurationMs, call.TypicalMs);
                            var cls = call.Failed ? "bad" : call.Slow ? "warn" : call.Skipped ? "" : ActorOrder.Good(SlowCallRule.Step(callRatio));
                            <li class="call @cls @(call.Skipped ? "skipped" : "")">
                                <span class="call-name" title="@call.Name">@call.Name</span>
                                <span class="track"><i style="left:@Pct(call.OffsetMs / Math.Max(1, actor.DurationMs))%;width:@(Math.Max(0.8, call.DurationMs / Math.Max(1, actor.DurationMs) * 100).ToString("0.##", CultureInfo.InvariantCulture))%"></i></span>
                                <span class="call-dur">@(call.Skipped ? "" : Format.Ms(call.DurationMs))</span>
                                <span class="call-status" title="@(call.TypicalMs is { } tyMs && !call.Skipped ? $"Typical for this call: {Format.Ms(tyMs)}" : call.Error)">@CallStatus(call)</span>
                                @if (showTypicals && !call.Skipped && call.TypicalMs is { } typ)
                                {
                                    <span class="call-typ muted">typical @Format.Ms(typ)@(Format.OverTypical(callRatio) ? " · " + Format.Times(callRatio) : "")</span>
                                }
                            </li>
                        }
                    </ol>
                }
            </section>
        }
        </div>
        <aside class="pop-side" aria-label="Actors in view" @onpointerenter="() => listHover = true" @onpointerleave="() => listHover = false">
            <div class="side-head">
                <h3>Actors in view <span class="n">@Format.Num(sideRows.Count)</span></h3>
                <p class="side-scope muted">
                    @(win is { } ws ? $"{Format.Time(ws.From)}{(ws.Follow ? " → now" : $" – {Format.Time(ws.To)}")}" : "whole run")
                    @if (tailMs is { } tm)
                    {
                        <button class="chip" @onclick="() => tailMs = null" title="Show all actors of the time frame again">slowest 5% (≥ @Format.Ms(tm)) ✕</button>
                    }
                    @if (groupSel is { } gc)
                    {
                        <button class="chip" @onclick="() => bucket = null" title="Show the whole time frame again">actors #@(gc.Lo + 1)–#@(gc.Hi + 1) ✕</button>
                    }
                    @if (activeBucket is { } ab)
                    {
                        <button class="chip" @onclick="() => bucket = null" title="Show the whole time frame again">bucket @Format.Time(ab)–@Format.Time(ab + width) ✕</button>
                        <button class="link-btn" @onclick="() => ZoomTo(ab, ab + width)" title="Zoom the chart into this bucket">Zoom in</button>
                    }
                </p>
                <p class="side-counts">
                    <button class="cnt bad" @onclick="() => SetShow(ActorShow.Failed, true)" disabled="@(sideCounts[0] == 0)" title="Show only failed actors"><i></i>@Format.Num(sideCounts[0]) failed</button>
                    <button class="cnt warn" @onclick="() => SetShow(ActorShow.Slow, true)" disabled="@(sideCounts[1] == 0)" title="Show only slow actors"><i></i>@Format.Num(sideCounts[1]) slow</button>
                    <button class="cnt good" @onclick="() => SetShow(ActorShow.All, true)" title="Show all actors"><i></i>@Format.Num(sideCounts[3]) ok</button>
                    @if (sideCounts[2] > 0) { <span class="cnt run"><i></i>@Format.Num(sideCounts[2]) running</span> }
                </p>
            </div>
            <ActorSideList Rows="sideRows" SelectedSequence="@selSeq" OnSelect="SelectRow" ResetKey="@sideReset" />
        </aside>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public int Index { get; set; }
    [Parameter, EditorRequired] public RunSnapshot Snapshot { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Optional: what to list when the popup opens (the overview card figures lead here, brain 0029).</summary>
