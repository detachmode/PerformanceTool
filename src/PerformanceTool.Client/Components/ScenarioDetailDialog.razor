    /// <summary>The overview strip's marks (brain 0035 update 1), recomputed when the finished count or the run's whole seconds changed and the last pass is over 0.7 s old.</summary>
    private string OverviewMarks(IReadOnlyList<ActorRecord> actors, int count, double elapsed)
    {
        var key = (count, (int)elapsed);
        if (key == ovKey || (Environment.TickCount64 - ovAt < 700 && ovCache.Length > 0)) return ovCache;
        ovCache = ActorBars.OverviewMarks(actors, count, elapsed);
        ovKey = key; ovAt = Environment.TickCount64;
        return ovCache;
