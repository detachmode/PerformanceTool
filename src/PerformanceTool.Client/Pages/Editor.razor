@* DRAFT editor page (brain 0011 + 0006): compose the scenario mix. Left: filterable, keyboard-navigable list of the scenarios in the
   mix; right: the selected one with the generated parameter editor (brain 0007). Plan settings and presets sit in the toolbar.
   Validation shows inline under each field; the summary on top links to the fields. Edits live in memory only. *@
@page "/editor"
@page "/drafts/editor"
@layout MainLayout
@implements IDisposable
@inject IRunSource Sim
@inject ScenarioCatalog Catalog
@inject IJSRuntime JS

<PageTitle>Editor · PerformanceTool</PageTitle>

@{
    var plan = Sim.Plan;
    var locked = Sim.IsRunning;
    var total = plan.Scenarios.Sum(x => x.RatePerMinute);
    if (selected >= plan.Scenarios.Count) selected = plan.Scenarios.Count - 1;
    var cfg = selected >= 0 ? plan.Scenarios[selected] : null;
    var scenario = cfg is null ? null : Catalog.Find(cfg.ScenarioId);

    // Validation, per field (inline) and as a flat summary with jump targets.
    var planErr = PlanErrors(plan);
    var entryErr = plan.Scenarios.Select(c => EntryErrors(c)).ToList();
    var summary = new List<Problem>();
    foreach (var (id, msg) in planErr) summary.Add(new(-1, "Plan", id, msg));
    if (plan.Scenarios.Count == 0) summary.Add(new(-1, "Plan", "dr-add", "Add at least one scenario."));
    for (var i = 0; i < plan.Scenarios.Count; i++)
        foreach (var p in entryErr[i].Problems) summary.Add(p with { Entry = i, Where = LabelOf(plan.Scenarios[i]) });
    var cfgErr = cfg is null ? null : entryErr[selected];
    var shownIdx = VisibleIndices(plan);
}

<div class="dr-page">
    <section class="dr-toolbar" aria-label="Plan and presets">
        <div class="dr-tb-group">
            <label for="dr-preset">Preset</label>
            <select id="dr-preset" @bind="selectedPreset" disabled="@locked">
                <option value="">— choose —</option>
                @foreach (var p in Sim.PresetNames) { <option value="@p">@p</option> }
            </select>
            <button class="btn ghost" @onclick="Load" disabled="@(locked || selectedPreset == "")">Load</button>
            <input @bind="presetName" placeholder="Save as…" aria-label="Preset name" disabled="@locked" />
            <button class="btn ghost" @onclick="Save" disabled="@(locked || presetName.Trim() == "")">Save</button>
            @if (message is not null) { <span class="dr-msg">@message</span> }
        </div>
        <div class="dr-tb-group right">
            <div class="dr-num @(planErr.ContainsKey("dr-dur") ? "is-invalid" : "")"><label for="dr-dur">Duration (s)</label><input id="dr-dur" type="number" min="1" @bind="plan.DurationSeconds" disabled="@locked" aria-invalid="@Aria.Bool(planErr.ContainsKey("dr-dur"))" />@if (planErr.TryGetValue("dr-dur", out var e1)) { <small class="field-error" role="alert">@e1</small> }</div>
            <div class="dr-num @(planErr.ContainsKey("dr-conc") ? "is-invalid" : "")"><label for="dr-conc">Max in-flight</label><input id="dr-conc" type="number" min="1" max="1000" @bind="plan.MaxConcurrency" disabled="@locked" aria-invalid="@Aria.Bool(planErr.ContainsKey("dr-conc"))" />@if (planErr.TryGetValue("dr-conc", out var e2)) { <small class="field-error" role="alert">@e2</small> }</div>
            <div class="dr-num @(planErr.ContainsKey("dr-to") ? "is-invalid" : "")"><label for="dr-to">Timeout (s)</label><input id="dr-to" type="number" min="1" max="300" @bind="plan.TimeoutSeconds" disabled="@locked" aria-invalid="@Aria.Bool(planErr.ContainsKey("dr-to"))" />@if (planErr.TryGetValue("dr-to", out var e3)) { <small class="field-error" role="alert">@e3</small> }</div>
        </div>
    </section>

    @if (locked)
    {
        <div class="dr-note">A run is in progress. Stop it on the <a href="overview">Overview</a> to edit the mix.</div>
    }
    @if (summary.Count > 0)
    {
        <div class="dr-problems" role="status">
            <b>@(summary.Count == 1 ? "1 thing to fix" : $"{summary.Count} things to fix")</b>
            <ul>
                @foreach (var pr in summary)
                {
                    var problem = pr;
                    <li><button class="dr-link-btn" @onclick="() => Jump(problem)"><span class="where">@problem.Where</span> @problem.Message</button></li>
                }
            </ul>
        </div>
    }

    <div class="dr-split">
        <aside class="dr-list" aria-label="Scenarios in the mix">
            <div class="dr-list-head">
                <h2>Scenarios</h2>
                <span class="count">@(listFilter.Length > 0 ? $"{shownIdx.Count} of {plan.Scenarios.Count}" : $"{plan.Scenarios.Count} / {LoadPlan.MaxEntries}")</span>
                <span class="spacer"></span>
                <button id="dr-add" class="btn ghost small" @onclick="() => addOpen = !addOpen" disabled="@(locked || plan.Scenarios.Count >= LoadPlan.MaxEntries)" aria-haspopup="menu" aria-expanded="@Aria.Bool(addOpen)">+ Add scenario</button>
            </div>
            <div class="dr-list-filter">
                <input id="dr-filter" type="search" class="dr-search" placeholder="Filter scenarios…  ( / )" aria-label="Filter scenarios" autocomplete="off"
                       value="@listFilter" @oninput="e => listFilter = e.Value?.ToString() ?? string.Empty" @onkeydown="FilterKey" />
            </div>
            @if (addOpen)
            {
                <ul class="dr-add-menu" aria-label="Scenario types">
                    @foreach (var sc in Catalog.All)
                    {
                        var chosen = sc;
                        <li><button @onclick="() => Add(chosen)"><b>@chosen.Name</b><span>@chosen.Description</span></button></li>
                    }
                </ul>
            }
            <ul class="dr-rows" role="listbox" aria-label="Scenarios, Up and Down select, Enter edits, Alt+Up and Alt+Down reorder" @onkeydown="ListKey">
                @foreach (var i in shownIdx)
                {
                    var idx = i;
                    var c = plan.Scenarios[idx];
                    var bad = entryErr[idx].Count;
                    <li @key="c">
                        <button id="dr-row-@idx" role="option" aria-selected="@Aria.Bool(idx == selected)" class="dr-row @(idx == selected ? "on" : "") @(bad > 0 ? "is-invalid" : "")" style="--series:@SeriesPalette.For(idx)"
                                tabindex="@(idx == selected ? 0 : -1)" @onclick="() => selected = idx">
                            <i class="dot"></i>
                            <span class="name"><span class="nm">@LabelOf(c)</span>@if (bad > 0) { <span class="row-err" title="@(bad == 1 ? "1 field needs attention" : $"{bad} fields need attention")" aria-label="@bad invalid @(bad == 1 ? "field" : "fields")">!</span> }</span>
                            <span class="rate">@Format.Rate(c.RatePerMinute) @Terms.PerMinuteShort</span>
                            <span class="type">@(Catalog.Find(c.ScenarioId)?.Name ?? c.ScenarioId)</span>
                        </button>
                    </li>
                }
                @if (plan.Scenarios.Count == 0) { <li class="muted dr-empty">No scenarios yet. Add one to start.</li> }
                else if (shownIdx.Count == 0) { <li class="muted dr-empty">No scenario matches “@listFilter”. <button class="dr-link-btn" @onclick='() => listFilter = ""'>Clear</button></li> }
            </ul>
            <div class="dr-list-foot">@Format.Rate(total) @Terms.PerMinuteShort in total · ≈ @Format.Num(total * plan.DurationSeconds / 60) @Terms.Instances per run</div>
        </aside>

        <section class="dr-detail" aria-label="Selected scenario">
            @if (cfg is null)
            {
                <div class="muted dr-empty">Select a scenario on the left to edit it.</div>
            }
            else
            {
                <div class="dr-detail-head" style="--series:@SeriesPalette.For(selected)">
                    <span class="swatch"></span>
                    <input id="dr-entry-label" class="entry-label" @bind="cfg.Label" disabled="@locked" aria-label="Label" />
                    <span class="chip" title="@scenario?.Description">@(scenario?.Name ?? cfg.ScenarioId)</span>
                    <span class="spacer"></span>
                    <div class="dr-head-actions" role="group" aria-label="Arrange">
                        <button class="btn ghost small icon" @onclick="() => Move(-1)" disabled="@(locked || selected == 0)" title="Move up (Alt+Up)" aria-label="Move up">↑</button>
                        <button class="btn ghost small icon" @onclick="() => Move(1)" disabled="@(locked || selected >= plan.Scenarios.Count - 1)" title="Move down (Alt+Down)" aria-label="Move down">↓</button>
                        <button class="btn ghost small" @onclick="Duplicate" disabled="@(locked || plan.Scenarios.Count >= LoadPlan.MaxEntries)" title="Duplicate this scenario">Duplicate</button>
                        <button class="btn ghost danger small" @onclick="Remove" disabled="@locked">Remove</button>
                    </div>
                </div>
                @if (scenario is not null)
                {
                    <p class="dr-detail-desc">@scenario.Description</p>
                    <div class="entry-body dr-form" style="--series:@SeriesPalette.For(selected)" @key="cfg">
                        <div class="field rate @(cfgErr!.Rate is null ? "" : "is-invalid")">
                            <label for="dr-rate">@Terms.InstancesCap / minute</label>
                            <input id="dr-rate" type="number" min="0.1" step="any" @bind="cfg.RatePerMinute" disabled="@locked" aria-invalid="@Aria.Bool(cfgErr.Rate is not null)" />
                            @if (cfgErr.Rate is not null) { <small class="field-error" role="alert">@cfgErr.Rate</small> }
                        </div>
                        <ParameterEditor Spec="scenario.Spec" Values="cfg.Parameters" Disabled="locked" IdPrefix="@($"dr{selected}")" Errors="cfgErr.Fields" />
                    </div>
                }
                else
                {
                    <div class="muted dr-empty">Scenario no longer exists in code.</div>
                }
            }
        </section>
    </div>
</div>

@code {
    private sealed record Problem(int Entry, string Where, string TargetId, string Message);
    private sealed record EntryProblems(string? Rate, Dictionary<string, List<string>> Fields, List<Problem> Problems)
    {
        public int Count => Problems.Count;
    }

    private int selected;
    private bool addOpen;
    private string listFilter = "";
    private string selectedPreset = "";
    private string presetName = "";
    private string? message;
    private string? pendingFocus;

    protected override void OnInitialized() => Sim.Changed += OnChanged;

    private void OnChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingFocus is { } id)
        {
            pendingFocus = null;
            try { await JS.InvokeVoidAsync("drFocus", id); } catch (Exception) { /* circuit gone */ }
        }
    }

    // ---------- validation ----------

    private static string LabelOf(ScenarioRunConfig c) => string.IsNullOrWhiteSpace(c.Label) ? c.ScenarioId : c.Label;

    private static Dictionary<string, string> PlanErrors(LoadPlan plan)
    {
        var m = new Dictionary<string, string>();
        if (plan.DurationSeconds is < 1 or > 24 * 3600) m["dr-dur"] = "Between 1 second and 24 hours.";
        if (plan.MaxConcurrency is < 1 or > 1000) m["dr-conc"] = "Between 1 and 1000.";
        if (plan.TimeoutSeconds is < 1 or > 300) m["dr-to"] = "Between 1 and 300 seconds.";
        return m;
    }

    private EntryProblems EntryErrors(ScenarioRunConfig c)
    {
        var idx = Sim.Plan.Scenarios.IndexOf(c);
        var problems = new List<Problem>();
        string? rate = null;
        if (c.RatePerMinute is <= 0 or > LoadPlan.MaxRatePerMinute || double.IsNaN(c.RatePerMinute))
        {
            rate = $"Between 0 and {LoadPlan.MaxRatePerMinute:N0} per minute.";
            problems.Add(new(idx, "", "dr-rate", $"{Terms.InstancesCap} / minute: {rate[..1].ToLowerInvariant()}{rate[1..]}"));
        }
        var fields = new Dictionary<string, List<string>>();
        if (Catalog.Find(c.ScenarioId) is { } sc)
        {
            fields = sc.Spec.ValidateByField(c.Parameters);
            foreach (var (key, msgs) in fields)
                foreach (var m in msgs)
                    problems.Add(new(idx, "", $"dr{idx}-{key}", m));
        }
        return new(rate, fields, problems);
    }

    private async Task Jump(Problem p)
    {
        if (p.Entry >= 0) { listFilter = ""; selected = p.Entry; }
        pendingFocus = p.TargetId;
        await Task.CompletedTask;
    }

    // ---------- list: filter, keyboard, editing ----------

    private List<int> VisibleIndices(LoadPlan plan)
    {
        var q = listFilter.Trim();
        return Enumerable.Range(0, plan.Scenarios.Count)
            .Where(i => q.Length == 0
                || LabelOf(plan.Scenarios[i]).Contains(q, StringComparison.OrdinalIgnoreCase)
                || (Catalog.Find(plan.Scenarios[i].ScenarioId)?.Name ?? plan.Scenarios[i].ScenarioId).Contains(q, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void FilterKey(KeyboardEventArgs e)
    {
        var vis = VisibleIndices(Sim.Plan);
        if (e.Key == "Escape") listFilter = "";
        else if ((e.Key is "ArrowDown" or "Enter") && vis.Count > 0)
        {
            if (!vis.Contains(selected)) selected = vis[0];
            pendingFocus = $"dr-row-{selected}";
        }
    }

    private void ListKey(KeyboardEventArgs e)
    {
        var vis = VisibleIndices(Sim.Plan);
        if (vis.Count == 0) return;
        if (e.AltKey && e.Key is "ArrowUp" or "ArrowDown")
        {
            if (!Sim.IsRunning) Move(e.Key == "ArrowUp" ? -1 : 1);
            return;
        }
        var pos = vis.IndexOf(selected);
        switch (e.Key)
        {
            case "ArrowDown": selected = vis[Math.Min(vis.Count - 1, pos + 1)]; pendingFocus = $"dr-row-{selected}"; break;
            case "ArrowUp": selected = vis[Math.Max(0, pos - 1)]; pendingFocus = $"dr-row-{selected}"; break;
            case "Home": selected = vis[0]; pendingFocus = $"dr-row-{selected}"; break;
            case "End": selected = vis[^1]; pendingFocus = $"dr-row-{selected}"; break;
            case "Enter": pendingFocus = "dr-entry-label"; break;
        }
    }

    private void Add(IScenario scenario)
    {
        Sim.AddEntry(scenario);
        selected = Sim.Plan.Scenarios.Count - 1;
        addOpen = false;
        listFilter = "";
    }

    private void Remove()
    {
        Sim.RemoveEntry(selected);
        selected = Math.Min(selected, Sim.Plan.Scenarios.Count - 1);
    }

    private void Duplicate()
    {
        Sim.DuplicateEntry(selected);
        selected++;
        listFilter = "";
        pendingFocus = "dr-entry-label";
    }

    private void Move(int delta)
    {
        selected = Sim.MoveEntry(selected, delta);
        pendingFocus = $"dr-row-{selected}";
    }

    private void Load()
    {
        Sim.LoadPreset(selectedPreset);
        selected = 0;
        listFilter = "";
        presetName = Sim.PresetName;
        message = $"Loaded “{Sim.PresetName}”.";
    }

    private void Save()
    {
        Sim.SavePreset(presetName);
        selectedPreset = Sim.PresetName;
        message = $"Saved “{Sim.PresetName}” (in memory).";
    }

    public void Dispose() => Sim.Changed -= OnChanged;
}
