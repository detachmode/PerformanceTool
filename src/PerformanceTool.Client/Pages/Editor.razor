@* Minimalist full-screen C# Script Editor (/editor):
   Full-viewport syntax-highlighted code editor with a single compact menu bar (file picker, Save, Try, Wrap, actions).
   Parameters & Test Run open in a clean overlay only when clicking "Try". *@
@page "/editor"
@page "/scripts"
@layout MainLayout
@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Components.Forms
@using PerformanceTool.Client.Components.Parameters
@using PerformanceTool.Services.Scenarios
@using PerformanceTool.Services.Scenarios.Spec
@implements IDisposable
@inject ScriptApiClient Api
@inject ScenarioCatalog Catalog
@inject IRunSource Sim
@inject IEnvironmentSource Envs
@inject DataModeState DataMode

<PageTitle>@fileName · Script Editor</PageTitle>

<div class="script-fullscreen">
    <div class="script-bar" role="toolbar" aria-label="Script editor toolbar">
        <div class="dd">
            <button type="button" class="btn ghost small script-file-btn" aria-haspopup="menu" aria-expanded="@Aria.Bool(filesOpen)"
                    @onclick="() => { filesOpen = !filesOpen; moreOpen = false; }" title="Switch, create, or upload .cs scripts">
                <span class="mono">@fileName</span>
                <span class="caret">▾</span>
            </button>
            @if (filesOpen)
            {
                <div class="dd-backdrop" @onclick="() => filesOpen = false"></div>
                <div class="dd-menu script-files-menu" role="menu" aria-label="C# script files">
                    <div class="dd-lbl">Scripts (@scripts.Count)</div>
                    @if (scripts.Count == 0)
                    {
                        <div class="muted" style="padding:.35rem .55rem">No .cs files yet.</div>
                    }
                    @foreach (var s in scripts)
                    {
                        var item = s;
                        var isCur = selectedId == item.ScriptId;
                        <button type="button" class="dd-item" role="menuitem" @onclick="() => PickFile(item)" style="flex-direction:column;align-items:flex-start;gap:.05rem">
                            <span>@(isCur ? "✓ " : "")<b>@item.FileName</b></span>
                            <span class="muted" style="font-size:.72rem">@item.ScenarioName</span>
                        </button>
                    }
                    <div class="dd-sep" role="separator"></div>
                    <button type="button" class="dd-item" role="menuitem" @onclick="NewScript">+ New .cs file</button>
                    <label class="dd-item" role="menuitem" style="cursor:pointer">
                        Upload .cs…
                        <InputFile OnChange="OnFileUpload" accept=".cs,.csx" style="display:none" />
                    </label>
                </div>
            }
        </div>

        @if (statusMessage is not null)
        {
            <span class="script-status @(statusIsError ? "field-error" : "saved")" role="status">@statusMessage</span>
        }
        else if (DataMode.IsFakeMode)
        {
            <button type="button" class="chip" @onclick="SwitchToLive" title="Custom scripts compile and run on the server">Switch to Live</button>
        }

        <span class="spacer"></span>

        <button type="button" class="btn ghost small @(wordWrap ? "wrap-on" : "")"
                aria-pressed="@Aria.Bool(wordWrap)"
                @onclick="() => wordWrap = !wordWrap"
                title="Toggle line wrap">
            Wrap
        </button>

        <button type="button" class="btn primary small" @onclick="CompileAndSave" disabled="@(busy || string.IsNullOrWhiteSpace(scriptCode))">
            @(compiling ? "Saving…" : "Save")
        </button>

        <button type="button" class="btn ghost small" @onclick="OpenTryDialog" disabled="@(busy || selectedSummary is null)"
                title="@(selectedSummary is null ? "Save the script first to try it out" : "Configure parameters and run a single test execution")">
            ▶ Try
        </button>

        <div class="dd">
            <button type="button" class="btn ghost small" aria-haspopup="menu" aria-expanded="@Aria.Bool(moreOpen)"
                    @onclick="() => { moreOpen = !moreOpen; filesOpen = false; }" aria-label="More script actions" title="More actions">
                ⋯
            </button>
            @if (moreOpen)
            {
                <div class="dd-backdrop" @onclick="() => moreOpen = false"></div>
                <div class="dd-menu right" role="menu" aria-label="More script actions">
                    <button type="button" class="dd-item" role="menuitem" @onclick="() => { moreOpen = false; renameOpen = true; }">Rename file…</button>
                    <button type="button" class="dd-item" role="menuitem" disabled="@(busy || selectedSummary is null || Sim.IsRunning)" @onclick="() => { moreOpen = false; AddToPlan(); }">+ Add to plan</button>
                    <div class="dd-sep" role="separator"></div>
                    <button type="button" class="dd-item bad" role="menuitem" disabled="@(busy || selectedSummary is null)" @onclick="() => { moreOpen = false; _ = DeleteCurrent(); }">Delete script</button>
                </div>
            }
        </div>
    </div>

    @if (renameOpen)
    {
        <form class="script-rename-bar" @onsubmit="() => renameOpen = false" @onsubmit:preventDefault="true">
            <label for="script-filename" class="muted">File name:</label>
            <input id="script-filename" class="env-name-input" value="@fileName" placeholder="order-stress.cs" autocomplete="off"
                   @oninput="e => fileName = e.Value?.ToString() ?? string.Empty" />
            <button type="submit" class="btn primary small">OK</button>
        </form>
    }

    <div class="script-editor-fill">
        <CSharpCodeEditor Value="@scriptCode" ValueChanged="v => scriptCode = v" WordWrap="@wordWrap" AriaLabel="C# scenario script" />
    </div>

    @if (diagnostics.Count > 0)
    {
        <div class="diag-list script-diag-dock" role="alert">
            @foreach (var d in diagnostics)
            {
                <div class="diag-row @(d.Severity == "Error" ? "err" : "warn")">
                    <code>(@d.Line,@d.Column) @d.Id</code>
                    <span>@d.Message</span>
                </div>
            }
        </div>
    }
</div>

@if (tryOpen && selectedSummary is not null && compiledSpec is not null)
{
    <div class="overlay" tabindex="-1" @onclick="() => tryOpen = false" role="presentation">
        <div class="dialog" style="width:min(720px,100%)" role="dialog" aria-modal="true" aria-labelledby="try-title" @onclick:stopPropagation="true">
            <div class="dlg-head">
                <h2 id="try-title">Try · @selectedSummary.ScenarioName</h2>
                <span class="muted">@(Envs.ActiveName is null ? "No environment" : $"Env: {Envs.ActiveName}")</span>
                <span class="spacer"></span>
                <button type="button" class="btn primary small" @onclick="RunTest" disabled="@busy">
                    @(testing ? "Running…" : "▶ Run once")
                </button>
                <button type="button" class="icon-btn" @onclick="() => tryOpen = false" aria-label="Close">✕</button>
            </div>

            <div class="script-try-body">
                @if (compiledSpec.Fields.Count > 0)
                {
                    <div class="form param-grid">
                        <ParameterEditor Spec="compiledSpec" Values="testParams" Disabled="@busy" IdPrefix="script-test" />
                    </div>
                }
                else
                {
                    <p class="muted" style="margin:0">This scenario takes no parameters.</p>
                }

                @if (testResult is not null)
                {
                    <div class="test-result @(testResult.Success ? "ok" : "bad")">
                        <div class="test-result-head">
                            <b>@(testResult.Success ? "Succeeded" : "Failed")</b>
                            @if (testResult.StatusCode is { } sc) { <span class="tag">HTTP @sc</span> }
                            <span class="muted">@testResult.DurationMs.ToString("0.#") ms</span>
                            <span class="muted">@testResult.Bytes B</span>
                            <span class="muted">startup @testResult.StartupDurationMs.ToString("0.#") ms · teardown @testResult.TeardownDurationMs.ToString("0.#") ms</span>
                        </div>
                        @if (!string.IsNullOrEmpty(testResult.Error))
                        {
                            <div class="field-error">@testResult.Error</div>
                        }
                        @if (testResult.Calls.Count > 0)
                        {
                            <div class="test-calls">
                                @foreach (var c in testResult.Calls)
                                {
                                    <div class="test-call-row">
                                        <code>@c.Method</code>
                                        <span class="url">@c.Url</span>
                                        <span class="muted">@(c.StatusCode?.ToString() ?? "err") · @c.DurationMs.ToString("0.#") ms</span>
                                    </div>
                                }
                            </div>
                        }
                        @if (testResult.Logs.Count > 0)
                        {
                            <div class="test-logs">
                                @foreach (var line in testResult.Logs)
                                {
                                    <div><code>@line</code></div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "script")]
    public string? RequestedScript { get; set; }

    private List<ClientScriptSummary> scripts = [];
    private string? selectedId;
    private ClientScriptSummary? selectedSummary;
    private ParameterSpec? compiledSpec;
    private JsonObject testParams = new();
    private string fileName = "order-api-stress.cs";
    private string scriptCode = StarterTemplate;
    private bool wordWrap = true;
    private bool filesOpen;
    private bool moreOpen;
    private bool renameOpen;
    private bool tryOpen;
    private List<ClientScriptDiagnostic> diagnostics = [];
    private ClientTestRunResult? testResult;
    private string? statusMessage;
    private bool statusIsError;
    private bool compiling;
    private bool testing;
    private bool busy => compiling || testing;

    private const string StarterTemplate = """
        // 1. Define parameters (reflected by the backend to build the Blazor form)
        public record ApiLoadParams(
            [property: Description("Target endpoint URL")]
            string Endpoint = "https://httpbin.org/post",
            [property: Description("Auth bearer token")]
            string? BearerToken = null,
            [property: Range(1, 5000)]
            int PayloadSizeBytes = 256,
            bool IncludeRandomJitter = true
        );

        // 2. Register the scenario using the injected 'Scenario' global
        Scenario.Define<ApiLoadParams>("Order API Stress Test", async (p, ctx) =>
        {
            using var request = new HttpRequestMessage(HttpMethod.Post, p.Endpoint);
            if (!string.IsNullOrEmpty(p.BearerToken))
                request.Headers.Authorization = new("Bearer", p.BearerToken);
            request.Content = new StringContent(new string('x', p.PayloadSizeBytes));

            using var response = await ctx.HttpClient.SendAsync(request, ctx.CancellationToken);
            response.EnsureSuccessStatusCode();

            if (p.IncludeRandomJitter)
                await Task.Delay(Random.Shared.Next(5, 25), ctx.CancellationToken);
        })
        .OnStartup(async (p, ctx) =>
        {
            ctx.Log("Startup hook ran");
            await Task.CompletedTask;
        })
        .OnTeardown(async (p, ctx) =>
        {
            ctx.Log("Teardown hook ran");
            await Task.CompletedTask;
        });
        """;

    protected override async Task OnInitializedAsync()
    {
        DataMode.Changed += OnStateChanged;
        Sim.Changed += OnStateChanged;
        await ReloadScriptsAsync();
    }

    private void OnStateChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private async Task ReloadScriptsAsync()
    {
        try
        {
            scripts = await Api.ListScriptsAsync();
            if (selectedId is null && !string.IsNullOrWhiteSpace(RequestedScript)
                && scripts.FirstOrDefault(s => string.Equals(s.ScenarioId, RequestedScript, StringComparison.OrdinalIgnoreCase)
                                            || string.Equals(s.ScriptId, RequestedScript, StringComparison.OrdinalIgnoreCase)
                                            || string.Equals(s.FileName, RequestedScript, StringComparison.OrdinalIgnoreCase)) is { } requested)
            {
                Select(requested);
            }
            else if (selectedId is not null && scripts.FirstOrDefault(s => s.ScriptId == selectedId) is { } found)
                Select(found);
            else if (scripts.Count > 0 && selectedSummary is null)
                Select(scripts[0]);
        }
        catch (Exception ex)
        {
            statusMessage = $"Load error: {ex.Message}";
            statusIsError = true;
        }
    }

    private void PickFile(ClientScriptSummary s)
    {
        filesOpen = false;
        renameOpen = false;
        Select(s);
    }

    private void Select(ClientScriptSummary s)
    {
        selectedId = s.ScriptId;
        selectedSummary = s;
        fileName = s.FileName;
        scriptCode = s.Code;
        diagnostics = [];
        testResult = null;
        compiledSpec = ParameterSpec.FromJsonSchema(s.Parameters);
        testParams = compiledSpec.DefaultJson();
        statusMessage = null;
        statusIsError = false;
    }

    private void NewScript()
    {
        filesOpen = false;
        selectedId = null;
        selectedSummary = null;
        compiledSpec = null;
        testParams = new JsonObject();
        fileName = "custom-scenario.cs";
        scriptCode = StarterTemplate;
        diagnostics = [];
        testResult = null;
        statusMessage = null;
        statusIsError = false;
        renameOpen = true;
    }

    private async Task OnFileUpload(InputFileChangeEventArgs e)
    {
        filesOpen = false;
        var file = e.File;
        if (file is null) return;
        using var stream = file.OpenReadStream(maxAllowedSize: 512 * 1024);
        using var reader = new StreamReader(stream);
        scriptCode = await reader.ReadToEndAsync();
        fileName = file.Name;
        selectedId = null;
        selectedSummary = null;
        compiledSpec = null;
        testResult = null;
        diagnostics = [];
        await CompileAndSave();
    }

    private async Task CompileAndSave()
    {
        compiling = true;
        renameOpen = false;
        statusMessage = null;
        statusIsError = false;
        diagnostics = [];
        testResult = null;
        try
        {
            var res = await Api.CompileAndSaveAsync(selectedId, fileName, scriptCode);
            diagnostics = res.Diagnostics.ToList();
            if (res.Success && res.Script is { } saved)
            {
                await ReloadScriptsAsync();
                Select(saved);
                statusMessage = "Saved ✓";
                statusIsError = false;
            }
            else
            {
                statusMessage = res.Error ?? "Compilation failed.";
                statusIsError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            statusIsError = true;
        }
        finally { compiling = false; }
    }

    private void OpenTryDialog()
    {
        if (selectedSummary is null) return;
        tryOpen = true;
    }

    private async Task RunTest()
    {
        if (selectedSummary is null) return;
        testing = true;
        statusMessage = null;
        statusIsError = false;
        testResult = null;
        try
        {
            testResult = await Api.TestRunAsync(selectedSummary.ScriptId, testParams, Envs.ActiveName);
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            statusIsError = true;
        }
        finally { testing = false; }
    }

    private void AddToPlan()
    {
        if (selectedSummary is null) return;
        var scenario = Catalog.Find(selectedSummary.ScenarioId);
        if (scenario is null) return;
        Sim.AddEntry(scenario);
        statusMessage = "Added to plan ✓";
        statusIsError = false;
    }

    private async Task DeleteCurrent()
    {
        if (selectedSummary is null) return;
        try
        {
            await Api.DeleteScriptAsync(selectedSummary.ScriptId, selectedSummary.ScenarioId);
            NewScript();
            renameOpen = false;
            await ReloadScriptsAsync();
            statusMessage = "Deleted";
            statusIsError = false;
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            statusIsError = true;
        }
    }

    private void SwitchToLive()
    {
        DataMode.SetFakeMode(false);
        _ = ReloadScriptsAsync();
    }

    public void Dispose()
    {
        DataMode.Changed -= OnStateChanged;
        Sim.Changed -= OnStateChanged;
    }
}
