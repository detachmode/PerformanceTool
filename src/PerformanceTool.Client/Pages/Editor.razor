@* Editor (brain 0024, 0020, 0019, 0016): edits the loaded scenarios, shown as the same ScenarioCards as the overview (idle state) plus an "Add scenario" tile.
   A card opens that scenario's settings in a side panel (a full-screen sheet on phones): label, actors/min and the generated parameters (essential first, the rest under "More options").
   Feedback: "Unsaved changes", Save only when something changed, "Saved ✓", and a confirm before loading over unsaved changes. *@
@page "/editor"
@layout MainLayout
@implements IDisposable
@inject IRunSource Sim
@inject ScenarioCatalog Catalog

<PageTitle>Editor · PerformanceTool</PageTitle>

@{
    var plan = Sim.Plan;
    var locked = Sim.IsRunning;
    var dirty = Sim.HasUnsavedChanges;
    if (selected >= plan.Scenarios.Count) selected = plan.Scenarios.Count - 1;
    if (selected < -1) selected = -1;
    var cfg = selected >= 0 ? plan.Scenarios[selected] : null;
    var scenario = cfg is null ? null : Catalog.Find(cfg.ScenarioId);
    var planErr = planSnap ??= PlanErrors(plan);
    var cfgErr = cfg is null ? null : ShownErrors(cfg);
    var hasAdvanced = scenario?.Spec.Fields.Any(f => f.Advanced) ?? false;
    var advancedInvalid = cfgErr is not null && scenario is not null
        && scenario.Spec.Fields.Where(f => f.Advanced).Any(f => cfgErr.Fields.Keys.Any(k => k.StartsWith(f.JsonName, StringComparison.Ordinal)));
}

<div class="page editor">
    <section class="preset-bar" aria-label="Presets">
        <div class="preset-title">
            <h1>Scenarios</h1>
            <span class="muted">Loaded from preset “@Sim.PresetName”</span>
            @if (dirty) { <span class="unsaved" role="status"><i></i>Unsaved changes</span> }
            else if (savedNote) { <span class="saved" role="status">Saved ✓</span> }
        </div>
        <div class="preset-actions">
            <label class="visually-hidden" for="load-preset">Load a preset into the scenarios</label>
            <select id="load-preset" value="" @onchange="OnLoadPicked" disabled="@locked">
                <option value="">Load preset…</option>
                @foreach (var p in Sim.PresetNames) { <option value="@p">@p</option> }
            </select>
            <button class="btn primary" @onclick="Save" disabled="@(locked || !dirty)" title="Save the scenarios to the preset “@Sim.PresetName”">Save</button>
            <button class="btn ghost" @onclick="OpenSaveAs" disabled="@locked" title="Save the scenarios as a new preset">Save as…</button>
        </div>
    </section>
    <p class="muted ed-hint">You are editing the loaded scenarios. A preset is loaded into them and saved from them.</p>

    @if (pendingLoad is not null)
    {
        <div class="notice" role="alertdialog" aria-label="Discard unsaved changes?">
            <span>Load preset “<b>@pendingLoad</b>” into the scenarios? It replaces the loaded scenarios; your unsaved changes will be lost.</span>
            <button class="btn primary" @onclick="ConfirmLoad">Load preset</button>
            <button class="btn ghost" @onclick="() => pendingLoad = null">Cancel</button>
        </div>
    }
    @if (saveAsOpen)
    {
        <form class="notice" @onsubmit="SaveAs" @onsubmit:preventDefault="true">
            <label for="save-as">Save the scenarios as preset</label>
            <input id="save-as" @bind="saveAsName" @bind:event="oninput" autocomplete="off" />
            <button class="btn primary" type="submit" disabled="@(saveAsName.Trim().Length == 0)">Save</button>
            <button class="btn ghost" type="button" @onclick="() => saveAsOpen = false">Cancel</button>
        </form>
    }
    @if (locked) { <div class="notice">A run is in progress. Stop it to edit the plan.</div> }

    <section class="settings" aria-label="Plan settings">
        <div class="num @(planErr.ContainsKey("dur") ? "is-invalid" : "")"><label for="p-dur">Duration (s)</label><input id="p-dur" type="number" min="1" value="@plan.DurationSeconds" @oninput="e => SetPlanInt(e, v => plan.DurationSeconds = v)" @onchange="Committed" disabled="@locked" aria-invalid="@Aria.Bool(planErr.ContainsKey("dur"))" /></div>
        <div class="num @(planErr.ContainsKey("conc") ? "is-invalid" : "")"><label for="p-conc">Max in-flight</label><input id="p-conc" type="number" min="1" max="1000" value="@plan.MaxConcurrency" @oninput="e => SetPlanInt(e, v => plan.MaxConcurrency = v)" @onchange="Committed" disabled="@locked" aria-invalid="@Aria.Bool(planErr.ContainsKey("conc"))" /></div>
        <div class="num @(planErr.ContainsKey("to") ? "is-invalid" : "")"><label for="p-to">Timeout (s)</label><input id="p-to" type="number" min="1" max="300" value="@plan.TimeoutSeconds" @oninput="e => SetPlanInt(e, v => plan.TimeoutSeconds = v)" @onchange="Committed" disabled="@locked" aria-invalid="@Aria.Bool(planErr.ContainsKey("to"))" /></div>
        @foreach (var e in planErr.Values) { <small class="field-error" role="alert">@e</small> }
    </section>

    <div class="ed-split @(cfg is null ? "" : "has-panel")">
        <div class="ed-main">
            <div class="grid ed-grid" aria-label="Loaded scenarios">
                @for (var i = 0; i < plan.Scenarios.Count; i++)
                {
                    var idx = i;
                    var c = plan.Scenarios[idx];
                    <ScenarioCard @key="c" Index="idx" Label="@LabelOf(c)" View="Empty" Actors="NoActors" Target="c.RatePerMinute"
                                  Idle="true" Subtitle="@(Catalog.Find(c.ScenarioId)?.Name ?? c.ScenarioId)" Selectable="true" Selected="@(idx == selected)"
                                  Edited="Sim.IsEntryChanged(c)" OnOpen="Select" />
                }
                <button class="card card-add" @onclick="() => addOpen = !addOpen" disabled="@(locked || plan.Scenarios.Count >= LoadPlan.MaxEntries)" aria-haspopup="true" aria-expanded="@Aria.Bool(addOpen)">
                    <span class="plus">+</span><span>Add scenario</span><small class="muted">@plan.Scenarios.Count / @LoadPlan.MaxEntries</small>
                </button>
                @if (addOpen)
                {
                    <ul class="add-menu" aria-label="Scenario types">
                        @foreach (var sc in Catalog.All)
                        {
                            var chosen = sc;
                            <li><button @onclick="() => Add(chosen)"><b>@chosen.Name</b><span>@chosen.Description</span></button></li>
                        }
                    </ul>
                }
            </div>
        </div>

        <section class="detail @(cfg is null ? "none" : "")" aria-label="Scenario settings">
            @if (cfg is null || scenario is null)
            {
                <div class="muted empty">@(cfg is null ? "Select a scenario to edit its settings." : "This scenario no longer exists in code.")</div>
            }
            else
            {
                <div class="detail-head">
                    <span class="muted" title="@scenario.Description">@scenario.Name</span>
                    <span class="spacer"></span>
                    @if (dirty) { <span class="unsaved small" role="status"><i></i>Unsaved</span> }
                    <button class="btn primary small" @onclick="Save" disabled="@(locked || !dirty)" title="Save the scenarios to the preset “@Sim.PresetName”">Save</button>
                    <button class="icon-btn" @onclick="() => selected = -1" aria-label="Close settings">✕</button>
                </div>
                <div class="detail-body">
                <div class="form" @key="cfg">
                    <div class="field wide">
                        <label for="entry-label">Label</label>
                        <input id="entry-label" class="entry-label" value="@cfg.Label" @oninput="e => { cfg.Label = e.Value?.ToString() ?? string.Empty; }" disabled="@locked" />
                    </div>
                    <div class="field rate @(cfgErr!.Rate is null ? "" : "is-invalid")">
                        <label for="entry-rate">Actors / minute</label>
                        <input id="entry-rate" type="number" min="0.1" step="any" value="@cfg.RatePerMinute" @oninput="SetRate" @onchange="Committed" disabled="@locked" aria-invalid="@Aria.Bool(cfgErr.Rate is not null)" />
                        @if (cfgErr.Rate is not null) { <small class="field-error" role="alert">@cfgErr.Rate</small> }
                    </div>
                    <ParameterEditor Spec="scenario.Spec" Values="cfg.Parameters" Disabled="locked" IdPrefix="@($"p{selected}")" Errors="cfgErr.Fields" Show="FieldFilter.Essential" Edited="Edited" Committed="Committed" />
                </div>
                @if (hasAdvanced)
                {
                    <details class="more" open="@advancedInvalid" @key="@((cfg, "more"))">
                        <summary>More options</summary>
                        <div class="form">
                            <ParameterEditor Spec="scenario.Spec" Values="cfg.Parameters" Disabled="locked" IdPrefix="@($"p{selected}")" Errors="cfgErr.Fields" Show="FieldFilter.Advanced" Edited="Edited" Committed="Committed" />
                        </div>
                    </details>
                }
                </div>
                <div class="detail-foot">
                    <button class="btn ghost danger small" @onclick="Remove" disabled="@locked">Remove scenario</button>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private sealed record EntryProblems(string? Rate, Dictionary<string, List<string>> Fields)
    {
        public int Count => (Rate is null ? 0 : 1) + Fields.Count;
    }

    private int selected = -1;
    private static readonly ScenarioView Empty = new(0, 0, 0, 0, 0, 0);
    private static readonly ActorRecord[] NoActors = [];

    private void Select(int i) { selected = i; addOpen = false; ResetErrors(); }

    // ---------- change detection while typing ----------
    // Dirty state is derived from the live plan on every render, so each input event only has to re-render this page (cheap: the
    // fingerprint of one plan plus the selected entry's validation). Errors are calmer: they are shown from a snapshot that is taken
    // when the user leaves a field (change event) or stops typing for 300 ms, never on each keystroke.
    private ScenarioRunConfig? snapFor;
    private EntryProblems? snap;
    private Dictionary<string, string>? planSnap;
    private CancellationTokenSource? debounce;

    private void ResetErrors() { snapFor = null; snap = null; planSnap = null; debounce?.Cancel(); }

    private EntryProblems ShownErrors(ScenarioRunConfig c)
    {
        if (!ReferenceEquals(snapFor, c) || snap is null) { snapFor = c; snap = EntryErrors(c); }
        return snap;
    }

    private void Edited()
    {
        debounce?.Cancel();
        debounce = new CancellationTokenSource();
        _ = SnapshotLater(debounce.Token);
    }

    private async Task SnapshotLater(CancellationToken ct)
    {
        try { await Task.Delay(300, ct); } catch (TaskCanceledException) { return; }
        if (disposed || ct.IsCancellationRequested) return;
        snap = null; planSnap = null;
        await InvokeAsync(StateHasChanged);
    }

    private void Committed() { debounce?.Cancel(); snap = null; planSnap = null; }

    private void SetRate(ChangeEventArgs e)
    {
        if (selected < 0) return;
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d))
            Sim.Plan.Scenarios[selected].RatePerMinute = d;
        Edited();
    }

    private void SetPlanInt(ChangeEventArgs e, Action<int> set)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) set(v);
        Edited();
    }
    private bool addOpen, saveAsOpen, savedNote;
    private string saveAsName = "";
    private string? pendingLoad;
    private bool disposed;

    protected override void OnInitialized() => Sim.Changed += OnChanged;

    private void OnChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    // ---------- validation (inline, per field) ----------

    private static string LabelOf(ScenarioRunConfig c) => string.IsNullOrWhiteSpace(c.Label) ? c.ScenarioId : c.Label;

    private static Dictionary<string, string> PlanErrors(LoadPlan plan)
    {
        var m = new Dictionary<string, string>();
        if (plan.DurationSeconds is < 1 or > 24 * 3600) m["dur"] = "Duration: between 1 second and 24 hours.";
        if (plan.MaxConcurrency is < 1 or > 1000) m["conc"] = "Max in-flight: between 1 and 1000.";
        if (plan.TimeoutSeconds is < 1 or > 300) m["to"] = "Timeout: between 1 and 300 seconds.";
        return m;
    }

    private EntryProblems EntryErrors(ScenarioRunConfig c)
    {
        string? rate = null;
        if (c.RatePerMinute is <= 0 or > LoadPlan.MaxRatePerMinute || double.IsNaN(c.RatePerMinute))
            rate = $"Between 0 and {LoadPlan.MaxRatePerMinute:N0} per minute.";
        var fields = Catalog.Find(c.ScenarioId) is { } sc ? sc.Spec.ValidateByField(c.Parameters) : new Dictionary<string, List<string>>();
        return new(rate, fields);
    }

    // ---------- list ----------

    private void Add(IScenario scenario)
    {
        Sim.AddEntry(scenario);
        ResetErrors();
        selected = Sim.Plan.Scenarios.Count - 1;
        addOpen = false;
    }

    private void Remove()
    {
        Sim.RemoveEntry(selected);
        selected = -1;
        ResetErrors();
    }

    // ---------- presets ----------

    private void OnLoadPicked(ChangeEventArgs e)
    {
        var name = e.Value?.ToString() ?? "";
        if (name.Length == 0) return;
        if (Sim.HasUnsavedChanges) pendingLoad = name;
        else DoLoad(name);
    }

    private void ConfirmLoad()
    {
        var name = pendingLoad;
        pendingLoad = null;
        if (name is not null) DoLoad(name);
    }

    private void DoLoad(string name)
    {
        Sim.LoadPreset(name);
        selected = -1;
        ResetErrors();
        saveAsOpen = false;
    }

    private void Save() { Sim.SavePreset(Sim.PresetName); FlashSaved(); }

    private void OpenSaveAs() { saveAsName = Sim.PresetName; saveAsOpen = true; pendingLoad = null; }

    private void SaveAs()
    {
        if (saveAsName.Trim().Length == 0) return;
        Sim.SavePreset(saveAsName);
        saveAsOpen = false;
        FlashSaved();
    }

    private async void FlashSaved()
    {
        savedNote = true;
        StateHasChanged();
        await Task.Delay(2500);
        if (disposed) return;
        savedNote = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        disposed = true;
        debounce?.Cancel();
        Sim.Changed -= OnChanged;
    }
}
