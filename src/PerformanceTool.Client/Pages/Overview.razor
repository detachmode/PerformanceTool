@* Overview (brain 0020): run status. One calm card per scenario; a card opens the scenario popup. *@
@page "/"
@page "/overview"
@layout MainLayout
@implements IDisposable
@inject IRunSource Sim
@inject ScenarioCatalog Catalog

<PageTitle>Overview · PerformanceTool</PageTitle>

@{
    var s = Sim.Current;
    var state = s.Paused ? "Paused" : s.Running ? "Running" : s.State == FakeRunState.Finished ? "Finished" : "Idle";
}

<div class="page">
    <div class="page-head">
        <h1>Scenarios</h1>
        <span class="muted">@state · @s.Count scenarios · @Format.Num(s.Scenarios.Sum(x => x.Finished)) actors finished</span>
    </div>

    <div class="grid" aria-label="Scenarios">
        @for (var i = 0; i < s.Count; i++)
        {
            var idx = i;
            <ScenarioCard @key="s.Plan.Scenarios[idx]" Index="idx" Label="@s.Labels[idx]" View="s.Scenarios[idx]" Actors="s.Store.Actors(idx)" Running="s.ActorsInFlight?[idx]"
                          Target="s.Plan.Scenarios[idx].RatePerMinute" Elapsed="s.Elapsed" OnOpen="i => { open = i; openFilter = DetailFilter.All; }" OnOpenFiltered="t => { open = t.Index; openFilter = t.Filter; }" />
        }
    </div>
</div>

@if (open is { } o && o < s.Count)
{
    <ScenarioDetailDialog Index="o" Snapshot="s" InitialShow="openFilter" OnClose="() => open = null" />
}

@code {
    private int? open;
    private DetailFilter openFilter;

    protected override void OnInitialized() => Sim.Changed += OnChanged;

    private void OnChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public void Dispose() => Sim.Changed -= OnChanged;
}
