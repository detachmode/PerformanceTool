<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared by the WebAssembly client and the server: scenarios, parameter specs, the load plan and the run DTOs.
       Keep it free of ASP.NET and browser dependencies (brain 0015). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Beesharp</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Embed C# sources in the Portable PDB (not the DLL) so the editor can show built-in scenario code even in Docker/published builds. -->
    <EmbedAllSources>true</EmbedAllSources>
    <PackageId>Beesharp.Core</PackageId>
    <Authors>detachmode</Authors>
    <Description>Core scenario, parameter, step-machine and runtime APIs for Beesharp load tests.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>beesharp;load-testing;performance;scenarios</PackageTags>
    <PackageProjectUrl>https://github.com/detachmode/PerformanceTool</PackageProjectUrl>
    <RepositoryUrl>https://github.com/detachmode/PerformanceTool</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="buildTransitive/Beesharp.Core.props" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <!-- Only for AddScenario<T>() on IServiceCollection and ILogger on ScenarioContext. From .NET 11 the SDK provides them
       itself (NU1510 asks to drop the references); older SDKs (the .NET 10 agent copy) still need them. The condition avoids a
       literal target name so the copy's net11.0 -> net10.0 rewrite keeps it working. -->
  <ItemGroup Condition="$([MSBuild]::VersionLessThan($([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')), '11.0'))">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
