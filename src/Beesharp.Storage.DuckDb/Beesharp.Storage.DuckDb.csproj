<Project Sdk="Microsoft.NET.Sdk">

  <!-- The DuckDB run storage (the default provider, brain 0046) and AddBeesharpStorage, which picks the provider.
       A separate project so a consumer that only needs the in-memory provider avoids the native DuckDB binaries (brain 0054). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Beesharp</RootNamespace>
    <PackageId>Beesharp.Storage.DuckDb</PackageId>
    <Description>DuckDB run storage provider for Beesharp with Parquet, DuckDB, JSON and CSV export.</Description>
    <PackageTags>beesharp;load-testing;performance;storage;duckdb</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.6.1" />
    <ProjectReference Include="../Beesharp.Storage/Beesharp.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Beesharp.Contracts" />
  </ItemGroup>

</Project>
