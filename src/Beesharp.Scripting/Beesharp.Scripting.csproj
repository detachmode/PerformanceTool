<Project Sdk="Microsoft.NET.Sdk">

  <!-- One Roslyn compile-and-store implementation for scenario scripts, preflights and shutdown programs (brain 0042, 0054).
       No ASP.NET: the scripts directory comes from options. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Beesharp</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Beesharp.Scripting</PackageId>
    <Description>Roslyn C# script compiler and store for Beesharp scenario, preflight and shutdown scripts.</Description>
    <PackageTags>beesharp;load-testing;performance;scripting;roslyn</PackageTags>
  </PropertyGroup>

  <!-- ILogger and IServiceCollection: from .NET 11 the SDK provides them itself (see Beesharp.Core.csproj); older SDKs still need the packages. -->
  <ItemGroup Condition="$([MSBuild]::VersionLessThan($([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')), '11.0'))">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.12.0" />
    <ProjectReference Include="../Beesharp.Core/Beesharp.Core.csproj" />
    <ProjectReference Include="../Beesharp.Contracts/Beesharp.Contracts.csproj" />
    <ProjectReference Include="../Beesharp.Storage/Beesharp.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Beesharp.Contracts" />
  </ItemGroup>

</Project>
